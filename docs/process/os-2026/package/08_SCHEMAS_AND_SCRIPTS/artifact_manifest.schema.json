{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/artifact-manifest.schema.json",
  "title": "Artifact Manifest",
  "type": "object",
  "required": [
    "artifact_id",
    "run_id",
    "project_id",
    "source_tool",
    "collected_at_utc",
    "files"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "issue_id": {
      "type": "string"
    },
    "source_tool": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "configuration": {
      "type": [
        "object",
        "string"
      ]
    },
    "scope": {
      "type": "object"
    },
    "date_range": {
      "type": "object"
    },
    "collected_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "operator_agent": {
      "type": "string"
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mime_type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}