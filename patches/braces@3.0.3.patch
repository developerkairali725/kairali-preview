diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..b6f467a2e09a32b602145fbd704e06e8898e01cd
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,14 @@
+'use strict';
+// Bound every public AST walker, including callers that supply an AST directly.
+const MAX_DEPTH = 100;
+const assertDepth = ast => {
+  const stack = [[ast, 0]];
+  while (stack.length) {
+    const [node, depth] = stack.pop();
+    if (depth > MAX_DEPTH) throw new SyntaxError('Maximum brace nesting depth exceeded');
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push([child, depth + 1]);
+    }
+  }
+};
+module.exports = { MAX_DEPTH, assertDepth };
