{"id":"ahv-page-treatment-programs-mobile","file":"AHV Page Treatment Programs Mobile.dc.html","sourceSha256":"cbff01438962a153b786f0b40c713f82fa2c5bcf4898c6fca17dbca4d76a50bc","variant":"mobile","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\ninput,button{font-family:'Mulish',sans-serif}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Ayurvedic Treatment Programmes in Kerala | Kairali</title>\n<meta name=\"description\" content=\"Explore Kairali’s Ayurvedic treatment programmes in Kerala. Browse programme details and arrange a free initial online consultation with an Ayurvedic physician.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/treatment-programs/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Ayurvedic Treatment Programmes in Kerala | Kairali\">\n<meta property=\"og:description\" content=\"Explore Kairali’s Ayurvedic treatment programmes in Kerala. Browse programme details and arrange a free initial online consultation with an Ayurvedic physician.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/treatment-programs/\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"@id\":\"https://ayurvedichealingvillage.com/treatment-programs/\",\"url\":\"https://ayurvedichealingvillage.com/treatment-programs/\",\"name\":\"Ayurvedic Treatment Programmes in Kerala | Kairali\",\"description\":\"Explore Kairali’s Ayurvedic treatment programmes in Kerala. Browse programme details and arrange a free initial online consultation with an Ayurvedic physician.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/treatment-programs/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"All Programmes\",\"item\":\"https://ayurvedichealingvillage.com/all-programs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Treatment Programs\",\"item\":\"https://ayurvedichealingvillage.com/treatment-programs/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Treatment Programmes — Mobile\" style=\"max-width:430px;margin:0 auto;background:#F7F4EA;box-shadow:0 0 40px rgba(70,50,20,.15);position:relative;padding-bottom:calc(64px + env(safe-area-inset-bottom,0px));box-sizing:border-box\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:20px 0 32px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;gap:8px;align-items:center;flex-wrap:wrap\"><a href=\"https://ayurvedichealingvillage.com/\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/all-programs/\" style=\"display:inline-flex;align-items:center;min-height:44px\">All Programmes</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118\">Treatment Programs</span></nav>\n  <div style=\"padding-top:4px\">\n    <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Ayurveda at Kairali</div>\n    <h1 style=\"font-family:'Marcellus',serif;font-size:30px;line-height:1.2;margin:12px 0 0;text-wrap:balance\">Ayurvedic treatment programmes</h1>\n    <p style=\"font-size:19px;line-height:1.65;color:#514a3f;margin:18px 0 0;border-left:3px solid #C1882C;padding-left:20px\">Explore Kairali’s Ayurvedic treatment programmes in Kerala. Read the programme details and speak with an Ayurvedic physician about the options you are considering.</p>\n  </div>\n  <div style=\"margin-top:28px;background:#43331E;color:#F7F4EA;border-radius:4px;padding:24px 22px\">\n    <h2 style=\"font-family:'Marcellus',serif;font-size:22px;line-height:1.3;color:#fff\">Discuss your next step with a physician</h2>\n    <p style=\"margin:12px 0 18px;font-size:17px;line-height:1.65;color:rgba(247,244,234,.92)\">Your initial online consultation with an Ayurvedic physician is free. Discuss your concerns and ask about the programme you are considering.</p>\n    <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" onClick=\"{{ guard }}\" style=\"display:flex;justify-content:center;align-items:center;min-height:48px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 20px;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;text-align:center\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Free initial online consultation</a>\n  </div>\n</section>\n\n<section id=\"browse\" aria-labelledby=\"browse-h\" style=\"background:#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:22px 0 0\">\n    <label style=\"display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:13px;letter-spacing:1.8px;text-transform:uppercase;color:#8F6212\">Search treatment programmes\n      <input type=\"search\" value=\"{{ query }}\" onChange=\"{{ onQuery }}\" placeholder=\"Search by programme name\" aria-describedby=\"result-count\" style=\"min-height:48px;box-sizing:border-box;padding:10px 14px;border:1px solid #75695A;border-radius:4px;background:#fff;font-size:17px;font-weight:400;letter-spacing:0;color:#2A2118;width:100%\">\n    </label>\n    <p id=\"result-count\" role=\"status\" style=\"margin:10px 0 0;font-size:16px;color:#75695A\">{{ resultLine }}</p>\n  </div>\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:30px 0 48px\">\n    <h2 id=\"browse-h\" style=\"font-family:'Marcellus',serif;font-size:26px;margin-bottom:18px\">Explore treatment programmes</h2>\n    <sc-if value=\"{{ hasResults }}\" hint-placeholder-val=\"{{ true }}\">\n      <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:16px\">\n        <sc-for list=\"{{ results }}\" as=\"r\" hint-placeholder-count=\"6\">\n          <li style=\"background:#FFFDF7;border:1px solid #E9E2D3;border-top:3px solid #C1882C;border-radius:4px;padding:20px 20px 18px;display:flex;flex-direction:column;gap:6px\">\n            <h3 style=\"font-family:'Marcellus',serif;font-size:21px;line-height:1.3\">{{ r.name }}</h3>\n            <p style=\"margin:0;font-style:italic;color:#75695A;font-size:15.5px\">{{ r.sanskrit }}</p>\n            <dl style=\"margin:10px 0 0;display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:15.5px;border-top:1px solid #EDE5D3;padding-top:12px\">\n              <dt style=\"color:#75695A\">Minimum duration</dt><dd style=\"margin:0;font-weight:600\">{{ r.duration }}</dd>\n            </dl>\n            <div style=\"display:flex;margin-top:auto;padding-top:14px\">\n              <a href=\"{{ r.href }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 18px;background:#5A4420;color:#F7F4EA;border-radius:4px;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase\" style-hover=\"background:#483616;color:#F7F4EA;text-decoration:none\">View programme</a>\n            </div>\n          </li>\n        </sc-for>\n      </ul>\n    </sc-if>\n    <sc-if value=\"{{ noResults }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"background:#FFFDF7;border:1px solid #E9E2D3;border-radius:4px;padding:26px 22px\">\n        <h3 style=\"font-family:'Marcellus',serif;font-size:23px\">No programmes match your search</h3>\n        <p style=\"margin:10px 0 18px;color:#514a3f\">Try another programme name or clear your search to see all treatment programmes.</p>\n        <button type=\"button\" onClick=\"{{ reset }}\" style=\"min-height:48px;padding:0 24px;border-radius:4px;border:1.5px solid #5A4420;background:#fff;color:#5A4420;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer\">Clear search</button>\n      </div>\n    </sc-if>\n    <div style=\"margin-top:30px;padding-top:22px;border-top:1px solid #E9E2D3;display:flex\">\n      <a href=\"https://ayurvedichealingvillage.com/all-programs/\" onClick=\"{{ guard }}\" style=\"flex:1;display:flex;justify-content:center;align-items:center;min-height:48px;padding:0 20px;border:1.5px solid #5A4420;color:#5A4420;border-radius:4px;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;text-align:center\" style-hover=\"background:#5A4420;color:#F7F4EA;text-decoration:none\">Explore all programmes</a>\n    </div>\n  </div>\n</section>\n\n<section aria-label=\"Next steps\" style=\"width:min(1220px,94%);margin:0 auto;padding:44px 0 56px;text-align:center\">\n  <h2 style=\"font-family:'Marcellus',serif;font-size:24px;margin:0 0 10px\">Discuss your next step with a physician</h2>\n  <p style=\"margin:0 auto 24px;font-size:17px;color:#514a3f\">Your initial online consultation with an Ayurvedic physician is free. Discuss your concerns and ask about the programme you are considering.</p>\n  <div style=\"display:flex\">\n    <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" onClick=\"{{ guard }}\" style=\"flex:1;display:flex;justify-content:center;align-items:center;min-height:52px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 20px;font-weight:700;font-size:15px;letter-spacing:1.5px;text-transform:uppercase;text-align:center\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Free initial online consultation</a>\n  </div>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:36px;display:flex;flex-direction:column;align-items:center;gap:4px;border-top:1px solid #E9E2D3;padding-top:18px\">\n    <a href=\"https://ayurvedichealingvillage.com/social-responsibilities/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Social Responsibility</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Past Retreats</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">News &amp; Past Events</a>\n  </nav>\n</section>\n</main>\n<div style=\"opacity:{{ barO }};visibility:{{ barV }};pointer-events:{{ barP }};transition:opacity .28s ease,visibility .28s ease;position:fixed;left:0;right:0;bottom:0;z-index:70;max-width:430px;margin:0 auto;padding-bottom:env(safe-area-inset-bottom,0px);display:flex;align-items:stretch;background:#2A2014;box-shadow:0 -8px 24px rgba(0,0,0,.25)\">\n  <a href=\"https://ayurvedichealingvillage.com/all-programs/\" onClick=\"{{ guard }}\" style=\"flex:1;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;color:#F7F4EA;font-weight:700;font-size:12.5px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:rgba(247,244,234,.08);text-decoration:none;color:#F7F4EA\">All programmes</a>\n  <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" onClick=\"{{ guard }}\" style=\"flex:1.3;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;background:#EEB41E;color:#2A2014;font-weight:700;font-size:12.5px;letter-spacing:1.5px;text-transform:uppercase;text-align:center;padding:0 12px\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2014\">Free initial online consultation</a>\n</div>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n<div style=\"height:76px;background:#2A2014\" aria-hidden=\"true\"></div>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  state = { query: '', barOn: false };\n  componentDidMount() {\n    document.documentElement.lang = 'en-US';\n    this._onScroll = () => {\n      const y = window.scrollY;\n      const nearEnd = (y + window.innerHeight) > (document.documentElement.scrollHeight - 140);\n      const bar = y > 300 && !nearEnd;\n      if (bar !== this.state.barOn) this.setState({ barOn: bar });\n    };\n    window.addEventListener('scroll', this._onScroll, { passive: true });\n    this._onScroll();\n  }\n  componentWillUnmount() { window.removeEventListener('scroll', this._onScroll); }\n  renderVals() {\n    const D = window.AHV_TREATMENT_PROGRAMS || { rows: [], count: 29 };\n    const norm = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[’']/g, '');\n    const q = norm(this.state.query.trim());\n    const results = D.rows.filter(p => !q || q.split(/\\s+/).every(w => (norm(p.name) + ' | ' + norm(p.sanskrit)).includes(w)))\n      .map(p => ({ name: p.name, sanskrit: p.sanskrit, duration: p.durationDisplay, href: 'https://ayurvedichealingvillage.com' + p.route }));\n    const on = this.state.barOn;\n    return {\n      barO: on ? 1 : 0, barV: on ? 'visible' : 'hidden', barP: on ? 'auto' : 'none',\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      query: this.state.query,\n      onQuery: (e) => this.setState({ query: e.target.value }),\n      reset: () => this.setState({ query: '' }),\n      results, hasResults: results.length > 0, noResults: results.length === 0,\n      resultLine: results.length + ' of ' + D.rows.length + ' programmes'\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/treatment-programs-data.js"]}