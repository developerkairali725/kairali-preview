 "template": "\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\ninput,button{font-family:'Mulish',sans-serif}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Ayurveda, Yoga &amp; Training Programmes in Kerala | Kairali</title>\n<meta name=\"description\" content=\"Explore Kairali’s Ayurveda, yoga and training programmes in Kerala. Compare programme details and arrange a free initial online physician consultation.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/all-programs/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Ayurveda, Yoga &amp; Training Programmes in Kerala | Kairali\">\n<meta property=\"og:description\" content=\"Explore Kairali’s Ayurveda, yoga and training programmes in Kerala. Compare programme details and arrange a free initial online physician consultation.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/all-programs/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2024/10/P-Banner.jpg\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"459\">\n<meta property=\"og:image:type\" content=\"image/jpeg\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"@id\":\"https://ayurvedichealingvillage.com/all-programs/\",\"url\":\"https://ayurvedichealingvillage.com/all-programs/\",\"name\":\"Ayurveda, Yoga & Training Programmes in Kerala | Kairali\",\"description\":\"Explore Kairali’s Ayurveda, yoga and training programmes in Kerala. Compare programme details and arrange a free initial online physician consultation.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/all-programs/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"All Programmes\",\"item\":\"https://ayurvedichealingvillage.com/all-programs/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"All Programmes finder — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 44px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;gap:8px;align-items:center\"><a href=\"https://ayurvedichealingvillage.com/\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118\">All Programmes</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:48px;align-items:end;padding-top:6px\">\n    <div>\n      <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Ayurveda, yoga &amp; learning in Kerala</div>\n      <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.6vw,54px);line-height:1.12;margin:12px 0 0;max-width:20ch;text-wrap:balance\">Find your programme at Kairali</h1>\n      <p style=\"font-size:19px;line-height:1.65;color:#514a3f;max-width:62ch;margin:20px 0 0;border-left:3px solid #C1882C;padding-left:20px\">Explore programmes for treatment, wellbeing, yoga and Ayurveda training. Browse at your own pace, compare the details, and speak with an Ayurvedic physician before choosing your next step.</p>\n    </div>\n    <div style=\"background:#43331E;color:#F7F4EA;border-radius:4px;padding:28px 30px\">\n      <h2 style=\"font-family:'Marcellus',serif;font-size:24px;line-height:1.3;color:#fff\">A personal conversation is a good place to start</h2>\n      <p style=\"margin:12px 0 20px;font-size:17px;line-height:1.65;color:rgba(247,244,234,.92)\">Your initial online consultation with an Ayurvedic physician is free. Discuss your concerns and ask about the programme you are considering.</p>\n      <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:48px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 28px;font-weight:700;font-size:14.5px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Free initial online consultation</a>\n    </div>\n  </div>\n</section>\n\n<section id=\"browse\" aria-labelledby=\"browse-h\" style=\"scroll-margin-top:80px;background:#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"position:sticky;top:0;z-index:40;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-bottom:1px solid #E9E2D3\">\n    <div style=\"width:min(1220px,94%);margin:0 auto;padding:18px 0;display:grid;grid-template-columns:minmax(260px,420px) minmax(0,1fr);gap:18px 32px;align-items:center\">\n      <label style=\"display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:13px;letter-spacing:1.8px;text-transform:uppercase;color:#8F6212\">Search programmes\n        <input type=\"search\" value=\"{{ query }}\" onChange=\"{{ onQuery }}\" placeholder=\"Search by programme name\" aria-describedby=\"result-count\" style=\"min-height:48px;box-sizing:border-box;padding:10px 14px;border:1px solid #75695A;border-radius:4px;background:#fff;font-size:17px;font-weight:400;letter-spacing:0;color:#2A2118;width:100%\">\n      </label>\n      <div role=\"group\" aria-label=\"Filter by category\" style=\"display:flex;gap:10px;flex-wrap:wrap\">\n        <sc-for list=\"{{ pills }}\" as=\"p\" hint-placeholder-count=\"5\">\n          <button type=\"button\" onClick=\"{{ p.pick }}\" aria-pressed=\"{{ p.on }}\" style=\"min-height:44px;box-sizing:border-box;padding:0 18px;border-radius:4px;border:1px solid {{ p.bd }};background:{{ p.bg }};color:{{ p.fg }};font-weight:700;font-size:15px;letter-spacing:.6px;cursor:pointer;display:inline-flex;align-items:center;gap:8px\">{{ p.label }}<span style=\"font-weight:400;opacity:.85\">{{ p.count }}</span></button>\n        </sc-for>\n      </div>\n    </div>\n  </div>\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 64px\">\n    <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:22px\">\n      <h2 id=\"browse-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px)\">Explore all programmes</h2>\n      <p id=\"result-count\" role=\"status\" style=\"margin:0;font-size:16px;color:#75695A\">{{ resultLine }}</p>\n    </div>\n    <div style=\"display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:32px;align-items:start\">\n      <div>\n        <sc-if value=\"{{ hasResults }}\" hint-placeholder-val=\"{{ true }}\">\n          <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(280px,100%),1fr));gap:18px\">\n            <sc-for list=\"{{ results }}\" as=\"r\" hint-placeholder-count=\"6\">\n              <li style=\"background:#FFFDF7;border:1px solid #E9E2D3;border-top:3px solid #C1882C;border-radius:4px;padding:22px 22px 20px;display:flex;flex-direction:column;gap:6px\">\n                <div style=\"display:flex;gap:6px;flex-wrap:wrap\"><sc-for list=\"{{ r.cats }}\" as=\"c\" hint-placeholder-count=\"1\"><span style=\"font-weight:700;font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:#8F6212;border:1px solid #E9E2D3;border-radius:3px;padding:3px 8px\">{{ c }}</span></sc-for></div>\n                <h3 style=\"font-family:'Marcellus',serif;font-size:21px;line-height:1.3;margin-top:6px\">{{ r.name }}</h3>\n                <sc-if value=\"{{ r.hasSanskrit }}\" hint-placeholder-val=\"{{ true }}\"><p style=\"margin:0;font-style:italic;color:#75695A;font-size:15.5px\">{{ r.sanskrit }}</p></sc-if>\n                <dl style=\"margin:10px 0 0;display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:15.5px;border-top:1px solid #EDE5D3;padding-top:12px\">\n                  <dt style=\"color:#75695A\">Minimum duration</dt><dd style=\"margin:0;font-weight:600\">{{ r.duration }}</dd>\n                  <dt style=\"color:#75695A\">Programme from</dt><dd style=\"margin:0;font-weight:600;color:#5A4420\">{{ r.price }}</dd>\n                </dl>\n                <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:14px\">\n                  <a href=\"{{ r.href }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 18px;background:#5A4420;color:#F7F4EA;border-radius:4px;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase\" style-hover=\"background:#483616;color:#F7F4EA;text-decoration:none\">View programme</a>\n                  <button type=\"button\" onClick=\"{{ r.toggle }}\" aria-pressed=\"{{ r.saved }}\" disabled=\"{{ r.disabled }}\" style=\"min-height:44px;padding:0 16px;border-radius:4px;border:1.5px solid #5A4420;background:{{ r.btnBg }};color:{{ r.btnFg }};font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;cursor:pointer;opacity:{{ r.btnOpacity }}\">{{ r.btnLabel }}</button>\n                </div>\n              </li>\n            </sc-for>\n          </ul>\n        </sc-if>\n        <sc-if value=\"{{ noResults }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"background:#FFFDF7;border:1px solid #E9E2D3;border-radius:4px;padding:32px 30px;max-width:60ch\">\n            <h3 style=\"font-family:'Marcellus',serif;font-size:24px\">No programmes match your search</h3>\n            <p style=\"margin:10px 0 18px;color:#514a3f\">Try another programme name or clear your filters to see all programmes.</p>\n            <button type=\"button\" onClick=\"{{ reset }}\" style=\"min-height:48px;padding:0 24px;border-radius:4px;border:1.5px solid #5A4420;background:#fff;color:#5A4420;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer\">Clear filters</button>\n          </div>\n        </sc-if>\n        <p style=\"margin:26px 0 0;font-size:15px;color:#75695A;max-width:80ch\">Minimum programme total for one person in a Deluxe Villa, single occupancy. Displayed rates are valid through 30 September 2026. For a later stay, request a current quote.</p>\n      </div>\n      <aside aria-labelledby=\"shortlist-h\" style=\"position:sticky;top:112px;background:#F7F4EA;border:1px solid #E9E2D3;border-radius:4px;padding:22px 22px 24px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:10px\"><h2 id=\"shortlist-h\" style=\"font-family:'Marcellus',serif;font-size:22px\">Your shortlist</h2><span style=\"font-size:14px;color:#75695A\">{{ savedCount }}/3</span></div>\n        <sc-if value=\"{{ noSaved }}\" hint-placeholder-val=\"{{ true }}\"><p style=\"margin:12px 0 0;font-size:16px;color:#514a3f\">Save programmes here while you explore.</p></sc-if>\n        <sc-if value=\"{{ hasSaved }}\" hint-placeholder-val=\"{{ false }}\">\n          <ul style=\"list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:8px\">\n            <sc-for list=\"{{ saved }}\" as=\"s\" hint-placeholder-count=\"1\">\n              <li style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;border-top:1px solid #E9E2D3;padding-top:8px\"><span style=\"font-size:15.5px;line-height:1.4\">{{ s.name }}</span><button type=\"button\" onClick=\"{{ s.toggle }}\" aria-label=\"Remove from shortlist: {{ s.name }}\" style=\"flex:none;min-width:44px;min-height:44px;border:none;background:transparent;color:#8F6212;font-size:22px;cursor:pointer\">×</button></li>\n            </sc-for>\n          </ul>\n          <p style=\"margin:12px 0 0;font-size:14px;color:#75695A\">You can compare up to three programmes.</p>\n          <button type=\"button\" onClick=\"{{ openCompare }}\" aria-expanded=\"{{ compareOpen }}\" aria-controls=\"compare\" style=\"margin-top:14px;width:100%;min-height:48px;border-radius:4px;border:none;background:#EEB41E;color:#2A2118;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer\">Compare programmes</button>\n        </sc-if>\n      </aside>\n    </div>\n  </div>\n</section>\n\n<sc-if value=\"{{ showCompare }}\" hint-placeholder-val=\"{{ false }}\">\n<section id=\"compare\" aria-labelledby=\"compare-h\" tabIndex=\"{{ minusOne }}\" style=\"width:min(1220px,94%);margin:0 auto;padding:56px 0 0\">\n  <h2 id=\"compare-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px)\">Your programme comparison</h2>\n  <p style=\"margin:10px 0 24px;color:#514a3f;max-width:70ch\">Compare programme details here. Your physician will discuss suitability during your consultation.</p>\n  <div style=\"display:grid;grid-template-columns:repeat({{ savedCount }},minmax(0,1fr));gap:18px\">\n    <sc-for list=\"{{ saved }}\" as=\"s\" hint-placeholder-count=\"2\">\n      <article style=\"background:#FFFDF7;border:1px solid #E9E2D3;border-top:3px solid #C1882C;border-radius:4px;padding:24px\">\n        <h3 style=\"font-family:'Marcellus',serif;font-size:22px;line-height:1.3\">{{ s.name }}</h3>\n        <sc-if value=\"{{ s.hasSanskrit }}\" hint-placeholder-val=\"{{ true }}\"><p style=\"margin:2px 0 0;font-style:italic;color:#75695A;font-size:15.5px\">{{ s.sanskrit }}</p></sc-if>\n        <dl style=\"margin:16px 0 0;display:grid;gap:10px;font-size:16px\">\n          <div><dt style=\"color:#75695A;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;font-weight:700\">Category</dt><dd style=\"margin:2px 0 0\">{{ s.catText }}</dd></div>\n          <div><dt style=\"color:#75695A;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;font-weight:700\">Minimum duration</dt><dd style=\"margin:2px 0 0\">{{ s.duration }}</dd></div>\n          <div><dt style=\"color:#75695A;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;font-weight:700\">Programme from</dt><dd style=\"margin:2px 0 0;font-family:'Marcellus',serif;font-size:22px;color:#5A4420\">{{ s.price }}</dd><dd style=\"margin:4px 0 0;font-size:14px;color:#75695A\">{{ s.basis }}</dd></div>\n        </dl>\n        <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:18px\">\n          <a href=\"{{ s.href }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 18px;background:#5A4420;color:#F7F4EA;border-radius:4px;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase\" style-hover=\"background:#483616;color:#F7F4EA;text-decoration:none\">View programme</a>\n          <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border:1.5px solid #5A4420;color:#5A4420;border-radius:4px;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase\" style-hover=\"background:#5A4420;color:#F7F4EA;text-decoration:none\">Request a quote</a>\n        </div>\n      </article>\n    </sc-for>\n  </div>\n  <div style=\"display:flex;gap:14px;flex-wrap:wrap;margin-top:22px\">\n    <div role=\"group\" aria-label=\"Currency\" style=\"display:flex;gap:8px\">\n      <sc-for list=\"{{ currencies }}\" as=\"c\" hint-placeholder-count=\"3\">\n        <button type=\"button\" onClick=\"{{ c.pick }}\" aria-pressed=\"{{ c.on }}\" style=\"min-height:44px;box-sizing:border-box;padding:0 18px;border-radius:4px;border:1px solid {{ c.bd }};background:{{ c.bg }};color:{{ c.fg }};font-weight:700;font-size:14px;letter-spacing:1px;cursor:pointer\">{{ c.label }}</button>\n      </sc-for>\n    </div>\n    <button type=\"button\" onClick=\"{{ closeCompare }}\" style=\"min-height:44px;padding:0 18px;border-radius:4px;border:1.5px solid #C9BFA8;background:#fff;color:#2A2118;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;cursor:pointer\">Close comparison</button>\n  </div>\n</section>\n</sc-if>\n\n<section aria-label=\"Next steps\" style=\"width:min(1220px,94%);margin:0 auto;padding:64px 0 72px;text-align:center\">\n  <h2 style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,34px);margin:0 0 10px\">A personal conversation is a good place to start</h2>\n  <p style=\"margin:0 auto 26px;font-size:17px;color:#514a3f;max-width:60ch\">Your initial online consultation with an Ayurvedic physician is free. Discuss your concerns and ask about the programme you are considering.</p>\n  <div style=\"display:flex;justify-content:center;gap:16px;flex-wrap:wrap\">\n    <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:52px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 34px;font-weight:700;font-size:15px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Free initial online consultation</a>\n    <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:52px;border:1.5px solid #5A4420;color:#5A4420;border-radius:4px;padding:0 34px;font-weight:700;font-size:15px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:#5A4420;color:#F7F4EA;text-decoration:none\">Request a quote</a>\n  </div>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:44px;display:flex;justify-content:center;gap:8px 28px;flex-wrap:wrap;border-top:1px solid #E9E2D3;padding-top:22px\">\n    <a href=\"https://ayurvedichealingvillage.com/social-responsibilities/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Social Responsibility</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Past Retreats</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">News &amp; Past Events</a>\n  </nav>\n</section>\n<section aria-label=\"Guidance\" data-ahv-finder-block=\"1\" style=\"margin-top:56px;padding:50px 0 56px;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n    <div style=\"width:min(760px,92%);margin:0 auto;text-align:center\">\n      <ul style=\"margin:0 auto 22px;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr));gap:10px 24px;max-width:640px;text-align:left\"> <li style=\"display:flex;gap:10px;align-items:baseline\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span><span>NABH Certified Hospital</span></li> <li style=\"display:flex;gap:10px;align-items:baseline\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span><span>{{ heritageLine }}</span></li> <li style=\"display:flex;gap:10px;align-items:baseline\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span><span>Individualised Programmes</span></li> <li style=\"display:flex;gap:10px;align-items:baseline\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span><span>World Luxury Award Winner</span></li> </ul> <h2 style=\"font-family:'Marcellus',serif;font-size:26px;margin:0 0 12px\">Not sure which programme fits?</h2>\n      <p style=\"margin:0 auto 28px;font-size:16.5px;line-height:1.7;color:#514a3f;max-width:56ch\">Share your goal in your own words — the patient care team or an Ayurvedic doctor will point you to the right programme.</p>\n      <div style=\"display:flex;justify-content:center;gap:16px;flex-wrap:wrap\">\n        <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" style=\"background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 34px;min-height:52px;display:inline-flex;align-items:center;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Free Doctor Consultation</a> <a href=\"https://wa.me/919289838797\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"border:1.5px solid #006038;color:#006038;border-radius:4px;padding:0 30px;min-height:52px;display:inline-flex;align-items:center;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:#006038;color:#F7F4EA;text-decoration:none\">WhatsApp Patient Care</a>\n        <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"border:1.5px solid #5A4420;color:#5A4420;border-radius:4px;padding:0 30px;min-height:52px;display:inline-flex;align-items:center;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:#5A4420;color:#F7F4EA;text-decoration:none\">Enquire Now</a>\n      </div>\n    </div>\n  </section> </main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n",
 "logic": "\nclass Component extends DCLogic {\n  state = { query: '', cat: 'All', saved: (function () { try { var s = JSON.parse(localStorage.getItem('ahv-shortlist') || '[]'); return Array.isArray(s) ? s.filter(function (r) { return typeof r === 'string'; }).slice(0, 3) : []; } catch (e) { return []; } })(), cur: 'INR', compareOpen: false };\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_FINDER || { copy: {}, programmes: [], counts: {} };\n    const { query, cat, saved, cur, compareOpen } = this.state;\n    const today = new Date();\n    const expired = (p) => !p.validTo || today > new Date(p.validTo + 'T23:59:59');\n    const fmt = (p) => {\n      const v = p.from && p.from[cur];\n      if (v == null) return 'Enquire for details';\n      if (expired(p)) return 'Request a quote';\n      const sym = { INR: '₹', USD: '$', EUR: '€' }[cur];\n      return sym + v.toLocaleString('en-IN');\n    };\n    const norm = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[’']/g, '');\n    const q = norm(query.trim());\n    const matches = (p) => {\n      if (cat !== 'All' && !p.categories.includes(cat)) return false;\n      if (!q) return true;\n      const hay = [p.name, p.sanskrit, ...(p.aliases || [])].map(norm).join(' | ');\n      return q.split(/\\s+/).every(w => hay.includes(w));\n    };\n    const guard = () => {}; /* preview-only nav guard neutralised for the published site */\n    const isSaved = (r) => saved.includes(r);\n    const toggle = (r) => () => this.setState(s => { const next = s.saved.includes(r) ? s.saved.filter(x => x !== r) : (s.saved.length >= 3 ? s.saved : [...s.saved, r]); try { localStorage.setItem('ahv-shortlist', JSON.stringify(next)); } catch (e) {} return { saved: next }; });\n    const full = saved.length >= 3;\n    const row = (p) => ({\n      name: p.name, sanskrit: p.sanskrit || '', hasSanskrit: !!p.sanskrit, cats: p.categories, catText: p.categories.join(' · '),\n      duration: p.durationDisplay, price: fmt(p), basis: p.priceBasisNote,\n      href: 'https://ayurvedichealingvillage.com' + p.route, saved: isSaved(p.route), toggle: toggle(p.route),\n      disabled: !isSaved(p.route) && full, btnOpacity: (!isSaved(p.route) && full) ? .5 : 1,\n      btnLabel: isSaved(p.route) ? 'Remove from shortlist' : 'Add to shortlist',\n      btnBg: isSaved(p.route) ? '#5A4420' : '#fff', btnFg: isSaved(p.route) ? '#F7F4EA' : '#5A4420'\n    });\n    const results = D.programmes.filter(matches).map(row);\n    const savedRows = saved.map(r => D.programmes.find(p => p.route === r)).filter(Boolean).map(row);\n    const labels = D.copy.filterLabels || {};\n    const pills = ['All', 'Wellness', 'Treatment', 'Training', 'Yoga & Meditation'].map(k => ({\n      label: labels[k] || k, count: k === 'All' ? (D.counts.unique || D.programmes.length) : D.programmes.filter(p => p.categories.includes(k)).length,\n      on: cat === k, bg: cat === k ? '#5A4420' : '#fff', fg: cat === k ? '#F7F4EA' : '#2A2118', bd: cat === k ? '#5A4420' : '#C9BFA8',\n      pick: () => this.setState({ cat: k })\n    }));\n    const currencies = [['₹ INR', 'INR'], ['$ USD', 'USD'], ['€ EUR', 'EUR']].map(([label, key]) => ({\n      label, on: cur === key, bg: cur === key ? '#5A4420' : '#fff', fg: cur === key ? '#F7F4EA' : '#2A2118', bd: cur === key ? '#5A4420' : '#C9BFA8', pick: () => this.setState({ cur: key })\n    }));\n    const showCompare = compareOpen && savedRows.length > 0;\n    return {\n      minusOne: -1, heritageLine: (new Date().getFullYear() - 1908) + '+ Years Heritage', guard, query, onQuery: (e) => this.setState({ query: e.target.value }), pills, results,\n      hasResults: results.length > 0, noResults: results.length === 0,\n      resultLine: results.length + ' of ' + D.programmes.length + ' programmes',\n      reset: () => this.setState({ query: '', cat: 'All' }),\n      saved: savedRows, savedCount: savedRows.length, hasSaved: savedRows.length > 0, noSaved: savedRows.length === 0,\n      compareOpen: showCompare, showCompare, currencies,\n      openCompare: () => { this.setState({ compareOpen: true }); setTimeout(() => { const el = document.getElementById('compare'); if (el) { el.focus({ preventScroll: true }); window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 24 }); } }, 60); },\n      closeCompare: () => this.setState({ compareOpen: false })\n    };\n  }\n}\n",
 "props": "",
 "scripts": [
  "/ahv/assets/all-programs-data.js"
 ]
}
