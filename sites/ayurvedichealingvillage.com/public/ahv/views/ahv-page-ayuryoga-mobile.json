\n<dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:20px 0 0\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">News &amp; Past Events</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Past Retreats</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Ayuryoga</span></nav>\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;margin-top:4px\">Past Retreat</div>\n  <h1 style=\"font-family:'Marcellus',serif;font-size:30px;line-height:1.2;margin:12px 0 0;text-wrap:balance\">Ayuryoga</h1>\n  <div role=\"note\" aria-label=\"Past retreat notice\" style=\"margin-top:20px;background:#fff;border:1px solid #C1882C;border-left:6px solid #C1882C;border-radius:4px;padding:16px 18px\">\n    <p style=\"margin:0;font-size:17px;line-height:1.6;color:#2A2118\">This is a past retreat. The original description, programme and inclusions below are retained as a historical record and are not a current offer. There are no current dates or bookings for this retreat.</p>\n    <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:4px;font-weight:700;font-size:15.5px\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>Past Retreats</a>\n  </div>\n  <img src=\"/ahv/assets/img/AHV-Ayuryoga-01.png\" alt=\"Palm trees and fields seen from above.\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block;border-radius:4px;margin-top:26px\">\n</section>\n\n<article aria-label=\"Historical retreat description\" style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 0;display:flex;flex-direction:column;gap:32px\">\n  <section id=\"description\" aria-labelledby=\"description-h\">\n    <h2 id=\"description-h\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.22;margin:0 0 16px;text-wrap:pretty\">Kairali’s Ayurvedic Healing Village in God’s Own Country Kerala</h2>\n    <sc-for list=\"{{ D.description.paragraphs }}\" as=\"p\" hint-placeholder-count=\"8\"><p style=\"margin:0 0 14px;font-size:17px\">{{ p }}</p></sc-for>\n    <img src=\"/ahv/assets/img/AHV-Ayuryoga-02.jpg\" alt=\"A person practising yoga outdoors beside cottages.\" width=\"264\" height=\"300\" loading=\"lazy\" style=\"width:100%;max-width:264px;height:auto;display:block;border-radius:4px;margin-top:8px\">\n  </section>\n\n  <section id=\"schedule\" aria-labelledby=\"schedule-h\" style=\"padding-top:28px;border-top:1px solid #E9E2D3\">\n    <h2 id=\"schedule-h\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.22;margin:0 0 16px\">Typical day schedule (for guidance)</h2>\n    <ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ D.schedule.items }}\" as=\"it\" hint-placeholder-count=\"11\"><li style=\"display:flex;gap:12px;padding:11px 0;border-bottom:1px solid #E0D7C4;font-size:17px;line-height:1.55\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ it }}</span></li></sc-for>\n    </ul>\n  </section>\n\n  <section id=\"information\" aria-labelledby=\"information-h\" style=\"padding-top:28px;border-top:1px solid #E9E2D3\">\n    <h2 id=\"information-h\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.22;margin:0 0 16px\">More information:</h2>\n    <sc-for list=\"{{ D.information.paragraphs }}\" as=\"p\" hint-placeholder-count=\"4\"><p style=\"margin:0 0 14px;font-size:17px\">{{ p }}</p></sc-for>\n  </section>\n\n  <section id=\"included\" aria-labelledby=\"included-h\" style=\"padding-top:28px;border-top:1px solid #E9E2D3\">\n    <h2 id=\"included-h\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.22;margin:0 0 16px\">Included in the Retreat:</h2>\n    <sc-for list=\"{{ D.included.paragraphs }}\" as=\"p\" hint-placeholder-count=\"2\"><p style=\"margin:0 0 14px;font-size:17px\">{{ p }}</p></sc-for>\n    <ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ D.included.items }}\" as=\"it\" hint-placeholder-count=\"7\"><li style=\"display:flex;gap:12px;padding:11px 0;border-bottom:1px solid #E0D7C4;font-size:17px;line-height:1.55\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ it }}</span></li></sc-for>\n    </ul>\n  </section>\n</article>\n\n<section id=\"current\" aria-labelledby=\"current-h\" style=\"margin-top:44px;padding:36px 0;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;flex-direction:column;gap:18px\">\n    <h2 id=\"current-h\" style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.2\">Explore current programmes</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px\">\n      <sc-for list=\"{{ currentLinks }}\" as=\"k\" hint-placeholder-count=\"2\">\n        <li><a href=\"{{ k.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;justify-content:center;min-height:48px;padding:6px 16px;border:1.5px solid #006038;border-radius:4px;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:#006038;text-align:center;line-height:1.35\" style-hover=\"background:#006038;color:#F7F4EA;text-decoration:none\">{{ k.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n</section>\n\n<section id=\"related\" aria-label=\"Related links\" style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 56px;display:flex;flex-direction:column;gap:36px\">\n  <sc-for list=\"{{ relatedGroups }}\" as=\"g\" hint-placeholder-count=\"2\">\n    <div id=\"{{ g.id }}\">\n      <h2 id=\"{{ g.headingId }}\" style=\"font-family:'Marcellus',serif;font-size:26px;margin:0 0 16px\">{{ g.heading }}</h2>\n      <ul aria-labelledby=\"{{ g.headingId }}\" style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E9E2D3\">\n        <sc-for list=\"{{ g.links }}\" as=\"r\" hint-placeholder-count=\"4\">\n          <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118;line-height:1.4\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n        </sc-for>\n      </ul>\n    </div>\n  </sc-for>\n  <nav aria-label=\"More from Kairali\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;border-top:1px solid #E9E2D3;padding-top:18px\">\n    <sc-for list=\"{{ footerLinks }}\" as=\"f\" hint-placeholder-count=\"3\">\n      <a href=\"{{ f.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">{{ f.label }}</a>\n    </sc-for>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_AYURYOGA || { description: { paragraphs: [] }, schedule: { items: [] }, information: { paragraphs: [] }, included: { paragraphs: [], items: [] }, relatedGroups: [], currentLinks: [], footerLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    const abs = (l) => ({ ...l, url: A + l.href });\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      D,\n      relatedGroups: (D.relatedGroups || []).map(g => ({ ...g, headingId: g.id + '-h', links: g.links.map(abs) })),\n      currentLinks: (D.currentLinks || []).map(abs), footerLinks: (D.footerLinks || []).map(abs)\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/ayuryoga-data.js"]}