 "template": "\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:ital,wght@0,400;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:underline;text-underline-offset:3px}\na:hover{color:#004226}\nh1,h2,h3,h4{font-family:'Marcellus',serif;font-weight:400;margin:0}\nul{margin:0;padding:0;list-style:none}\n:focus-visible{outline:3px solid #5A4420;outline-offset:2px}\n@media (prefers-reduced-motion: reduce){*{transition:none !important;animation:none !important}}\n</style>\n</helmet>\n<div data-screen-label=\"Offers, deals and gift vouchers — Desktop 1440\" style=\"max-width:100%;margin:0 auto;background:#F7F4EA;box-sizing:border-box\">\n\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 0;box-sizing:border-box\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:13.5px;line-height:1.5;color:#75695A;display:flex;gap:10px;align-items:center;flex-wrap:wrap\">\n    <a href=\"https://ayurvedichealingvillage.com/\" style=\"display:inline-flex;align-items:center;min-height:44px\">Home</a><span aria-hidden=\"true\">/</span>\n    <span style=\"color:#2A2118\">Special Offers</span>\n    </nav>\n\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:32px 56px;align-items:end;padding:10px 0 30px\">\n    <div style=\"min-width:0\">\n      <p style=\"font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;margin:0\">Kairali — The Ayurvedic Healing Village · Since 1908</p>\n      <h1 style=\"font-size:54px;line-height:1.1;margin:14px 0 0;max-width:20ch;text-wrap:balance\">Special Offers</h1>\n      <p style=\"font-size:17.5px;line-height:1.6;color:#514A3F;max-width:48ch;margin:20px 0 0;border-left:3px solid #C1882C;padding-left:20px\">Current care initiatives, deals and gift vouchers at the hospital.</p>\n    </div>\n    <div style=\"border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:20px 22px;box-sizing:border-box\">\n      <p style=\"margin:0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#5A4420\">Offers listed</p>\n      <p style=\"font-family:'Marcellus',serif;font-size:44px;line-height:1;margin:14px 0 0;color:#2A2118\">3</p>\n      <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.5;color:#514A3F\">Discount tiers as stated on each offer. No fixed end date.</p>\n    </div>\n  </div>\n</section>\n\n<div style=\"overflow:hidden;width:100%;box-sizing:border-box;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;background:#E0D7C4;height:300px;display:flex;align-items:center;justify-content:center;text-align:center\"><img src=\"/ahv/assets/img/commercial/6bdeb945c4b304d1c1a8a31abcafac18d02b4fd4bfd3ac097a50393e353697d5.webp\" alt=\"Herb leaves, turmeric, stone mortar and pestle, oil bottles and a hanging brass vessel\" loading=\"eager\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n\n<nav aria-label=\"On this page\" style=\"width:100%;box-sizing:border-box;background:#EFE9DA;border-bottom:1px solid #E9E2D3\">\n  <ul style=\"width:min(1220px,94%);margin:0 auto;display:flex;flex-wrap:wrap;gap:8px 10px;padding:12px 0;box-sizing:border-box\">\n    <li><a href=\"#current-offers\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid #C9BFA8;border-radius:4px;background:#F7F4EA;font-size:15px;text-decoration:none\">Current offers</a></li>\n    <li><a href=\"#gift-vouchers\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid #C9BFA8;border-radius:4px;background:#F7F4EA;font-size:15px;text-decoration:none\">Gift vouchers</a></li>\n    <li><a href=\"#a-note\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid #C9BFA8;border-radius:4px;background:#F7F4EA;font-size:15px;text-decoration:none\">A Note from Kairali</a></li>\n    <li><a href=\"#three-journeys\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid #C9BFA8;border-radius:4px;background:#F7F4EA;font-size:15px;text-decoration:none\">Three Journeys</a></li>\n    <li><a href=\"#how-healing-begins\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid #C9BFA8;border-radius:4px;background:#F7F4EA;font-size:15px;text-decoration:none\">How Healing Begins</a></li>\n  </ul>\n</nav>\n\n<main style=\"width:min(1220px,94%);margin:0 auto;padding:44px 0 0;box-sizing:border-box\" data-ahv-offer-cards=\"1\">\n\n  <section aria-labelledby=\"current-offers\">\n    <h2 id=\"current-offers\" style=\"font-size:32px;line-height:1.2\">Current offers and deals</h2>\n\n    <article style=\"display:grid;grid-template-columns:minmax(0,520px) minmax(0,1fr);gap:40px;margin:28px 0 0;padding:0;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;box-sizing:border-box;overflow:hidden;align-items:stretch\">\n      <div style=\"overflow:hidden;background:#E0D7C4;min-height:420px;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;box-sizing:border-box\"><img src=\"/ahv/assets/img/commercial/775c5adec97f99fbd773ee36cf4903844f79ea13635db974cf00821263818e82.webp\" alt=\"Healing at Kairali\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n      <div style=\"padding:32px 32px 32px 0;box-sizing:border-box;min-width:0;display:flex;flex-direction:column\">\n        <p style=\"margin:0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Featured offer</p>\n        <h3 style=\"font-size:30px;line-height:1.2;margin:12px 0 0;max-width:22ch\">Holistic Ayurvedic Care for Ageing Parents &amp; Senior Wellbeing</h3>\n        <p style=\"margin:14px 0 0;max-width:46ch;font-size:17px;line-height:1.65;color:#514A3F\">Compassionate Ayurvedic care designed to ease joint pain due to ageing, relieve body pain in old age, boost low energy in seniors, and gently support muscle weakness — so your loved ones can age with comfort and dignity.</p>\n        <dl style=\"display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin:24px 0 0;background:#E9E2D3;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden\">\n          <div style=\"background:#FFFFFF;padding:16px 18px;box-sizing:border-box\">\n            <dt style=\"font-size:12.5px;font-weight:700;letter-spacing:2.2px;text-transform:uppercase;color:#75695A\">Offer value</dt>\n            <dd style=\"margin:8px 0 0;font-family:'Marcellus',serif;font-size:26px;line-height:1.1;color:#2A2118\">Up to 20% off</dd>\n          </div>\n          <div style=\"background:#FFFFFF;padding:16px 18px;box-sizing:border-box\">\n            <dt style=\"font-size:12.5px;font-weight:700;letter-spacing:2.2px;text-transform:uppercase;color:#75695A\">Valid until</dt>\n            <dd style=\"margin:8px 0 0;font-family:'Marcellus',serif;font-size:26px;line-height:1.1;color:#2A2118\">No fixed end date</dd>\n          </div>\n          <div style=\"background:#FFFFFF;padding:16px 18px;box-sizing:border-box\">\n            <dt style=\"font-size:12.5px;font-weight:700;letter-spacing:2.2px;text-transform:uppercase;color:#75695A\">Minimum stay</dt>\n            <dd style=\"margin:8px 0 0;font-family:'Marcellus',serif;font-size:26px;line-height:1.1;color:#2A2118\">3 nights</dd>\n          </div>\n        </dl>\n        <div style=\"display:flex;flex-wrap:wrap;gap:14px;margin:28px 0 0\">\n          <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 24px;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Enquire about this offer</a>\n          <a href=\"https://wa.me/919289838797\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 24px;border-radius:4px;border:1.5px solid #006038;color:#006038;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp Patient Care</a>\n        </div>\n      </div>\n    </article>\n\n    <div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 32px;margin:28px 0 0\">\n      <section aria-labelledby=\"deal-inclusions\" style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <h4 id=\"deal-inclusions\" style=\"font-size:20px;line-height:1.3\">What the offer includes</h4>\n        <ul style=\"display:flex;flex-direction:column;gap:8px;margin:14px 0 0\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Up to 20% off on select wellness programs</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>10% for 3–13 nights, 15% for 14–20 nights and 20% for 21 nights or more.</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Stays of 1–2 nights are charged at standard rates; offer savings start at 3 nights.</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Complimentary initial health consultation included</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>A priority check-in plus a personalised care briefing for your loved one — absolutely complimentary</span></li>\n        </ul>\n      </section>\n      <section aria-labelledby=\"deal-who\" style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <h4 id=\"deal-who\" style=\"font-size:20px;line-height:1.3\">Who it applies to</h4>\n        <ul style=\"display:flex;flex-direction:column;gap:8px;margin:14px 0 0\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>For Seniors (60+)</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>For Adult Children &amp; Caregivers</span></li>\n        </ul>\n      </section>\n      <section aria-labelledby=\"deal-claim\" style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <h4 id=\"deal-claim\" style=\"font-size:20px;line-height:1.3\">How to claim</h4>\n        <ul style=\"display:flex;flex-direction:column;gap:8px;margin:14px 0 0\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Ask for this offer when you enquire with our patient care team.</span></li>\n        </ul>\n      </section>\n      <section aria-labelledby=\"deal-terms\" style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <h4 id=\"deal-terms\" style=\"font-size:20px;line-height:1.3\">Conditions</h4>\n        <ul style=\"display:flex;flex-direction:column;gap:8px;margin:14px 0 0\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Limited slots available — book early to secure your spot</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>One offer applies per booking: if more than one offer fits your stay, we apply the one that gives you the best saving, and discounts are not added together.</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:17px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>All programs are conducted under strict medical supervision and safety protocols specifically designed for senior care.</span></li>\n        </ul>\n      </section>\n    </div>\n\n    <h3 style=\"font-size:26px;line-height:1.25;margin:44px 0 0;padding-top:26px;border-top:1px solid #E9E2D3\">Other current offers</h3>\n    <div style=\"display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;margin:20px 0 0\">\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;display:flex;flex-direction:column;box-sizing:border-box;overflow:hidden\">\n        <div style=\"overflow:hidden;background:#E0D7C4;height:170px;display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;box-sizing:border-box\"><img src=\"/ahv/assets/img/commercial/8b7554df0dfba8ff5a0851801f3c2a0154577ea3bd2a8b7fe2a249867ff05bcb.webp\" alt=\"Senior Wellness at Kairali\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n        <div style=\"padding:22px 24px 24px;display:flex;flex-direction:column;flex:1;box-sizing:border-box\">\n          <p style=\"margin:0;font-weight:700;font-size:12.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Offer</p>\n          <h4 style=\"font-size:21px;line-height:1.3;margin:10px 0 0\">Exclusive Offer for Olympic and Paralympic Athletes – Up to 20% OFF</h4>\n          <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.6;color:#514A3F\">For all Packages.</p>\n          <ul style=\"display:flex;flex-direction:column;gap:7px;margin:12px 0 0;flex:1\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>10% Discount for ayurvedic treatment package between 3 to 13 Nights</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>15% Discount for ayurvedic treatment package between 14 to 20 Nights; and</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>20% Discount for ayurvedic treatment package for 21 Nights or above.</span></li>\n <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Stays of 1–2 nights are charged at standard rates; offer savings start at 3 nights.</span></li>\n          </ul>\n          <p style=\"margin:16px 0 0;padding-top:14px;border-top:1px solid #E9E2D3;font-size:15px;line-height:1.5;color:#75695A\">Rates and inclusions are subject to change. One offer applies per booking: if more than one offer fits your stay, we apply the one that gives you the best saving, and discounts are not added together. No fixed end date.</p>\n          <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;margin:16px 0 0;padding:0 20px;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Enquire Now</a>\n        </div>\n      </article>\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;display:flex;flex-direction:column;box-sizing:border-box;overflow:hidden\">\n        <div style=\"overflow:hidden;background:#E0D7C4;height:170px;display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;box-sizing:border-box\"><img src=\"/ahv/assets/img/commercial/89f77332ca59e7ab6a7ea204951c3fab743488be21f624fecde06b084a846509.webp\" alt=\"Athletes and Recovery\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n        <div style=\"padding:22px 24px 24px;display:flex;flex-direction:column;flex:1;box-sizing:border-box\">\n          <p style=\"margin:0;font-weight:700;font-size:12.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Offer</p>\n          <h4 style=\"font-size:21px;line-height:1.3;margin:10px 0 0\">Defence &amp; Paramilitary Personnel get upto 20% OFF</h4>\n          <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.6;color:#514A3F\">For serving and retired members of India’s Armed Forces, Central Armed Police Forces (CAPFs) and Assam Rifles, and their spouses, parents and children.</p>\n          <ul style=\"display:flex;flex-direction:column;gap:7px;margin:12px 0 0;flex:1\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>10% Discount for ayurvedic treatment package between 3 to 13 Nights</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>15% Discount for ayurvedic treatment package between 14 to 20 Nights; and</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>20% Discount for ayurvedic treatment package for 21 Nights or above.</span></li>\n <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Stays of 1–2 nights are charged at standard rates; offer savings start at 3 nights.</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Availability and the change and cancellation terms are stated in your quote before you pay. Once confirmed, the agreed offer is honoured for that booking.</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>This offer is only applicable for online/offline booking.</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.55\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>All applicable fees/taxes payable by the Customer.</span></li>\n          </ul>\n          <p style=\"margin:16px 0 0;padding-top:14px;border-top:1px solid #E9E2D3;font-size:15px;line-height:1.5;color:#75695A\">Rates and inclusions are subject to change. One offer applies per booking: if more than one offer fits your stay, we apply the one that gives you the best saving, and discounts are not added together. No fixed end date.</p>\n          <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;margin:16px 0 0;padding:0 20px;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Enquire Now</a>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"gift-vouchers\" style=\"margin:56px 0 0;padding-top:28px;border-top:1px solid #E9E2D3\">\n    <h2 id=\"gift-vouchers\" style=\"font-size:32px;line-height:1.2\">Gift vouchers</h2>\n    <div style=\"display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:40px;margin:20px 0 0;align-items:start\">\n      <div style=\"min-width:0;max-width:51ch\">\n        <p style=\"margin:0;font-size:17px;line-height:1.7;color:#514A3F\">Share the gift of wellness with Kairali’s Gift Vouchers. Ideal for birthdays, anniversaries, or corporate gifts, these vouchers provide friends and family the opportunity to enjoy genuine Ayurvedic treatments and a refreshing stay at our Healing Village.</p>\n        <p style=\"margin:14px 0 0;font-size:17px;line-height:1.7;color:#514A3F\">For personalized assistance, exclusive discounts, and customized voucher options, feel free to reach out to our dedicated Health &amp; Ayurveda Consultants.</p>\n        <div style=\"display:flex;flex-wrap:wrap;gap:14px;margin:22px 0 0\">\n          <a href=\"mailto:info@kairali.com\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 24px;border-radius:4px;border:1.5px solid #006038;color:#006038;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Email info@kairali.com</a>\n          <a href=\"tel:+91 9555 156 156\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 24px;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Call / WhatsApp +91-95551 56156</a>\n        </div>\n      </div>\n      <div style=\"border-radius:4px;overflow:hidden;height:280px;\"><img src=\"/ahv/assets/img/gallery-2026/product/hero-product-kairtis-oil-canister-01.webp\" alt=\"A Kairali Ayurvedic oil canister\" loading=\"lazy\" style=\"display:block;width:100%;height:100%;object-fit:cover\"></div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"a-note\" style=\"margin:64px 0 0;padding-top:30px;border-top:1px solid #E9E2D3\">\n    <p id=\"record-start\" style=\"margin:0;font-size:17px;line-height:1.6;color:#514A3F\">🌿 A Note from Kairali</p>\n    <h2 id=\"a-note\" style=\"font-size:38px;line-height:1.2;margin:14px 0 0;max-width:22ch\">At Kairali, Healing Is a Responsibility — Not a Promotion.</h2>\n    <p style=\"margin:18px 0 0;max-width:51ch;font-size:19px;line-height:1.6;color:#514A3F\">118 years of Ayurvedic tradition. Offered with purpose.</p>\n\n    <div style=\"display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:40px 56px;margin:32px 0 0;align-items:start\">\n      <div style=\"min-width:0\">\n        <p style=\"margin:0;max-width:51ch\">For over a century, Kairali has extended specialised care to those who have:</p>\n        <ul style=\"display:flex;flex-direction:column;gap:16px;margin:22px 0 0;max-width:56ch\">\n          <li style=\"display:grid;grid-template-columns:34px minmax(0,1fr);gap:14px;align-items:start;font-size:17px;line-height:1.65\"><span style=\"font-size:24px;line-height:1.2\" aria-hidden=\"true\">🏠</span><span>Given us life — our parents, elders, and loved ones who carried us through our earliest years</span></li>\n          <li style=\"display:grid;grid-template-columns:34px minmax(0,1fr);gap:14px;align-items:start;font-size:17px;line-height:1.65\"><span style=\"font-size:24px;line-height:1.2\" aria-hidden=\"true\">🏅</span><span>Represented our nation — athletes who carried India’s flag on the world’s greatest stages</span></li>\n          <li style=\"display:grid;grid-template-columns:34px minmax(0,1fr);gap:14px;align-items:start;font-size:17px;line-height:1.65\"><span style=\"font-size:24px;line-height:1.2\" aria-hidden=\"true\">🛡️</span><span>Protected our borders — soldiers and paramilitary forces who gave years of their strength to our safety</span></li>\n        </ul>\n      </div>\n      <div style=\"border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:22px 24px;box-sizing:border-box;text-align:center\">\n        <p style=\"margin:0;font-size:26px\" aria-hidden=\"true\">🌿</p>\n        <p style=\"margin:10px 0 0;font-family:'Marcellus',serif;font-size:34px;line-height:1.1;color:#2A2118\">118 Years</p>\n        <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.5;color:#514A3F\">of Ayurvedic Excellence</p>\n      </div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"why-special-care\" style=\"margin:56px 0 0;padding-top:28px;border-top:1px solid #E9E2D3\">\n    <p style=\"margin:0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Why These Care Initiatives Exist</p>\n    <h3 id=\"why-special-care\" style=\"font-size:30px;line-height:1.2;margin:12px 0 0\">Why Kairali Extends Special Care</h3>\n    <div style=\"max-width:51ch;margin:18px 0 0\">\n      <p style=\"margin:0\">Healing is not equal for everyone. Some lives need gentler care.</p>\n      <p style=\"margin:16px 0 0\">Some bodies carry extraordinary strain — strain earned through service and sacrifice.</p>\n      <p style=\"margin:16px 0 0\">Some minds and muscles have served the nation beyond what ordinary limits allow.</p>\n      <p style=\"margin:16px 0 0\">Ayurveda, when practised ethically, must respond to these realities with humility and purpose.</p>\n    </div>\n    <div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 32px;margin:32px 0 0\">\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:24px\" aria-hidden=\"true\">🌱</p>\n        <h4 style=\"font-size:21px;line-height:1.3;margin:10px 0 0\">Rooted in Ethics, Not Commerce</h4>\n        <p style=\"margin:10px 0 0;font-size:17px;line-height:1.65;color:#514A3F\">These programs exist because they are right — not because they are profitable.</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:24px\" aria-hidden=\"true\">👨‍⚕️</p>\n        <h4 style=\"font-size:21px;line-height:1.3;margin:10px 0 0\">Doctor-Led, Always</h4>\n        <p style=\"margin:10px 0 0;font-size:17px;line-height:1.65;color:#514A3F\">Every care plan is created by qualified Ayurvedic physicians — never templated or packaged.</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:24px\" aria-hidden=\"true\">🕊️</p>\n        <h4 style=\"font-size:21px;line-height:1.3;margin:10px 0 0\">Dignity as the Foundation</h4>\n        <p style=\"margin:10px 0 0;font-size:17px;line-height:1.65;color:#514A3F\">Whether elder, athlete, or veteran — each guest is received with the same quiet respect.</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:24px\" aria-hidden=\"true\">🏡</p>\n        <h4 style=\"font-size:21px;line-height:1.3;margin:10px 0 0\">A Healing Environment That Heals</h4>\n        <p style=\"margin:10px 0 0;font-size:17px;line-height:1.65;color:#514A3F\">Fourteen acres of lush serenity in Palakkad — designed for deep rest and genuine recovery.</p>\n      </div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"three-journeys\" style=\"margin:56px 0 0;padding-top:28px;border-top:1px solid #E9E2D3\">\n    <p style=\"margin:0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Three Journeys. One Commitment.</p>\n    <h3 id=\"three-journeys\" style=\"font-size:30px;line-height:1.2;margin:12px 0 0;max-width:24ch\">Three Journeys. One Commitment to Healing.</h3>\n    <p style=\"margin:18px 0 0;max-width:51ch\">Each initiative is a story of respect — shaped around a different life path, but united by the same principle: every person who has given deeply to others deserves healing that honours that giving.</p>\n\n    <div style=\"display:flex;flex-direction:column;gap:26px;margin:32px 0 0\">\n      <article style=\"display:grid;grid-template-columns:300px minmax(0,1fr);gap:32px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;box-sizing:border-box;overflow:hidden;align-items:stretch\">\n        <div style=\"min-height:260px;overflow:hidden\"><img src=\"/ahv/assets/img/gallery-2026/treatments/vasti-janu-vasti-04.webp\" alt=\"Kairali therapists performing janu vasti, a warm-oil knee treatment, on a patient\" loading=\"lazy\" style=\"display:block;width:100%;height:100%;object-fit:cover\"></div>\n        <div style=\"padding:26px 30px 28px 0;box-sizing:border-box;min-width:0\">\n          <p style=\"margin:0;display:inline-block;border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:5px 12px;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420\">For Senior Citizens</p>\n          <p style=\"margin:14px 0 0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Those Who Once Cared for Us</p>\n          <h4 style=\"font-size:24px;line-height:1.25;margin:10px 0 0\">Elderly &amp; Senior Wellness Care</h4>\n          <p style=\"margin:12px 0 0;max-width:51ch;font-size:17px;line-height:1.65;color:#514A3F\">Our parents gave us strength, stability, and care. As time slows them down, they deserve healing that preserves dignity, comfort, and independence — not pity, not urgency.</p>\n          <ul style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 32px;margin:18px 0 0\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Age-safe, doctor-led Ayurvedic therapies</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Gentle, evidence-informed care for chronic conditions</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Assisted living &amp; senior-friendly private villas</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Long-stay healing programs with personalised routines</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Up to 20% off on select wellness packages</span></li>\n          </ul>\n          <a href=\"/offers/senior-citizen-offer/\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;margin:22px 0 0;padding:0 24px;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Discover Elderly Wellness Care</a>\n        </div>\n      </article>\n\n      <article style=\"display:grid;grid-template-columns:300px minmax(0,1fr);gap:32px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;box-sizing:border-box;overflow:hidden;align-items:stretch\">\n        <div style=\"min-height:260px;overflow:hidden\"><img src=\"/ahv/assets/img/gallery-2026/photo/yoga-side-female-patient-02.webp\" alt=\"A patient in a side-stretch yoga pose at Kairali\" loading=\"lazy\" style=\"display:block;width:100%;height:100%;object-fit:cover\"></div>\n        <div style=\"padding:26px 30px 28px 0;box-sizing:border-box;min-width:0\">\n          <p style=\"margin:0;display:inline-block;border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:5px 12px;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420\">For Athletes</p>\n          <p style=\"margin:14px 0 0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Those Who Carried the Nation</p>\n          <h4 style=\"font-size:24px;line-height:1.25;margin:10px 0 0\">Olympic &amp; Paralympic Athlete Care</h4>\n          <p style=\"margin:12px 0 0;max-width:51ch;font-size:17px;line-height:1.65;color:#514A3F\">Athletes push their bodies beyond normal limits — for performance, for pride, for the nation. Recovery and longevity matter as much as the victory itself. Their bodies deserve the same discipline in healing.</p>\n          <ul style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 32px;margin:18px 0 0\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Sports-specific Ayurvedic rehabilitation programs</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Muscle, nerve &amp; joint recovery therapies</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Performance longevity &amp; career extension programs</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Mind–body balance after competitive strain</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Specialised care for para-athletes &amp; adaptive needs</span></li>\n          </ul>\n          <a href=\"/offers/olympics-and-paralympics-offer/\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;margin:22px 0 0;padding:0 24px;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Call Us For Program Details</a>\n          <p style=\"margin:8px 0 0;font-size:14.5px;line-height:1.5;color:#75695A\">Telephone: <a href=\"tel:+919555156156\">+91 9555 156 156</a></p>\n        </div>\n      </article>\n\n      <article style=\"display:grid;grid-template-columns:300px minmax(0,1fr);gap:32px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;box-sizing:border-box;overflow:hidden;align-items:stretch\">\n        <div style=\"min-height:260px;overflow:hidden\"><img src=\"/ahv/assets/img/gallery-2026/treatments/hero-detail-cloth-herbal-poultice-01.webp\" alt=\"A warm herbal poultice being pressed during an Ayurvedic treatment at Kairali\" loading=\"lazy\" style=\"display:block;width:100%;height:100%;object-fit:cover\"></div>\n        <div style=\"padding:26px 30px 28px 0;box-sizing:border-box;min-width:0\">\n          <p style=\"margin:0;display:inline-block;border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:5px 12px;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420\">For Defence &amp; Paramilitary</p>\n          <p style=\"margin:14px 0 0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Those Who Protect Us While We Sleep</p>\n          <h4 style=\"font-size:24px;line-height:1.25;margin:10px 0 0\">Defence &amp; Paramilitary Wellness</h4>\n          <p style=\"margin:12px 0 0;max-width:51ch;font-size:17px;line-height:1.65;color:#514A3F\">Years of discipline, high stress, and physical demand leave invisible scars. Healing for our defenders must restore strength, calm, and resilience — not just the body, but the whole person.</p>\n          <ul style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 32px;margin:18px 0 0\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Stress &amp; fatigue management programs</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Trauma-informed Ayurvedic healing</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Structured routines aligned with service lifestyle</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Long-term wellness programs for veterans</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Confidential, dignified care in a private setting</span></li>\n          </ul>\n          <a href=\"/offers/defence-paramilitary-personnel-get-upto-30-off/\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;margin:22px 0 0;padding:0 24px;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Call Us For Program Details</a>\n          <p style=\"margin:8px 0 0;font-size:14.5px;line-height:1.5;color:#75695A\">Telephone: <a href=\"tel:+919555156156\">+91 9555 156 156</a></p>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"healing-foundation\" style=\"margin:56px 0 0;padding-top:28px;border-top:1px solid #E9E2D3\">\n    <p style=\"margin:0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Our Healing Foundation</p>\n    <h3 id=\"healing-foundation\" style=\"font-size:30px;line-height:1.2;margin:12px 0 0;max-width:24ch\">One Healing Philosophy. Personalised for Every Life Path.</h3>\n    <p style=\"margin:18px 0 0;max-width:51ch\">Regardless of who you are or which program you seek — the foundation beneath every treatment at Kairali remains unchanged.</p>\n    <div style=\"display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:26px;margin:30px 0 0\">\n      <div style=\"border-top:2px solid #C1882C;padding:20px 0 0;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:24px\" aria-hidden=\"true\">👨‍⚕️</p>\n        <h4 style=\"font-size:20px;line-height:1.3;margin:10px 0 0\">Doctor-Led Ayurveda</h4>\n        <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Not package-based. Every guest is assessed by a qualified physician who creates a care plan specific to their body, history, and needs.</p>\n      </div>\n      <div style=\"border-top:2px solid #C1882C;padding:20px 0 0;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:24px\" aria-hidden=\"true\">📋</p>\n        <h4 style=\"font-size:20px;line-height:1.3;margin:10px 0 0\">Individualised Protocols</h4>\n        <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">No two guests receive the same treatment. Ayurveda recognises individuality — our care reflects that at every step.</p>\n      </div>\n      <div style=\"border-top:2px solid #C1882C;padding:20px 0 0;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:24px\" aria-hidden=\"true\">🌿</p>\n        <h4 style=\"font-size:20px;line-height:1.3;margin:10px 0 0\">Ethical, Non-Commercial Healing</h4>\n        <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">These are not promotional offers. They are commitments made in the spirit of Ayurveda — to serve those who most deserve it.</p>\n      </div>\n      <div style=\"border-top:2px solid #C1882C;padding:20px 0 0;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:24px\" aria-hidden=\"true\">🏡</p>\n        <h4 style=\"font-size:20px;line-height:1.3;margin:10px 0 0\">Quiet Immersive Environment</h4>\n        <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Fourteen acres of peace in Palakkad, Kerala. No noise, no rush — only the conditions in which genuine healing becomes possible.</p>\n      </div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"how-healing-begins\" style=\"margin:56px 0 0;padding-top:28px;border-top:1px solid #E9E2D3\">\n    <p style=\"margin:0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">The Journey</p>\n    <h3 id=\"how-healing-begins\" style=\"font-size:30px;line-height:1.2;margin:12px 0 0\">How Healing Begins</h3>\n    <p style=\"margin:18px 0 0;max-width:51ch\">A simple, unhurried process — designed so you can focus on being present, not on paperwork.</p>\n    <ol style=\"display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:26px;margin:30px 0 0;padding:0;list-style:none\">\n      <li style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <p style=\"margin:0;font-family:'Marcellus',serif;font-size:32px;line-height:1;color:#C1882C\">1</p>\n        <h4 style=\"font-size:20px;line-height:1.3;margin:12px 0 0\">Medical Consultation</h4>\n        <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">A thorough assessment by our Ayurvedic physician — your health history, current condition, and goals discussed with full attention.</p>\n      </li>\n      <li style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <p style=\"margin:0;font-family:'Marcellus',serif;font-size:32px;line-height:1;color:#C1882C\">2</p>\n        <h4 style=\"font-size:20px;line-height:1.3;margin:12px 0 0\">Personalised Care Plan</h4>\n        <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">A program designed specifically for you — therapies, diet, daily routine, and duration — tailored to your unique constitution.</p>\n      </li>\n      <li style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <p style=\"margin:0;font-family:'Marcellus',serif;font-size:32px;line-height:1;color:#C1882C\">3</p>\n        <h4 style=\"font-size:20px;line-height:1.3;margin:12px 0 0\">Guided Therapies &amp; Stay</h4>\n        <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Gentle, expert-administered therapies in a calm environment. Your comfort and safety are monitored throughout your stay.</p>\n      </li>\n      <li style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:24px 26px;box-sizing:border-box\">\n        <p style=\"margin:0;font-family:'Marcellus',serif;font-size:32px;line-height:1;color:#C1882C\">4</p>\n        <h4 style=\"font-size:20px;line-height:1.3;margin:12px 0 0\">Post-Program Guidance</h4>\n        <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Detailed guidance for maintaining the benefits of your healing at home — so your recovery continues long after you leave.</p>\n      </li>\n    </ol>\n  </section>\n\n  <section aria-labelledby=\"not-sure-which\" style=\"margin:56px 0 0;padding:30px 0 0;border-top:1px solid #E9E2D3\">\n    <div style=\"border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:34px 38px;box-sizing:border-box\">\n      <p style=\"margin:0;font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">We Are Here for You</p>\n      <h3 id=\"not-sure-which\" style=\"font-size:30px;line-height:1.2;margin:12px 0 0\">Not Sure Which Program Applies?</h3>\n      <div style=\"max-width:51ch;margin:16px 0 0\">\n        <p style=\"margin:0\">Not sure which program applies to you or your family member?</p>\n        <p style=\"margin:0\">Our doctors will guide you with clarity and care.</p>\n        <p style=\"margin:16px 0 0\">There is no pressure here. Only a conversation — at whatever pace feels right.</p>\n        <p style=\"margin:16px 0 0\">No discounts. No urgency. Just honest guidance from people who care.</p>\n      </div>\n    </div>\n  </section>\n</main>\n\n<div style=\"margin-top:56px;width:100%;box-sizing:border-box;background:#FFFFFF;background-image:repeating-linear-gradient(0deg,rgba(193,136,44,.06) 0 1px,rgba(255,255,255,0) 1px 8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;padding:48px 0\">\n  <div style=\"width:min(760px,94%);margin:0 auto;text-align:center;box-sizing:border-box\">\n    <ul style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 32px;text-align:left;margin:0 auto;max-width:620px\">\n      <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.5\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>NABH Certified Hospital</span></li>\n      <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.5\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>118+ Years Heritage</span></li>\n      <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.5\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Individualised Programmes</span></li>\n      <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.5\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>World Luxury Award Winner</span></li>\n    </ul>\n    <h2 style=\"font-size:26px;line-height:1.25;margin:32px 0 0\">Not sure which programme fits?</h2>\n    <p style=\"font-size:16.5px;line-height:1.6;color:#514A3F;max-width:43ch;margin:14px auto 0\">Share your goal in your own words — the patient care team or an Ayurvedic doctor will point you to the right programme.</p>\n    <div style=\"display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin:28px 0 0\">\n      <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 24px;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Free Doctor Consultation</a>\n      <a href=\"https://wa.me/919289838797\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 24px;border-radius:4px;border:1.5px solid #006038;color:#006038;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp Patient Care</a>\n      <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 24px;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Enquire Now</a>\n    </div>\n  </div>\n</div>\n\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n\n</div>\n\n",
