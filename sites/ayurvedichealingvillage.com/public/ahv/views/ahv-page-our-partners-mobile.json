  "sourceSha256": "9dc915a3ab0a65856b9eb591fc6e0add0927c656c3664c47d04dedded9640146",
  "variant": "mobile",
  "template": "\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Ayurvedic Partnerships &amp; Franchise | Kairali Healing Village</title>\n<meta name=\"description\" content=\"Kairali partners with wellness centers, franchises, and educators to promote authentic Ayurveda, holistic healing, and Ayurvedic training worldwide.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/our-partners/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:title\" content=\"Our Partners\">\n<meta property=\"og:description\" content=\"Kairali partners with wellness centers, franchises, and educators to promote authentic Ayurveda, holistic healing, and Ayurvedic training worldwide.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/our-partners/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/11/our-story.png\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"524\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://ayurvedichealingvillage.com/our-partners/\",\"url\":\"https://ayurvedichealingvillage.com/our-partners/\",\"name\":\"Ayurvedic Partnerships & Franchise | Kairali Healing Village\",\"description\":\"Kairali partners with wellness centers, franchises, and educators to promote authentic Ayurveda, holistic healing, and Ayurvedic training worldwide.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Kairali — The Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/our-partners/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"About Us\",\"item\":\"https://ayurvedichealingvillage.com/about-us/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Our Partners\",\"item\":\"https://ayurvedichealingvillage.com/our-partners/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Our Partners — Mobile\" style=\"max-width:430px;margin:0 auto;background:#F7F4EA;box-shadow:0 0 40px rgba(70,50,20,.15);position:relative;box-sizing:border-box\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:20px 0 22px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/about-us/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">About Us</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Our Partners</span></nav>\n  <div style=\"padding-top:4px\">\n    <div style=\"font-weight:700;font-size:12px;letter-spacing:2.4px;color:#8F6212;text-transform:uppercase;line-height:1.5\">Kairali — The Ayurvedic Healing Village · Since 1908</div>\n    <h1 id=\"page-h1\" style=\"font-family:'Marcellus',serif;font-size:clamp(30px,9vw,38px);line-height:1.12;margin:10px 0 0;text-wrap:balance\">Our Partners</h1>\n  </div>\n</section>\n<div style=\"width:min(1220px,94%);margin:0 auto\">\n  <img src=\"/ahv/assets/img/AHV-Partners-Landscape.webp\" alt=\"\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block;border-radius:4px\">\n</div>\n\n<article aria-labelledby=\"page-h1\" style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 0\">\n  <p data-pos=\"4\" style=\"margin:0 0 32px;font-size:19px;line-height:1.65;color:#2A2118;text-wrap:pretty;border-left:3px solid #C1882C;padding-left:18px\">Kairali – The Ayurvedic Healing Village has formed a network of distinguished partners to expand its offerings and spread the message of authentic Ayurvedic healing. These relationships are critical to Kairali’s objective of promoting holistic health and traditional healing techniques globally.</p>\n  <section id=\"franchise\" aria-labelledby=\"franchise-h\" style=\"padding:0 0 24px;border-bottom:1px solid #E0D7C4\">\n    <h2 id=\"franchise-h\" data-pos=\"5\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.25;margin:0 0 10px;text-wrap:balance\">Franchise Partnerships:</h2>\n    <p data-pos=\"5\" style=\"margin:0;font-size:17.5px;line-height:1.7;text-wrap:pretty\">With its all-inclusive Ayurvedic Franchise Scheme, Kairali helps business owners open Ayurvedic treatment facilities, wellness centres, hotel wellness centres, and health retreats. Franchisees benefit from this program’s leadership experience and well-known brand. Associates gain access to Kairali’s GMP-certified Ayurvedic products, staff training, technical support, and marketing assistance.</p>\n  </section>\n  <section id=\"wellness-centers\" aria-labelledby=\"wellness-centers-h\" style=\"padding:24px 0;border-bottom:1px solid #E0D7C4\">\n    <h2 id=\"wellness-centers-h\" data-pos=\"6\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.25;margin:0 0 10px;text-wrap:balance\">Collaborations with Wellness Centers:</h2>\n    <p data-pos=\"6\" style=\"margin:0;font-size:17.5px;line-height:1.7;text-wrap:pretty\">Kairali incorporates its authentic Ayurvedic products and therapies into a range of health and wellness initiatives by collaborating with wellness facilities throughout the world. Through these partnerships, traditional Ayurvedic methods are made available to a wider range of people, encouraging natural healing and overall health.</p>\n  </section>\n  <section id=\"educational\" aria-labelledby=\"educational-h\" style=\"padding:24px 0 0\">\n    <h2 id=\"educational-h\" data-pos=\"7\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.25;margin:0 0 10px;text-wrap:balance\">Educational Alliances:</h2>\n    <p data-pos=\"7\" style=\"margin:0;font-size:17.5px;line-height:1.7;text-wrap:pretty\">Kairali works with training facilities and educational institutions to provide courses in yoga and Ayurvedic treatments. These collaborations seek to preserve and advance this age-old discipline by teaching people traditional therapeutic techniques and sharing Ayurvedic knowledge.</p>\n  </section>\n\n  <section id=\"partner-logos\" aria-label=\"Our partners\" style=\"padding:40px 0 0;margin-top:40px;border-top:1px solid #E9E2D3\">\n    <ul style=\"list-style:none;margin:0 auto;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:24px;max-width:1000px\">\n      <sc-for list=\"{{ logos }}\" as=\"l\" hint-placeholder-count=\"8\"><li id=\"{{ l.id }}\" class=\"{{ l.cardClass }}\">\n<a href=\"{{ l.href }}\" target=\"{{ l.target }}\" rel=\"{{ l.rel }}\" class=\"ahv-partner-link\"><img src=\"{{ l.src }}\" alt=\"{{ l.alt }}\" loading=\"lazy\" width=\"180\" height=\"100\"><h3>{{ l.label }}</h3><span class=\"ahv-partner-action\">{{ l.linkLabel }}</span></a>\n</li></sc-for>\n    </ul>\n  </section>\n\n  <p data-pos=\"8\" style=\"margin:48px auto 0;padding:24px 16px 40px;max-width:70ch;box-sizing:border-box;font-size:17.5px;line-height:1.85;text-wrap:pretty\">By extending its global reach and ensuring that everyone has access to holistic well-being, Kairali – The Ayurvedic Healing Village can maintain its dedication to authentic Ayurvedic healing.</p>\n</article>\n<div style=\"height:56px\"></div>\n</main>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n</div>\n",
  "logic": "\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; this.queuePartnerLanding(); }\n  componentDidUpdate() { this.queuePartnerLanding(); }\n  componentWillUnmount() { clearTimeout(this._partnerLanding); }\n  queuePartnerLanding() {\n    if (this._partnerLanded || !window.location.hash) return;\n    clearTimeout(this._partnerLanding);\n    // The design runtime binds props repeatedly while replacing the initial HTML.\n    // Land once that render sequence settles, rather than scrolling a discarded node.\n    this._partnerLanding = setTimeout(() => {\n      const card = document.querySelector('.ahv-partner-selected');\n      if (!card || !card.getBoundingClientRect().height) return;\n      card.scrollIntoView({ block: 'start', behavior: 'instant' });\n      this._partnerLanded = true;\n    }, 100);\n  }\n  renderVals() {\n    const D = window.AHV_PARTNERS || { logos: [] };\n    return { guard: () => {} /* preview-only nav guard neutralised for the published site */, logos: D.logos.map(l => Object.assign({}, l, { cardClass: \"ahv-partner-card\" + (window.location.hash === \"#\" + l.id ? \" ahv-partner-selected\" : \"\") })) };\n  }\n}\n",
  "props": "",
  "scripts": [
    "/ahv/assets/our-partners-data.js"
  ]
}
