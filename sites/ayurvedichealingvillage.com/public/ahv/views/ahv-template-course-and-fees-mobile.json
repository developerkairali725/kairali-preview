{"id": "ahv-template-course-and-fees-mobile", "file": "AHV Template Course and Fees Mobile.dc.html", "sourceSha256": "e7f1673ce4b33aa01ceaf73addfc1807d9c828a3f00b47268e909e868fe2c274", "variant": "mobile", "template": "\n<helmet>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  html, body { margin:0; padding:0; background:#F7F4EA; }\n  *, *::before, *::after { box-sizing: border-box; }\n  body { font-family:'Mulish', sans-serif; color:#2A2118; -webkit-font-smoothing:antialiased; }\n  a { color:#006038; }\n  a:hover { color:#004226; }\n  @media (prefers-reduced-motion: reduce) { * { transition:none !important; animation:none !important; } }\n</style>\n</helmet>\n\n<div style=\"width:100%;max-width:100%;background:#F7F4EA;font-family:'Mulish',sans-serif;color:#2A2118;font-size:17px;line-height:1.7;overflow-x:hidden;\">\n\n  <dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n\n  <section style=\"padding:22px 20px 0;\">\n    <nav aria-label=\"Breadcrumb\" style=\"font-size:13.5px;line-height:1.5;color:#75695A;margin-bottom:14px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;\">\n      <a href=\"https://ayurvedichealingvillage.com/ayurveda-training-programs/\" style=\"display:inline-flex;align-items:center;min-height:44px;color:#006038;text-decoration:none;\">← Training Courses</a>\n    </nav>\n    <p style=\"margin:0 0 10px;font-size:11.5px;line-height:1.5;letter-spacing:2.2px;text-transform:uppercase;color:#8F6212;font-weight:700;\">Kairali — The Ayurvedic Healing Village · Since 1908</p>\n    <h1 style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:33px;line-height:1.16;letter-spacing:-0.2px;color:#2A2118;\">Training Course Fees</h1>\n    <p style=\"margin:18px 0 0;padding-left:16px;border-left:3px solid #C1882C;font-size:17.5px;line-height:1.6;color:#514A3F;\">Course structure, duration, schedule and fees for study at the Kairali Institute of Ayurveda and Panchakarma Therapy, with accommodation rates listed separately.</p>\n  </section>\n\n  <div style=\"overflow:hidden;width:100%;height:240px;margin-top:24px;background:#E0D7C4;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;padding:0 20px;\"><img src=\"/ahv/assets/img/article/TREATMENTS-24-min.webp\" alt=\"A therapist pouring warm herbal powder over a patient during an Udwarthanam treatment\" loading=\"eager\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n\n  <nav aria-label=\"On this page\" style=\"margin:0;padding:22px 20px;background:#FFFFFF;border-bottom:1px solid #E9E2D3;\">\n    <p style=\"margin:0 0 10px;font-size:11.5px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#8F6212;\">On this page</p>\n    <ul style=\"list-style:none;margin:0;padding:0;border-top:1px solid #E9E2D3;\">\n      <sc-for list=\"{{ anchors }}\" as=\"a\" hint-placeholder-count=\"3\">\n        <li style=\"border-bottom:1px solid #E9E2D3;\">\n          <a href=\"{{ a.href }}\" style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px;padding:6px 0;font-size:16px;line-height:1.5;color:#006038;text-decoration:none;\">{{ a.label }}<span aria-hidden=\"true\" style=\"color:#C1882C;\">↓</span></a>\n        </li>\n      </sc-for>\n    </ul>\n  </nav>\n\n  <main style=\"padding:30px 20px 0;\">\n\n    <h2 style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:27px;line-height:1.25;color:#2A2118;\">{{ introHeading }}</h2>\n    <div style=\"width:48px;height:2px;background:#C1882C;margin:14px 0 20px;\"></div>\n    <p style=\"margin:0;font-size:17px;line-height:1.7;color:#2A2118;\">{{ introBody }}</p>\n\n    <sc-if value=\"{{ showIntroImage }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"overflow:hidden;margin-top:24px;height:200px;background:#E0D7C4;border:1px solid #E9E2D3;border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;padding:14px;\"><img src=\"/ahv/assets/img/article/ayurveda-training-new.webp\" alt=\"Training Course Fees\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n    </sc-if>\n\n    <section aria-labelledby=\"fees-h\" style=\"margin-top:38px;padding-top:30px;border-top:1px solid #E9E2D3;\">\n      <h2 id=\"fees-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:27px;line-height:1.25;color:#2A2118;\">Course fees, duration and schedule</h2>\n      <div style=\"width:48px;height:2px;background:#C1882C;margin:14px 0 18px;\"></div>\n      <p style=\"margin:0 0 8px;font-size:17px;line-height:1.7;color:#2A2118;\">Rates are charged <strong>per night</strong> and are all-inclusive of accommodation, meals, training and taxes.</p>\n      <p style=\"margin:0 0 20px;font-size:15px;line-height:1.6;color:#75695A;\">Rates valid 1 October 2026 to 30 September 2027.</p>\n\n      <p style=\"margin:0 0 14px;font-size:11.5px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:#5A4420;\">Training programmes</p>\n\n      <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;\">\n        <sc-for list=\"{{ courseRows }}\" as=\"r\" hint-placeholder-count=\"5\">\n          <li style=\"background:#FFFFFF;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden;\">\n            <p style=\"margin:0;padding:13px 14px;background:#E0D7C4;border-bottom:1px solid #C9BFA8;font-size:16.5px;font-weight:600;line-height:1.35;color:#2A2118;\">{{ r.course }}</p>\n            <p style=\"margin:0;padding:11px 14px 0;font-size:15.5px;line-height:1.55;color:#514A3F;\">{{ r.summary }}</p>\n            <dl style=\"margin:0;padding:4px 14px 10px;\">\n              <sc-for list=\"{{ r.cells }}\" as=\"c\" hint-placeholder-count=\"8\">\n                <div style=\"display:grid;grid-template-columns:96px minmax(0,1fr);gap:12px;align-items:baseline;padding:9px 0;border-bottom:1px solid #EFEADD;\">\n                  <dt style=\"margin:0;font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#75695A;line-height:1.5;\">{{ c.label }}</dt>\n                  <dd style=\"margin:0;font-size:16px;line-height:1.5;color:#514A3F;font-variant-numeric:tabular-nums;\">\n                    <sc-if value=\"{{ c.confirm }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"display:inline-block;padding:2px 8px;background:#F3EEE0;border:1px solid #E9E2D3;border-radius:4px;font-size:12.5px;font-weight:700;letter-spacing:1.2px;color:#8F6212;\">Arranged on enquiry</span></sc-if>\n                    {{ c.body }}\n                  </dd>\n                </div>\n              </sc-for>\n            </dl>\n          </li>\n        </sc-for>\n      </ul>\n      <p style=\"margin:14px 0 0;font-size:15px;line-height:1.6;color:#75695A;\">There is no separate course fee: tuition is included in the nightly rate, charged per villa and occupancy. Classes are one-to-one or for groups. There are no fixed course dates: dates and session times are agreed with you when you enquire.</p>\n    </section>\n\n    <section aria-labelledby=\"villa-h\" style=\"margin-top:38px;padding-top:30px;border-top:1px solid #E9E2D3;\">\n      <h2 id=\"villa-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:27px;line-height:1.25;color:#2A2118;\">Accommodation rates</h2>\n      <div style=\"width:48px;height:2px;background:#C1882C;margin:14px 0 18px;\"></div>\n\n      <p style=\"margin:0 0 16px;font-size:17px;line-height:1.7;color:#2A2118;\">Per night, all-inclusive of accommodation, meals, training and taxes. Valid 1 Oct 2026 to 30 Sep 2027.</p>\n      <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;\">\n        <sc-for list=\"{{ villaRows }}\" as=\"v\" hint-placeholder-count=\"4\">\n          <li style=\"background:#FFFFFF;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden;\">\n            <p style=\"margin:0;padding:13px 14px;background:#E0D7C4;border-bottom:1px solid #C9BFA8;font-size:16.5px;font-weight:600;line-height:1.35;color:#2A2118;\">{{ v.villa }}</p>\n            <dl style=\"margin:0;padding:4px 14px 10px;\">\n              <div style=\"display:grid;grid-template-columns:104px minmax(0,1fr);gap:12px;align-items:baseline;padding:9px 0;border-bottom:1px solid #EFEADD;\">\n                <dt style=\"margin:0;font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#75695A;line-height:1.5;\">INR single</dt>\n                <dd style=\"margin:0;font-size:16px;line-height:1.5;color:#514A3F;font-variant-numeric:tabular-nums;\">{{ v.inrS }}</dd>\n              </div>\n              <div style=\"display:grid;grid-template-columns:104px minmax(0,1fr);gap:12px;align-items:baseline;padding:9px 0;border-bottom:1px solid #EFEADD;\">\n                <dt style=\"margin:0;font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#75695A;line-height:1.5;\">INR double</dt>\n                <dd style=\"margin:0;font-size:16px;line-height:1.5;color:#514A3F;font-variant-numeric:tabular-nums;\">{{ v.inrD }}</dd>\n              </div>\n              <div style=\"display:grid;grid-template-columns:104px minmax(0,1fr);gap:12px;align-items:baseline;padding:9px 0;border-bottom:1px solid #EFEADD;\">\n                <dt style=\"margin:0;font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#75695A;line-height:1.5;\">USD single</dt>\n                <dd style=\"margin:0;font-size:16px;line-height:1.5;color:#514A3F;font-variant-numeric:tabular-nums;\">{{ v.usdS }}</dd>\n              </div>\n              <div style=\"display:grid;grid-template-columns:104px minmax(0,1fr);gap:12px;align-items:baseline;padding:9px 0;border-bottom:1px solid #EFEADD;\">\n                <dt style=\"margin:0;font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#75695A;line-height:1.5;\">USD double</dt>\n                <dd style=\"margin:0;font-size:16px;line-height:1.5;color:#514A3F;font-variant-numeric:tabular-nums;\">{{ v.usdD }}</dd>\n              </div>\n              <div style=\"display:grid;grid-template-columns:104px minmax(0,1fr);gap:12px;align-items:baseline;padding:9px 0;border-bottom:1px solid #EFEADD;\">\n                <dt style=\"margin:0;font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#75695A;line-height:1.5;\">EUR single</dt>\n                <dd style=\"margin:0;font-size:16px;line-height:1.5;color:#514A3F;font-variant-numeric:tabular-nums;\">{{ v.eurS }}</dd>\n              </div>\n              <div style=\"display:grid;grid-template-columns:104px minmax(0,1fr);gap:12px;align-items:baseline;padding:9px 0;border-bottom:1px solid #EFEADD;\">\n                <dt style=\"margin:0;font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#75695A;line-height:1.5;\">EUR double</dt>\n                <dd style=\"margin:0;font-size:16px;line-height:1.5;color:#514A3F;font-variant-numeric:tabular-nums;\">{{ v.eurD }}</dd>\n              </div>\n            </dl>\n          </li>\n        </sc-for>\n      </ul>\n    </section>\n    <section aria-labelledby=\"incl-h\" style=\"margin-top:38px;padding-top:30px;border-top:1px solid #E9E2D3;\">\n      <h2 id=\"incl-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:27px;line-height:1.25;color:#2A2118;\">What the rate includes</h2>\n      <div style=\"width:48px;height:2px;background:#C1882C;margin:14px 0 18px;\"></div>      <div style=\"margin-bottom:22px;\">\n        <h3 style=\"margin:0 0 10px;font-size:18px;line-height:1.3;color:#2A2118;\">Professional Training &amp; Certification</h3>\n        <ul style=\"display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none;\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Daily theory classes by expert Ayurvedic Doctors</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Hands-on practical training led by Senior Ayurvedic Trainers &amp; Ayurvedic Doctors</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Comprehensive training in authentic Ayurvedic therapies and techniques</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Certification issued by Kairali Institute of Panchakarma Therapies</span></li>\n        </ul>\n      </div>      <div style=\"margin-bottom:22px;\">\n        <h3 style=\"margin:0 0 10px;font-size:18px;line-height:1.3;color:#2A2118;\">Accommodation &amp; Meals</h3>\n        <ul style=\"display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none;\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Villa accommodation (category per package)</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Three wholesome vegetarian Ayurvedic meals daily using organic ingredients</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Daily in-room mineral water and unlimited herbal detox water</span></li>\n        </ul>\n      </div>      <div style=\"margin-bottom:22px;\">\n        <h3 style=\"margin:0 0 10px;font-size:18px;line-height:1.3;color:#2A2118;\">Additional Benefits</h3>\n        <ul style=\"display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none;\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Pool, library, gym, outdoor facilities</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Organic farm tours and cultural immersion</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>All-inclusive pricing with no hidden costs (accommodation, meals, training &amp; taxes)</span></li>\n        </ul>\n      </div>    </section>\n\n    <section aria-labelledby=\"notes-h\" style=\"margin-top:38px;padding-top:30px;border-top:1px solid #E9E2D3;\">\n      <h2 id=\"notes-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:27px;line-height:1.25;color:#2A2118;\">Programme notes</h2>\n      <div style=\"width:48px;height:2px;background:#C1882C;margin:14px 0 18px;\"></div>      <ul style=\"display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none;\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Classes Monday to Friday only</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Full advance payment required</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Group discount 20% for 5 or more students</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:11px;font-size:16.5px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>No photography or videography during practical sessions</span></li>\n      </ul>\n    </section>\n\n    <section aria-labelledby=\"transport-h\" style=\"margin-top:38px;padding-top:30px;border-top:1px solid #E9E2D3;\">\n      <h2 id=\"transport-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:27px;line-height:1.25;color:#2A2118;\">Transport</h2>\n      <div style=\"width:48px;height:2px;background:#C1882C;margin:14px 0 18px;\"></div>      <p style=\"margin:0 0 16px;font-size:17px;line-height:1.7;color:#2A2118;\">One-way, air-conditioned, including 5% GST.</p>\n      <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;\">\n        <li style=\"background:#FFFFFF;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden;\">\n          <p style=\"margin:0;padding:13px 14px;background:#E0D7C4;border-bottom:1px solid #C9BFA8;font-size:16.5px;font-w