{"id":"ahv-page-how-to-reach-mobile","file":"AHV Page How To Reach Mobile.dc.html","sourceSha256":"ff2ccdbc82863060241acb880982a16b04c4ba7580adbd39bb792a7303c932d5","variant":"mobile","template":"\n<helmet>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n\n\n<style>\n  body { margin:0; background:#F7F4EA; }\n  a { color:#006038; }\n  a:hover { color:#004226; }\n  @media (prefers-reduced-motion: reduce) { * { animation:none !important; transition:none !important; scroll-behavior:auto !important; } }\n</style>\n</helmet>\n<div ref=\"{{ rootRef }}\" style=\"width:100%;max-width:100%;margin:0 auto;background:#F7F4EA;color:#2A2118;font-family:Mulish,sans-serif;font-size:18px;line-height:1.7;overflow-x:hidden;box-sizing:border-box;\">\n\n  <dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n\n  <header style=\"width:min(1220px,94%);margin:0 auto;padding:22px 0 26px;box-sizing:border-box;\">\n    <nav aria-label=\"Breadcrumb\" style=\"display:flex;align-items:center;font-size:14px;color:#75695A;margin:-12px 0 8px;\">\n      <a href=\"#\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 8px 0 0;color:#006038;text-decoration:none;\">Home</a>\n      <span style=\"padding:0 6px 0 0;color:#C9BFA8;\">›</span>\n      <span aria-current=\"page\">How to Reach</span>\n    </nav>\n    <p style=\"font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;margin:0 0 14px;line-height:1.5;\">Kairali — The Ayurvedic Healing Village · Since 1908</p>\n    <h1 style=\"font-family:Marcellus,serif;font-weight:400;font-size:38px;line-height:1.18;margin:0 0 20px;color:#2A2118;text-wrap:pretty;\">Your route to the Healing Village</h1>\n    <p style=\"max-width:66ch;font-size:18px;line-height:1.7;color:#514A3F;margin:0;border-left:2px solid #C1882C;padding-left:16px;\">Kairali – The Ayurvedic Healing Village is an NABH-accredited Ayurvedic hospital near Palakkad, Kerala, in South India. This page shows you which airport to choose, how our transfers work and exactly what to expect from the moment you land.</p>\n  </header>\n\n  <div style=\"overflow:hidden;width:100%;box-sizing:border-box;height:200px;background:#E0D7C4;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;display:flex;align-items:center;justify-content:center;padding:0 18px;\"><img src=\"/ahv/assets/img/wx-pathway.webp\" alt=\"A paved path winding past tile-roofed villas, palms and flowering shrubs in the garden\" loading=\"eager\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n\n  <section onClick=\"{{ onCopyClick }}\" style=\"width:min(1220px,94%);margin:0 auto;padding:26px 0 0;box-sizing:border-box;\">\n    <p style=\"font-size:16.5px;line-height:1.6;color:#514A3F;margin:0 0 6px;\">III/73 Palayamkadu, P.O. Olassery, Kodumbu, Palakkad District – 678551, Kerala, India</p>\n    <p style=\"font-size:15px;color:#75695A;margin:0 0 16px;\">Phone hours 8:00 AM–9:00 PM IST, daily</p>\n    <button type=\"button\" data-copy=\"III/73 Palayamkadu, P.O. Olassery, Kodumbu, Palakkad District – 678551, Kerala, India\" style=\"width:100%;min-height:52px;border:1.5px solid #006038;border-radius:4px;background:transparent;color:#006038;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-family:Mulish,sans-serif;\">Copy the address</button>\n  </section>\n\n  <section style=\"width:min(1220px,94%);margin:0 auto;padding:36px 0 0;box-sizing:border-box;\">\n    <p style=\"font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;margin:0 0 10px;\">Start here</p>\n    <h2 style=\"font-family:Marcellus,serif;font-weight:400;font-size:30px;line-height:1.25;margin:0 0 20px;color:#2A2118;\">The simplest way to reach us</h2>\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:22px;box-sizing:border-box;\">\n        <p style=\"font-size:14px;color:#75695A;margin:0 0 8px;\">Arriving from outside India</p>\n        <h3 style=\"font-family:Marcellus,serif;font-weight:400;font-size:24px;line-height:1.3;margin:0 0 12px;color:#2A2118;\">Fly to Coimbatore (CJB)</h3>\n        <p style=\"max-width:66ch;font-size:17.5px;line-height:1.7;color:#514A3F;margin:0;\">The nearest airport — a private car transfer of about 1½–2 hours. Kochi / Cochin (COK) is a good alternative when it has better connections from your country — about 2½–3 hours by road.</p>\n      </article>\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:22px;box-sizing:border-box;\">\n        <p style=\"font-size:14px;color:#75695A;margin:0 0 8px;\">Already travelling within India</p>\n        <h3 style=\"font-family:Marcellus,serif;font-weight:400;font-size:24px;line-height:1.3;margin:0 0 12px;color:#2A2118;\">Palakkad Junction (PGT)</h3>\n        <p style=\"max-width:66ch;font-size:17.5px;line-height:1.7;color:#514A3F;margin:0;\">The nearest railhead, about 35 minutes away — or drive in on the NH544 Coimbatore–Kochi corridor.</p>\n      </article>\n    </div>\n    <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:18px 0 0;border-left:2px solid #C1882C;padding-left:16px;\">Coimbatore airport is in the neighbouring state of Tamil Nadu; the hospital is in Kerala. Your transfer crosses the state border by road — this is routine and needs no extra formalities.</p>\n  </section>\n\n  <section style=\"width:100%;margin:36px 0 0;padding:0;box-sizing:border-box;\">\n    <div style=\"width:min(1220px,94%);margin:0 auto;\">\n      <p style=\"font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;margin:0 0 10px;\">Where we are</p>\n      <h2 style=\"font-family:Marcellus,serif;font-weight:400;font-size:30px;line-height:1.25;margin:0 0 14px;color:#2A2118;\">Four steps in, from the subcontinent to the gate</h2>\n      <p style=\"max-width:66ch;font-size:17.5px;line-height:1.7;color:#514A3F;margin:0 0 20px;\">Kerala lies on India’s south-west coast. Palakkad District sits inland, on the border between Kerala and Tamil Nadu, at the foot of the Western Ghats.</p>\n    </div>\n\n    <div style=\"position:sticky;top:0;z-index:20;background:#F7F4EA;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;\">\n      <ol data-steprail=\"1\" onClick=\"{{ onStepClick }}\" style=\"list-style:none;display:flex;gap:10px;margin:0;padding:12px 3%;overflow-x:auto;box-sizing:border-box;\">\n        <li style=\"display:flex;flex:0 0 auto;\">\n          <button type=\"button\" data-step=\"0\" style=\"display:flex;flex-direction:column;justify-content:center;gap:2px;min-height:56px;min-width:104px;padding:8px 16px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;text-align:left;cursor:pointer;font-family:Mulish,sans-serif;\">\n            <span data-num=\"1\" style=\"font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#8F6212;\">Step 1</span>\n            <span data-title=\"1\" style=\"font-family:Marcellus,serif;font-size:19px;color:#2A2118;white-space:nowrap;\">India</span>\n          </button>\n        </li>\n        <li style=\"display:flex;flex:0 0 auto;\">\n          <button type=\"button\" data-step=\"1\" style=\"display:flex;flex-direction:column;justify-content:center;gap:2px;min-height:56px;min-width:104px;padding:8px 16px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;text-align:left;cursor:pointer;font-family:Mulish,sans-serif;\">\n            <span data-num=\"1\" style=\"font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#8F6212;\">Step 2</span>\n            <span data-title=\"1\" style=\"font-family:Marcellus,serif;font-size:19px;color:#2A2118;white-space:nowrap;\">Kerala</span>\n          </button>\n        </li>\n        <li style=\"display:flex;flex:0 0 auto;\">\n          <button type=\"button\" data-step=\"2\" style=\"display:flex;flex-direction:column;justify-content:center;gap:2px;min-height:56px;min-width:104px;padding:8px 16px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;text-align:left;cursor:pointer;font-family:Mulish,sans-serif;\">\n            <span data-num=\"1\" style=\"font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#8F6212;\">Step 3</span>\n            <span data-title=\"1\" style=\"font-family:Marcellus,serif;font-size:19px;color:#2A2118;white-space:nowrap;\">Palakkad</span>\n          </button>\n        </li>\n        <li style=\"display:flex;flex:0 0 auto;\">\n          <button type=\"button\" data-step=\"3\" style=\"display:flex;flex-direction:column;justify-content:center;gap:2px;min-height:56px;min-width:104px;padding:8px 16px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;text-align:left;cursor:pointer;font-family:Mulish,sans-serif;\">\n            <span data-num=\"1\" style=\"font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#8F6212;\">Step 4</span>\n            <span data-title=\"1\" style=\"font-family:Marcellus,serif;font-size:19px;color:#2A2118;white-space:nowrap;\">Grounds</span>\n          </button>\n        </li>\n      </ol>\n    </div>\n\n    <div style=\"position:relative;width:100%;height:340px;background:#F2EDE0;border-bottom:1px solid #E9E2D3;box-sizing:border-box;\">\n      <div data-panel=\"0\" style=\"position:absolute;inset:0;\"></div>\n      <div data-panel=\"1\" style=\"position:absolute;inset:0;display:none;\"></div>\n      <div data-panel=\"2\" style=\"position:absolute;inset:0;display:none;overflow-y:auto;padding:20px 5%;box-sizing:border-box;\">\n        <p style=\"font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#8F6212;margin:0 0 14px;\">Road diagram, not to scale</p>\n        <div style=\"display:flex;flex-direction:column;gap:14px;\">\n          <div style=\"border-left:2px solid #C1882C;padding-left:14px;\">\n            <p style=\"margin:0;font-family:Marcellus,serif;font-size:21px;color:#2A2118;\">Coimbatore (CJB)</p>\n            <p style=\"margin:2px 0 0;font-size:16.5px;color:#514A3F;\">~62 km · ~1½–2 hr by road, NH544</p>\n          </div>\n          <div style=\"border-left:2px solid #C1882C;padding-left:14px;\">\n            <p style=\"margin:0;font-family:Marcellus,serif;font-size:21px;color:#2A2118;\">Kochi / Cochin (COK)</p>\n            <p style=\"margin:2px 0 0;font-size:16.5px;color:#514A3F;\">~115 km · ~2½–3 hr by road</p>\n          </div>\n          <div style=\"border-left:2px solid #C1882C;padding-left:14px;\">\n            <p style=\"margin:0;font-family:Marcellus,serif;font-size:21px;color:#2A2118;\">Palakkad Junction (PGT)</p>\n            <p style=\"margin:2px 0 0;font-size:16.5px;color:#514A3F;\">~18 km · ~35 min, west through Kodumbu</p>\n          </div>\n          <div style=\"border-left:2px solid #5A4420;padding-left:14px;\">\n            <p style=\"margin:0;font-family:Marcellus,serif;font-size:21px;color:#2A2118;\">Olassery, Kodumbu</p>\n            <p style=\"margin:2px 0 0;font-size:16.5px;color:#514A3F;\">The hospital, at the foot of the Western Ghats</p>\n          </div>\n        </div>\n      </div>\n      <div data-panel=\"3\" style=\"position:absolute;inset:0;display:none;padding:18px 5%;box-sizing:border-box;\">\n        <div style=\"height:100%;border:1px solid #E9E2D3;border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:18px;box-sizing:border-box;text-align:center;\"><img src=\"/ahv/assets/img/travel/89310cfa7faa54ee1eecf73b427105b0af81fd179ce8fad0e6992eaa563b51c1.webp\" alt=\"Illustrated aerial map of the grounds, numbering the reception, Ayurvedic hospital, yoga centre, meditation hall, villas, herbal garden and other facilities\" loading=\"lazy\" style=\"width:100%;flex:1 1 auto;min-height:0;max-height:100%;object-fit:contain;display:block;\">\n        </div>\n      </div>\n    </div>\n\n    <div style=\"width:min(1220px,94%);margin:0 auto;padding:18px 0 0;box-sizing:border-box;\">\n      <p data-cap=\"0\" style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 16px;\">India, with the hospital marked in Palakkad District, Kerala, on the south-west coast.</p>\n      <p data-cap=\"1\" style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 16px;display:none;\">Kerala and the western tip of Tamil Nadu. Coimbatore airport (CJB) lies to the east in Tamil Nadu; Kochi airport (COK) to the south-west in Kerala.</p>\n      <p data-cap=\"2\" style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 16px;display:none;\">Palakkad District, by road. Each arrival point with the drive that follows it — the last leg runs west out of Palakkad town through Kodumbu to Olassery.</p>\n      <p data-cap=\"3\" style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 16px;display:none;\">The village grounds at Olassery, Kodumbu.</p>\n      <div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;\">\n        <button type=\"button\" onClick=\"{{ onPrev }}\" style=\"min-height:52px;border-radius:4px;border:1.5px solid #5A4420;background:transparent;color:#5A4420;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-family:Mulish,sans-serif;\">Previous</button>\n        <button type=\"button\" onClick=\"{{ onNext }}\" style=\"min-height:52px;border-radius:4px;border:1.5px solid #5A4420;background:#5A4420;color:#F7F4EA;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-family:Mulish,sans-serif;\">Zoom in</button>\n      </div>\n      <a href=\"https://www.google.com/maps/dir/?api=1&amp;destination=10.727275,76.710507\" style=\"display:flex;align-items:center;justify-content:center;min-height:52px;margin-top:12px;border-radius:4px;border:1.5px solid #006038;color:#006038;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;box-sizing:border-box;\">Open directions in Google Maps</a>\n      <p style=\"font-size:14px;color:#75695A;margin:12px 0 0;\">Steps 1–2 use Natural Earth geometry. Steps 3–4 are diagrams, not to scale.</p>\n    </div>\n  </section>\n\n  <section style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 0;box-sizing:border-box;\">\n    <p style=\"font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;margin:0 0 10px;\">Ways to reach us</p>\n    <h2 style=\"font-family:Marcellus,serif;font-weight:400;font-size:30px;line-height:1.25;margin:0 0 14px;color:#2A2118;\">By air, by rail, by road</h2>\n    <p style=\"max-width:66ch;font-size:17.5px;line-height:1.7;color:#514A3F;margin:0 0 20px;\">However you travel, we can receive you at the airport or railway station with a named driver — you never have to look for a taxi on arrival.</p>\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:22px;box-sizing:border-box;\">\n        <h3 style=\"font-family:Marcellus,serif;font-weight:400;font-size:24px;margin:0 0 14px;color:#2A2118;\">By air</h3>\n        <div style=\"display:flex;flex-direction:column;gap:12px;padding-bottom:14px;border-bottom:1px solid #E9E2D3;\">\n          <div><p style=\"margin:0;font-size:17px;color:#2A2118;\">Coimbatore (CJB) — nearest</p><p style=\"margin:2px 0 0;font-size:16px;color:#75695A;\">~62 km · ~1½–2 hr</p></div>\n          <div><p style=\"margin:0;font-size:17px;color:#2A2118;\">Kochi / Cochin (COK) — alternative</p><p style=\"margin:2px 0 0;font-size:16px;color:#75695A;\">~115 km · ~2½–3 hr</p></div>\n        </div>\n        <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:14px 0 0;\"><strong style=\"font-weight:700;color:#2A2118;\">On arrival:</strong> share your flight number and landing time with us in advance, and a car with a name-board can wait for you.</p>\n      </article>\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:22px;box-sizing:border-box;\">\n        <h3 style=\"font-family:Marcellus,serif;font-weight:400;font-size:24px;margin:0 0 14px;color:#2A2118;\">By rail</h3>\n        <div style=\"padding-bottom:14px;border-bottom:1px solid #E9E2D3;\">\n          <p style=\"margin:0;font-size:17px;color:#2A2118;\">Palakkad Junction (PGT) — recommended</p><p style=\"margin:2px 0 0;font-size:16px;color:#75695A;\">~18 km · ~35 min</p>\n        </div>\n        <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:14px 0 0;\"><strong style=\"font-weight:700;color:#2A2118;\">On arrival:</strong> taxis wait at the station, or send us your train number and arrival time — we will pick you up.</p>\n      </article>\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:22px;box-sizing:border-box;\">\n        <h3 style=\"font-family:Marcellus,serif;font-weight:400;font-size:24px;margin:0 0 14px;color:#2A2118;\">By road</h3>\n        <div style=\"display:flex;flex-direction:column;gap:12px;padding-bottom:14px;border-bottom:1px solid #E9E2D3;\">\n          <div><p style=\"margin:0;font-size:17px;color:#2A2118;\">On the NH544 corridor</p><p style=\"margin:2px 0 0;font-size:16px;color:#75695A;\">Coimbatore–Kochi</p></div>\n          <div><p style=\"margin:0;font-size:17px;color:#2A2118;\">Self-drive or private taxi</p><p style=\"margin:2px 0 0;font-size:16px;color:#75695A;\">via Palakkad</p></div>\n        </div>\n        <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:14px 0 0;\"><strong style=\"font-weight:700;color:#2A2118;\">On arrival:</strong> follow the signs to Kodumbu and Olassery; call the main line if you need directions on the day.</p>\n      </article>\n    </div>\n  </section>\n\n  <section onClick=\"{{ onCopyClick }}\" style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 0;box-sizing:border-box;\">\n    <p style=\"font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;margin:0 0 10px;\">Transfers from airport &amp; station</p>\n    <h2 style=\"font-family:Marcellus,serif;font-weight:400;font-size:30px;line-height:1.25;margin:0 0 14px;color:#2A2118;\">Let us handle the last leg</h2>\n    <p style=\"max-width:66ch;font-size:17.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">The hospital can arrange a private car for your arrival from the airport or railway station. To request one, message our patient care coordinator, Priya, on WhatsApp, or call the main line. Please tell us:</p>\n    <ul style=\"max-width:66ch;margin:0 0 20px;padding:0 0 0 20px;color:#514A3F;font-size:17.5px;line-height:1.9;\">\n      <li>Your arrival date and time</li>\n      <li>Flight or train number</li>\n      <li>Number of patients travelling</li>\n      <li>Any mobility or medical needs</li>\n    </ul>\n    <div style=\"display:flex;flex-direction:column;gap:12px;\">\n      <div style=\"display:flex;gap:10px;\">\n        <a href=\"https://wa.me/919289838797\" style=\"flex:1;display:flex;align-items:center;min-height:52px;padding:0 14px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;color:#006038;font-size:17px;font-weight:600;text-decoration:none;box-sizing:border-box;\" target=\"_blank\" rel=\"noopener noreferrer\">+91 92898 38797</a>\n        <button type=\"button\" data-copy=\"+91 92898 38797\" style=\"min-width:88px;min-height:52px;border:1.5px solid #006038;border-radius:4px;background:transparent;color:#006038;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-family:Mulish,sans-serif;\">Copy</button>\n      </div>\n      <div style=\"display:flex;gap:10px;\">\n        <a href=\"tel:+91 9555 156 156\" style=\"flex:1;display:flex;align-items:center;min-height:52px;padding:0 14px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;color:#006038;font-size:17px;font-weight:600;text-decoration:none;box-sizing:border-box;\">+91 9555 156 156</a>\n        <button type=\"button\" data-copy=\"+91 9555 156 156\" style=\"min-width:88px;min-height:52px;border:1.5px solid #006038;border-radius:4px;background:transparent;color:#006038;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-family:Mulish,sans-serif;\">Copy</button>\n      </div>\n      <div style=\"display:flex;gap:10px;\">\n        <a href=\"mailto:info@kairali.com\" style=\"flex:1;display:flex;align-items:center;min-height:52px;padding:0 14px;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;color:#006038;font-size:17px;font-weight:600;text-decoration:none;box-sizing:border-box;\">info@kairali.com</a>\n        <button type=\"button\" data-copy=\"info@kairali.com\" style=\"min-width:88px;min-height:52px;border:1.5px solid #006038;border-radius:4px;background:transparent;color:#006038;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-family:Mulish,sans-serif;\">Copy</button>\n      </div>\n    </div>\n    <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:18px 0 0;\">The main line is answered by an automated menu — press 2 for reservations. Open 8:00 AM to 9:00 PM IST, daily. Transfer and any charges are confirmed by our team at booking.</p>\n  </section>\n\n  <section style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 0;box-sizing:border-box;\">\n    <p style=\"font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;margin:0 0 10px;\">First trip to India</p>\n    <h2 style=\"font-family:Marcellus,serif;font-weight:400;font-size:30px;line-height:1.25;margin:0 0 20px;color:#2A2118;\">Your arrival in India</h2>\n    <h3 style=\"font-family:Marcellus,serif;font-weight:400;font-size:24px;margin:0 0 12px;color:#2A2118;\">Your arrival, step by step</h3>\n    <ol style=\"max-width:66ch;margin:0 0 26px;padding:0 0 0 20px;color:#514A3F;font-size:17.5px;line-height:1.8;\">\n      <li style=\"margin-bottom:10px;\">Clear immigration and collect your baggage.</li>\n      <li style=\"margin-bottom:10px;\">Exit through the arrivals gate.</li>\n      <li style=\"margin-bottom:10px;\"><strong style=\"font-weight:700;color:#2A2118;\">A Kairali representative receives you</strong> with a name-board. You receive the driver’s name and vehicle details before you land.</li>\n      <li style=\"margin-bottom:10px;\">The driver helps with your luggage and brings you directly to the hospital.</li>\n      <li>If you cannot find the driver, call or message the arrival number and wait inside the terminal.</li>\n    </ol>\n    <h3 style=\"font-family:Marcellus,serif;font-weight:400;font-size:24px;margin:0 0 12px;color:#2A2118;\">Good to know</h3>\n    <div style=\"display:flex;flex-direction:column;gap:12px;\">\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px;box-sizing:border-box;\">\n        <p style=\"margin:0 0 4px;font-size:17px;font-weight:700;color:#2A2118;\">Local SIM / eSIM</p>\n        <p style=\"margin:0;font-size:16.5px;line-height:1.6;color:#514A3F;\">Available at the airport — useful from the moment you land.</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px;box-sizing:border-box;\">\n        <p style=\"margin:0 0 4px;font-size:17px;font-weight:700;color:#2A2118;\">WhatsApp</p>\n        <p style=\"margin:0;font-size:16.5px;line-height:1.6;color:#514A3F;\">It is how we coordinate your pick-up and stay in touch throughout.</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px;box-sizing:border-box;\">\n        <p style=\"margin:0 0 4px;font-size:17px;font-weight:700;color:#2A2118;\">Currency</p>\n        <p style=\"margin:0;font-size:16.5px;line-height:1.6;color:#514A3F;\">The Indian Rupee (₹). ATMs are available at both airports.</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px;box-sizing:border-box;\">\n        <p style=\"margin:0 0 4px;font-size:17px;font-weight:700;color:#2A2118;\">English</p>\n        <p style=\"margin:0;font-size:16.5px;line-height:1.6;color:#514A3F;\">Widely spoken in Kerala; our team communicates in English.</p>\n      </div>\n    </div>\n    <div style=\"display:flex;flex-direction:column;gap:16px;margin-top:22px;\">\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0;border-left:2px solid #C1882C;padding-left:16px;\"><strong style=\"font-weight:700;color:#2A2118;\">Late-night arrivals.</strong> A pre-arranged transfer is strongly recommended — local roads are quiet after dark. Share the driver and vehicle details with someone at home before you set off.</p>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0;border-left:2px solid #C1882C;padding-left:16px;\"><strong style=\"font-weight:700;color:#2A2118;\">Travelling with mobility or medical needs.</strong> A wheelchair-accessible vehicle, breaks during the drive and an accompanying caregiver can be arranged — please tell us at booking.</p>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0;border-left:2px solid #C1882C;padding-left:16px;\"><strong style=\"font-weight:700;color:#2A2118;\">Visa &amp; entry.</strong> Most international visitors need a valid passport and an Indian visa or an eligible e-Visa. Requirements vary by nationality and can change — please check the official Government of India visa portal before you travel. <a href=\"https://indianvisaonline.gov.in/\">Government of India visa portal</a></p>\n    </div>\n  </section>\n\n  <section style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 0;box-sizing:border-box;\">\n    <p style=\"font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;margin:0 0 10px;\">Distances at a glance</p>\n    <h2 style=\"font-family:Marcellus,serif;font-weight:400;font-size:30px;line-height:1.25;margin:0 0 18px;color:#2A2118;\">From the main hubs to the hospital</h2>\n    <div style=\"display:flex;flex-direction:column;gap:12px;\">\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px;box-sizing:border-box;\">\n        <p style=\"margin:0 0 6px;font-size:18px;color:#2A2118;\">Coimbatore airport (CJB)</p>\n        <p style=\"margin:0;font-size:16.5px;color:#514A3F;\">By road · ~62 km · ~1½–2 hr</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px;box-sizing:border-box;\">\n        <p style=\"margin:0 0 6px;font-size:18px;color:#2A2118;\">Kochi / Cochin airport (COK)</p>\n        <p style=\"margin:0;font-size:16.5px;color:#514A3F;\">By road · ~115 km · ~2½–3 hr</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px;box-sizing:border-box;\">\n        <p style=\"margin:0 0 6px;font-size:18px;color:#2A2118;\">Palakkad Junction (PGT)</p>\n        <p style=\"margin:0;font-size:16.5px;color:#514A3F;\">By road · ~18 km · ~35 min</p>\n      </div>\n    </div>\n    <p style=\"max-width:66ch;font-size:16px;line-height:1.7;color:#75695A;margin:14px 0 0;\">Distances are measured to the hospital and are approximate; travel times vary with traffic, route and season. Our team can confirm the best option for your arrival.</p>\n  </section>\n\n  <section onClick=\"{{ onCopyClick }}\" style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 0;box-sizing:border-box;\">\n    <p style=\"font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;margin:0 0 10px;\">Where to find us</p>\n    <h2 style=\"font-family:Marcellus,serif;font-weight:400;font-size:30px;line-height:1.25;margin:0 0 18px;color:#2A2118;\">Addresses</h2>\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:22px;box-sizing:border-box;\">\n        <p style=\"font-size:14px;color:#75695A;margin:0 0 8px;\">The Healing Village · Palakkad</p>\n        <h3 style=\"font-family:Marcellus,serif;font-weight:400;font-size:24px;line-height:1.3;margin:0 0 12px;color:#2A2118;\">Kairali – The Ayurvedic Healing Village</h3>\n        <p style=\"font-size:17px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">III/73 Palayamkadu, P.O. Olassery,<br>Kodumbu, Palakkad District – 678551,<br>Kerala, India</p>\n        <div style=\"display:flex;flex-direction:column;gap:10px;\">\n          <button type=\"button\" data-copy=\"III/73 Palayamkadu, P.O. Olassery, Kodumbu, Palakkad District – 678551, Kerala, India\" style=\"min-height:52px;border:1.5px solid #006038;border-radius:4px;background:transparent;color:#006038;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-family:Mulish,sans-serif;\">Copy address</button>\n          <a href=\"tel:+91 9555 156 156\" style=\"display:flex;align-items:center;min-height:52px;padding:0 16px;border:1px solid #E9E2D3;border-radius:4px;color:#006038;font-size:17px;font-weight:600;text-decoration:none;box-sizing:border-box;\">+91 9555 156 156</a>\n          <a href=\"https://wa.me/919289838797\" style=\"display:flex;align-items:center;min-height:52px;padding:0 16px;border:1px solid #E9E2D3;border-radius:4px;color:#006038;font-size:17px;font-weight:600;text-decoration:none;box-sizing:border-box;\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp +91 92898 38797</a>\n          <a href=\"mailto:info@kairali.com\" style=\"display:flex;align-items:center;min-height:52px;padding:0 16px;border:1px solid #E9E2D3;border-radius:4px;color:#006038;font-size:17px;font-weight:600;text-decoration:none;box-sizing:border-box;\">info@kairali.com</a>\n        </div>\n      </article>\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:22px;box-sizing:border-box;\">\n        <p style=\"font-size:14px;color:#75695A;margin:0 0 8px;\">Reservations office · New Delhi</p>\n        <h3 style=\"font-family:Marcellus,serif;font-weight:400;font-size:24px;line-height:1.3;margin:0 0 12px;color:#2A2118;\">Kairali Ayurvedic Health Resort Pvt. Ltd.</h3>\n        <p style=\"font-size:17px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">D-130, Block D, Ambedkar Colony,<br>Mehrauli, New Delhi – 110030,<br>India</p>\n        <div style=\"display:flex;flex-direction:column;gap:10px;\">\n          <button type=\"button\" data-copy=\"D-130, Block D, Ambedkar Colony, Mehrauli, New Delhi – 110030, India\" style=\"min-height:52px;border:1.5px solid #006038;border-radius:4px;background:transparent;color:#006038;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-family:Mulish,sans-serif;\">Copy address</button>\n          <a href=\"tel:+91 9555 156 156\" style=\"display:flex;align-items:center;min-height:52px;padding:0 16px;border:1px solid #E9E2D3;border-radius:4px;color:#006038;font-size:17px;font-weight:600;text-decoration:none;box-sizing:border-box;\">+91 9555 156 156</a>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <section style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 0;box-sizing:border-box;\">\n    <p style=\"font-size:12.5px;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;margin:0 0 10px;\">Before you travel</p>\n    <h2 style=\"font-family:Marcellus,serif;font-weight:400;font-size:30px;line-height:1.25;margin:0 0 14px;color:#2A2118;\">Frequently asked questions</h2>\n    <details style=\"border-top:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">Should I fly to Coimbatore or Kochi?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">Coimbatore (CJB) is the nearest airport, about one and a half to two hours by road, and the simplest arrival for most visitors. Choose Kochi / Cochin (COK) — about two and a half to three hours by road — when it offers a better international connection from your country.</p>\n    </details>\n    <details style=\"border-top:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">How far is the nearest airport?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">Coimbatore International Airport (CJB) is the nearest at around 62 km — about one and a half to two hours by car. Kochi / Cochin International Airport (COK) is around 115 km away, about two and a half to three hours by road.</p>\n    </details>\n    <details style=\"border-top:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">Do you arrange pick-up from the airport or railway station?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">Yes. The hospital can arrange a private car for arriving patients. Message our patient care team on WhatsApp, or call the main line, and share your arrival date, time and flight or train number. A team member will confirm the driver and vehicle details.</p>\n    </details>\n    <details style=\"border-top:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">How will I recognise the driver?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">A Kairali representative waits for you in the arrivals area with a name-board. You receive the driver’s name and vehicle details before you land, so you know exactly who is picking you up.</p>\n    </details>\n    <details style=\"border-top:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">Is pick-up available for late-evening arrivals?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">Yes. A pre-arranged transfer is recommended for late arrivals, when local roads are quiet. Share your flight details in advance and your driver will wait for you at any hour.</p>\n    </details>\n    <details style=\"border-top:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">Can I come by train?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">Yes. Palakkad Junction (PGT) is the recommended station, around 18 km away — about a 35-minute drive. Taxis are available at the station, or send us your train number and arrival time and we will pick you up.</p>\n    </details>\n    <details style=\"border-top:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">Is the trip safe for a solo traveller?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">Kerala is among the calmest regions of India, and English is widely spoken. With a pre-arranged transfer you are met by a named driver, so there is no need to look for a taxi on arrival. Many of our patients travel to us alone.</p>\n    </details>\n    <details style=\"border-top:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">Can you accommodate a wheelchair or a caregiver?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">Yes. A wheelchair-accessible vehicle and an accompanying caregiver can be arranged. Please tell us your requirements at booking so the right vehicle is ready.</p>\n    </details>\n    <details style=\"border-top:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">Do I need an Indian visa?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">Most international visitors need a valid passport and an Indian visa or an eligible e-Visa. Requirements vary by nationality and can change — please check the official Government of India visa portal before you travel.</p>\n    </details>\n    <details style=\"border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;padding:4px 0;\">\n      <summary style=\"list-style:none;cursor:pointer;min-height:56px;display:flex;align-items:center;font-size:17.5px;font-weight:600;color:#2A2118;\">Is this a hospital or a spa?</summary>\n      <p style=\"max-width:66ch;font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 0 14px;\">Kairali – The Ayurvedic Healing Village is an NABH-accredited Ayurvedic hospital. Care is led by registered Ayurvedic physicians, and every treatment programme begins with a clinical consultation. It is not a spa.</p>\n    </details>\n  </section>\n\n  <div style=\"height:56px;\"></div>\n  <section style=\"width:100%;box-sizing:border-box;background:#FFFFFF;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;background-image:repeating-linear-gradient(135deg, rgba(193,136,44,0.045) 0 1px, transparent 1px 9px);padding:40px 5%;\">\n    <div style=\"max-width:760px;margin:0 auto;text-align:center;\">\n      <ul style=\"list-style:none;margin:0 0 26px;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px;text-align:left;\">\n        <li style=\"font-size:15.5px;line-height:1.5;color:#2A2118;\"><span style=\"color:#C1882C;padding-right:8px;\">◆</span>NABH Certified Hospital</li>\n        <li style=\"font-size:15.5px;line-height:1.5;color:#2A2118;\"><span style=\"color:#C1882C;padding-right:8px;\">◆</span>118+ Years Heritage</li>\n        <li style=\"font-size:15.5px;line-height:1.5;color:#2A2118;\"><span style=\"color:#C1882C;padding-right:8px;\">◆</span>Individualised Programmes</li>\n        <li style=\"font-size:15.5px;line-height:1.5;color:#2A2118;\"><span style=\"color:#C1882C;padding-right:8px;\">◆</span>World Luxury Award Winner</li>\n      </ul>\n      <h2 style=\"font-family:Marcellus,serif;font-weight:400;font-size:26px;line-height:1.3;margin:0 0 12px;color:#2A2118;\">Not sure which programme fits?</h2>\n      <p style=\"font-size:16.5px;line-height:1.7;color:#514A3F;margin:0 auto 24px;max-width:56ch;\">Share your goal in your own words — the patient care team or an Ayurvedic doctor will point you to the right programme.</p>\n      <div style=\"display:flex;flex-wrap:wrap;gap:12px;justify-content:center;\">\n        <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" style=\"flex:1 1 100%;display:inline-flex;align-items:center;justify-content:center;height:52px;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;padding:0 18px;box-sizing:border-box;\">Free Doctor Consultation</a>\n        <a href=\"https://wa.me/919289838797\" style=\"flex:1 1 100%;display:inline-flex;align-items:center;justify-content:center;height:52px;border-radius:4px;border:1.5px solid #006038;color:#006038;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;padding:0 18px;box-sizing:border-box;\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp Patient Care</a>\n        <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"flex:1 1 100%;display:inline-flex;align-items:center;justify-content:center;height:52px;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;padding:0 18px;box-sizing:border-box;\">Enquire Now</a>\n      </div>\n    </div>\n  </section>\n\n  <dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n\n  <div style=\"position:sticky;bottom:0;z-index:30;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:10px 3%;background:#F7F4EA;border-top:1px solid #E9E2D3;box-sizing:border-box;\">\n    <a href=\"https://wa.me/919289838797?text=Hello%2C%20I%20would%20like%20to%20arrange%20a%20transfer%20to%20Kairali%20%E2%80%93%20The%20Ayurvedic%20Healing%20Village.%20My%20arrival%20details%3A\" style=\"display:flex;align-items:center;justify-content:center;height:52px;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:13.5px;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;text-align:center;\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp transfer</a>\n    <a href=\"tel:+91 9555 156 156\" style=\"display:flex;align-items:center;justify-content:center;height:52px;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:13.5px;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;box-sizing:border-box;\">Call</a>\n  </div>\n</div>\n","logic":"\nconst VILLAGE = [10.727275, 76.710507];\nconst CJB = [11.0297, 77.0434];\nconst COK = [10.152, 76.401];\n\nclass Component extends DCLogic {\n  constructor(p) { super(p); this.step = 0; }\n\n  renderVals() {\n    return {\n      rootRef: (el) => { this.root = el; },\n      onStepClick: (e) => {\n        const b = e.target.closest('[data-step]');\n        if (b) this.setStep(+b.dataset.step);\n      },\n      onPrev: () => this.setStep(Math.max(0, this.step - 1)),\n      onNext: () => this.setStep(Math.min(3, this.step + 1)),\n      onCopyClick: (e) => {\n        const b = e.target.closest('[data-copy]');\n        if (!b) return;\n        const txt = b.dataset.copy;\n        const done = () => {\n          const old = b.textContent;\n          b.textContent = 'Copied';\n          setTimeout(() => { b.textContent = old; }, 1600);\n        };\n        if (navigator.clipboard) navigator.clipboard.writeText(txt).then(done, done);\n        else done();\n      }\n    };\n  }\n\n  componentDidMount() { this.sync(); this.waitForLibs(); }\n\n  q(sel) { return this.root ? Array.from(this.root.querySelectorAll(sel)) : []; }\n\n  setStep(n) { this.step = n; this.sync(); }\n\n  sync() {\n    if (!this.root) return;\n    this.q('[data-step]').forEach((b) => {\n      const on = +b.dataset.step === this.step;\n      b.style.background = on ? '#5A4420' : '#FFFFFF';\n      b.style.borderColor = on ? '#5A4420' : '#E9E2D3';\n      b.setAttribute('aria-current', on ? 'step' : 'false');\n      const num = b.querySelector('[data-num]');\n      const title = b.querySelector('[data-title]');\n      if (num) num.style.color = on ? '#EEB41E' : '#8F6212';\n      if (title) title.style.color = on ? '#F7F4EA' : '#2A2118';\n    });\n    this.q('[data-panel]').forEach((p) => {\n      p.style.display = +p.dataset.panel === this.step ? 'block' : 'none';\n    });\n    this.q('[data-cap]').forEach((p) => {\n      p.style.display = +p.dataset.cap === this.step ? 'block' : 'none';\n    });\n  }\n\n  waitForLibs() {\n    let tries = 0;\n    const tick = () => {\n      if (window.d3 && window.topojson) { this.buildMaps(); return; }\n      if (tries++ > 120) return;\n      setTimeout(tick, 100);\n    };\n    tick();\n  }\n\n  async buildMaps() {\n    try {\n      const topo = await fetch('https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-110m.json').then(r => r.json());\n      const world = window.topojson.feature(topo, topo.objects.countries).features;\n      this.drawGeo(0, world, { fitTo: world.find(f => f.properties.name === 'India'), labels: [[VILLAGE, 'The hospital', true]] });\n      this.drawGeo(1, world, {\n        fitTo: { type: 'MultiPoint', coordinates: [[74.8, 8.4], [78.4, 12.6]] },\n        labels: [[VILLAGE, 'The hospital', true], [CJB, 'CJB', false], [COK, 'COK', false]]\n      });\n    } catch (e) { /* geometry unavailable */ }\n  }\n\n  drawGeo(idx, world, opts) {\n    const host = this.root && this.root.querySelector('[data-panel=\"' + idx + '\"]');\n    if (!host || host.childElementCount) return;\n    const ref = this.root.querySelector('[data-panel=\"0\"]');\n    const w = host.clientWidth || (ref && ref.clientWidth) || 390;\n    const h = host.clientHeight || (ref && ref.clientHeight) || 340;\n    const d3 = window.d3;\n    const svg = d3.select(host).append('svg')\n      .attr('width', '100%').attr('height', '100%')\n      .attr('viewBox', '0 0 ' + w + ' ' + h)\n      .attr('preserveAspectRatio', 'xMidYMid slice')\n      .style('display', 'block')\n      .attr('role', 'img')\n      .attr('aria-label', idx === 0 ? 'Map of India with the hospital marked in Kerala' : 'Map of Kerala and western Tamil Nadu with the hospital and the two airports marked');\n    svg.append('rect').attr('width', w).attr('height', h).attr('fill', '#F2EDE0');\n    const proj = d3.geoMercator().fitExtent([[24, 24], [w - 24, h - 24]], opts.fitTo);\n    const path = d3.geoPath(proj);\n    svg.append('g').selectAll('path').data(world).join('path')\n      .attr('d', path)\n      .attr('fill', d => d.properties.name === 'India' ? '#E6DCC6' : '#EDE7DA')\n      .attr('stroke', '#C9BFA8').attr('stroke-width', 0.8);\n    const g = svg.append('g');\n    opts.labels.forEach(([ll, text, main]) => {\n      const p = proj([ll[1], ll[0]]);\n      if (!p) return;\n      g.append('circle').attr('cx', p[0]).attr('cy', p[1]).attr('r', main ? 7 : 5)\n        .attr('fill', main ? '#C1882C' : '#5A4420').attr('stroke', '#F7F4EA').attr('stroke-width', 2);\n      g.append('text').attr('x', p[0] + 12).attr('y', p[1] + 5)\n        .attr('font-family', 'Mulish, sans-serif').attr('font-size', 15)\n        .attr('font-weight', main ? 700 : 400)\n        .attr('fill', '#2A2118').text(text);\n    });\n  }\n}\n","props":"{\"$preview\":{\"width\":390,\"height\":844}}","scripts":["https://unpkg.com/d3@7.9.0/dist/d3.min.js","https://unpkg.com/topojson-client@3.1.0/dist/topojson-client.min.js"]}