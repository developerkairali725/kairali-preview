\":\"https://ayurvedichealingvillage.com/mindfulness-retreat/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Mindfulness Retreat — Mobile\" style=\"max-width:430px;margin:0 auto;background:#F7F4EA;box-shadow:0 0 40px rgba(70,50,20,.15);position:relative;box-sizing:border-box\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:20px 0 28px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">News &amp; Past Events</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Past Retreats</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Mindfulness Retreat</span></nav>\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;margin-top:4px\">Past Retreat</div>\n  <h1 style=\"font-family:'Marcellus',serif;font-size:29px;line-height:1.2;margin:12px 0 0;text-wrap:balance\">Mindfulness Retreat</h1>\n  <div role=\"note\" aria-label=\"Past retreat notice\" style=\"margin-top:20px;background:#fff;border:1px solid #C1882C;border-left:6px solid #C1882C;border-radius:4px;padding:16px 18px\">\n      <p style=\"margin:0;font-size:17px;line-height:1.6;color:#2A2118\">This is a past retreat. The original description and speaker biographies below are retained as a historical record and are not a current offer. There are no current dates or bookings for this retreat.</p>\n      <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:4px;font-weight:700;font-size:15.5px\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>Past Retreats</a>\n  </div>\n</section>\n<div style=\"width:min(1220px,94%);margin:0 auto\">\n  <img src=\"/ahv/assets/img/AHV-Mindfulness-Hero.webp\" alt=\"Ayurvedic treatment with herbal powder\" width=\"772\" height=\"289\" style=\"width:100%;max-width:772px;height:auto;display:block;border-radius:4px\">\n</div>\n\n<article aria-label=\"Historical retreat description\" style=\"width:min(1220px,94%);margin:0 auto;padding:36px 0 0\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;margin-bottom:8px\">Historical retreat description</div>\n  <div style=\"display:flex;flex-direction:column;gap:20px\">\n    <section id=\"intro\" aria-labelledby=\"intro-h\">\n      <h2 id=\"intro-h\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.22;margin:0 0 16px;text-wrap:balance\">{{ s0.heading }}</h2>\n      <sc-for list=\"{{ s0.paragraphs }}\" as=\"p\" hint-placeholder-count=\"11\"><p style=\"margin:0 0 14px;font-size:17px\">{{ p }}</p></sc-for>\n    </section>\n    <figure style=\"margin:0\">\n      <img src=\"/ahv/assets/img/AHV-Mindfulness-Poster.webp\" alt=\"Historical Mindfulness Retreat poster: June 26–30, 2014, four nights and five days\" width=\"300\" height=\"250\" loading=\"lazy\" style=\"width:100%;max-width:300px;height:auto;display:block;border-radius:4px\">\n    </figure>\n  </div>\n\n  <section id=\"coach\" aria-labelledby=\"coach-h\" style=\"padding-top:32px;border-top:1px solid #E9E2D3;margin-top:32px\">\n    <h2 id=\"coach-h\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.22;margin:0 0 20px;text-wrap:balance\">{{ coachHeading }}</h2>\n    <div data-profile=\"coach\" style=\"display:flex;flex-direction:column;gap:14px\">\n      <img src=\"{{ coach.image }}\" alt=\"{{ coach.alt }}\" width=\"140\" height=\"121\" loading=\"lazy\" style=\"width:140px;height:auto;display:block;border-radius:4px\">\n      <div>\n        <h3 style=\"font-family:'Marcellus',serif;font-size:22px;line-height:1.25;margin:0 0 10px\">{{ coach.name }}</h3>\n        <sc-for list=\"{{ coach.paragraphs }}\" as=\"p\" hint-placeholder-count=\"1\"><p style=\"margin:0 0 12px;font-size:17px\">{{ p }}</p></sc-for>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"experts\" aria-labelledby=\"experts-h\" style=\"padding-top:32px;border-top:1px solid #E9E2D3;margin-top:32px\">\n    <h2 id=\"experts-h\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.22;margin:0 0 20px;text-wrap:balance\">{{ expertsHeading }}</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0\">\n      <sc-for list=\"{{ experts }}\" as=\"e\" hint-placeholder-count=\"6\">\n        <li data-profile=\"expert\" style=\"display:flex;flex-direction:column;gap:14px;padding:24px 0;border-top:1px solid #E0D7C4\">\n          <img src=\"{{ e.image }}\" alt=\"{{ e.alt }}\" width=\"140\" height=\"121\" loading=\"lazy\" style=\"width:140px;height:auto;display:block;border-radius:4px\">\n          <div>\n            <h3 style=\"font-family:'Marcellus',serif;font-size:22px;line-height:1.25;margin:0 0 4px\">{{ e.name }}</h3>\n            <div data-role=\"true\" style=\"font-weight:700;font-size:15.5px;color:#8F6212;margin:0 0 12px;line-height:1.5\">{{ e.role }}</div>\n            <sc-for list=\"{{ e.paragraphs }}\" as=\"p\" hint-placeholder-count=\"1\"><p style=\"margin:0 0 12px;font-size:17px\">{{ p }}</p></sc-for>\n          </div>\n        </li>\n      </sc-for>\n    </ul>\n  </section>\n</article>\n\n<nav id=\"related\" aria-labelledby=\"related-h\" style=\"width:min(1220px,94%);margin:40px auto 0;padding:32px 0 56px;border-top:1px solid #E9E2D3\">\n  <h2 id=\"related-h\" style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.2;margin:0 0 22px\">{{ relatedHeading }}</h2>\n  <div style=\"display:grid;grid-template-columns:1fr;gap:28px\">\n    <sc-for list=\"{{ groups }}\" as=\"g\" hint-placeholder-count=\"5\">\n      <section aria-labelledby=\"{{ g.hid }}\">\n        <h3 id=\"{{ g.hid }}\" style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;font-family:'Mulish',sans-serif;margin:0 0 6px\">{{ g.label }}</h3>\n        <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n          <sc-for list=\"{{ g.links }}\" as=\"k\" hint-placeholder-count=\"2\">\n            <li style=\"border-bottom:1px solid #E0D7C4\"><a href=\"{{ k.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:48px;padding:6px 0;font-size:16.5px;font-weight:600;line-height:1.4\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ k.label }}</span></a></li>\n          </sc-for>\n        </ul>\n      </section>\n    </sc-for>\n  </div>\n</nav>\n</main>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_MINDFULNESS || { sections: [], profiles: [], relatedGroups: [], relatedHeading: '', coachHeading: '', expertsHeading: '' };\n    const A = 'https://ayurvedichealingvillage.com';\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      s0: D.sections[0] || { heading: '', paragraphs: [] },\n      coachHeading: D.coachHeading, coach: D.profiles[0] || { name: '', paragraphs: [], image: '', alt: '' },\n      expertsHeading: D.expertsHeading, experts: D.profiles.slice(1),\n      relatedHeading: D.relatedHeading,\n      groups: D.relatedGroups.map((g, i) => ({ ...g, hid: 'related-g' + i, links: g.links.map(l => ({ ...l, url: A + l.href })) }))\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/mindfulness-retreat-data.js"]}