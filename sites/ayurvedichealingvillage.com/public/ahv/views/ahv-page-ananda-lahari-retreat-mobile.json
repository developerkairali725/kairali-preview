0px;background:#fff;border:1px solid #C1882C;border-left:6px solid #C1882C;border-radius:4px;padding:16px 18px\">\n    <p style=\"margin:0;font-size:17px;line-height:1.6;color:#2A2118\">This is a past retreat. The description below is retained from the original retreat page. There are no current dates or bookings for this retreat.</p>\n    <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:4px;font-weight:700;font-size:15.5px\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>Past Retreats</a>\n  </div>\n</section>\n<img src=\"/ahv/assets/img/AHV-Ananda-Landscape.png\" alt=\"Palm trees and fields seen from above.\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block\">\n\n<article aria-label=\"Historical retreat description\" style=\"width:min(1220px,94%);margin:0 auto;padding:36px 0 0\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;margin-bottom:8px\">Historical retreat description</div>\n  <section id=\"overview\" aria-labelledby=\"overview-h\">\n    <h2 id=\"overview-h\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.22;margin:0 0 16px;text-wrap:balance\">{{ s0.heading }}</h2>\n    <sc-for list=\"{{ s0.paragraphs }}\" as=\"p\" hint-placeholder-count=\"3\"><p style=\"margin:0 0 14px;font-size:17px\">{{ p }}</p></sc-for>\n    <figure style=\"margin:8px 0 0\">\n      <img src=\"/ahv/assets/img/AHV-Ananda-Alcohol-Free.jpg\" alt=\"Historical retreat artwork reading Alcohol Free.\" width=\"450\" height=\"400\" loading=\"lazy\" style=\"width:100%;max-width:450px;height:auto;display:block;border-radius:4px\">\n    </figure>\n  </section>\n  <sc-for list=\"{{ rest }}\" as=\"s\" hint-placeholder-count=\"5\">\n    <section id=\"{{ s.id }}\" aria-labelledby=\"{{ s.hid }}\" style=\"padding-top:32px;border-top:1px solid #E9E2D3;margin-top:32px;display:flex;flex-direction:column;gap:18px\">\n      <h2 id=\"{{ s.hid }}\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.22;text-wrap:balance\">{{ s.heading }}</h2>\n      <sc-if value=\"{{ s.hasImage }}\" hint-placeholder-val=\"{{ false }}\">\n        <img src=\"{{ s.image }}\" alt=\"{{ s.alt }}\" width=\"{{ s.width }}\" height=\"{{ s.height }}\" loading=\"lazy\" style=\"width:100%;max-width:{{ s.maxW }};height:auto;display:block;border-radius:4px\">\n      </sc-if>\n      <div>\n        <sc-for list=\"{{ s.paragraphs }}\" as=\"p\" hint-placeholder-count=\"2\"><p style=\"margin:0 0 14px;font-size:17px\">{{ p }}</p></sc-for>\n        <sc-if value=\"{{ s.hasList }}\" hint-placeholder-val=\"{{ false }}\">\n          <ul style=\"margin:6px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n            <sc-for list=\"{{ s.list }}\" as=\"it\" hint-placeholder-count=\"13\"><li style=\"display:flex;gap:12px;padding:11px 0;border-bottom:1px solid #E0D7C4;font-size:17px;line-height:1.55\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ it }}</span></li></sc-for>\n          </ul>\n        </sc-if>\n      </div>\n    </section>\n  </sc-for>\n</article>\n\n<section id=\"current\" aria-labelledby=\"current-h\" style=\"margin-top:44px;padding:36px 0;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;flex-direction:column;gap:18px\">\n    <h2 id=\"current-h\" style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.2\">Explore current programmes</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px\">\n      <sc-for list=\"{{ currentLinks }}\" as=\"k\" hint-placeholder-count=\"2\">\n        <li><a href=\"{{ k.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;justify-content:center;min-height:48px;padding:6px 16px;border:1.5px solid #006038;border-radius:4px;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:#006038;text-align:center;line-height:1.35\" style-hover=\"background:#006038;color:#F7F4EA;text-decoration:none\">{{ k.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n</section>\n\n<nav aria-label=\"More from Kairali\" style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 56px;display:flex;flex-direction:column;align-items:center;gap:4px\">\n  <sc-for list=\"{{ footerLinks }}\" as=\"f\" hint-placeholder-count=\"3\">\n    <a href=\"{{ f.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">{{ f.label }}</a>\n  </sc-for>\n</nav>\n</main>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  componentDidMount() {\n    document.documentElement.lang = 'en-US';\n    [['en', 'https://ayurvedichealingvillage.com/ananda-lahari-yoga-and-ayurveda-retreat/'], ['de', 'https://ayurvedichealingvillage.com/de/ananda-lahari-yoga-und-ayurveda-retreat/'], ['fr', 'https://ayurvedichealingvillage.com/fr/retraite-ananda-lahari-yoga-et-ayurveda/']].forEach(([hl, href]) => {\n      if (!document.querySelector('link[rel=\"alternate\"][hreflang=\"' + hl + '\"]')) { const l = document.createElement('link'); l.rel = 'alternate'; l.hreflang = hl; l.href = href; document.head.appendChild(l); }\n    });\n  }\n  renderVals() {\n    const D = window.AHV_ANANDA || { sections: [], currentLinks: [], footerLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    const abs = (l) => ({ ...l, url: A + l.href });\n    const secs = D.sections.map(s => ({ ...s, hid: s.id + '-h', hasImage: !!s.image, hasList: !!(s.list && s.list.length), maxW: (s.width || 832) + 'px' }));\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      s0: secs[0] || { heading: '', paragraphs: [] },\n      rest: secs.slice(1),\n      currentLinks: D.currentLinks.map(abs), footerLinks: D.footerLinks.map(abs)\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/ananda-retreat-data.js"]}