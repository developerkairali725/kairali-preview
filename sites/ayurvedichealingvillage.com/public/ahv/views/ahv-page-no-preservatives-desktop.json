{"id":"ahv-page-no-preservatives-desktop","file":"AHV Page No Preservatives Desktop.dc.html","sourceSha256":"482bdd4eee044e536e48938d4061a1d7a585fa21225e8471deb73faa199f723d","variant":"desktop","template":"\n<helmet>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\" />\n<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;600;700&display=swap\" rel=\"stylesheet\" />\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: #EDE8DA; font-family: Mulish, system-ui, sans-serif; color: #2A2118; -webkit-font-smoothing: antialiased; }\n  a { color: #006038; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }\n  a:hover { color: #004226; }\n  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }\n</style>\n</helmet>\n\n<div style=\"width: 100%; margin: 0 auto; background: #F7F4EA; background-image: repeating-linear-gradient(0deg, rgba(42,33,24,0.014) 0 1px, rgba(0,0,0,0) 1px 4px); overflow-x: hidden;\">\n\n  <dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n\n  <main>\n    <section style=\"padding: 44px 0 0;\">\n      <div style=\"width: min(1220px, 94%); margin: 0 auto;\">\n        <nav aria-label=\"Breadcrumb\" style=\"font-size: 13.5px; line-height: 1.6; color: #75695A; display: flex; flex-wrap: wrap; align-items: center; gap: 10px;\">\n          <a href=\"https://ayurvedichealingvillage.com/\" style=\"min-height: 44px; min-width: 44px; display: inline-flex; align-items: center; padding: 10px 8px; margin-left: -8px;\">Home</a>\n          <span aria-hidden=\"true\" style=\"color: #C9BFA8;\">·</span>\n          <span aria-current=\"page\" style=\"color: #514A3F;\">No Preservatives</span>\n          <sc-if value=\"{{ showDraft }}\" hint-placeholder-val=\"{{ true }}\"><span style=\"font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #8F6212; border: 1px solid #E0D7C4; border-radius: 4px; padding: 3px 7px; background: #FFFFFF;\">Breadcrumb provisional — awaiting sitemap-final.json</span></sc-if>\n        </nav>\n\n        <p style=\"margin: 34px 0 0; font-size: 12.5px; line-height: 1.5; letter-spacing: 2.6px; text-transform: uppercase; color: #8F6212; font-weight: 600;\">Kairali — The Ayurvedic Healing Village · Since 1908</p>\n\n        <h1 style=\"margin: 18px 0 0; font-family: Marcellus, serif; font-weight: 400; font-size: 58px; line-height: 1.12; letter-spacing: 0.2px; color: #2A2118; max-width: 20ch; text-wrap: pretty;\">No Preservatives</h1>\n\n        <div style=\"margin: 30px 0 0; border-left: 2px solid #C1882C; padding-left: 22px; max-width: 62ch;\">\n          <p style=\"margin: 0; font-size: 20px; line-height: 1.62; color: #514A3F; text-wrap: pretty;\">Nothing served at Kairali is preserved, canned or chemically stabilised. Meals are cooked the day they are eaten, from produce picked on the property. This page sets out the reasoning behind that rule.</p>\n          <sc-if value=\"{{ showDraft }}\" hint-placeholder-val=\"{{ true }}\"><p style=\"margin: 14px 0 0; font-size: 11.5px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: #8F6212;\">Draft standfirst — approve or replace</p></sc-if>\n        </div>\n      </div>\n\n      <sc-if value=\"{{ fullBleed }}\" hint-placeholder-val=\"{{ true }}\">\n        <div style=\"overflow:hidden;margin: 52px 0 0; width: 100%; height: 400px; background: #E0D7C4; background-image: repeating-linear-gradient(135deg, rgba(90,68,32,0.05) 0 1px, rgba(0,0,0,0) 1px 9px); border-top: 1px solid #E9E2D3; border-bottom: 1px solid #E9E2D3; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center; padding: 0 24px;\"><img src=\"/ahv/assets/img/gallery/ee7d129f97f1b7e211572def4f1bbae675da2b34eaf75e3b76df1d57f01a63bd.webp\" alt=\"Aerial view of paddy fields and coconut palms in the Kerala countryside around the hospital\" loading=\"eager\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n      </sc-if>\n      <sc-if value=\"{{ contained }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"overflow:hidden;width: min(1220px, 94%); margin: 52px auto 0; height: 400px; border-radius: 4px; background: #E0D7C4; background-image: repeating-linear-gradient(135deg, rgba(90,68,32,0.05) 0 1px, rgba(0,0,0,0) 1px 9px); border: 1px solid #E9E2D3; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center; padding: 0 24px;\"><img src=\"/ahv/assets/img/gallery/ee7d129f97f1b7e211572def4f1bbae675da2b34eaf75e3b76df1d57f01a63bd.webp\" alt=\"Aerial view of paddy fields and coconut palms in the Kerala countryside around the hospital\" loading=\"eager\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n      </sc-if>\n    </section>\n\n    <div style=\"width: min(1220px, 94%); margin: 0 auto; padding: 76px 0 84px; display: grid; grid-template-columns: minmax(0, 68ch) minmax(240px, 300px); gap: 96px; justify-content: space-between; align-items: start;\">\n\n      <article style=\"min-width: 0;\">\n        <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 30px; line-height: 1.28; color: #2A2118; max-width: 42ch; text-wrap: pretty;\">Kairali – The Ayurvedic Healing Village: Advocating Fresh, Natural Foods for Holistic Wellness</h2>\n        <p style=\"margin: 22px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; max-width: 66ch; text-wrap: pretty;\">At <span style=\"font-weight: 700;\">Kairali – The Ayurvedic Healing Village</span>, the importance of wholesome, fresh, and unadulterated food is deeply rooted in its Ayurvedic philosophy. Food is not just nourishment for the body; it is a vital source of energy and balance for the mind and soul. Central to Ayurveda is the concept of <span style=\"font-weight: 700;\">‘prana’</span>, the life force present in fresh food, which is essential for maintaining health and vitality. Preserved and canned foods, however, lack this vital energy and fail to meet the body’s holistic nutritional needs.</p>\n\n        <figure style=\"margin: 44px 0 0;\">\n          <div role=\"img\" aria-label=\"No Preservatives\" style=\"overflow:hidden;height: 340px; border-radius: 4px; background: #E0D7C4; background-image: repeating-linear-gradient(135deg, rgba(90,68,32,0.05) 0 1px, rgba(0,0,0,0) 1px 9px); border: 1px solid #E9E2D3; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center; padding: 0 24px;\"><img src=\"/ahv/assets/img/reader25b/6ca1dd59833947b993ff0e64200c346f975c79456219177733004976c3da579d.webp\" alt=\"No Preservatives\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n        </figure>\n\n        <div style=\"margin: 56px 0 0; border-top: 1px solid #E9E2D3; padding-top: 34px;\">\n          <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 30px; line-height: 1.28; color: #2A2118; max-width: 42ch; text-wrap: pretty;\">The Drawbacks of Preserved and Canned Foods</h2>\n          <p style=\"margin: 22px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; max-width: 66ch; text-wrap: pretty;\">Preserved and canned foods, while convenient, often lose their nutritional integrity and vitality during processing. Packed with preservatives and artificial additives, these foods are devoid of the natural essence required to sustain optimal health. According to Ayurveda, such foods disturb the body’s natural equilibrium by aggravating the doshas, leading to imbalances that manifest as obesity, digestive disorders, and other chronic ailments.</p>\n          <p style=\"margin: 22px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; max-width: 66ch;\">Key issues with preserved and canned foods include:</p>\n          <ol style=\"margin: 26px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 22px; max-width: 66ch;\">\n            <li style=\"display: flex; gap: 18px; align-items: baseline;\">\n              <span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 22px; color: #C1882C; min-width: 22px;\">1</span>\n              <span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Loss of Vitality and Nutrients</span>: The processing of food strips it of essential nutrients and prana, reducing its ability to nourish the body effectively.</span>\n            </li>\n            <li style=\"display: flex; gap: 18px; align-items: baseline;\">\n              <span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 22px; color: #C1882C; min-width: 22px;\">2</span>\n              <span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Aggravation of Doshas</span>: Consuming such foods disrupts the balance of Vata, Pitta, and Kapha doshas, which are vital for physical and mental harmony.</span>\n            </li>\n            <li style=\"display: flex; gap: 18px; align-items: baseline;\">\n              <span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 22px; color: #C1882C; min-width: 22px;\">3</span>\n              <span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Adulteration and Health Risks</span>: The presence of preservatives and chemicals can lead to toxicity in the body over time, impairing metabolism and overall health.</span>\n            </li>\n            <li style=\"display: flex; gap: 18px; align-items: baseline;\">\n              <span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 22px; color: #C1882C; min-width: 22px;\">4</span>\n              <span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Digestive Challenges</span>: These foods often lack the natural fiber and enzymes needed to support proper digestion, leading to stagnation and inefficiency in nutrient absorption.</span>\n            </li>\n          </ol>\n        </div>\n\n        <div style=\"margin: 56px 0 0; border-top: 1px solid #E9E2D3; padding-top: 34px;\">\n          <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 30px; line-height: 1.28; color: #2A2118; max-width: 42ch; text-wrap: pretty;\">Kairali’s Commitment to Freshness and Purity</h2>\n          <p style=\"margin: 22px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; max-width: 66ch; text-wrap: pretty;\">At Kairali, food is regarded as a cornerstone of wellness. The Ayurvedic Healing Village strongly advocates for the consumption of fresh, natural, and unprocessed foods, aligning with the principles of Ayurveda that emphasize purity and balance. By promoting a diet rich in seasonal fruits, vegetables, whole grains, and freshly prepared meals, Kairali ensures that guests receive the nourishment they need for a healthy and balanced life.</p>\n        </div>\n\n        <div style=\"margin: 56px 0 0; border-top: 1px solid #E9E2D3; padding-top: 34px;\">\n          <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 30px; line-height: 1.28; color: #2A2118; max-width: 42ch;\">Why Fresh Food Matters:</h2>\n          <ol style=\"margin: 26px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 22px; max-width: 66ch;\">\n            <li style=\"display: flex; gap: 18px; align-items: baseline;\">\n              <span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 22px; color: #C1882C; min-width: 22px;\">1</span>\n              <span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Restores Balance</span>: Fresh foods help maintain the dosha balance, promoting optimal physical and mental health.</span>\n            </li>\n            <li style=\"display: flex; gap: 18px; align-items: baseline;\">\n              <span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 22px; color: #C1882C; min-width: 22px;\">2</span>\n              <span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Enhances Vitality</span>: Foods rich in prana energize the body, improve digestion, and support a stronger immune system.</span>\n            </li>\n            <li style=\"display: flex; gap: 18px; align-items: baseline;\">\n              <span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 22px; color: #C1882C; min-width: 22px;\">3</span>\n              <span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Purity for the Body and Mind</span>: Fresh, wholesome meals detoxify the body, calm the mind, and elevate the spirit, aligning with Ayurveda’s holistic approach to well-being.</span>\n            </li>\n          </ol>\n        </div>\n\n        <div style=\"margin: 56px 0 0; border-top: 1px solid #E9E2D3; padding-top: 34px;\">\n          <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 30px; line-height: 1.28; color: #2A2118; max-width: 42ch; text-wrap: pretty;\">A Lifestyle Free from Preservatives</h2>\n          <p style=\"margin: 22px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; max-width: 66ch; text-wrap: pretty;\">Kairali’s kitchen practices align with its ethos of purity and simplicity. Meals prepared at the retreat use fresh, locally sourced ingredients, free from preservatives and artificial additives. This approach not only supports physical health but also fosters mindfulness and a deeper connection to the food we consume.</p>\n          <p style=\"margin: 22px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; max-width: 66ch; text-wrap: pretty;\">In addition to offering a fresh food philosophy, Kairali encourages guests to adopt these habits in their daily lives. By avoiding preserved and canned foods, individuals can break free from the cycle of poor nutrition, regain energy, and live a malady-free life.</p>\n        </div>\n\n        <div style=\"margin: 56px 0 0; border-top: 1px solid #E9E2D3; padding-top: 34px;\">\n          <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 30px; line-height: 1.28; color: #2A2118; max-width: 42ch; text-wrap: pretty;\">A Commitment to Holistic Health</h2>\n          <p style=\"margin: 22px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; max-width: 66ch; text-wrap: pretty;\"><span style=\"font-weight: 700;\">Kairali – The Ayurvedic Healing Village</span> serves as a beacon of Ayurvedic wisdom, inspiring a lifestyle centred around balance, purity, and well-being. Its promotion of fresh, natural foods underscores its dedication to holistic health, empowering individuals to make choices that nurture their body, mind, and soul. By embracing the power of fresh foods, Kairali helps its guests embark on a journey of rejuvenation and vitality, creating a foundation for a healthier and more fulfilling life.</p>\n        </div>\n      </article>\n\n      <aside aria-labelledby=\"house-rules-heading\" style=\"min-width: 0; position: sticky; top: 32px; background: #FFFFFF; border: 1px solid #E9E2D3; border-radius: 4px; padding: 28px 26px 30px;\">\n        <h2 id=\"house-rules-heading\" style=\"margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 2.4px; text-transform: uppercase; color: #8F6212;\">House rules of the property</h2>\n        <p style=\"margin: 14px 0 0; font-size: 15.5px; line-height: 1.65; color: #75695A;\">Eight standing rules govern daily life here. Each is explained on its own page.</p>\n        <ul style=\"margin: 24px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 2px; border-top: 1px solid #E9E2D3;\">\n          <li style=\"border-bottom: 1px solid #E9E2D3;\"><a href=\"https://ayurvedichealingvillage.com/no-smoking/\" style=\"display: flex; gap: 12px; align-items: baseline; min-height: 44px; padding: 12px 2px; font-size: 16.5px; line-height: 1.5; text-decoration: none;\" style-hover=\"background: #F7F4EA; color: #004226;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>No Smoking</span></a></li>\n          <li style=\"border-bottom: 1px solid #E9E2D3;\"><a href=\"https://ayurvedichealingvillage.com/alcohol-free/\" style=\"display: flex; gap: 12px; align-items: baseline; min-height: 44px; padding: 12px 2px; font-size: 16.5px; line-height: 1.5; text-decoration: none;\" style-hover=\"background: #F7F4EA; color: #004226;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>Alcohol Free</span></a></li>\n          <li style=\"border-bottom: 1px solid #E9E2D3;\"><a href=\"https://ayurvedichealingvillage.com/no-caffeine/\" style=\"display: flex; gap: 12px; align-items: baseline; min-height: 44px; padding: 12px 2px; font-size: 16.5px; line-height: 1.5; text-decoration: none;\" style-hover=\"background: #F7F4EA; color: #004226;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>No Caffeine</span></a></li>\n          <li style=\"border-bottom: 1px solid #E9E2D3;\"><span aria-current=\"page\" style=\"display: flex; gap: 12px; align-items: baseline; min-height: 44px; padding: 12px 2px; font-size: 16.5px; line-height: 1.5; color: #2A2118; font-weight: 700; background: #F7F4EA;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>No Preservatives</span></span></li>\n          <li style=\"border-bottom: 1px solid #E9E2D3;\"><a href=\"https://ayurvedichealingvillage.com/no-refridgeration/\" style=\"display: flex; gap: 12px; align-items: baseline; min-height: 44px; padding: 12px 2px; font-size: 16.5px; line-height: 1.5; text-decoration: none;\" style-hover=\"background: #F7F4EA; color: #004226;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>No Refridgeration</span></a></li>\n          <li style=\"border-bottom: 1px solid #E9E2D3;\"><a href=\"https://ayurvedichealingvillage.com/vegetarian/\" style=\"display: flex; gap: 12px; align-items: baseline; min-height: 44px; padding: 12px 2px; font-size: 16.5px; line-height: 1.5; text-decoration: none;\" style-hover=\"background: #F7F4EA; color: #004226;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>Vegetarian</span></a></li>\n          <li style=\"border-bottom: 1px solid #E9E2D3;\"><a href=\"https://ayurvedichealingvillage.com/organic-farm/\" style=\"display: flex; gap: 12px; align-items: baseline; min-height: 44px; padding: 12px 2px; font-size: 16.5px; line-height: 1.5; text-decoration: none;\" style-hover=\"background: #F7F4EA; color: #004226;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>Organic Farming</span></a></li>\n          <li style=\"border-bottom: 1px solid #E9E2D3;\"><a href=\"https://ayurvedichealingvillage.com/animal-husbandry/\" style=\"display: flex; gap: 12px; align-items: baseline; min-height: 44px; padding: 12px 2px; font-size: 16.5px; line-height: 1.5; text-decoration: none;\" style-hover=\"background: #F7F4EA; color: #004226;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>Animal Husbandry</span></a></li>\n        </ul>\n        <div style=\"margin: 26px 0 0; border-top: 1px solid #E9E2D3; padding-top: 22px;\">\n          <h3 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 19px; line-height: 1.35; color: #2A2118;\">A question about the diet?</h3>\n          <p style=\"margin: 10px 0 0; font-size: 15.5px; line-height: 1.65; color: #514A3F;\">Write to the patient care team before admission.</p>\n          <a href=\"mailto:info@kairali.com\" style=\"display: inline-flex; align-items: center; min-height: 44px; margin-top: 10px; font-size: 16px;\">info@kairali.com</a>\n        </div>\n      </aside>\n    </div>\n\n    <section aria-labelledby=\"closing-heading\" style=\"border-top: 1px solid #E9E2D3; border-bottom: 1px solid #E9E2D3; margin-top: 56px; background: #FFFFFF; background-image: repeating-linear-gradient(45deg, rgba(193,136,44,0.055) 0 1px, rgba(0,0,0,0) 1px 7px); padding: 64px 3%;\">\n      <div style=\"max-width: 760px; margin: 0 auto; text-align: center;\">\n        <ul style=\"margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 40px; text-align: left; max-width: 620px; margin-inline: auto;\">\n          <li style=\"display: flex; gap: 12px; align-items: baseline; font-size: 16.5px; line-height: 1.55; color: #2A2118;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 12px;\">◆</span><span>NABH Certified Hospital</span></li>\n          <li style=\"display: flex; gap: 12px; align-items: baseline; font-size: 16.5px; line-height: 1.55; color: #2A2118;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 12px;\">◆</span><span>118+ Years Heritage</span></li>\n          <li style=\"display: flex; gap: 12px; align-items: baseline; font-size: 16.5px; line-height: 1.55; color: #2A2118;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 12px;\">◆</span><span>Individualised Programmes</span></li>\n          <li style=\"display: flex; gap: 12px; align-items: baseline; font-size: 16.5px; line-height: 1.55; color: #2A2118;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 12px;\">◆</span><span>World Luxury Award Winner</span></li>\n        </ul>\n        <h2 id=\"closing-heading\" style=\"margin: 40px 0 0; font-family: Marcellus, serif; font-weight: 400; font-size: 26px; line-height: 1.3; color: #2A2118;\">Not sure which programme fits?</h2>\n        <p style=\"margin: 14px auto 0; font-size: 16.5px; line-height: 1.7; color: #514A3F; max-width: 56ch;\">Share your goal in your own words — the patient care team or an Ayurvedic doctor will point you to the right programme.</p>\n        <div style=\"margin: 32px 0 0; display: flex; flex-wrap: wrap; gap: 14px; justify-content: center;\">\n          <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" style=\"display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 21px; border-radius: 4px; background: #EEB41E; color: #2A2118; border: 1.5px solid #EEB41E; font-weight: 700; font-size: 14px; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none;\" style-hover=\"background: #E0A70F; border-color: #E0A70F;\">Free Doctor Consultation</a>\n          <a href=\"https://wa.me/919289838797\" style=\"display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 21px; border-radius: 4px; background: rgba(0,0,0,0); color: #006038; border: 1.5px solid #006038; font-weight: 700; font-size: 14px; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none;\" style-hover=\"background: #006038; color: #FFFFFF;\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp Patient Care</a>\n          <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 21px; border-radius: 4px; background: rgba(0,0,0,0); color: #5A4420; border: 1.5px solid #5A4420; font-weight: 700; font-size: 14px; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none;\" style-hover=\"background: #5A4420; color: #FFFFFF;\">Enquire Now</a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n\n","logic":"\nclass Component extends DCLogic {\n  renderVals() {\n    const band = this.props.heroBand ?? \"full-bleed\";\n    return {\n      showDraft: this.props.showDraftMarkers ?? true,\n      fullBleed: band === \"full-bleed\",\n      contained: band !== \"full-bleed\"\n    };\n  }\n}\n","props":"{\"showDraftMarkers\":{\"editor\":\"boolean\",\"default\":false,\"tsType\":\"boolean\",\"section\":\"Review\"},\"heroBand\":{\"editor\":\"enum\",\"options\":[\"full-bleed\",\"contained\"],\"default\":\"full-bleed\",\"tsType\":\"string\",\"section\":\"Hero\"}}","scripts":[]}