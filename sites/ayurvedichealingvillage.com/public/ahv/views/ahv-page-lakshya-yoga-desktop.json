ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n        <sc-for list=\"{{ D.included.items }}\" as=\"it\" hint-placeholder-count=\"6\"><li style=\"display:flex;gap:14px;padding:12px 0;border-bottom:1px solid #E0D7C4;font-size:17.5px;line-height:1.6\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ it }}</span></li></sc-for>\n      </ul>\n    </section>\n    <section id=\"extras\" aria-labelledby=\"extras-h\">\n      <h2 id=\"extras-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Optional Extras:</h2>\n      <ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n        <sc-for list=\"{{ D.extras.items }}\" as=\"it\" hint-placeholder-count=\"5\"><li style=\"display:flex;gap:14px;padding:12px 0;border-bottom:1px solid #E0D7C4;font-size:17.5px;line-height:1.6\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ it }}</span></li></sc-for>\n      </ul>\n    </section>\n  </div>\n\n  <section id=\"arrangements\" aria-labelledby=\"arrangements-h\" style=\"padding-top:48px;border-top:1px solid #E9E2D3;margin-top:48px;max-width:70ch\">\n    <h2 id=\"arrangements-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Historical retreat arrangements</h2>\n    <sc-for list=\"{{ D.arrangements.paragraphs }}\" as=\"p\" hint-placeholder-count=\"4\"><p style=\"margin:0 0 14px\">{{ p }}</p></sc-for>\n  </section>\n\n  <section id=\"teacher\" aria-labelledby=\"teacher-h\" style=\"padding-top:48px;border-top:1px solid #E9E2D3;margin-top:48px;display:grid;grid-template-columns:150px minmax(0,1fr);gap:24px 40px;align-items:start\">\n    <div style=\"display:flex;flex-direction:column;gap:16px;align-items:flex-start\">\n      <img src=\"/ahv/assets/img/AHV-Lakshya-04.jpg\" alt=\"A woman holding her hands together.\" width=\"150\" height=\"150\" loading=\"lazy\" style=\"width:100%;max-width:150px;height:auto;display:block;border-radius:4px\">\n      <img src=\"/ahv/assets/img/AHV-Lakshya-05.png\" alt=\"Lakshya Yoga logo.\" width=\"105\" height=\"100\" loading=\"lazy\" style=\"width:100%;max-width:105px;height:auto;display:block\">\n    </div>\n    <div style=\"max-width:70ch\">\n      <h2 id=\"teacher-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Teacher</h2>\n      <sc-for list=\"{{ D.teacher.paragraphs }}\" as=\"p\" hint-placeholder-count=\"2\"><p style=\"margin:0 0 16px\">{{ p }}</p></sc-for>\n      <a href=\"http://www.lakshyayoga.com/\" rel=\"noopener\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;font-weight:700;font-size:15.5px\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>www.lakshyayoga.com</a>\n    </div>\n  </section>\n</article>\n\n<section id=\"current\" aria-labelledby=\"current-h\" style=\"margin-top:64px;padding:48px 0;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px 48px;align-items:center\">\n    <h2 id=\"current-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);line-height:1.2\">Explore current programmes</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:12px\">\n      <sc-for list=\"{{ currentLinks }}\" as=\"k\" hint-placeholder-count=\"2\">\n        <li><a href=\"{{ k.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border:1.5px solid #006038;border-radius:4px;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;color:#006038\" style-hover=\"background:#006038;color:#F7F4EA;text-decoration:none\">{{ k.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n</section>\n\n<section id=\"related\" aria-labelledby=\"related-h\" style=\"width:min(1220px,94%);margin:0 auto;padding:56px 0 64px\">\n  <h2 id=\"related-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);margin:0 0 18px\">Knowledge Centre</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(340px,100%),1fr));gap:0 32px;border-top:1px solid #E9E2D3\">\n    <sc-for list=\"{{ relatedLinks }}\" as=\"r\" hint-placeholder-count=\"9\">\n      <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118;line-height:1.4\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n    </sc-for>\n  </ul>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:44px;display:flex;justify-content:center;gap:8px 28px;flex-wrap:wrap;border-top:1px solid #E9E2D3;padding-top:22px\">\n    <sc-for list=\"{{ footerLinks }}\" as=\"f\" hint-placeholder-count=\"3\">\n      <a href=\"{{ f.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">{{ f.label }}</a>\n    </sc-for>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_LAKSHYA || { description: { paragraphs: [] }, schedule: { items: [], note: '' }, workshops: { rows: [] }, included: { items: [] }, extras: { items: [] }, arrangements: { paragraphs: [] }, teacher: { paragraphs: [] }, relatedLinks: [], currentLinks: [], footerLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    const abs = (l) => ({ ...l, url: A + l.href });\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      D,\n      workshopRows: (D.workshops.rows || []).map(r => ({ name: r[0], text: r[1] })),\n      relatedLinks: (D.relatedLinks || []).map(abs), currentLinks: (D.currentLinks || []).map(abs), footerLinks: (D.footerLinks || []).map(abs)\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/lakshya-yoga-data.js"]}