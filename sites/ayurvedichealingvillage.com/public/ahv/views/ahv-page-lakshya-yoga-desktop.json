gvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:6px;font-weight:700;font-size:15.5px\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>Past Retreats</a>\n    </div>\n  </div>\n  <img src=\"/ahv/assets/img/AHV-Lakshya-01.jpg\" alt=\"An Ayurvedic treatment with a herbal preparation.\" width=\"772\" height=\"289\" style=\"width:100%;max-width:772px;height:auto;display:block;border-radius:4px;margin-top:40px\">\n</section>\n\n<article aria-label=\"Historical retreat description\" style=\"width:min(1220px,94%);margin:0 auto;padding:24px 0 0\">\n  <section id=\"description\" aria-labelledby=\"description-h\" style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,560px);gap:32px 64px;align-items:start\">\n    <div style=\"max-width:70ch\">\n      <h2 id=\"description-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Historical retreat description</h2>\n      <sc-for list=\"{{ D.description.paragraphs }}\" as=\"p\" hint-placeholder-count=\"3\"><p style=\"margin:0 0 16px\">{{ p }}</p></sc-for>\n    </div>\n    <img src=\"/ahv/assets/img/AHV-Lakshya-02.jpg\" alt=\"A person practising yoga beside a pond and cottages.\" width=\"560\" height=\"280\" loading=\"lazy\" style=\"width:100%;max-width:560px;height:auto;display:block;border-radius:4px;justify-self:end;margin-top:8px\">\n  </section>\n  <img src=\"/ahv/assets/img/AHV-Lakshya-03.jpg\" alt=\"A collage of cottages, yoga practice and an Ayurvedic treatment.\" width=\"1024\" height=\"372\" loading=\"lazy\" style=\"width:100%;max-width:1024px;height:auto;display:block;border-radius:4px;margin:48px 0 0\">\n\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px 64px;padding-top:48px;border-top:1px solid #E9E2D3;margin-top:48px;align-items:start\">\n    <section id=\"schedule\" aria-labelledby=\"schedule-h\">\n      <h2 id