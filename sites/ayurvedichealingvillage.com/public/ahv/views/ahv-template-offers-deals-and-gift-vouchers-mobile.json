 "variant": "mobile",
 "template": "\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:ital,wght@0,400;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\n<style>\nbody{margin:0;background:#EDE9DC;color:#2A2118;font-family:'Mulish',sans-serif;font-size:17px;line-height:1.7}\na{color:#006038;text-decoration:underline;text-underline-offset:3px}\na:hover{color:#004226}\nh1,h2,h3,h4{font-family:'Marcellus',serif;font-weight:400;margin:0}\nul,ol{margin:0;padding:0;list-style:none}\n:focus-visible{outline:3px solid #5A4420;outline-offset:2px}\nsummary{cursor:pointer}\nsummary::-webkit-details-marker{display:none}\n@media (prefers-reduced-motion: reduce){*{transition:none !important;animation:none !important}}\n</style>\n</helmet>\n<div data-screen-label=\"Offers — Mobile 390\" style=\"width:100%;background:#F7F4EA;box-sizing:border-box;overflow:hidden\">\n\n<dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n\n<section style=\"padding:22px 20px 24px;box-sizing:border-box\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:13.5px;line-height:1.5;color:#75695A\">\n    <a href=\"https://ayurvedichealingvillage.com/\" style=\"display:inline-flex;align-items:center;min-height:44px\">← Home</a>\n    </nav>\n  <p style=\"font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase;margin:16px 0 0;line-height:1.5\">Kairali — The Ayurvedic Healing Village · Since 1908</p>\n  <h1 style=\"font-size:36px;line-height:1.12;margin:12px 0 0\">Offers &amp; Care Initiatives</h1><nav data-offer-directory aria-label=\"Offers and partnerships\" style=\"display:flex;flex-wrap:wrap;gap:12px 24px;margin:24px 0 0\"><a href=\"#m-three-journeys\" style=\"display:inline-flex;align-items:center;min-height:44px;font-weight:700\">Care &amp; Commitment</a><a href=\"/gift-vouchers/\" style=\"display:inline-flex;align-items:center;min-height:44px;font-weight:700\">Gift Vouchers — Coming Soon</a><a href=\"/our-partners/\" style=\"display:inline-flex;align-items:center;min-height:44px;font-weight:700\">Partnerships &amp; Tie-ups</a></nav>\n  <p style=\"font-size:17px;line-height:1.6;color:#514A3F;margin:16px 0 0;border-left:3px solid #C1882C;padding-left:16px\">Care initiatives at the hospital, with gift vouchers coming soon.</p>\n</section>\n\n<div style=\"overflow:hidden;width:100%;box-sizing:border-box;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;background:#E0D7C4;height:200px;display:flex;align-items:center;justify-content:center;text-align:center;padding:16px\"><img src=\"/ahv/assets/img/commercial/775c5adec97f99fbd773ee36cf4903844f79ea13635db974cf00821263818e82.webp\" alt=\"Healing at Kairali\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n\n\n<div style=\"background:#EFE9DA;border-bottom:1px solid #E9E2D3;padding:16px 20px;box-sizing:border-box\">\n  <div style=\"display:flex;flex-direction:column;gap:10px\">\n    <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" style=\"display:flex;align-items:center;justify-content:center;height:52px;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:13.5px;text-transform:uppercase;letter-spacing:1.4px;text-decoration:none;box-sizing:border-box\">Free Doctor Consultation</a>\n    <a href=\"https://wa.me/919289838797\" style=\"display:flex;align-items:center;justify-content:center;height:52px;border-radius:4px;border:1.5px solid #006038;color:#006038;font-weight:700;font-size:13.5px;text-transform:uppercase;letter-spacing:1.4px;text-decoration:none;box-sizing:border-box\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp Patient Care</a>\n  </div>\n</div>\n\n<nav aria-label=\"On this page\" style=\"border-bottom:1px solid #E9E2D3;background:#F7F4EA;box-sizing:border-box\">\n  <p style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0;padding:16px 20px 4px;box-sizing:border-box;font-size:12.5px;font-weight:700;letter-spacing:2.2px;text-transform:uppercase;color:#5A4420\">On this page <span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span></p>\n  <ul style=\"padding:0 20px 14px;box-sizing:border-box\">\n    <li><a href=\"#m-current-offers\" style=\"display:flex;align-items:center;min-height:48px;font-size:16px;text-decoration:none;border-top:1px solid #E9E2D3\">Current offers and deals</a></li>\n    <li><a href=\"#m-gift-vouchers\" style=\"display:flex;align-items:center;min-height:48px;font-size:16px;text-decoration:none;border-top:1px solid #E9E2D3\">Gift vouchers</a></li>\n    <li><a href=\"#m-a-note\" style=\"display:flex;align-items:center;min-height:48px;font-size:16px;text-decoration:none;border-top:1px solid #E9E2D3\">A Note from Kairali</a></li>\n    <li><a href=\"#m-three-journeys\" style=\"display:flex;align-items:center;min-height:48px;font-size:16px;text-decoration:none;border-top:1px solid #E9E2D3\">Three Paths</a></li>\n    <li><a href=\"#m-how-healing-begins\" style=\"display:flex;align-items:center;min-height:48px;font-size:16px;text-decoration:none;border-top:1px solid #E9E2D3\">How Healing Begins</a></li>\n  </ul>\n</nav>\n\n<main style=\"padding:28px 20px 0;box-sizing:border-box\" data-ahv-offer-cards=\"1\">\n\n  <section aria-labelledby=\"m-current-offers\">\n    <h2 id=\"m-current-offers\" style=\"font-size:27px;line-height:1.2\">Current offers and deals</h2>\n\n    <article style=\"margin:20px 0 0;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;overflow:hidden;box-sizing:border-box\">\n      <div style=\"overflow:hidden;background:#E0D7C4;height:190px;display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;box-sizing:border-box\"><img src=\"/ahv/assets/img/commercial/8b7554df0dfba8ff5a0851801f3c2a0154577ea3bd2a8b7fe2a249867ff05bcb.webp\" alt=\"Senior Wellness at Kairali\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n      <div style=\"padding:22px 20px 24px;box-sizing:border-box\">\n        <p style=\"margin:0;font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Featured offer</p>\n        <h3 style=\"font-size:24px;line-height:1.22;margin:10px 0 0\">Holistic Ayurvedic Care for Ageing Parents &amp; Senior Wellbeing</h3>\n        <p style=\"margin:12px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Compassionate Ayurvedic care designed to ease joint pain due to ageing, relieve body pain in old age, boost low energy in seniors, and gently support muscle weakness — so your loved ones can age with comfort and dignity.</p>\n        <dl style=\"margin:18px 0 0;border-top:1px solid #E9E2D3\">\n          <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:12px 0;border-bottom:1px solid #E9E2D3\">\n            <dt style=\"font-size:12px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:#75695A\">Offer value</dt>\n            <dd style=\"margin:0;font-family:'Marcellus',serif;font-size:20px;color:#2A2118;text-align:right\">Up to 20% off</dd>\n          </div>\n          <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:12px 0;border-bottom:1px solid #E9E2D3\">\n            <dt style=\"font-size:12px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:#75695A\">Minimum stay</dt>\n            <dd style=\"margin:0;font-family:'Marcellus',serif;font-size:20px;color:#2A2118;text-align:right\">3 nights</dd>\n          </div>\n        </dl>\n        <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display:flex;align-items:center;justify-content:center;height:52px;margin:18px 0 0;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:13.5px;text-transform:uppercase;letter-spacing:1.4px;text-decoration:none;box-sizing:border-box\">Enquire about this offer</a>\n      </div>\n    </article>\n\n    <div style=\"margin:18px 0 0;border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;box-sizing:border-box;overflow:hidden\">\n      <div style=\"border-bottom:1px solid #E9E2D3;padding:18px 20px\">\n        <h4 style=\"font-size:19px;line-height:1.3;margin:0\">What the offer includes</h4>\n        <ul style=\"margin:12px 0 0;display:flex;flex-direction:column;gap:8px\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Up to 20% off on select wellness programs</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>10% for 3–13 nights, 15% for 14–20 nights and 20% for 21 nights or more.</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Stays of 1–2 nights are charged at standard rates; offer savings start at 3 nights.</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Complimentary initial health consultation included</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>A priority check-in plus a personalised care briefing for your loved one — absolutely complimentary</span></li>\n        </ul>\n      </div>\n      <details style=\"border-bottom:1px solid #E9E2D3\">\n        <summary style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:10px 20px;box-sizing:border-box;font-family:'Marcellus',serif;font-size:19px;color:#2A2118;list-style:none\">Who it applies to <span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span></summary>\n        <ul style=\"padding:0 20px 18px;box-sizing:border-box;display:flex;flex-direction:column;gap:8px\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>For Seniors (60+)</span></li>\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>For Adult Children &amp; Caregivers</span></li>\n        </ul>\n      </details>\n      <details style=\"border-bottom:1px solid #E9E2D3\">\n        <summary style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:10px 20px;box-sizing:border-box;font-family:'Marcellus',serif;font-size:19px;color:#2A2118;list-style:none\">How to claim <span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span></summary>\n        <ul style=\"padding:0 20px 18px;box-sizing:border-box;display:flex;flex-direction:column;gap:8px\">\n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Ask for this offer when you enquire with our patient care team.</span></li>\n        </ul>\n      </details>\n      <details>\n        <summary style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;padding:10px 20px;box-sizing:border-box;font-family:'Marcellus',serif;font-size:19px;color:#2A2118;list-style:none\">Conditions <span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span></summary>\n        <ul style=\"padding:0 20px 18px;box-sizing:border-box;display:flex;flex-direction:column;gap:8px\">\n          \n          <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16.5px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>One offer applies per booking: if more than one offer fits your stay, we apply the one that gives you the best saving, and discounts are not added together.</span></li>\n        </ul>\n      </details>\n    </div>\n\n    <h3 style=\"font-size:22px;line-height:1.25;margin:34px 0 0;padding-top:20px;border-top:1px solid #E9E2D3\">Other current offers</h3>\n    <ul style=\"display:flex;flex-direction:column;gap:14px;margin:16px 0 0\">\n      <li style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;box-sizing:border-box;overflow:hidden\">\n        <div style=\"display:grid;grid-template-columns:110px minmax(0,1fr);gap:0;align-items:stretch\">\n          <div style=\"overflow:hidden;background:#E0D7C4;min-height:110px;display:flex;align-items:center;justify-content:center;text-align:center;padding:10px;box-sizing:border-box\"><img src=\"/ahv/assets/img/commercial/89f77332ca59e7ab6a7ea204951c3fab743488be21f624fecde06b084a846509.webp\" alt=\"Athletes and Recovery\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n          <div style=\"padding:14px 16px;box-sizing:border-box;min-width:0\">\n            <p style=\"margin:0;font-weight:700;font-size:11px;letter-spacing:2px;color:#8F6212;text-transform:uppercase\">Offer</p>\n            <h4 style=\"font-size:18px;line-height:1.3;margin:6px 0 0\">Exclusive Offer for Olympic and Paralympic Athletes – Up to 20% OFF</h4>\n            <p style=\"margin:6px 0 0;font-size:15px;line-height:1.5;color:#75695A\">10% for 3–13 nights · 15% for 14–20 nights · 20% for 21 nights or above. For all Packages. No fixed end date.</p>\n          </div>\n        </div>\n        <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display:flex;align-items:center;justify-content:center;height:52px;border-top:1px solid #E9E2D3;color:#5A4420;font-weight:700;font-size:13.5px;text-transform:uppercase;letter-spacing:1.4px;text-decoration:none;box-sizing:border-box\">Enquire Now</a>\n      </li>\n      <li style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;box-sizing:border-box;overflow:hidden\">\n        <div style=\"display:grid;grid-template-columns:110px minmax(0,1fr);gap:0;align-items:stretch\">\n          <div style=\"overflow:hidden;background:#E0D7C4;min-height:110px;display:flex;align-items:center;justify-content:center;text-align:center;padding:10px;box-sizing:border-box\"><img src=\"/ahv/assets/img/commercial/6c7db61940f19d249ee3e9df66e490e2bbf966d01d31f372cb87f5e2f5c86c58.webp\" alt=\"Wellness for Defence Personnel\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n          <div style=\"padding:14px 16px;box-sizing:border-box;min-width:0\">\n            <p style=\"margin:0;font-weight:700;font-size:11px;letter-spacing:2px;color:#8F6212;text-transform:uppercase\">Offer</p>\n            <h4 style=\"font-size:18px;line-height:1.3;margin:6px 0 0\">Defence &amp; Paramilitary Personnel get upto 20% OFF</h4>\n            <p style=\"margin:6px 0 0;font-size:15px;line-height:1.5;color:#75695A\">10% for 3–13 nights · 15% for 14–20 nights · 20% for 21 nights or above. For serving and retired members of India’s Armed Forces, Central Armed Police Forces (CAPFs) and Assam Rifles, and their spouses, parents and children. No fixed end date.</p>\n          </div>\n        </div>\n        <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display:flex;align-items:center;justify-content:center;height:52px;border-top:1px solid #E9E2D3;color:#5A4420;font-weight:700;font-size:13.5px;text-transform:uppercase;letter-spacing:1.4px;text-decoration:none;box-sizing:border-box\">Enquire Now</a>\n      </li>\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"m-gift-vouchers m-gift-vouchers-status\" style=\"margin:40px 0 0;padding-top:22px;border-top:1px solid #E9E2D3\">\n    <h2 id=\"m-gift-vouchers\" style=\"font-size:27px;line-height:1.2\">Gift vouchers</h2>\n    <p id=\"m-gift-vouchers-status\" style=\"margin:8px 0 0;font-size:14px;font-weight:700;line-height:1.4;letter-spacing:1.4px;text-transform:uppercase;color:#8F6212\">Coming Soon</p>\n    <div style=\"border-radius:4px;overflow:hidden;height:170px;margin:16px 0 0\"><img src=\"/ahv/assets/img/gallery-2026/product/hero-product-kairtis-oil-canister-01.webp\" alt=\"A Kairali Ayurvedic oil canister\" loading=\"lazy\" style=\"display:block;width:100%;height:100%;object-fit:cover\"></div>\n    <p style=\"margin:16px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">A thoughtful way to support the health of family and friends. We’re preparing gift vouchers for health assessments and appropriate treatment at AHV. Treatment will depend on the recipient’s assessment and individual needs. Gift vouchers are not yet available to purchase. Details will be shared when the offering launches.</p>\n    <a href=\"mailto:info@kairali.com\" style=\"display:flex;align-items:center;justify-content:center;height:52px;margin:18px 0 0;border-radius:4px;border:1.5px solid #006038;color:#006038;font-weight:700;font-size:13.5px;text-transform:uppercase;letter-spacing:1.4px;text-decoration:none;box-sizing:border-box\">Email info@kairali.com</a>\n    <a href=\"tel:+91 9555 156 156\" style=\"display:flex;align-items:center;justify-content:center;height:52px;margin:12px 0 0;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1.5px;text-decoration:none;box-sizing:border-box\">Call / WhatsApp +91-95551 56156</a>\n  </section>\n\n  <section aria-labelledby=\"m-a-note\" style=\"margin:44px 0 0;padding-top:24px;border-top:1px solid #E9E2D3\">\n    <p style=\"margin:0;font-size:16.5px;line-height:1.6;color:#514A3F\">🌿 A Note from Kairali</p>\n    <h2 id=\"m-a-note\" style=\"font-size:29px;line-height:1.2;margin:12px 0 0\">At Kairali, Healing Is a Responsibility — Not a Promotion.</h2>\n    <p style=\"margin:14px 0 0;font-size:18px;line-height:1.6;color:#514A3F\">118 years of Ayurvedic tradition. Offered with purpose.</p>\n    <p style=\"margin:18px 0 0\">For over a century, Kairali has extended specialised care to those who have:</p>\n    <ul style=\"display:flex;flex-direction:column;gap:14px;margin:18px 0 0\">\n      <li style=\"display:grid;grid-template-columns:30px minmax(0,1fr);gap:12px;align-items:start;font-size:16.5px;line-height:1.65\"><span style=\"font-size:22px;line-height:1.2\" aria-hidden=\"true\">🏠</span><span>Given us life — our parents, elders, and loved ones who carried us through our earliest years</span></li>\n      <li style=\"display:grid;grid-template-columns:30px minmax(0,1fr);gap:12px;align-items:start;font-size:16.5px;line-height:1.65\"><span style=\"font-size:22px;line-height:1.2\" aria-hidden=\"true\">🏅</span><span>Represented our nation — athletes who carried India’s flag on the world’s greatest stages</span></li>\n      <li style=\"display:grid;grid-template-columns:30px minmax(0,1fr);gap:12px;align-items:start;font-size:16.5px;line-height:1.65\"><span style=\"font-size:22px;line-height:1.2\" aria-hidden=\"true\">🛡️</span><span>Protected our borders — soldiers and paramilitary forces who gave years of their strength to our safety</span></li>\n    </ul>\n    <div style=\"border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:20px;margin:20px 0 0;box-sizing:border-box;display:grid;grid-template-columns:34px minmax(0,1fr);gap:14px;align-items:center\">\n      <p style=\"margin:0;font-size:24px\" aria-hidden=\"true\">🌿</p>\n      <p style=\"margin:0;font-family:'Marcellus',serif;font-size:24px;line-height:1.2;color:#2A2118\">118 Years<span style=\"display:block;font-family:'Mulish',sans-serif;font-size:15.5px;line-height:1.5;color:#514A3F\">of Ayurvedic Excellence</span></p>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"m-why-special-care\" style=\"margin:40px 0 0;padding-top:22px;border-top:1px solid #E9E2D3\">\n    <p style=\"margin:0;font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Why These Care Initiatives Exist</p>\n    <h3 id=\"m-why-special-care\" style=\"font-size:24px;line-height:1.22;margin:10px 0 0\">Why Kairali Extends Special Care</h3>\n    <p style=\"margin:14px 0 0\">Healing is not equal for everyone. Some lives need gentler care.</p>\n    <p style=\"margin:14px 0 0\">Some bodies carry extraordinary strain — strain earned through service and sacrifice.</p>\n    <p style=\"margin:14px 0 0\">Some minds and muscles have served the nation beyond what ordinary limits allow.</p>\n    <p style=\"margin:14px 0 0\">Ayurveda, when practised ethically, must respond to these realities with humility and purpose.</p>\n    <div style=\"display:flex;flex-direction:column;gap:14px;margin:22px 0 0\">\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px 20px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:22px\" aria-hidden=\"true\">🌱</p>\n        <h4 style=\"font-size:19px;line-height:1.3;margin:8px 0 0\">Rooted in Ethics, Not Commerce</h4>\n        <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">These programs exist because they are right — not because they are profitable.</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px 20px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:22px\" aria-hidden=\"true\">👨‍⚕️</p>\n        <h4 style=\"font-size:19px;line-height:1.3;margin:8px 0 0\">Doctor-Led, Always</h4>\n        <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Every care plan is created by qualified Ayurvedic physicians — never templated or packaged.</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px 20px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:22px\" aria-hidden=\"true\">🕊️</p>\n        <h4 style=\"font-size:19px;line-height:1.3;margin:8px 0 0\">Dignity as the Foundation</h4>\n        <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Whether elder, athlete, or veteran — each patient is received with the same quiet respect.</p>\n      </div>\n      <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;padding:18px 20px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:22px\" aria-hidden=\"true\">🏡</p>\n        <h4 style=\"font-size:19px;line-height:1.3;margin:8px 0 0\">A Healing Environment That Heals</h4>\n        <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Fourteen acres of lush serenity in Palakkad — designed for deep rest and genuine recovery.</p>\n      </div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"m-three-journeys\" style=\"margin:40px 0 0;padding-top:22px;border-top:1px solid #E9E2D3\">\n    <p style=\"margin:0;font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Three Paths. One Commitment.</p>\n    <h3 id=\"m-three-journeys\" style=\"font-size:24px;line-height:1.22;margin:10px 0 0\">Three Paths. One Commitment to Healing.</h3>\n    <p style=\"margin:14px 0 0\">Each initiative is a story of respect — shaped around a different life path, but united by the same principle: every person who has given deeply to others deserves healing that honours that giving.</p>\n\n    <div style=\"display:flex;flex-direction:column;gap:18px;margin:22px 0 0\">\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;overflow:hidden;box-sizing:border-box\">\n        <div style=\"min-height:150px;overflow:hidden\"><img src=\"/ahv/assets/img/gallery-2026/treatments/vasti-janu-vasti-04.webp\" alt=\"Kairali therapists performing janu vasti, a warm-oil knee treatment, on a patient\" loading=\"lazy\" style=\"display:block;width:100%;height:100%;object-fit:cover\"></div>\n        <div style=\"padding:18px 20px 22px;box-sizing:border-box\">\n          <p style=\"margin:0;display:inline-block;border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:5px 11px;font-size:11.5px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#5A4420\">For Senior Citizens</p>\n          <p style=\"margin:12px 0 0;font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Those Who Once Cared for Us</p>\n          <h4 style=\"font-size:21px;line-height:1.25;margin:8px 0 0\">Elderly &amp; Senior Wellness Care</h4>\n          <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Our parents gave us strength, stability, and care. As time slows them down, they deserve healing that preserves dignity, comfort, and independence — not pity, not urgency.</p>\n          <ul style=\"display:flex;flex-direction:column;gap:8px;margin:14px 0 0\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Age-safe, doctor-led Ayurvedic therapies</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Gentle, evidence-informed care for chronic conditions</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Assisted living &amp; senior-friendly private villas</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Long-stay healing programs with personalised routines</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Up to 20% off on select wellness packages</span></li>\n          </ul>\n          <a href=\"/offers/senior-citizen-offer/\" style=\"display:flex;align-items:center;justify-content:center;height:52px;margin:18px 0 0;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:1.3px;text-decoration:none;box-sizing:border-box;text-align:center\">Discover Elderly Wellness Care</a>\n        </div>\n      </article>\n\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;overflow:hidden;box-sizing:border-box\">\n        <div style=\"min-height:150px;overflow:hidden\"><img src=\"/ahv/assets/img/gallery-2026/photo/yoga-side-female-patient-02.webp\" alt=\"A patient in a side-stretch yoga pose at Kairali\" loading=\"lazy\" style=\"display:block;width:100%;height:100%;object-fit:cover\"></div>\n        <div style=\"padding:18px 20px 22px;box-sizing:border-box\">\n          <p style=\"margin:0;display:inline-block;border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:5px 11px;font-size:11.5px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#5A4420\">For Athletes</p>\n          <p style=\"margin:12px 0 0;font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Those Who Carried the Nation</p>\n          <h4 style=\"font-size:21px;line-height:1.25;margin:8px 0 0\">Olympic &amp; Paralympic Athlete Care</h4>\n          <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Athletes push their bodies beyond normal limits — for performance, for pride, for the nation. Recovery and longevity matter as much as the victory itself. Their bodies deserve the same discipline in healing.</p>\n          <ul style=\"display:flex;flex-direction:column;gap:8px;margin:14px 0 0\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Sports-specific Ayurvedic rehabilitation programs</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Muscle, nerve &amp; joint recovery therapies</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Performance longevity &amp; career extension programs</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Mind–body balance after competitive strain</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Specialised care for para-athletes &amp; adaptive needs</span></li>\n          </ul>\n          <a href=\"/offers/olympics-and-paralympics-offer/\" style=\"display:flex;align-items:center;justify-content:center;height:52px;margin:18px 0 0;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:1.3px;text-decoration:none;box-sizing:border-box;text-align:center\">View Programme Details</a>\n          <p style=\"margin:8px 0 0;font-size:14.5px;line-height:1.5;color:#75695A\">Telephone: <a href=\"tel:+919555156156\">+91 9555 156 156</a></p>\n        </div>\n      </article>\n\n      <article style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;overflow:hidden;box-sizing:border-box\">\n        <div style=\"min-height:150px;overflow:hidden\"><img src=\"/ahv/assets/img/gallery-2026/treatments/hero-detail-cloth-herbal-poultice-01.webp\" alt=\"A warm herbal poultice being pressed during an Ayurvedic treatment at Kairali\" loading=\"lazy\" style=\"display:block;width:100%;height:100%;object-fit:cover\"></div>\n        <div style=\"padding:18px 20px 22px;box-sizing:border-box\">\n          <p style=\"margin:0;display:inline-block;border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:5px 11px;font-size:11.5px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#5A4420\">For Defence &amp; Paramilitary</p>\n          <p style=\"margin:12px 0 0;font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Those Who Protect Us While We Sleep</p>\n          <h4 style=\"font-size:21px;line-height:1.25;margin:8px 0 0\">Defence &amp; Paramilitary Wellness</h4>\n          <p style=\"margin:10px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Years of discipline, high stress, and physical demand leave invisible scars. Healing for our defenders must restore strength, calm, and resilience — not just the body, but the whole person.</p>\n          <ul style=\"display:flex;flex-direction:column;gap:8px;margin:14px 0 0\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Stress &amp; fatigue management programs</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Trauma-informed Ayurvedic healing</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Structured routines aligned with service lifestyle</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Long-term wellness programs for veterans</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:10px;font-size:16px;line-height:1.6\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Confidential, dignified care in a private setting</span></li>\n          </ul>\n          <a href=\"/offers/defence-and-paramilitary/\" style=\"display:flex;align-items:center;justify-content:center;height:52px;margin:18px 0 0;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:1.3px;text-decoration:none;box-sizing:border-box;text-align:center\">View Programme Details</a>\n          <p style=\"margin:8px 0 0;font-size:14.5px;line-height:1.5;color:#75695A\">Telephone: <a href=\"tel:+919555156156\">+91 9555 156 156</a></p>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"m-healing-foundation\" style=\"margin:40px 0 0;padding-top:22px;border-top:1px solid #E9E2D3\">\n    <p style=\"margin:0;font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Our Healing Foundation</p>\n    <h3 id=\"m-healing-foundation\" style=\"font-size:24px;line-height:1.22;margin:10px 0 0\">One Healing Philosophy. Personalised for Every Life Path.</h3>\n    <p style=\"margin:14px 0 0\">Regardless of who you are or which program you seek — the foundation beneath every treatment at Kairali remains unchanged.</p>\n    <div style=\"display:flex;flex-direction:column;margin:20px 0 0\">\n      <div style=\"border-top:2px solid #C1882C;padding:16px 0 20px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:22px\" aria-hidden=\"true\">👨‍⚕️</p>\n        <h4 style=\"font-size:19px;line-height:1.3;margin:8px 0 0\">Doctor-Led Ayurveda</h4>\n        <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Not package-based. Every patient is assessed by a qualified physician who creates a care plan specific to their body, history, and needs.</p>\n      </div>\n      <div style=\"border-top:2px solid #C1882C;padding:16px 0 20px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:22px\" aria-hidden=\"true\">📋</p>\n        <h4 style=\"font-size:19px;line-height:1.3;margin:8px 0 0\">Individualised Protocols</h4>\n        <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">No two patients receive the same treatment. Ayurveda recognises individuality — our care reflects that at every step.</p>\n      </div>\n      <div style=\"border-top:2px solid #C1882C;padding:16px 0 20px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:22px\" aria-hidden=\"true\">🌿</p>\n        <h4 style=\"font-size:19px;line-height:1.3;margin:8px 0 0\">Ethical, Non-Commercial Healing</h4>\n        <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">These are not promotional offers. They are commitments made in the spirit of Ayurveda — to serve those who most deserve it.</p>\n      </div>\n      <div style=\"border-top:2px solid #C1882C;padding:16px 0 20px;box-sizing:border-box\">\n        <p style=\"margin:0;font-size:22px\" aria-hidden=\"true\">🏡</p>\n        <h4 style=\"font-size:19px;line-height:1.3;margin:8px 0 0\">Quiet Immersive Environment</h4>\n        <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Fourteen acres of peace in Palakkad, Kerala. No noise, no rush — only the conditions in which genuine healing becomes possible.</p>\n      </div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"m-how-healing-begins\" style=\"margin:40px 0 0;padding-top:22px;border-top:1px solid #E9E2D3\">\n    <p style=\"margin:0;font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">The Process</p>\n    <h3 id=\"m-how-healing-begins\" style=\"font-size:24px;line-height:1.22;margin:10px 0 0\">How Healing Begins</h3>\n    <p style=\"margin:14px 0 0\">A simple, unhurried process — designed so you can focus on being present, not on paperwork.</p>\n    <ol style=\"display:flex;flex-direction:column;gap:0;margin:20px 0 0;padding:0;list-style:none;border-left:2px solid #E0D7C4\">\n      <li style=\"display:grid;grid-template-columns:38px minmax(0,1fr);gap:14px;padding:0 0 22px 16px;box-sizing:border-box\">\n        <span style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.1;color:#C1882C\">1</span>\n        <div style=\"min-width:0\">\n          <h4 style=\"font-size:19px;line-height:1.3\">Medical Consultation</h4>\n          <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">A thorough assessment by our Ayurvedic physician — your health history, current condition, and goals discussed with full attention.</p>\n        </div>\n      </li>\n      <li style=\"display:grid;grid-template-columns:38px minmax(0,1fr);gap:14px;padding:0 0 22px 16px;box-sizing:border-box\">\n        <span style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.1;color:#C1882C\">2</span>\n        <div style=\"min-width:0\">\n          <h4 style=\"font-size:19px;line-height:1.3\">Personalised Care Plan</h4>\n          <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">A program designed specifically for you — therapies, diet, daily routine, and duration — tailored to your unique constitution.</p>\n        </div>\n      </li>\n      <li style=\"display:grid;grid-template-columns:38px minmax(0,1fr);gap:14px;padding:0 0 22px 16px;box-sizing:border-box\">\n        <span style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.1;color:#C1882C\">3</span>\n        <div style=\"min-width:0\">\n          <h4 style=\"font-size:19px;line-height:1.3\">Guided Therapies &amp; Stay</h4>\n          <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Gentle, expert-administered therapies in a calm environment. Your comfort and safety are monitored throughout your stay.</p>\n        </div>\n      </li>\n      <li style=\"display:grid;grid-template-columns:38px minmax(0,1fr);gap:14px;padding:0 0 4px 16px;box-sizing:border-box\">\n        <span style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.1;color:#C1882C\">4</span>\n        <div style=\"min-width:0\">\n          <h4 style=\"font-size:19px;line-height:1.3\">Post-Program Guidance</h4>\n          <p style=\"margin:8px 0 0;font-size:16.5px;line-height:1.65;color:#514A3F\">Detailed guidance for maintaining the benefits of your healing at home — so your recovery continues long after you leave.</p>\n        </div>\n      </li>\n    </ol>\n  </section>\n\n  <section aria-labelledby=\"m-not-sure-which\" style=\"margin:40px 0 0;padding-top:22px;border-top:1px solid #E9E2D3\">\n    <div style=\"border:1px solid #C9BFA8;border-radius:4px;background:#EFE9DA;padding:22px 20px;box-sizing:border-box\">\n      <p style=\"margin:0;font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">We Are Here for You</p>\n      <h3 id=\"m-not-sure-which\" style=\"font-size:24px;line-height:1.22;margin:10px 0 0\">Not Sure Which Program Applies?</h3>\n      <p style=\"margin:14px 0 0;font-size:16.5px;line-height:1.65\">Not sure which program applies to you or your family member?</p>\n      <p style=\"margin:0;font-size:16.5px;line-height:1.65\">Our doctors will guide you with clarity and care.</p>\n      <p style=\"margin:14px 0 0;font-size:16.5px;line-height:1.65\">There is no pressure here. Only a conversation — at whatever pace feels right.</p>\n      <p style=\"margin:14px 0 0;font-size:16.5px;line-height:1.65\">No pressure and no urgency — just honest guidance from people who care.</p>\n    </div>\n  </section>\n</main>\n\n<div style=\"margin-top:44px;width:100%;box-sizing:border-box;background:#FFFFFF;background-image:repeating-linear-gradient(0deg,rgba(193,136,44,.06) 0 1px,rgba(255,255,255,0) 1px 8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;padding:34px 20px\">\n  <ul style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 16px;margin:0\">\n    <li style=\"display:grid;grid-template-columns:14px minmax(0,1fr);gap:8px;font-size:15px;line-height:1.45\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>NABH Certified Hospital</span></li>\n    <li style=\"display:grid;grid-template-columns:14px minmax(0,1fr);gap:8px;font-size:15px;line-height:1.45\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>118+ Years Heritage</span></li>\n    <li style=\"display:grid;grid-template-columns:14px minmax(0,1fr);gap:8px;font-size:15px;line-height:1.45\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Individualised Programmes</span></li>\n    <li style=\"display:grid;grid-template-columns:14px minmax(0,1fr);gap:8px;font-size:15px;line-height:1.45\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>World Luxury Award Winner</span></li>\n  </ul>\n  <h2 style=\"font-size:26px;line-height:1.25;margin:26px 0 0;text-align:center\">Not sure which programme fits?</h2>\n  <p style=\"font-size:16.5px;line-height:1.6;color:#514A3F;margin:12px 0 0;text-align:center\">Share your goal in your own words — the patient care team or an Ayurvedic doctor will point you to the right programme.</p>\n  <div style=\"display:flex;flex-wrap:wrap;gap:12px;margin:24px 0 0\">\n    <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" style=\"display:flex;align-items:center;justify-content:center;height:52px;flex:1 1 100%;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:13.5px;text-transform:uppercase;letter-spacing:1.4px;text-decoration:none;box-sizing:border-box\">Free Doctor Consultation</a>\n    <a href=\"https://wa.me/919289838797\" style=\"display:flex;align-items:center;justify-content:center;height:52px;flex:1 1 100%;border-radius:4px;border:1.5px solid #006038;color:#006038;font-weight:700;font-size:13.5px;text-transform:uppercase;letter-spacing:1.4px;text-decoration:none;box-sizing:border-box\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp Patient Care</a>\n    <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display:flex;align-items:center;justify-content:center;height:52px;flex:1 1 100%;border-radius:4px;border:1.5px solid #5A4420;color:#5A4420;font-weight:700;font-size:13.5px;text-transform:uppercase;letter-spacing:1.4px;text-decoration:none;box-sizing:border-box\">Enquire Now</a>\n  </div>\n</div>\n\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n\n</div>\n\n",
