{"id":"ahv-page-accreditations-desktop","file":"AHV Page Accreditations Desktop.dc.html","sourceSha256":"e797fc9ba932606e3a2a91839ac30f75cd518e552289453ef5e909aba701faa8","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nbutton{font-family:inherit;cursor:pointer}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Accredited Ayurvedic Wellness at Kairali - A Trusted Retreat</title>\n<meta name=\"description\" content=\"Kairali - The Ayurvedic Healing Village is globally recognized for authentic Ayurveda, ISO certification, Green Leaf accreditation, and eco-friendly wellness practices.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/accreditations/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:title\" content=\"Accreditations\">\n<meta property=\"og:description\" content=\"Kairali - The Ayurvedic Healing Village is globally recognized for authentic Ayurveda, ISO certification, Green Leaf accreditation, and eco-friendly wellness practices.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/accreditations/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/11/our-story.png\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"524\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://ayurvedichealingvillage.com/accreditations/\",\"url\":\"https://ayurvedichealingvillage.com/accreditations/\",\"name\":\"Accredited Ayurvedic Wellness at Kairali - A Trusted Retreat\",\"description\":\"Kairali - The Ayurvedic Healing Village is globally recognized for authentic Ayurveda, ISO certification, Green Leaf accreditation, and eco-friendly wellness practices.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\",\"breadcrumb\":{\"@id\":\"https://ayurvedichealingvillage.com/accreditations/#breadcrumb\"}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/accreditations/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"About Us\",\"item\":\"https://ayurvedichealingvillage.com/about-us/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Awards & Accreditations\",\"item\":\"https://ayurvedichealingvillage.com/awards-and-accreditations/\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Accreditations\",\"item\":\"https://ayurvedichealingvillage.com/accreditations/\"}]},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"}]}\n</script>\n</helmet>\n<div data-screen-label=\"Accreditations — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 28px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\">\n    <sc-for list=\"{{ ancestors }}\" as=\"b\" hint-placeholder-count=\"3\">\n      <a href=\"{{ b.canonical }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">{{ b.label }}</a><span aria-hidden=\"true\">/</span>\n    </sc-for>\n    <span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Accreditations</span>\n  </nav>\n  <div style=\"padding-top:6px\">\n    <div style=\"font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Kairali — The Ayurvedic Healing Village · Since 1908</div>\n    <h1 id=\"page-h1\" style=\"font-family:'Marcellus',serif;font-size:clamp(36px,4vw,56px);line-height:1.1;margin:12px 0 0;max-width:20ch;text-wrap:balance\">Accreditations</h1>\n  </div>\n</section>\n<div style=\"width:min(1220px,94%);margin:0 auto\">\n  <img src=\"/ahv/assets/img/AHV-About-Landscape.webp\" alt=\"Aerial view of paddy fields and coconut palms in the Kerala countryside around the hospital\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block;border-radius:4px\">\n</div>\n<div style=\"width:min(1220px,94%);margin:0 auto;padding:56px 0 0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,3fr);gap:32px 64px;align-items:start\">\n  <nav aria-labelledby=\"contents-h\" style=\"position:sticky;top:96px\">\n    <h2 id=\"contents-h\" style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;font-family:'Mulish',sans-serif;margin:0 0 6px\">On this page</h2>\n    <ol style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ toc }}\" as=\"t\" hint-placeholder-count=\"6\">\n        <li style=\"border-bottom:1px solid #E0D7C4\"><a href=\"#{{ t.id }}\" style=\"display:flex;align-items:center;gap:12px;min-height:46px;padding:6px 0;font-size:15.5px;font-weight:600;line-height:1.4;color:#2A2118\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ t.label }}</span></a></li>\n      </sc-for>\n      <li style=\"border-bottom:1px solid #E0D7C4\"><a href=\"#certificates\" style=\"display:flex;align-items:center;gap:12px;min-height:46px;padding:6px 0;font-size:15.5px;font-weight:600;line-height:1.4;color:#2A2118\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>Certificates &amp; recognition</span></a></li>\n    </ol>\n  </nav>\n  <article id=\"accreditations-body\" aria-labelledby=\"page-h1\" style=\"max-width:72ch;min-width:0\">{{ body }}</article>\n</div>\n\n<section id=\"certificates\" aria-labelledby=\"certificates-h\" style=\"width:min(1220px,94%);margin:64px auto 0;padding:64px 0 72px;border-top:1px solid #E0D7C4;scroll-margin-top:96px\">\n  <p style=\"margin:0 0 8px;font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;text-align:center\">{{ gallery.eyebrow }}</p>\n  <h2 id=\"certificates-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:0 0 32px;text-align:center;text-wrap:balance\">{{ gallery.heading }}</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr));gap:28px 24px\">\n    <sc-for list=\"{{ documents }}\" as=\"c\" hint-placeholder-count=\"7\">\n      <li style=\"background:#fff;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden;min-width:0\">\n        <button type=\"button\" data-doc-index=\"{{ c.i }}\" onClick=\"{{ c.open }}\" style=\"display:flex;flex-direction:column;width:100%;padding:0;border:0;background:#fff;color:#2A2118;text-align:left\" style-hover=\"color:#006038\">\n          <img src=\"{{ c.src }}\" alt=\"{{ c.label }}\" width=\"{{ c.width }}\" height=\"{{ c.height }}\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-bottom:1px solid #E9E2D3\">\n          <span style=\"display:flex;flex-direction:column;gap:4px;padding:14px 16px 16px;min-height:44px;box-sizing:border-box\"><span style=\"font-weight:700;font-size:15.5px;line-height:1.4\">{{ c.label }}</span><span style=\"display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:12.5px;letter-spacing:2px;text-transform:uppercase;color:#006038\">View document<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span></span>\n        </button>\n      </li>\n    </sc-for>\n  </ul>\n</section>\n\n<aside aria-labelledby=\"ctx-h\" style=\"background:#EFE9DA;border-top:1px solid #E0D7C4\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:56px 0 64px\">\n    <h2 id=\"ctx-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(24px,2vw,30px);line-height:1.25;margin:0 0 28px\">{{ ctxHeading }}</h2>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:32px 48px\">\n      <sc-for list=\"{{ groups }}\" as=\"g\" hint-placeholder-count=\"4\">\n        <nav aria-labelledby=\"{{ g.hid }}\" style=\"min-width:0\">\n          <h3 id=\"{{ g.hid }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-family:'Marcellus',serif;font-size:21px;color:#2A2118;border-bottom:2px solid #C1882C\">{{ g.label }}</h3>\n          <ul style=\"list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column\">\n            <sc-for list=\"{{ g.items }}\" as=\"it\" hint-placeholder-count=\"3\">\n              <li style=\"min-width:0\">\n                <sc-if value=\"{{ it.isLink }}\" hint-placeholder-val=\"{{ true }}\"><a href=\"{{ it.href }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;min-height:44px;padding:4px 0;font-size:16.5px;line-height:1.4;color:#2A2118\" style-hover=\"color:#006038\">{{ it.text }}</a></sc-if>\n                <sc-if value=\"{{ it.isCurrent }}\" hint-placeholder-val=\"{{ false }}\"><span aria-current=\"page\" style=\"display:flex;align-items:center;gap:10px;min-height:44px;padding:4px 0;font-size:16.5px;line-height:1.4;font-weight:700;color:#5A4420\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>{{ it.text }}</span></sc-if>\n              </li>\n            </sc-for>\n          </ul>\n        </nav>\n      </sc-for>\n    </div>\n  </div>\n</aside>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n\n<div id=\"doc-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"doc-dialog-title\" onKeyDown=\"{{ dlgKey }}\" style=\"display:{{ dlgDisplay }};position:fixed;inset:0;z-index:200;background:rgba(26,20,12,.94);flex-direction:column;align-items:center;justify-content:center;padding:24px;box-sizing:border-box\">\n  <div style=\"width:100%;max-width:1280px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;color:#F7F4EA\">\n    <div style=\"display:flex;flex-direction:column;gap:2px;min-height:44px;justify-content:center\"><span aria-live=\"polite\" style=\"font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#E9E2D3\">{{ counter }}</span><span id=\"doc-dialog-title\" style=\"font-family:'Marcellus',serif;font-size:22px;line-height:1.25\">{{ curLabel }}</span></div>\n    <div style=\"display:flex;gap:12px;flex-wrap:wrap\">\n      <button type=\"button\" id=\"doc-zoom\" aria-pressed=\"{{ zoomPressed }}\" onClick=\"{{ toggleZoom }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 20px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"background:rgba(247,244,234,.12)\">{{ zoomLabel }}</button>\n      <button type=\"button\" id=\"doc-close\" onClick=\"{{ close }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 20px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"background:rgba(247,244,234,.12)\">Close document<span aria-hidden=\"true\">✕</span></button>\n    </div>\n  </div>\n  <div id=\"doc-stage\" style=\"width:100%;max-width:1280px;flex:1 1 auto;min-height:0;margin:20px 0;display:flex;justify-content:center;align-items:flex-start;overflow:auto;border-radius:4px\">{{ viewerImg }}</div>\n  <div style=\"width:100%;max-width:1280px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap\">\n    <button type=\"button\" id=\"doc-prev\" onClick=\"{{ prev }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 22px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"background:rgba(247,244,234,.12)\"><span aria-hidden=\"true\">←</span>Previous document</button>\n    <button type=\"button\" id=\"doc-next\" onClick=\"{{ next }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 22px;border:1px solid #EEB41E;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"filter:brightness(.94)\">Next document<span aria-hidden=\"true\">→</span></button>\n  </div>\n</div>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  state = { open: false, i: 0, zoom: false };\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  componentWillUnmount() { document.body.style.overflow = ''; }\n  openAt(idx) {\n    this._opener = idx;\n    // Settle any in-flight smooth scroll at the trigger before locking (About viewer race fix, notes/about-us-page.md).\n    const btn = document.querySelector('button[data-doc-index=\"' + idx + '\"]');\n    if (btn) { const r = btn.getBoundingClientRect(); if (r.top < 0 || r.bottom > window.innerHeight) window.scrollTo({ top: window.scrollY + r.top - Math.max(0, (window.innerHeight - r.height) / 2), behavior: 'instant' }); else window.scrollTo({ top: window.scrollY, behavior: 'instant' }); }\n    this.setState({ open: true, i: idx, zoom: false });\n    document.body.style.overflow = 'hidden';\n    setTimeout(() => { const c = document.getElementById('doc-close'); if (c) c.focus(); }, 30);\n  }\n  closeViewer() {\n    const idx = this._opener != null ? this._opener : this.state.i;\n    this.setState({ open: false, zoom: false });\n    document.body.style.overflow = '';\n    setTimeout(() => { const btn = document.querySelector('button[data-doc-index=\"' + idx + '\"]'); if (btn) btn.focus(); }, 30);\n  }\n  renderVals() {\n    const D = window.AHV_ACCREDITATIONS, P = window.AHV_ACCREDITATIONS_RENDER;\n    const A = 'https://ayurvedichealingvillage.com';\n    const guard = () => {}; /* preview-only nav guard neutralised for the published site */\n    if (!D || !P) return { guard, ancestors: [], toc: [], body: null, gallery: {}, documents: [], ctxHeading: '', groups: [], dlgDisplay: 'none', viewerImg: null, counter: '', curLabel: '', zoomLabel: 'Actual size', zoomPressed: 'false' };\n    const docs = D.gallery.documents, n = docs.length, i = this.state.i, cur = docs[i] || docs[0];\n    const go = (d) => this.setState(s => ({ i: (s.i + d + n) % n, zoom: false }));\n    const zoom = this.state.zoom;\n    const viewerImg = this.state.open ? React.createElement('img', { id: 'doc-expanded', key: cur.src + (zoom ? 'z' : 'f'), src: cur.src, alt: cur.label, width: cur.width, height: cur.height,\n      style: zoom ? { display: 'block', width: cur.width + 'px', maxWidth: 'none', height: 'auto', background: '#000' } : { display: 'block', width: 'auto', height: 'auto', maxWidth: '100%', maxHeight: 'calc(100vh - 240px)', objectFit: 'contain', background: '#000' } }) : null;\n    return {\n      guard, ancestors: D.breadcrumb.slice(0, -1), toc: P.contents(D), body: P.blocks(D, guard, false),\n      gallery: { eyebrow: D.gallery.eyebrow, heading: D.gallery.heading },\n      documents: docs.map((c, idx) => ({ i: idx, src: c.src, label: c.label, width: c.width, height: c.height, open: () => this.openAt(idx) })),\n      ctxHeading: D.contextNav.heading,\n      groups: D.contextNav.groups.map((g, gi) => ({ hid: 'ctx-g' + gi, label: g.label, items: g.links.map(l => ({ text: l.text, href: A + l.href, isLink: l.href !== D.path, isCurrent: l.href === D.path })) })),\n      dlgDisplay: this.state.open ? 'flex' : 'none', viewerImg, counter: n ? 'Document ' + (i + 1) + ' of ' + n : '', curLabel: cur ? cur.label : '',\n      zoomLabel: zoom ? 'Fit to screen' : 'Actual size', zoomPressed: zoom ? 'true' : 'false', toggleZoom: () => this.setState(s => ({ zoom: !s.zoom })),\n      close: () => this.closeViewer(), prev: () => go(-1), next: () => go(1),\n      dlgKey: (e) => {\n        if (e.key === 'Escape') { e.preventDefault(); this.closeViewer(); return; }\n        if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); return; }\n        if (e.key === 'ArrowRight') { e.preventDefault(); go(1); return; }\n        if (e.key === 'Tab') {\n          const f = [...e.currentTarget.querySelectorAll('button')];\n          const first = f[0], last = f[f.length - 1];\n          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }\n          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }\n        }\n      }\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/accreditations-data.js","/ahv/assets/accreditations-render.js"]}