{"id":"ahv-page-past-retreats-desktop","file":"AHV Page Past Retreats Desktop.dc.html","sourceSha256":"feaa42ae539b79e1b817f4190912afb1a1105fa2137bb4833a347bc5a428fd5e","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Past Yoga &amp; Ayurveda Retreats | Kairali Healing Village</title>\n<meta name=\"description\" content=\"Explore past yoga, Ayurveda and culinary retreats at Kairali – The Ayurvedic Healing Village. Read retreat stories and discover current programmes.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Past Yoga &amp; Ayurveda Retreats | Kairali Healing Village\">\n<meta property=\"og:description\" content=\"Explore past yoga, Ayurveda and culinary retreats at Kairali – The Ayurvedic Healing Village. Read retreat stories and discover current programmes.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/11/our-story.png\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"524\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"@id\":\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\",\"url\":\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\",\"name\":\"Past Yoga & Ayurveda Retreats | Kairali Healing Village\",\"description\":\"Explore past yoga, Ayurveda and culinary retreats at Kairali – The Ayurvedic Healing Village. Read retreat stories and discover current programmes.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/archive-yoga-retreat/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Past Events\",\"item\":\"https://ayurvedichealingvillage.com/archive/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Past Retreats\",\"item\":\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Past Retreats — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 40px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">News &amp; Past Events</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Past Retreats</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:24px 64px;align-items:start;padding-top:6px\">\n    <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.6vw,54px);line-height:1.12;margin:0;text-wrap:balance\">Past Retreats</h1>\n    <p style=\"font-size:18px;line-height:1.65;color:#514a3f;max-width:70ch;margin:0;border-left:3px solid #C1882C;padding-left:20px\">Dive into our Yoga Retreat Archive and explore highlights from past retreats such as Ananda Lahari Yoga and Ayurveda Retreat, Lakshya Yoga Retreat, Ashtanga Yoga &amp; Ayurveda Retreat, Mindfulness Retreat, among many others held at Kairali – The Ayurvedic Healing Village, Palakkad Kerala. From serene yoga sessions and guided meditations to transformative wellness experiences, each retreat reflects the harmony of mind, body, and spirit. Relive the moments that have inspired countless journeys toward inner peace.</p>\n  </div>\n</section>\n<div style=\"width:min(1440px,100%);margin:0 auto\">\n  <img src=\"/ahv/assets/img/AHV-Retreat-Archive-Landscape.png\" alt=\"Palm trees and fields seen from above.\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block\">\n</div>\n\n<nav aria-label=\"On this page\" style=\"position:sticky;top:0;z-index:40;background:rgba(247,244,234,.97);backdrop-filter:blur(8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;gap:4px 26px;flex-wrap:wrap;align-items:center\">\n    <a href=\"#archive\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Retreat archive</a>\n    <a href=\"#more\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">More past retreats</a>\n    <a href=\"#current\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Explore current programmes</a>\n    <a href=\"#group\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Kairali Group</a>\n    <a href=\"#about\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">About Kairali</a>\n  </div>\n</nav>\n\n<section id=\"archive\" aria-labelledby=\"archive-h\" style=\"scroll-margin-top:{{ anchorMargin }};width:min(1220px,94%);margin:0 auto;padding:56px 0 0\">\n  <h2 id=\"archive-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:0 0 28px\">Retreat archive</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px\">\n    <sc-for list=\"{{ cards }}\" as=\"c\" hint-placeholder-count=\"8\">\n      <li style=\"background:#fff;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden;display:flex;flex-direction:column\">\n        <a href=\"{{ c.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;flex:1;color:#2A2118\" style-hover=\"color:#2A2118;text-decoration:none\">\n          <img src=\"{{ c.image }}\" alt=\"{{ c.alt }}\" width=\"{{ c.width }}\" height=\"{{ c.height }}\" loading=\"lazy\" style=\"width:100%;max-width:600px;height:auto;display:block;align-self:center\">\n          <span style=\"display:flex;flex-direction:column;gap:10px;padding:20px 24px 24px;flex:1\">\n            <span style=\"font-weight:700;font-size:12.5px;letter-spacing:2.4px;color:#8F6212;text-transform:uppercase\">Past Retreat</span>\n            <h3 style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.25;color:#2A2118\">{{ c.title }}</h3>\n            <p style=\"margin:0;font-size:17px;line-height:1.6;color:#514a3f\">{{ c.excerpt }}</p>\n            <span style=\"margin-top:auto;display:inline-flex;align-items:center;gap:10px;min-height:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#006038\">Read retreat story<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span>\n          </span>\n        </a>\n      </li>\n    </sc-for>\n  </ul>\n</section>\n\n<section id=\"more\" aria-labelledby=\"more-h\" style=\"scroll-margin-top:{{ anchorMargin }};width:min(1220px,94%);margin:0 auto;padding:64px 0 0\">\n  <h2 id=\"more-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:0 0 20px\">More past retreats</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(360px,100%),1fr));gap:0 32px;border-top:1px solid #E9E2D3\">\n    <sc-for list=\"{{ more }}\" as=\"m\" hint-placeholder-count=\"9\">\n      <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ m.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;justify-content:center;gap:2px;min-height:64px;padding:12px 0;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none\"><span style=\"font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Past Retreat</span><span style=\"display:flex;align-items:center;gap:12px;font-size:17px;font-weight:600;line-height:1.4\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ m.title }}</span></a></li>\n    </sc-for>\n  </ul>\n</section>\n\n<section id=\"current\" aria-labelledby=\"current-h\" style=\"scroll-margin-top:{{ anchorMargin }};margin-top:64px;padding:48px 0;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px 48px;align-items:center\">\n    <h2 id=\"current-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);line-height:1.2\">Explore current programmes</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:12px\">\n      <sc-for list=\"{{ currentLinks }}\" as=\"k\" hint-placeholder-count=\"2\">\n        <li><a href=\"{{ k.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border:1.5px solid #006038;border-radius:4px;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;color:#006038\" style-hover=\"background:#006038;color:#F7F4EA;text-decoration:none\">{{ k.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n</section>\n\n<section aria-label=\"Related links\" style=\"width:min(1220px,94%);margin:0 auto;padding:64px 0 72px;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:48px 64px;align-items:start\">\n  <div id=\"group\" aria-labelledby=\"group-h\" style=\"scroll-margin-top:{{ anchorMargin }}\">\n    <h2 id=\"group-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);margin:0 0 18px\">Kairali Group</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));gap:0 32px;border-top:1px solid #E9E2D3\">\n      <sc-for list=\"{{ groupLinks }}\" as=\"r\" hint-placeholder-count=\"15\">\n        <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118;line-height:1.4\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n  <div id=\"about\" aria-labelledby=\"about-h\" style=\"scroll-margin-top:{{ anchorMargin }}\">\n    <h2 id=\"about-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);margin:0 0 18px\">About Kairali</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E9E2D3\">\n      <sc-for list=\"{{ aboutLinks }}\" as=\"r\" hint-placeholder-count=\"4\">\n        <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118;line-height:1.4\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n  <nav aria-label=\"More from Kairali\" style=\"grid-column:1 / -1;margin-top:8px;display:flex;justify-content:center;gap:8px 28px;flex-wrap:wrap;border-top:1px solid #E9E2D3;padding-top:22px\">\n    <sc-for list=\"{{ footerLinks }}\" as=\"f\" hint-placeholder-count=\"3\">\n      <a href=\"{{ f.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">{{ f.label }}</a>\n    </sc-for>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  state = { navH: 52 };\n  componentDidMount() {\n    document.documentElement.lang = 'en-US';\n    // 5 chips wrap to 2 rows at 1024; measure so anchors clear the stuck nav at every width.\n    this._measure = () => {\n      const nav = document.querySelector('nav[aria-label=\"On this page\"]');\n      const h = nav ? Math.round(nav.getBoundingClientRect().height) : 52;\n      if (h !== this.state.navH) this.setState({ navH: h });\n    };\n    this._measure();\n    window.addEventListener('resize', this._measure);\n    this._t = setTimeout(this._measure, 800);\n  }\n  componentWillUnmount() { window.removeEventListener('resize', this._measure); clearTimeout(this._t); }\n  renderVals() {\n    const D = window.AHV_PAST_RETREATS || { cards: [], more: [], currentLinks: [], groupLinks: [], aboutLinks: [], footerLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    const abs = (l) => ({ ...l, url: A + l.href });\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      anchorMargin: (this.state.navH + 12) + 'px',\n      cards: D.cards.map(abs), more: D.more.map(abs), currentLinks: D.currentLinks.map(abs),\n      groupLinks: D.groupLinks.map(abs), aboutLinks: D.aboutLinks.map(abs), footerLinks: D.footerLinks.map(abs)\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/past-retreats-data.js"]}