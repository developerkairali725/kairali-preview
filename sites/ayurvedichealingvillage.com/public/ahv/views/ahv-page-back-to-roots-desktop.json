{"id":"ahv-page-back-to-roots-desktop","file":"AHV Page Back to Roots Desktop.dc.html","sourceSha256":"a44730f7e353dfa340f6303b73d0315e40bf3d098e34aa5a7ef3720fdc87a68d","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Kairali’s Ayurvedic Culinary Legacy | Chef Retreat &amp; Wellness Cuisine</title>\n<meta name=\"description\" content=\"Experience Kairali’s commitment to Ayurvedic cuisine &amp; holistic wellness. Relive India’s first Chef Retreat, blending tradition with gourmet innovation.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/back-to-roots/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:title\" content=\"Back to Roots\">\n<meta property=\"og:description\" content=\"Experience Kairali’s commitment to Ayurvedic cuisine &amp; holistic wellness. Relive India’s first Chef Retreat, blending tradition with gourmet innovation.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/back-to-roots/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/11/our-story.png\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"524\">\n<meta property=\"og:image:type