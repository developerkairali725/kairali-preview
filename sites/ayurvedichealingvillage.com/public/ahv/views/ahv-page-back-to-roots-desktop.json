HV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 40px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">News &amp; Past Events</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Past Retreats</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Back to Roots</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:24px 64px;align-items:start;padding-top:6px\">\n    <div>\n      <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Past Retreat</div>\n      <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.4vw,50px);line-height:1.12;margin:12px 0 0;text-wrap:balance\">Back to Roots</h1>\n    </div>\n    <div role=\"note\" aria-label=\"Past retreat notice\" style=\"background:#fff;border:1px solid #C1882C;border-left:6px solid #C1882C;border-radius:4px;padding:20px 24px\">\n      <p style=\"margin:0;font-size:17px;line-height:1.6;color:#2A2118\">This is a past retreat. The original description below is retained as a historical record and is not a current offer. There are no current dates or bookings for this retreat.</p>\n      <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:6px;font-weight:700;font-size:15.5px\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>Past Retreats</a>\n    </div>\n  </div>\n</section>\n<div style=\"width:min(1440px,100%);margin:0 auto\">\n  <img src=\"/ahv/assets/img/AHV-BackToRoots-Landscape.png\" alt=\"Green fields and paths among coconut palms\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block\">\n</div>\n\n<article aria-label=\"Historical retreat description\" style=\"width:min(1220px,94%);margin:0 auto;padding:56px 0 0\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;margin-bottom:8px\">Historical retreat description</div>\n  <section id=\"back-to-roots\" aria-labelledby=\"back-to-roots-h\" style=\"max-width:70ch\">\n    <h2 id=\"back-to-roots-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px;text-wrap:balance\">{{ s0.heading }}</h2>\n    <sc-for list=\"{{ s0.paragraphs }}\" as=\"p\" hint-placeholder-count=\"7\"><p style=\"margin:0 0 16px;color:#2A2118\">{{ p }}</p></sc-for>\n  </section>\n</article>\n\n<nav id=\"related\" aria-labelledby=\"related-h\" style=\"width:min(1220px,94%);margin:64px auto 0;padding:48px 0 64px;border-top:1px solid #E9E2D3\">\n  <h2 id=\"related-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);line-height:1.2;margin:0 0 28px\">{{ relatedHeading }}</h2>\n  <section aria-labelledby=\"related-g0\">\n    <h3 id=\"related-g0\" style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;font-family:'Mulish',sans-serif;margin:0 0 6px\">{{ g0.label }}</h3>\n    <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(320px,100%),1fr));gap:0 40px;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ g0.links }}\" as=\"k\" hint-placeholder-count=\"15\">\n        <li style=\"border-bottom:1px solid #E0D7C4\"><a href=\"{{ k.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:48px;padding:6px 0;font-size:16.5px;font-weight:600;line-height:1.4\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ k.label }}</span></a></li>\n      </sc-for>\n    </ul>\n  </section>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:32px 48px;align-items:start;margin-top:36px\">\n    <sc-for list=\"{{ gRest }}\" as=\"g\" hint-placeholder-count=\"3\">\n      <section aria-labelledby=\"{{ g.hid }}\">\n        <h3 id=\"{{ g.hid }}\" style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;font-family:'Mulish',sans-serif;margin:0 0 6px\">{{ g.label }}</h3>\n        <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n          <sc-for list=\"{{ g.links }}\" as=\"k\" hint-placeholder-count=\"2\">\n            <li style=\"border-bottom:1px solid #E0D7C4\"><a href=\"{{ k.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:48px;padding:6px 0;font-size:16.5px;font-weight:600;line-height:1.4\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ k.label }}</span></a></li>\n          </sc-for>\n        </ul>\n      </section>\n    </sc-for>\n  </div>\n</nav>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_BACK_TO_ROOTS || { sections: [], relatedGroups: [], relatedHeading: '' };\n    const A = 'https://ayurvedichealingvillage.com';\n    const groups = D.relatedGroups.map((g, i) => ({ ...g, hid: 'related-g' + i, links: g.links.map(l => ({ ...l, url: A + l.href })) }));\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      s0: D.sections[0] || { heading: '', paragraphs: [] },\n      relatedHeading: D.relatedHeading, g0: groups[0] || { label: '', links: [] }, gRest: groups.slice(1)\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/back-to-roots-data.js"]}