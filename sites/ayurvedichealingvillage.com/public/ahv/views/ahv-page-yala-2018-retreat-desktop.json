{"id":"ahv-page-yala-2018-retreat-desktop","file":"AHV Page Yala 2018 Retreat Desktop.dc.html","sourceSha256":"881a5728c9692f67fc70df6fdfee33d4c218206edaf9ae3e8a2b801d2406acb3","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Ayurvedic New Year: Yala 2018 | Past Retreat | Kairali Healing Village</title>\n<meta name=\"description\" content=\"Explore the historical Yala 2018 New Year retreat at Kairali’s Ayurvedic Healing Village, including its original yoga, Ayurveda and Kerala itinerary.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/ayurvedic-new-year-yala-2018/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Ayurvedic New Year: Yala 2018 | Past Retreat | Kairali Healing Village\">\n<meta property=\"og:description\" content=\"Explore the historical Yala 2018 New Year retreat at Kairali’s Ayurvedic Healing Village, including its original yoga, Ayurveda and Kerala itinerary.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/ayurvedic-new-year-yala-2018/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/11/our-story.png\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"524\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://ayurvedichealingvillage.com/ayurvedic-new-year-yala-2018/\",\"url\":\"https://ayurvedichealingvillage.com/ayurvedic-new-year-yala-2018/\",\"name\":\"Ayurvedic New Year: Yala 2018 | Past Retreat | Kairali Healing Village\",\"description\":\"Explore the historical Yala 2018 New Year retreat at Kairali’s Ayurvedic Healing Village, including its original yoga, Ayurveda and Kerala itinerary.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/ayurvedic-new-year-yala-2018/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Past Events\",\"item\":\"https://ayurvedichealingvillage.com/archive/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Past Retreats\",\"item\":\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Ayurvedic New Year: Yala 2018!\",\"item\":\"https://ayurvedichealingvillage.com/ayurvedic-new-year-yala-2018/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Yala 2018 — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 40px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">News &amp; Past Events</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Past Retreats</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Ayurvedic New Year: Yala 2018!</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:24px 64px;align-items:start;padding-top:6px\">\n    <div>\n      <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Past Retreat</div>\n      <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.6vw,54px);line-height:1.12;margin:12px 0 0;text-wrap:balance\">Ayurvedic New Year: Yala 2018!</h1>\n    </div>\n    <div role=\"note\" aria-label=\"Past retreat notice\" style=\"background:#fff;border:1px solid #C1882C;border-left:6px solid #C1882C;border-radius:4px;padding:20px 24px\">\n      <p style=\"margin:0;font-size:17px;line-height:1.6;color:#2A2118\">This is a past retreat. The original description, itinerary and inclusions below are retained as a historical record and are not a current offer. There are no current dates or bookings for this retreat.</p>\n      <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;margin-top:6px;font-weight:700;font-size:15.5px\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>Past Retreats</a>\n    </div>\n  </div>\n  <img src=\"/ahv/assets/img/AHV-Yala-01.png\" alt=\"Palm trees and fields seen from above.\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block;border-radius:4px;margin-top:40px\">\n</section>\n\n<article aria-label=\"Historical retreat description\" style=\"width:min(1220px,94%);margin:0 auto;padding:24px 0 0\">\n  <div style=\"display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:48px 64px;align-items:start\">\n    <section id=\"description\" aria-labelledby=\"description-h\" style=\"max-width:70ch\">\n      <h2 id=\"description-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Historical retreat description</h2>\n      <sc-for list=\"{{ descParas }}\" as=\"p\" hint-placeholder-count=\"8\">\n        <p style=\"margin:0 0 16px\"><sc-if value=\"{{ p.isPlain }}\" hint-placeholder-val=\"{{ true }}\">{{ p.text }}</sc-if><sc-if value=\"{{ p.isEm }}\" hint-placeholder-val=\"{{ false }}\"><em>{{ p.text }}</em></sc-if><sc-if value=\"{{ p.hasLead }}\" hint-placeholder-val=\"{{ false }}\"><strong>{{ p.lead }}</strong>{{ p.rest }}</sc-if></p>\n      </sc-for>\n    </section>\n    <section id=\"yoga\" aria-labelledby=\"yoga-h\" style=\"max-width:70ch\">\n      <h2 id=\"yoga-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Yoga &amp; Meditation Practice</h2>\n      <sc-for list=\"{{ D.yoga.paragraphs }}\" as=\"p\" hint-placeholder-count=\"6\"><p style=\"margin:0 0 16px\">{{ p }}</p></sc-for>\n      <img src=\"/ahv/assets/img/AHV-Yala-03.jpg\" alt=\"Two photographs of yoga practice outdoors beside cottages.\" width=\"834\" height=\"100\" loading=\"lazy\" style=\"width:100%;max-width:834px;height:auto;display:block;border-radius:4px;margin-top:8px\">\n    </section>\n  </div>\n\n  <div style=\"display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:48px 64px;padding-top:48px;border-top:1px solid #E9E2D3;margin-top:48px;align-items:start\">\n    <section id=\"source-section-4\" aria-labelledby=\"village-h\" style=\"max-width:70ch\">\n      <h2 id=\"village-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">The Healing Village</h2>\n      <sc-for list=\"{{ D.village.paragraphs }}\" as=\"p\" hint-placeholder-count=\"2\"><p style=\"margin:0 0 16px\">{{ p }}</p></sc-for>\n    </section>\n    <section id=\"source-section-7\" aria-labelledby=\"highlights-h\">\n      <h2 id=\"highlights-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Highlights</h2>\n      <ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n        <sc-for list=\"{{ D.highlights.items }}\" as=\"it\" hint-placeholder-count=\"12\"><li style=\"display:flex;gap:14px;padding:12px 0;border-bottom:1px solid #E0D7C4;font-size:17.5px;line-height:1.6\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ it }}</span></li></sc-for>\n      </ul>\n    </section>\n  </div>\n\n  <section id=\"source-section-20\" aria-labelledby=\"itinerary-h\" style=\"padding-top:48px;border-top:1px solid #E9E2D3;margin-top:48px\">\n    <h2 id=\"itinerary-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 28px;max-width:70ch;text-wrap:pretty\">A rich program to deeply detox your body and refresh your mind!</h2>\n    <ol style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 64px\">\n      <sc-for list=\"{{ days }}\" as=\"d\" hint-placeholder-count=\"10\">\n        <li style=\"background:#fff;border:1px solid #E9E2D3;border-radius:4px;padding:22px 26px 10px\">\n          <h3 id=\"{{ d.hid }}\" style=\"font-family:'Marcellus',serif;font-size:23px;line-height:1.25;margin:0 0 12px;display:flex;align-items:center;gap:12px\"><span aria-hidden=\"true\" style=\"color:#C1882C;font-size:14px\">◆</span>{{ d.heading }}</h3>\n          <ul aria-labelledby=\"{{ d.hid }}\" style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n            <sc-for list=\"{{ d.items }}\" as=\"it\" hint-placeholder-count=\"8\"><li style=\"padding:10px 0;border-bottom:1px solid #EFE9DC;font-size:17px;line-height:1.55\">{{ it }}</li></sc-for>\n          </ul>\n        </li>\n      </sc-for>\n    </ol>\n  </section>\n\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px 64px;padding-top:48px;border-top:1px solid #E9E2D3;margin-top:48px;align-items:start\">\n    <section id=\"source-section-111\" aria-labelledby=\"ayurveda-h\" style=\"max-width:70ch\">\n      <h2 id=\"ayurveda-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">What is Ayurveda</h2>\n      <sc-for list=\"{{ D.ayurveda.paragraphs }}\" as=\"p\" hint-placeholder-count=\"1\"><p style=\"margin:0 0 16px\">{{ p }}</p></sc-for>\n    </section>\n    <section id=\"source-section-113\" aria-labelledby=\"class-h\" style=\"max-width:70ch\">\n      <h2 id=\"class-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Ayurvedic Class</h2>\n      <sc-for list=\"{{ D.ayurvedicClass.paragraphs }}\" as=\"p\" hint-placeholder-count=\"1\"><p style=\"margin:0 0 16px\">{{ p }}</p></sc-for>\n    </section>\n  </div>\n\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px 64px;padding-top:48px;border-top:1px solid #E9E2D3;margin-top:48px;align-items:start\">\n    <section id=\"source-section-115\" aria-labelledby=\"diet-h\" style=\"max-width:70ch\">\n      <h2 id=\"diet-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Ayurvedic Diet</h2>\n      <sc-for list=\"{{ D.diet.paragraphs }}\" as=\"p\" hint-placeholder-count=\"3\"><p style=\"margin:0 0 16px\">{{ p }}</p></sc-for>\n    </section>\n    <section id=\"source-section-119\" aria-labelledby=\"backwaters-h\" style=\"max-width:70ch\">\n      <h2 id=\"backwaters-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Kerala Backwaters &amp; Houseboat Trip</h2>\n      <sc-for list=\"{{ D.backwaters.paragraphs }}\" as=\"p\" hint-placeholder-count=\"5\"><p style=\"margin:0 0 16px\">{{ p }}</p></sc-for>\n    </section>\n  </div>\n</article>\n\n<section id=\"current\" aria-labelledby=\"current-h\" style=\"margin-top:64px;padding:48px 0;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px 48px;align-items:center\">\n    <h2 id=\"current-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);line-height:1.2\">Explore current programmes</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:12px\">\n      <sc-for list=\"{{ currentLinks }}\" as=\"k\" hint-placeholder-count=\"2\">\n        <li><a href=\"{{ k.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border:1.5px solid #006038;border-radius:4px;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;color:#006038\" style-hover=\"background:#006038;color:#F7F4EA;text-decoration:none\">{{ k.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n</section>\n\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 64px\">\n  <nav aria-label=\"More from Kairali\" style=\"display:flex;justify-content:center;gap:8px 28px;flex-wrap:wrap\">\n    <sc-for list=\"{{ footerLinks }}\" as=\"f\" hint-placeholder-count=\"3\">\n      <a href=\"{{ f.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">{{ f.label }}</a>\n    </sc-for>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_YALA || { description: { paragraphs: [] }, yoga: { paragraphs: [] }, village: { paragraphs: [] }, highlights: { items: [] }, itinerary: { days: [] }, ayurveda: { paragraphs: [] }, ayurvedicClass: { paragraphs: [] }, diet: { paragraphs: [] }, backwaters: { paragraphs: [] }, currentLinks: [], footerLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    const abs = (l) => ({ ...l, url: A + l.href });\n    return {\n      guard: (e) => { e.preventDefault(); },\n      D,\n      descParas: (D.description.paragraphs || []).map(p => ({ ...p, isPlain: !p.em && !p.lead, isEm: !!p.em, hasLead: !!p.lead })),\n      days: (D.itinerary.days || []).map((d, i) => ({ ...d, hid: 'day-' + (i + 1) + '-h' })),\n      currentLinks: (D.currentLinks || []).map(abs), footerLinks: (D.footerLinks || []).map(abs)\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/yala-2018-data.js"]}