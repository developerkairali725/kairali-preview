{"id":"ahv-page-past-retreats-mobile","file":"AHV Page Past Retreats Mobile.dc.html","sourceSha256":"1e8c09670a25ca0e3230f5de0e1eb899a2ca2fb300d8f8080d0d62c28c6f5820","variant":"mobile","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Past Yoga &amp; Ayurveda Retreats | Kairali Healing Village</title>\n<meta name=\"description\" content=\"Explore past yoga, Ayurveda and culinary retreats at Kairali – The Ayurvedic Healing Village. Read retreat stories and discover current programmes.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Past Yoga &amp; Ayurveda Retreats | Kairali Healing Village\">\n<meta property=\"og:description\" content=\"Explore past yoga, Ayurveda and culinary retreats at Kairali – The Ayurvedic Healing Village. Read retreat stories and discover current programmes.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/11/our-story.png\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"524\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"@id\":\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\",\"url\":\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\",\"name\":\"Past Yoga & Ayurveda Retreats | Kairali Healing Village\",\"description\":\"Explore past yoga, Ayurveda and culinary retreats at Kairali – The Ayurvedic Healing Village. Read retreat stories and discover current programmes.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Kairali — The Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/archive-yoga-retreat/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Past Events\",\"item\":\"https://ayurvedichealingvillage.com/archive/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Past Retreats\",\"item\":\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Past Retreats — Mobile\" style=\"max-width:430px;margin:0 auto;background:#F7F4EA;box-shadow:0 0 40px rgba(70,50,20,.15);position:relative;box-sizing:border-box\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:20px 0 28px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">News &amp; Past Events</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Past Retreats</span></nav>\n  <h1 style=\"font-family:'Marcellus',serif;font-size:30px;line-height:1.2;margin:4px 0 0;text-wrap:balance\">Past Retreats</h1>\n  <p style=\"font-size:17px;line-height:1.65;color:#514a3f;margin:18px 0 0;border-left:3px solid #C1882C;padding-left:18px\">Dive into our Yoga Retreat Archive and explore highlights from past retreats such as Ananda Lahari Yoga and Ayurveda Retreat, Lakshya Yoga Retreat, Ashtanga Yoga &amp; Ayurveda Retreat, Mindfulness Retreat, among many others held at Kairali – The Ayurvedic Healing Village, Palakkad Kerala. From serene yoga sessions and guided meditations to transformative wellness experiences, each retreat reflects the harmony of mind, body, and spirit. Relive the moments that have inspired countless paths toward inner peace.</p>\n</section>\n<img src=\"/ahv/assets/img/AHV-Retreat-Archive-Landscape.webp\" alt=\"Palm trees and fields seen from above.\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block\">\n\n<nav aria-label=\"On this page\" style=\"position:sticky;top:64px;z-index:40;background:rgba(