tyle=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:22px\">\n    <sc-for list=\"{{ cards }}\" as=\"c\" hint-placeholder-count=\"8\">\n      <li style=\"background:#fff;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden\">\n        <a href=\"{{ c.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;color:#2A2118\" style-hover=\"color:#2A2118;text-decoration:none\">\n          <img src=\"{{ c.image }}\" alt=\"{{ c.alt }}\" width=\"{{ c.width }}\" height=\"{{ c.height }}\" loading=\"lazy\" style=\"width:100%;max-width:600px;height:auto;display:block\">\n          <span style=\"display:flex;flex-direction:column;gap:8px;padding:16px 18px 18px\">\n            <span style=\"font-weight:700;font-size:12px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Past Retreat</span>\n            <h3 style=\"font-family:'Marcellus',serif;font-size:23px;line-height:1.25;color:#2A2118\">{{ c.title }}</h3>\n            <p style=\"margin:0;font-size:17px;line-height:1.6;color:#514a3f\">{{ c.excerpt }}</p>\n            <span style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;font-weight:700;font-size:13px;letter-spacing:1.8px;text-transform:uppercase;color:#006038\">Read retreat story<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span>\n          </span>\n        </a>\n      </li>\n    </sc-for>\n  </ul>\n</section>\n\n<section id=\"more\" aria-labelledby=\"more-h\" style=\"scroll-margin-top:{{ anchorMargin }};width:min(1220px,94%);margin:0 auto;padding:44px 0 0\">\n  <h2 id=\"more-h\" style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.2;margin:0 0 16px\">More past retreats</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E9E2D3\">\n    <sc-for list=\"{{ more }}\" as=\"m\" hint-placeholder-count=\"9\">\n      <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ m.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;justify-content:center;gap:2px;min-height:64px;padding:12px 0;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none\"><span style=\"font-weight:700;font-size:11.5px;letter-spacing:2.2px;color:#8F6212;text-transform:uppercase\">Past Retreat</span><span style=\"display:flex;align-items:center;gap:12px;font-size:17px;font-weight:600;line-height:1.4\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ m.title }}</span></a></li>\n    </sc-for>\n  </ul>\n</section>\n\n<section id=\"current\" aria-labelledby=\"current-h\" style=\"scroll-margin-top:{{ anchorMargin }};margin-top:44px;padding:36px 0;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;flex-direction:column;gap:18px\">\n    <h2 id=\"current-h\" style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.2\">Explore current programmes</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px\">\n      <sc-for list=\"{{ currentLinks }}\" as=\"k\" hint-placeholder-count=\"2\">\n        <li><a href=\"{{ k.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;justify-content:center;min-height:48px;padding:6px 16px;border:1.5px solid #006038;border-radius:4px;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:#006038;text-align:center;line-height:1.35\" style-hover=\"background:#006038;color:#F7F4EA;text-decoration:none\">{{ k.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n</section>\n\n<section id=\"group\" aria-labelledby=\"group-h\" style=\"scroll-margin-top:{{ anchorMargin }};width:min(1220px,94%);margin:0 auto;padding:44px 0 0\">\n  <h2 id=\"group-h\" style=\"font-family:'Marcellus',serif;font-size:26px;margin:0 0 16px\">Kairali Group</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E9E2D3\">\n    <sc-for list=\"{{ groupLinks }}\" as=\"r\" hint-placeholder-count=\"15\">\n      <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118;line-height:1.4\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n    </sc-for>\n  </ul>\n</section>\n\n<section id=\"about\" aria-labelledby=\"about-h\" style=\"scroll-margin-top:{{ anchorMargin }};width:min(1220px,94%);margin:0 auto;padding:40px 0 56px\">\n  <h2 id=\"about-h\" style=\"font-family:'Marcellus',serif;font-size:26px;margin:0 0 16px\">About Kairali</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E9E2D3\">\n    <sc-for list=\"{{ aboutLinks }}\" as=\"r\" hint-placeholder-count=\"4\">\n      <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118;line-height:1.4\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n    </sc-for>\n  </ul>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:36px;display:flex;flex-direction:column;align-items:center;gap:4px;border-top:1px solid #E9E2D3;padding-top:18px\">\n    <sc-for list=\"{{ footerLinks }}\" as=\"f\" hint-placeholder-count=\"3\">\n      <a href=\"{{ f.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">{{ f.label }}</a>\n    </sc-for>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  state = { navH: 144 };\n  componentDidMount() {\n    document.documentElement.lang = 'en-US';\n    this._measure = () => {\n      const nav = document.querySelector('nav[aria-label=\"On this page\"]');\n      const h = nav ? Math.round(nav.getBoundingClientRect().height) : 144;\n      if (h !== this.state.navH) this.setState({ navH: h });\n    };\n    this._measure();\n    window.addEventListener('resize', this._measure);\n    this._t = setTimeout(this._measure, 800);\n  }\n  componentWillUnmount() { window.removeEventListener('resize', this._measure); clearTimeout(this._t); }\n  renderVals() {\n    const D = window.AHV_PAST_RETREATS || { cards: [], more: [], currentLinks: [], groupLinks: [], aboutLinks: [], footerLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    const abs = (l) => ({ ...l, url: A + l.href });\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      anchorMargin: (64 + this.state.navH + 20) + 'px',\n      cards: D.cards.map(abs), more: D.more.map(abs), currentLinks: D.currentLinks.map(abs),\n      groupLinks: D.groupLinks.map(abs), aboutLinks: D.aboutLinks.map(abs), footerLinks: D.footerLinks.map(abs)\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/past-retreats-data.js"]}