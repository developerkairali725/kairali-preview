{"id":"ahv-page-maharaja-suite-desktop","file":"AHV Page Maharaja Suite Desktop.dc.html","sourceSha256":"a8bb8a7ed3095055a28de8691f09df08891e37b31ea9c38ba624e9ed210efb1d","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\ntable{border-collapse:collapse}\nbutton{font-family:'Mulish',sans-serif;cursor:pointer}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Maharaja Suite at Kairali – Ultimate Luxury Ayurveda Retreat</title>\n<meta name=\"description\" content=\"Stay in the Maharaja Suite at Kairali Ayurvedic Healing Village for a royal wellness experience with Ayurveda, yoga, and holistic healing in Kerala.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/maharaja-suite/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:title\" content=\"Maharaja Suite\">\n<meta property=\"og:description\" content=\"Stay in the Maharaja Suite at Kairali Ayurvedic Healing Village for a royal wellness experience with Ayurveda, yoga, and holistic healing in Kerala.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/maharaja-suite/\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://ayurvedichealingvillage.com/maharaja-suite/\",\"url\":\"https://ayurvedichealingvillage.com/maharaja-suite/\",\"name\":\"Maharaja Suite at Kairali – Ultimate Luxury Ayurveda Retreat\",\"description\":\"Stay in the Maharaja Suite at Kairali Ayurvedic Healing Village for a royal wellness experience with Ayurveda, yoga, and holistic healing in Kerala.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/maharaja-suite/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Our Villas\",\"item\":\"https://ayurvedichealingvillage.com/our-villas/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Maharaja Suite\",\"item\":\"https://ayurvedichealingvillage.com/maharaja-suite/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Maharaja Suite — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 0\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/our-villas/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Our Villas</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Maharaja Suite</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:24px 64px;align-items:end;padding-top:6px\">\n    <div>\n      <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Our Villas</div>\n      <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.6vw,54px);line-height:1.12;margin:12px 0 0;text-wrap:balance\">Maharaja Suite</h1>\n    </div>\n    <ul aria-label=\"Villa facts\" style=\"list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px\">\n      <sc-for list=\"{{ D.facts }}\" as=\"f\" hint-placeholder-count=\"4\"><li style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 18px;background:#fff;border:1px solid #E0D7C4;border-radius:4px;font-size:16px;font-weight:600\">{{ f }}</li></sc-for>\n    </ul>\n  </div>\n  <img src=\"/ahv/assets/img/AHV-Maharaja-G18.webp\" alt=\"Maharaja Suite exterior and garden path\" width=\"1400\" height=\"1000\" style=\"width:100%;max-width:1400px;height:auto;display:block;border-radius:4px;margin-top:36px\">\n</section>\n\n<section aria-labelledby=\"about-h\" style=\"width:min(1220px,94%);margin:0 auto;padding:48px 0 0;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:40px 72px;align-items:start\">\n  <div style=\"max-width:70ch\">\n    <h2 id=\"about-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">About the Suite</h2>\n    <sc-for list=\"{{ aboutBlocks }}\" as=\"b\" hint-placeholder-count=\"6\"><div><sc-if value=\"{{ b.isP }}\" hint-placeholder-val=\"{{ true }}\"><p style=\"margin:0 0 16px\">{{ b.text }}</p></sc-if><sc-if value=\"{{ b.isUl }}\" hint-placeholder-val=\"{{ false }}\"><ul style=\"margin:0 0 16px;padding:0;list-style:none;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\"><sc-for list=\"{{ b.items }}\" as=\"it\" hint-placeholder-count=\"5\"><li style=\"display:flex;gap:14px;padding:10px 0;border-bottom:1px solid #E0D7C4;font-size:17.5px;line-height:1.6\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ it }}</span></li></sc-for></ul></sc-if></div></sc-for>\n  </div>\n  <div style=\"display:flex;flex-direction:column;gap:28px\">\n    <blockquote style=\"margin:0;padding:22px 26px;background:#fff;border-left:6px solid #C1882C;border:1px solid #E0D7C4;border-left-width:6px;border-left-color:#C1882C;border-radius:4px;font-family:'Marcellus',serif;font-size:21px;line-height:1.5;color:#2A2118\">{{ D.quote }}</blockquote>\n    <div aria-label=\"Enquiry\" style=\"background:#43331E;color:#F7F4EA;border-radius:4px;padding:24px 26px;display:flex;flex-direction:column;gap:12px\">\n      <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;justify-content:center;min-height:52px;background:#EEB41E;color:#2A2118;border-radius:4px;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;padding:0 20px;text-align:center\" style-hover=\"background:#D9A317;color:#2A2118;text-decoration:none\">Enquire about your stay</a>\n      <a href=\"https://ayurvedichealingvillage.com/all-programs/\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;justify-content:center;min-height:52px;border:1.5px solid rgba(247,244,234,.7);color:#F7F4EA;border-radius:4px;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;padding:0 20px;text-align:center\" style-hover=\"background:rgba(247,244,234,.12);color:#F7F4EA;text-decoration:none\">Explore programmes</a>\n    </div>\n  </div>\n</section>\n\n<section id=\"amenities\" aria-labelledby=\"amenities-h\" style=\"width:min(1220px,94%);margin:0 auto;padding-top:48px;border-top:1px solid #E9E2D3;margin-top:48px\">\n  <h2 id=\"amenities-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Suite Features</h2>\n  <ul style=\"margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(260px,100%),1fr));gap:0 40px;border-top:1px solid #E0D7C4\">\n    <sc-for list=\"{{ D.amenities }}\" as=\"it\" hint-placeholder-count=\"14\"><li style=\"display:flex;gap:14px;padding:12px 0;border-bottom:1px solid #E0D7C4;font-size:17.5px;line-height:1.6\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ it }}</span></li></sc-for>\n  </ul>\n</section>\n\n<section id=\"gallery\" aria-labelledby=\"gallery-h\" style=\"width:min(1220px,94%);margin:0 auto;padding-top:48px;border-top:1px solid #E9E2D3;margin-top:48px\">\n  <h2 id=\"gallery-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 24px\">Gallery</h2>\n  <sc-for list=\"{{ galleryGroups }}\" as=\"grp\" hint-placeholder-count=\"2\">\n    <div style=\"margin-bottom:40px\">\n      <h3 id=\"{{ grp.hid }}\" style=\"font-family:'Marcellus',serif;font-size:23px;line-height:1.25;margin:0 0 16px;display:flex;align-items:center;gap:12px\"><span aria-hidden=\"true\" style=\"color:#C1882C;font-size:14px\">◆</span>{{ grp.name }}<span style=\"font-family:'Mulish',sans-serif;font-size:15px;color:#75695A;font-weight:600\">{{ grp.countLabel }}</span></h3>\n      <ul aria-labelledby=\"{{ grp.hid }}\" style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px\">\n        <sc-for list=\"{{ grp.items }}\" as=\"g\" hint-placeholder-count=\"15\">\n          <li style=\"background:#fff;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden\">\n            <button type=\"button\" data-gallery-index=\"{{ g.i }}\" aria-label=\"{{ g.btnLabel }}\" onClick=\"{{ g.open }}\" style=\"display:flex;flex-direction:column;width:100%;padding:0;border:0;background:#fff;color:#2A2118;text-align:left\" style-hover=\"color:#006038\">\n              <img src=\"{{ g.image }}\" alt=\"{{ g.alt }}\" width=\"{{ g.width }}\" height=\"{{ g.height }}\" loading=\"lazy\" style=\"width:100%;height:auto;display:block\">\n              <span style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:6px 16px;font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#006038\">View image<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span>\n            </button>\n          </li>\n        </sc-for>\n      </ul>\n    </div>\n  </sc-for>\n</section>\n\n<section id=\"rooms\" aria-labelledby=\"rooms-h\" style=\"width:min(1220px,94%);margin:0 auto;padding-top:48px;border-top:1px solid #E9E2D3;margin-top:8px\">\n  <h2 id=\"rooms-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 18px\">Suite Name and Numbers</h2>\n  <table aria-labelledby=\"rooms-h\" style=\"width:100%;font-size:17px;line-height:1.5;border-top:1px solid #E0D7C4\">\n    <thead>\n      <tr style=\"border-bottom:1px solid #E0D7C4\">\n        <th scope=\"col\" style=\"text-align:left;font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#75695A;padding:14px 16px 14px 0\">Villa</th>\n        <th scope=\"col\" style=\"text-align:left;font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#75695A;padding:14px 16px\">Bed</th>\n        <th scope=\"col\" style=\"text-align:left;font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#75695A;padding:14px 16px\">Room</th>\n        <th scope=\"col\" style=\"text-align:left;font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#75695A;padding:14px 16px\">Zodiac</th>\n        <th scope=\"col\" style=\"text-align:left;font-weight:700;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#75695A;padding:14px 0 14px 16px\">Photos</th>\n      </tr>\n    </thead>\n    <tbody>\n      <sc-for list=\"{{ rooms }}\" as=\"r\" hint-placeholder-count=\"2\">\n        <tr style=\"border-bottom:1px solid #E0D7C4;vertical-align:middle\">\n          <th scope=\"row\" style=\"text-align:left;font-family:'Marcellus',serif;font-weight:400;font-size:20px;padding:12px 16px 12px 0\">{{ r.name }}</th>\n          <td style=\"padding:12px 16px\">{{ r.bed }}</td>\n          <td style=\"padding:12px 16px\">{{ r.room }}</td>\n          <td style=\"padding:12px 16px\"><img src=\"{{ r.zodiacImage.image }}\" alt=\"{{ r.zodiacImage.alt }}\" width=\"120\" height=\"120\" loading=\"lazy\" style=\"width:48px;height:48px;display:block\"></td>\n          <td style=\"padding:12px 0 12px 16px\"><button type=\"button\" data-room-index=\"{{ r.i }}\" onClick=\"{{ r.open }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 16px;border:1.5px solid #006038;border-radius:4px;background:transparent;color:#006038;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:#006038;color:#F7F4EA\">{{ r.btnLabel }}<span aria-hidden=\"true\">→</span></button></td>\n        </tr>\n      </sc-for>\n    </tbody>\n  </table>\n</section>\n\n<section id=\"related\" aria-labelledby=\"related-h\" style=\"width:min(1220px,94%);margin:0 auto;padding:48px 0 64px;border-top:1px solid #E9E2D3;margin-top:48px\">\n  <h2 id=\"related-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);margin:0 0 22px\">The other villas</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px\">\n    <sc-for list=\"{{ relatedVillas }}\" as=\"o\" hint-placeholder-count=\"3\">\n      <li><a href=\"{{ o.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;background:#fff;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden;color:#2A2118\" style-hover=\"border-color:#C1882C;text-decoration:none;color:#006038\">\n        <img src=\"{{ o.image }}\" alt=\"{{ o.alt }}\" width=\"378\" height=\"335\" loading=\"lazy\" style=\"width:100%;max-width:378px;height:auto;display:block;align-self:center\">\n        <span style=\"display:flex;align-items:center;gap:10px;min-height:56px;padding:8px 18px;font-family:'Marcellus',serif;font-size:21px\"><span aria-hidden=\"true\" style=\"color:#C1882C;font-size:13px\">◆</span>{{ o.label }}</span>\n      </a></li>\n    </sc-for>\n  </ul>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n\n<div id=\"villa-dialog\" role=\"dialog\" aria-modal=\"true\" aria-label=\"{{ dlgLabel }}\" onKeyDown=\"{{ dlgKey }}\" style=\"display:{{ dlgDisplay }};position:fixed;inset:0;z-index:200;background:rgba(26,20,12,.94);flex-direction:column;align-items:center;justify-content:center;padding:24px;box-sizing:border-box\">\n  <div style=\"width:100%;max-width:1280px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;color:#F7F4EA\">\n    <div aria-live=\"polite\" style=\"font-weight:700;font-size:14px;letter-spacing:2px;text-transform:uppercase;min-height:44px;display:inline-flex;align-items:center\">{{ counter }}</div>\n    <button type=\"button\" id=\"villa-close\" onClick=\"{{ close }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 20px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"background:rgba(247,244,234,.12)\">Close image<span aria-hidden=\"true\">✕</span></button>\n  </div>\n  <sc-if value=\"{{ dlgOpen }}\" hint-placeholder-val=\"{{ false }}\"><img id=\"villa-expanded\" ref=\"{{ curRef }}\" alt=\"{{ cur.alt }}\" width=\"{{ cur.width }}\" height=\"{{ cur.height }}\" style=\"display:block;width:auto;height:auto;max-width:min(1280px,100%);max-height:calc(100vh - 220px);object-fit:contain;margin:20px 0;border-radius:4px;background:#000\"></sc-if>\n  <div style=\"width:100%;max-width:1280px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap\">\n    <button type=\"button\" id=\"villa-prev\" onClick=\"{{ prev }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 22px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"background:rgba(247,244,234,.12)\"><span aria-hidden=\"true\">←</span>Previous image</button>\n    <button type=\"button\" id=\"villa-next\" onClick=\"{{ next }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 22px;border:1px solid #EEB41E;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"filter:brightness(.94)\">Next image<span aria-hidden=\"true\">→</span></button>\n  </div>\n</div>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  state = { open: false, set: null, i: 0, ret: null };\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  componentWillUnmount() { document.body.style.overflow = ''; }\n  openSet(set, idx, ret, label) {\n    this.setState({ open: true, set, i: idx, ret, label });\n    document.body.style.overflow = 'hidden';\n    setTimeout(() => { const c = document.getElementById('villa-close'); if (c) c.focus(); }, 30);\n  }\n  closeViewer() {\n    const ret = this.state.ret;\n    this.setState({ open: false });\n    document.body.style.overflow = '';\n    setTimeout(() => { const btn = ret ? document.querySelector(ret) : null; if (btn) btn.focus(); }, 30);\n  }\n  renderVals() {\n    const D = window.AHV_MAHARAJA || { facts: [], aboutBlocks: [], amenities: [], gallery: [], galleryGroups: [], rooms: [], relatedVillas: [], quote: '' };\n    const A = 'https://ayurvedichealingvillage.com';\n    const gallery = D.gallery || [];\n    const groups = (D.galleryGroups || []).map(name => {\n      const items = gallery.map((g, idx) => ({ ...g, i: idx })).filter(g => g.group === name);\n      return { name, hid: 'gallery-' + name.toLowerCase() + '-h', countLabel: items.length + ' photographs', items: items.map(g => ({ ...g, btnLabel: 'View image: ' + g.alt, open: () => this.openSet(gallery, g.i, 'button[data-gallery-index=\"' + g.i + '\"]', 'Maharaja Suite gallery') })) };\n    });\n    const rooms = (D.rooms || []).map((r, idx) => ({ ...r, i: idx, btnLabel: r.images.length + ' photos', open: () => this.openSet(r.images, 0, 'button[data-room-index=\"' + idx + '\"]', r.name + ' room ' + r.room + ' photos') }));\n    const set = this.state.set || [];\n    const n = set.length, i = this.state.i;\n    const cur = set[i] || { image: '', alt: '', width: 1400, height: 1000 };\n    const go = (d) => this.setState(s => ({ i: (s.i + d + n) % n }));\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      D, galleryGroups: groups, rooms, aboutBlocks: (D.aboutBlocks || []).map(b => ({ ...b, isP: b.type === 'p', isUl: b.type === 'ul' })),\n      relatedVillas: (D.relatedVillas || []).map(o => ({ ...o, url: A + o.href })),\n      dlgDisplay: this.state.open ? 'flex' : 'none', dlgOpen: this.state.open, dlgLabel: this.state.label || 'Maharaja Suite gallery',\n      cur,\n      // New closure per render, so React re-attaches and assigns the current source each time cur changes.\n      curRef: (el) => { if (el && cur.image) { el.setAttribute('src', cur.image); } },\n      counter: n ? (i + 1) + ' of ' + n : '',\n      close: () => this.closeViewer(), prev: () => go(-1), next: () => go(1),\n      dlgKey: (e) => {\n        if (e.key === 'Escape') { e.preventDefault(); this.closeViewer(); return; }\n        if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); return; }\n        if (e.key === 'ArrowRight') { e.preventDefault(); go(1); return; }\n        if (e.key === 'Tab') {\n          const f = [...e.currentTarget.querySelectorAll('button')];\n          const first = f[0], last = f[f.length - 1];\n          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }\n          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }\n        }\n      }\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/maharaja-suite-data.js"]}