{"id":"ahv-page-ashtanga-retreat-mobile","file":"AHV Page Ashtanga Retreat Mobile.dc.html","sourceSha256":"6388f2737f5defba04ce3099c30b8dc335cf77ebee60972de690cf14f5a80779","variant":"mobile","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Ashtanga Yoga &amp; Ayurveda Retreat | Luxury Wellness Retreat in India</title>\n<meta name=\"description\" content=\"Experience deep healing at the Ashtanga Yoga &amp; Ayurveda Retreat at Kairali – The Ayurvedic Healing Village. Enjoy guided yoga, meditation, Ayurvedic therapies &amp; sattvic meals in a serene Kerala retreat.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/ashtanga-yoga-and-ayurveda-retreat/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:title\" content=\"Ashtanga Yoga &amp; Ayurveda Retreat\">\n<meta property=\"og:description\" content=\"Experience deep healing at the Ashtanga Yoga &amp; Ayurveda Retreat at Kairali – The Ayurvedic Healing Village. Enjoy guided yoga, meditation, Ayurvedic therapies &amp; sattvic meals in a serene Kerala retreat.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/ashtanga-yoga-and-ayurveda-retreat/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-cont