  "template": "\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\nsummary{cursor:pointer;list-style:none;position:relative}summary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";position:absolute;right:4px;top:50%;transform:translateY(-50%);font-size:26px;color:#8F6212;line-height:1}\ndetails[open] summary::after{content:\"–\"}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>One-Day Ayurveda Workshop at Kairali – Learn &amp; Rejuvenate</title>\n<meta name=\"description\" content=\"Join Kairali’s one-day Ayurveda workshop in Kerala. Discover Ayurvedic principles, therapies, diet &amp; yoga for holistic wellness in a serene retreat setting.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/one-day-ayurveda-workshop-program-kerala/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"One-Day Ayurveda Workshop at Kairali – Learn &amp; Rejuvenate\">\n<meta property=\"og:description\" content=\"Join Kairali’s one-day Ayurveda workshop in Kerala. Discover Ayurvedic principles, therapies, diet &amp; yoga for holistic wellness in a serene retreat setting.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/one-day-ayurveda-workshop-program-kerala/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2024/11/4-17-1.jpg\">\n<meta property=\"og:image:width\" content=\"1400\">\n<meta property=\"og:image:height\" content=\"1000\">\n<meta property=\"og:image:type\" content=\"image/jpeg\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/\",\"url\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/\",\"name\":\"Ayurveda Training Courses & Workshops in Kerala | Kairali\",\"description\":\"Explore Ayurveda training courses and workshops at Kairali in Kerala. Compare course durations, training hours and levels, and enquire about current dates and fees.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"FAQPage\",\"@id\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Who is this training program suitable for?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Our program is suitable for therapists, doctors, dieticians, managers, students, and Ayurveda enthusiasts who wish to deepen their knowledge and skills in Ayurveda.\"}},{\"@type\":\"Question\",\"name\":\"What is the duration of the training program?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The listed course options run for 1, 3, 5, 10 or 20 days, with 3, 9, 15, 40 or 80 training hours respectively.\"}},{\"@type\":\"Question\",\"name\":\"Can I specialize in a specific area of Ayurveda?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Our program allows you to customize your learning experience and focus on specific areas of interest within Ayurveda, such as therapy, nutrition, consultation, or management.\"}}]},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Training Programs\",\"item\":\"https://ayurvedichealingvillage.com/training-programs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"the One-Day Workshop\",\"item\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"the One-Day Workshops — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 40px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;gap:8px;align-items:center\"><a href=\"https://ayurvedichealingvillage.com/\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/training-programs/\" style=\"display:inline-flex;align-items:center;min-height:44px\">Training Programs</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118\">One-Day Ayurveda Workshop</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:48px;align-items:end;padding-top:6px\">\n    <div>\n      <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Ayurveda training course · OAP-HV · 1 day</div>\n      <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.6vw,54px);line-height:1.12;margin:12px 0 0;max-width:20ch;text-wrap:balance\">One-Day Ayurveda Workshop</h1>\n      <p style=\"font-size:19px;line-height:1.65;color:#514a3f;max-width:66ch;margin:20px 0 0;border-left:3px solid #C1882C;padding-left:20px\">A three-hour introduction to Ayurveda at the hospital: two hours of guided theory with an Ayurvedic doctor, then a 45-minute Abhyangam session so the principles are felt as well as heard. No prior knowledge is needed, and a participation certificate is awarded at the close.</p>\n    </div>\n    <div style=\"background:#43331E;color:#F7F4EA;border-radius:4px;padding:28px 30px\">\n      <h2 style=\"font-family:'Marcellus',serif;font-size:24px;line-height:1.3;color:#fff\">Plan your Ayurveda training</h2>\n      <p style=\"margin:12px 0 20px;font-size:17px;line-height:1.65;color:rgba(247,244,234,.92)\">Tell us about your background and the course you are considering. We can discuss the training options with you.</p>\n      <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:48px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 28px;font-weight:700;font-size:14.5px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Enquire about Ayurveda training</a>\n    </div>\n  </div>\n</section>\n\n<nav aria-label=\"On this page\" style=\"position:sticky;top:0;z-index:40;background:rgba(247,244,234,.97);backdrop-filter:blur(8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;gap:4px 26px;flex-wrap:wrap;align-items:center\">\n    <a href=\"#process\" style=\"display:inline-flex;align-items:center;min-height:50px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Process</a>\n    <a href=\"#features\" style=\"display:inline-flex;align-items:center;min-height:50px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Features</a>\n    <a href=\"#courses\" style=\"display:inline-flex;align-items:center;min-height:50px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Courses</a>\n    <a href=\"#faqs\" style=\"display:inline-flex;align-items:center;min-height:50px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">FAQs</a>\n    <a href=\"#related\" style=\"display:inline-flex;align-items:center;min-height:50px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Related programmes</a>\n  </div>\n</nav>\n\n<section id=\"process\" aria-labelledby=\"process-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:64px 0 0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:56px;align-items:start\">\n  <img src=\"/ahv/assets/img/AHV-Ananda-Workshop.webp\" alt=\"One-Day Ayurveda Workshop — training at Kairali – The Ayurvedic Healing Village\" width=\"580\" height=\"386\" loading=\"lazy\" style=\"width:100%;max-width:580px;height:auto;display:block;border-radius:4px;position:sticky;top:76px\">\n  <div>\n    <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">The programme</div>\n    <h2 id=\"process-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:12px 0 18px;text-wrap:balance\">Process Involved In the One-Day Workshop</h2>\n    <p style=\"margin:0 0 22px;max-width:64ch\">{{ processLead }}</p>\n    <div style=\"display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ steps }}\" as=\"st\" hint-placeholder-count=\"5\">\n        <div style=\"display:grid;grid-template-columns:52px minmax(0,1fr);gap:18px;padding:16px 0;border-bottom:1px solid #E0D7C4\">\n          <div style=\"font-family:'Marcellus',serif;font-size:24px;color:#8F6212;line-height:1.2\">{{ st.n }}</div>\n          <p style=\"margin:0;max-width:60ch\"><strong style=\"font-weight:700;color:#2A2118\">{{ st.label }}</strong>{{ st.body }}</p>\n        </div>\n      </sc-for>\n    </div>\n  </div>\n</section>\n\n<section id=\"features\" aria-label=\"Features and learning outcomes\" style=\"scroll-margin-top:60px;margin-top:64px;padding:56px 0 60px;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n<div style=\"width:min(1220px,94%);margin:0 auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px 56px\">\n  <div style=\"display:flex;flex-direction:column;gap:24px\">\n    <img src=\"/ahv/assets/img/AHV-Ayurveda-Training-Practice.webp\" alt=\"A therapist pouring oil into a suspended brass vessel.\" width=\"720\" height=\"500\" loading=\"lazy\" style=\"width:100%;max-width:720px;height:auto;display:block;border-radius:4px\">\n    <div>\n      <h2 style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,34px);line-height:1.2;margin:0 0 16px\">Features of the program</h2>\n      <ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px\">\n        <sc-for list=\"{{ features }}\" as=\"f\" hint-placeholder-count=\"3\">\n          <li style=\"display:flex;gap:12px;align-items:baseline;max-width:60ch\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span><strong style=\"font-weight:700\">{{ f.label }}</strong>{{ f.body }}</span></li>\n        </sc-for>\n      </ul>\n    </div>\n  </div>\n  <div style=\"display:flex;flex-direction:column;gap:24px\">\n    <img src=\"/ahv/assets/img/AHV-Ayurveda-Training-Therapies.webp\" alt=\"Therapists applying warm oil along a patient’s leg.\" width=\"720\" height=\"500\" loading=\"lazy\" style=\"width:100%;max-width:720px;height:auto;display:block;border-radius:4px\">\n    <div>\n      <h2 style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.6vw,34px);line-height:1.2;margin:0 0 16px\">Learning outcomes</h2>\n      <ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px\">\n        <sc-for list=\"{{ learning }}\" as=\"f\" hint-placeholder-count=\"3\">\n          <li style=\"display:flex;gap:12px;align-items:baseline;max-width:60ch\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span><strong style=\"font-weight:700\">{{ f.label }}</strong>{{ f.body }}</span></li>\n        </sc-for>\n      </ul>\n    </div>\n  </div>\n</div>\n</section>\n\n<section id=\"courses\" aria-labelledby=\"courses-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:64px 0 0\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Five course options</div>\n  <h2 id=\"courses-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:12px 0 12px\">Available Courses</h2>\n  <p style=\"margin:0 0 28px;color:#514a3f;max-width:70ch\">Explore the course options below. Contact us to discuss the programme, dates, current fees and inclusions.</p>\n  <div style=\"background:#FFFDF7;border:1px solid #E9E2D3;border-top:3px solid #C1882C;border-radius:4px;overflow-x:auto\">\n    <table style=\"width:100%;border-collapse:collapse;font-size:16px;line-height:1.55\">\n      <caption style=\"position:absolute;left:-9999px\">Ayurveda training courses: code, duration, training hours, level and suitable for</caption>\n      <thead>\n        <tr style=\"background:#F2EDDF\">\n          <th scope=\"col\" style=\"text-align:left;padding:14px 18px;font-size:12.5px;letter-spacing:1.6px;text-transform:uppercase;color:#75695A;font-weight:700;border-bottom:1px solid #E0D7C4\">Course</th>\n          <th scope=\"col\" style=\"text-align:left;padding:14px 18px;font-size:12.5px;letter-spacing:1.6px;text-transform:uppercase;color:#75695A;font-weight:700;border-bottom:1px solid #E0D7C4\">Code</th>\n          <th scope=\"col\" style=\"text-align:left;padding:14px 18px;font-size:12.5px;letter-spacing:1.6px;text-transform:uppercase;color:#75695A;font-weight:700;border-bottom:1px solid #E0D7C4\">Duration</th>\n          <th scope=\"col\" style=\"text-align:left;padding:14px 18px;font-size:12.5px;letter-spacing:1.6px;text-transform:uppercase;color:#75695A;font-weight:700;border-bottom:1px solid #E0D7C4\">Training hours</th>\n          <th scope=\"col\" style=\"text-align:left;padding:14px 18px;font-size:12.5px;letter-spacing:1.6px;text-transform:uppercase;color:#75695A;font-weight:700;border-bottom:1px solid #E0D7C4\">Level</th>\n          <th scope=\"col\" style=\"text-align:left;padding:14px 18px;font-size:12.5px;letter-spacing:1.6px;text-transform:uppercase;color:#75695A;font-weight:700;border-bottom:1px solid #E0D7C4\">Suitable for</th>\n        </tr>\n      </thead>\n      <tbody>\n        <sc-for list=\"{{ courses }}\" as=\"c\" hint-placeholder-count=\"5\">\n          <tr style=\"vertical-align:top;border-bottom:1px solid #EDE5D3\">\n            <th scope=\"row\" style=\"text-align:left;padding:18px 18px;font-weight:400;width:30%\"><span style=\"display:block;font-family:'Marcellus',serif;font-size:19px;line-height:1.35\"><a href=\"{{ c.href }}\" style=\"color:#2A2118\" style-hover=\"color:#006038\">{{ c.name }}</a></span><a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" aria-label=\"Enquire about this course: {{ c.name }}\" style=\"margin-top:12px;display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1.5px solid #5A4420;color:#5A4420;border-radius:4px;font-weight:700;font-size:12.5px;letter-spacing:1.4px;text-transform:uppercase\" style-hover=\"background:#5A4420;color:#F7F4EA;text-decoration:none\">Enquire about this course</a></th>\n            <td style=\"padding:18px 18px;color:#75695A;font-size:15.5px;white-space:nowrap\">{{ c.code }}</td>\n            <td style=\"padding:18px 18px;font-weight:600\">{{ c.duration }}</td>\n            <td style=\"padding:18px 18px;font-weight:600\">{{ c.hours }}</td>\n            <td style=\"padding:18px 18px\">{{ c.level }}</td>\n            <td style=\"padding:18px 18px;color:#514a3f;font-size:15.5px;width:28%\">{{ c.audience }}</td>\n          </tr>\n        </sc-for>\n      </tbody>\n    </table>\n  </div>\n  <p style=\"margin:18px 0 0;font-size:15.5px;color:#75695A\">Contact us for current course fees, dates and inclusions.</p>\n</section>\n\n<section aria-label=\"Plan your Ayurveda training\" style=\"position:relative;overflow:hidden;background:#43331E;color:#F7F4EA;margin-top:64px\">\n  <img src=\"/ahv/assets/img/lotus.svg\" alt=\"\" aria-hidden=\"true\" style=\"position:absolute;right:-60px;top:-50px;width:430px;opacity:.08;pointer-events:none\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:60px 0;display:grid;grid-template-columns:minmax(0,1.4fr) auto;gap:32px 64px;align-items:center\">\n    <div>\n      <h2 style=\"font-family:'Marcellus',serif;font-size:clamp(30px,3vw,42px);line-height:1.18;color:#fff;text-wrap:balance\">Plan your Ayurveda training</h2>\n      <p style=\"margin:14px 0 0;color:rgba(247,244,234,.92);font-size:17.5px;line-height:1.75;max-width:60ch\">Tell us about your background and the course you are considering. We can discuss the training options with you.</p>\n    </div>\n    <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;justify-content:center;min-height:52px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 34px;font-weight:700;font-size:15px;letter-spacing:1.5px;text-transform:uppercase;text-align:center\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Enquire about Ayurveda training</a>\n  </div>\n</section>\n\n<section id=\"faqs\" aria-labelledby=\"faq-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:64px 0 0\">\n  <h2 id=\"faq-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);margin:0 0 26px\">Frequently asked questions</h2>\n  <div style=\"display:flex;flex-direction:column;border-top:1px solid #D8D1C0;max-width:900px\">\n    <sc-for list=\"{{ faq }}\" as=\"q\" hint-placeholder-count=\"3\">\n      <details style=\"border-bottom:1px solid #D8D1C0\">\n        <summary style=\"font-family:'Marcellus',serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 44px 19px 0;min-height:44px;box-sizing:border-box\" style-hover=\"color:#006038\">{{ q.question }}</summary>\n        <p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f;max-width:70ch\">{{ q.answer }}</p>\n      </details>\n    </sc-for>\n  </div>\n</section>\n\n<section id=\"related\" aria-labelledby=\"related-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:64px 0 72px\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Ayurvedic treatment programmes</div>\n  <h2 id=\"related-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);margin:12px 0 24px\">Explore more programmes</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));gap:0 32px;border-top:1px solid #E9E2D3\">\n    <sc-for list=\"{{ related }}\" as=\"r\" hint-placeholder-count=\"8\">\n      <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.href }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n    </sc-for>\n  </ul>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:44px;display:flex;justify-content:center;gap:8px 28px;flex-wrap:wrap;border-top:1px solid #E9E2D3;padding-top:22px\">\n    <a href=\"https://ayurvedichealingvillage.com/social-responsibilities/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Social Responsibility</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Past Retreats</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">News &amp; Past Events</a>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n<section data-rate-reference=\"KTAHV/TRG/EN-INR/20260925-R1\" style=\"width:min(1100px,92%);margin:32px auto;padding:24px 0;line-height:1.7\"><h2>Residential training tariff</h2><p>Rates effective 1 October 2026 to 30 September 2027. Per night, per villa; accommodation, meals, training and taxes included.</p><div style=\"overflow-x:auto\"><table style=\"width:100%;text-align:left;border-collapse:collapse\"><thead><tr><th>Villa</th><th>Single occupancy</th><th>Double occupancy</th></tr></thead><tbody><tr><th scope=\"row\">Deluxe Villa</th><td>₹18,410</td><td>₹30,530</td></tr><tr><th scope=\"row\">Classic Villa</th><td>₹20,855</td><td>₹32,735</td></tr><tr><th scope=\"row\">Royal Villa</th><td>₹25,160</td><td>₹36,620</td></tr><tr><th scope=\"row\">Maharaja Suite</th><td>₹45,110</td><td>₹55,520</td></tr></tbody></table></div><p>1-night course: Deluxe Villa single-occupancy total ₹18,410 (₹18,410 × 1 nights).</p><p>Classes run Monday to Friday. Personal treatments and optional services are charged separately. Group discount: 20% for five or more students.</p><details><summary>Booking and cancellation terms</summary><p>Rates effective 1 October 2026 to 30 September 2027. Per night, per villa, by occupancy; all government taxes included.</p><h3>Booking and payment</h3><ul><li>A 40% deposit secures the booking; the balance is due no later than 30 days before admission</li><li>Requests for a specific villa must be made at least six months in advance and are subject to availability; confirmation requires full payment</li></ul><h3>Admission and discharge</h3><ul><li>Check-in from 12:00 noon; check-out by 10:00</li><li>Early check-in and late check-out are available on request, subject to availability, and may carry a charge</li></ul><h3>Cancellation</h3><ul><li>More than 30 days before admission: full refund</li><li>15 to 30 days before admission: 50% of the amount paid is refunded, less applicable transaction fees and taxes</li><li>Fewer than 15 days before admission, or a change of dates during the stay: no refund</li></ul><h3>Children</h3><ul><li>Under 5 years: complimentary</li><li>5 to 12 years: 50% of the meal charge; extra bed at the standard rate</li><li>Over 12 years: full charge</li><li>Parents or guardians must supervise children at all times. Parts of the facility are treatment areas and are not suitable for children</li></ul><p>See the <a href=\"/documents/\">published tariff</a> for full inclusions, exclusions and terms. KTAHV/TRG/EN-INR/20260925-R1.</p></details></section>",
  "logic": "\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_AYURVEDA_TRAINING || { courses: [], process: [], features: [], learning: [], faq: [], relatedLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    // Split \"Label: body\" for typographic emphasis only — text stays byte-identical (label + ': ' + body).\n    const split = (s) => { const i = s.indexOf(': '); return i > 0 ? { label: s.slice(0, i + 2), body: s.slice(i + 2) } : { label: '', body: s }; };\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      processLead: D.process[0] || '',\n      steps: D.process.slice(1).map((s, i) => ({ n: String(i + 1).padStart(2, '0'), ...split(s) })),\n      features: D.features.map(split),\n      learning: D.learning.map(split),\n      courses: D.courses.map(c => ({ ...c, href: A + c.href, duration: c.days + (c.days === 1 ? ' day' : ' days'), hours: c.hours + ' hours' })),\n      faq: D.faq,\n      related: D.relatedLinks.map(r => ({ label: r.label, href: A + r.href }))\n    };\n  }\n}\n",
