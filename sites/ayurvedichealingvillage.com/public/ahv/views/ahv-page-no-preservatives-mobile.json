{"id":"ahv-page-no-preservatives-mobile","file":"AHV Page No Preservatives Mobile.dc.html","sourceSha256":"dbf94a679f6891a41f84092279f3c52ce7ca2191db3e90474dd755a0a11f4efc","variant":"mobile","template":"\n<helmet>\n<meta name=\"design_doc_mode\" content=\"canvas\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\" />\n<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;600;700&display=swap\" rel=\"stylesheet\" />\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: #DCD5C3; font-family: Mulish, system-ui, sans-serif; color: #2A2118; -webkit-font-smoothing: antialiased; }\n  a { color: #006038; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }\n  a:hover { color: #004226; }\n  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }\n</style>\n</helmet>\n\n<div style=\"width: 100%; background: #F7F4EA; background-image: repeating-linear-gradient(0deg, rgba(42,33,24,0.014) 0 1px, rgba(0,0,0,0) 1px 4px); border: 1px solid #C9BFA8; overflow: hidden;\">\n      <dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n\n      <main>\n        <section style=\"padding: 24px 20px 0;\">\n          <nav aria-label=\"Breadcrumb\" style=\"font-size: 13px; line-height: 1.6; color: #75695A; display: flex; flex-wrap: wrap; align-items: center; gap: 8px;\">\n            <a href=\"https://ayurvedichealingvillage.com/\" style=\"min-height: 44px; min-width: 44px; display: inline-flex; align-items: center; padding: 10px 8px; margin-left: -8px;\">Home</a>\n            <span aria-hidden=\"true\" style=\"color: #C9BFA8;\">·</span>\n            <span aria-current=\"page\" style=\"color: #514A3F;\">No Preservatives</span>\n          </nav>\n          <p style=\"margin: 22px 0 0; font-size: 12.5px; line-height: 1.65; letter-spacing: 2.6px; text-transform: uppercase; color: #8F6212; font-weight: 600;\">Kairali — The Ayurvedic Healing Village · Since 1908</p>\n          <h1 style=\"margin: 14px 0 0; font-family: Marcellus, serif; font-weight: 400; font-size: 36px; line-height: 1.16; color: #2A2118; text-wrap: pretty;\">No Preservatives</h1>\n          <div style=\"margin: 22px 0 0; border-left: 2px solid #C1882C; padding-left: 16px;\">\n            <p style=\"margin: 0; font-size: 17.5px; line-height: 1.65; color: #514A3F; text-wrap: pretty;\">Nothing served at Kairali is preserved, canned or chemically stabilised. Meals are cooked the day they are eaten, from produce picked on the property.</p>\n            <sc-if value=\"{{ showDraft }}\" hint-placeholder-val=\"{{ true }}\"><p style=\"margin: 12px 0 0; font-size: 11px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; color: #8F6212;\">Draft standfirst — approve or replace</p></sc-if>\n          </div>\n        </section>\n\n        <div style=\"overflow:hidden;margin: 28px 0 0; width: 100%; height: 230px; background: #E0D7C4; background-image: repeating-linear-gradient(135deg, rgba(90,68,32,0.05) 0 1px, rgba(0,0,0,0) 1px 9px); border-top: 1px solid #E9E2D3; border-bottom: 1px solid #E9E2D3; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 0 20px;\"><img src=\"/ahv/assets/img/gallery/ee7d129f97f1b7e211572def4f1bbae675da2b34eaf75e3b76df1d57f01a63bd.webp\" alt=\"Aerial view of paddy fields and coconut palms in the Kerala countryside around the hospital\" loading=\"eager\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n\n        <nav aria-labelledby=\"rules-a\" style=\"margin: 44px 0 0; background: #E0D7C4; border-top: 1px solid #C9BFA8; border-bottom: 1px solid #C9BFA8; padding: 30px 0 4px;\">\n          <div style=\"padding: 0 20px;\">\n            <h2 id=\"rules-a\" style=\"margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 2.4px; text-transform: uppercase; color: #5A4420;\">House rules of the property</h2>\n            <p style=\"margin: 12px 0 0; font-size: 16.5px; line-height: 1.6; color: #514A3F;\">Eight standing rules govern daily life here. Each is explained on its own page.</p>\n          </div>\n          <ul style=\"margin: 22px 0 0; padding: 0; list-style: none;\">\n            <li><a href=\"https://ayurvedichealingvillage.com/no-smoking/\" style=\"display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 58px; padding: 14px 20px; border-top: 1px solid #C9BFA8; font-size: 18px; line-height: 1.45; text-decoration: none;\"><span>No Smoking</span><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span></a></li>\n            <li><a href=\"https://ayurvedichealingvillage.com/alcohol-free/\" style=\"display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 58px; padding: 14px 20px; border-top: 1px solid #C9BFA8; font-size: 18px; line-height: 1.45; text-decoration: none;\"><span>Alcohol Free</span><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span></a></li>\n            <li><a href=\"https://ayurvedichealingvillage.com/no-caffeine/\" style=\"display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 58px; padding: 14px 20px; border-top: 1px solid #C9BFA8; font-size: 18px; line-height: 1.45; text-decoration: none;\"><span>No Caffeine</span><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span></a></li>\n            <li><span aria-current=\"page\" style=\"display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 58px; padding: 14px 20px; border-top: 1px solid #C9BFA8; background: #F7F4EA; font-size: 18px; line-height: 1.45; color: #2A2118; font-weight: 700;\"><span>No Preservatives</span><span style=\"font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #8F6212;\">You are here</span></span></li>\n            <li><a href=\"https://ayurvedichealingvillage.com/no-refridgeration/\" style=\"display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 58px; padding: 14px 20px; border-top: 1px solid #C9BFA8; font-size: 18px; line-height: 1.45; text-decoration: none;\"><span>No Refridgeration</span><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span></a></li>\n            <li><a href=\"https://ayurvedichealingvillage.com/vegetarian/\" style=\"display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 58px; padding: 14px 20px; border-top: 1px solid #C9BFA8; font-size: 18px; line-height: 1.45; text-decoration: none;\"><span>Vegetarian</span><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span></a></li>\n            <li><a href=\"https://ayurvedichealingvillage.com/organic-farm/\" style=\"display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 58px; padding: 14px 20px; border-top: 1px solid #C9BFA8; font-size: 18px; line-height: 1.45; text-decoration: none;\"><span>Organic Farming</span><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span></a></li>\n            <li><a href=\"https://ayurvedichealingvillage.com/animal-husbandry/\" style=\"display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 58px; padding: 14px 20px; border-top: 1px solid #C9BFA8; border-bottom: 1px solid #C9BFA8; font-size: 18px; line-height: 1.45; text-decoration: none;\"><span>Animal Husbandry</span><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span></a></li>\n          </ul>\n          <div style=\"padding: 22px 20px 26px;\">\n            <h3 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 20px; line-height: 1.3; color: #2A2118;\">A question about the diet?</h3>\n            <p style=\"margin: 8px 0 0; font-size: 16.5px; line-height: 1.6; color: #514A3F;\">Write to the patient care team before admission.</p>\n            <a href=\"mailto:info@kairali.com\" style=\"display: inline-flex; align-items: center; min-height: 44px; margin-top: 6px; font-size: 17px;\">info@kairali.com</a>\n          </div>\n        </nav>\n<article style=\"padding: 34px 20px 0;\">\n          <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 25px; line-height: 1.26; color: #2A2118; text-wrap: pretty;\">Kairali – The Ayurvedic Healing Village: Advocating Fresh, Natural Foods for Holistic Wellness</h2>\n          <p style=\"margin: 18px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; text-wrap: pretty;\">At <span style=\"font-weight: 700;\">Kairali – The Ayurvedic Healing Village</span>, the importance of wholesome, fresh, and unadulterated food is deeply rooted in its Ayurvedic philosophy. Food is not just nourishment for the body; it is a vital source of energy and balance for the mind and soul. Central to Ayurveda is the concept of <span style=\"font-weight: 700;\">‘prana’</span>, the life force present in fresh food, which is essential for maintaining health and vitality. Preserved and canned foods, however, lack this vital energy and fail to meet the body’s holistic nutritional needs.</p>\n        </article>\n\n        <figure style=\"margin: 30px 0 0;\">\n          <img src=\"/ahv/assets/img/house-rules/no-preservatives-2026.webp\" alt=\"Illustration of fresh vegetables, leafy greens and pumpkin\" loading=\"lazy\" style=\"width:100%;height:auto;object-fit:contain;display:block;\">\n        </figure>\n\n        <article style=\"padding: 0 20px;\">\n          <div style=\"margin: 34px 0 0; border-top: 1px solid #E9E2D3; padding-top: 26px;\">\n            <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 25px; line-height: 1.26; color: #2A2118; text-wrap: pretty;\">The Drawbacks of Preserved and Canned Foods</h2>\n            <p style=\"margin: 18px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; text-wrap: pretty;\">Preserved and canned foods, while convenient, often lose their nutritional integrity and vitality during processing. Packed with preservatives and artificial additives, these foods are devoid of the natural essence required to sustain optimal health. According to Ayurveda, such foods disturb the body’s natural equilibrium by aggravating the doshas, leading to imbalances that manifest as obesity, digestive disorders, and other chronic ailments.</p>\n            <p style=\"margin: 18px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118;\">Key issues with preserved and canned foods include:</p>\n            <ol style=\"margin: 22px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 20px;\">\n              <li style=\"display: flex; flex-direction: column; gap: 6px;\"><span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 20px; color: #C1882C;\">1</span><span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Loss of Vitality and Nutrients</span>: The processing of food strips it of essential nutrients and prana, reducing its ability to nourish the body effectively.</span></li>\n              <li style=\"display: flex; flex-direction: column; gap: 6px;\"><span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 20px; color: #C1882C;\">2</span><span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Aggravation of Doshas</span>: Consuming such foods disrupts the balance of Vata, Pitta, and Kapha doshas, which are vital for physical and mental harmony.</span></li>\n              <li style=\"display: flex; flex-direction: column; gap: 6px;\"><span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 20px; color: #C1882C;\">3</span><span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Adulteration and Health Risks</span>: The presence of preservatives and chemicals can lead to toxicity in the body over time, impairing metabolism and overall health.</span></li>\n              <li style=\"display: flex; flex-direction: column; gap: 6px;\"><span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 20px; color: #C1882C;\">4</span><span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Digestive Challenges</span>: These foods often lack the natural fiber and enzymes needed to support proper digestion, leading to stagnation and inefficiency in nutrient absorption.</span></li>\n            </ol>\n          </div>\n\n          <div style=\"margin: 34px 0 0; border-top: 1px solid #E9E2D3; padding-top: 26px;\">\n            <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 25px; line-height: 1.26; color: #2A2118; text-wrap: pretty;\">Kairali’s Commitment to Freshness and Purity</h2>\n            <p style=\"margin: 18px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; text-wrap: pretty;\">At Kairali, food is regarded as a cornerstone of wellness. The Ayurvedic Healing Village strongly advocates for the consumption of fresh, natural, and unprocessed foods, aligning with the principles of Ayurveda that emphasize purity and balance. By promoting a diet rich in seasonal fruits, vegetables, whole grains, and freshly prepared meals, Kairali ensures that guests receive the nourishment they need for a healthy and balanced life.</p>\n          </div>\n\n          <div style=\"margin: 34px 0 0; border-top: 1px solid #E9E2D3; padding-top: 26px;\">\n            <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 25px; line-height: 1.26; color: #2A2118;\">Why Fresh Food Matters:</h2>\n            <ol style=\"margin: 22px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 20px;\">\n              <li style=\"display: flex; flex-direction: column; gap: 6px;\"><span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 20px; color: #C1882C;\">1</span><span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Restores Balance</span>: Fresh foods help maintain the dosha balance, promoting optimal physical and mental health.</span></li>\n              <li style=\"display: flex; flex-direction: column; gap: 6px;\"><span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 20px; color: #C1882C;\">2</span><span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Enhances Vitality</span>: Foods rich in prana energize the body, improve digestion, and support a stronger immune system.</span></li>\n              <li style=\"display: flex; flex-direction: column; gap: 6px;\"><span aria-hidden=\"true\" style=\"font-family: Marcellus, serif; font-size: 20px; color: #C1882C;\">3</span><span style=\"font-size: 18px; line-height: 1.7; color: #2A2118;\"><span style=\"font-weight: 700;\">Purity for the Body and Mind</span>: Fresh, wholesome meals detoxify the body, calm the mind, and elevate the spirit, aligning with Ayurveda’s holistic approach to well-being.</span></li>\n            </ol>\n          </div>\n\n          <div style=\"margin: 34px 0 0; border-top: 1px solid #E9E2D3; padding-top: 26px;\">\n            <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 25px; line-height: 1.26; color: #2A2118; text-wrap: pretty;\">A Lifestyle Free from Preservatives</h2>\n            <p style=\"margin: 18px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; text-wrap: pretty;\">Kairali’s kitchen practices align with its ethos of purity and simplicity. Meals prepared at the retreat use fresh, locally sourced ingredients, free from preservatives and artificial additives. This approach not only supports physical health but also fosters mindfulness and a deeper connection to the food we consume.</p>\n            <p style=\"margin: 18px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; text-wrap: pretty;\">In addition to offering a fresh food philosophy, Kairali encourages guests to adopt these habits in their daily lives. By avoiding preserved and canned foods, individuals can break free from the cycle of poor nutrition, regain energy, and live a malady-free life.</p>\n          </div>\n\n          <div style=\"margin: 34px 0 0; border-top: 1px solid #E9E2D3; padding-top: 26px;\">\n            <h2 style=\"margin: 0; font-family: Marcellus, serif; font-weight: 400; font-size: 25px; line-height: 1.26; color: #2A2118; text-wrap: pretty;\">A Commitment to Holistic Health</h2>\n            <p style=\"margin: 18px 0 0; font-size: 18px; line-height: 1.7; color: #2A2118; text-wrap: pretty;\"><span style=\"font-weight: 700;\">Kairali – The Ayurvedic Healing Village</span> serves as a beacon of Ayurvedic wisdom, inspiring a lifestyle centred around balance, purity, and well-being. Its promotion of fresh, natural foods underscores its dedication to holistic health, empowering individuals to make choices that nurture their body, mind, and soul. By embracing the power of fresh foods, Kairali helps its guests embark on a journey of rejuvenation and vitality, creating a foundation for a healthier and more fulfilling life.</p>\n          </div>\n        </article>\n\n        \n\n        <section aria-labelledby=\"closing-a\" style=\"border-top: 1px solid #E9E2D3; border-bottom: 1px solid #E9E2D3; margin-top: 56px; background: #FFFFFF; background-image: repeating-linear-gradient(45deg, rgba(193,136,44,0.055) 0 1px, rgba(0,0,0,0) 1px 7px); padding: 40px 20px;\">\n          <div style=\"max-width: 760px; margin: 0 auto; text-align: center;\">\n            <ul style=\"margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 18px; text-align: left;\">\n              <li style=\"display: flex; gap: 10px; align-items: baseline; font-size: 16px; line-height: 1.5; color: #2A2118;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>NABH Certified Hospital</span></li>\n              <li style=\"display: flex; gap: 10px; align-items: baseline; font-size: 16px; line-height: 1.5; color: #2A2118;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>118+ Years Heritage</span></li>\n              <li style=\"display: flex; gap: 10px; align-items: baseline; font-size: 16px; line-height: 1.5; color: #2A2118;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>Individualised Programmes</span></li>\n              <li style=\"display: flex; gap: 10px; align-items: baseline; font-size: 16px; line-height: 1.5; color: #2A2118;\"><span aria-hidden=\"true\" style=\"color: #C1882C; font-size: 11px;\">◆</span><span>World Luxury Award Winner</span></li>\n            </ul>\n            <h2 id=\"closing-a\" style=\"margin: 32px 0 0; font-family: Marcellus, serif; font-weight: 400; font-size: 26px; line-height: 1.3; color: #2A2118;\">Not sure which programme fits?</h2>\n            <p style=\"margin: 12px auto 0; font-size: 16.5px; line-height: 1.7; color: #514A3F;\">Share your goal in your own words — the patient care team or an Ayurvedic doctor will point you to the right programme.</p>\n            <div style=\"margin: 26px 0 0; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;\">\n              <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" style=\"display: inline-flex; align-items: center; justify-content: center; width: 100%; height: 52px; padding: 0 18px; border-radius: 4px; background: #EEB41E; color: #2A2118; border: 1.5px solid #EEB41E; font-weight: 700; font-size: 14px; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none;\">Free Doctor Consultation</a>\n              <a href=\"https://wa.me/919289838797\" style=\"display: inline-flex; align-items: center; justify-content: center; width: 100%; height: 52px; padding: 0 18px; border-radius: 4px; background: rgba(0,0,0,0); color: #006038; border: 1.5px solid #006038; font-weight: 700; font-size: 14px; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none;\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp Patient Care</a>\n              <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" style=\"display: inline-flex; align-items: center; justify-content: center; width: 100%; height: 52px; padding: 0 18px; border-radius: 4px; background: rgba(0,0,0,0); color: #5A4420; border: 1.5px solid #5A4420; font-weight: 700; font-size: 14px; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none;\">Enquire Now</a>\n            </div>\n          </div>\n        </section>\n      </main>\n\n      <dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n    </div>\n\n","logic":"\nclass Component extends DCLogic {\n  renderVals() {\n    return { showDraft: this.props.showDraftMarkers ?? false };\n  }\n}\n","props":"{\"showDraftMarkers\":{\"editor\":\"boolean\",\"default\":false,\"tsType\":\"boolean\",\"section\":\"Review\"}}","scripts":[]}
