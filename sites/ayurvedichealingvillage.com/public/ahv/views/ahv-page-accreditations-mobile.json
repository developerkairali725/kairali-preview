{"id":"ahv-page-accreditations-mobile","file":"AHV Page Accreditations Mobile.dc.html","sourceSha256":"b10c33cb110a2dc932dd561e78c6df21f891b8f9bfcacf2211539f0c4e3ff693","variant":"mobile","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n\n<style>\nbody{margin:0;background:#EFE9DA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:17px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nbutton{font-family:inherit;cursor:pointer}\nh1,h2,h3,h4{font-weight:400;margin:0}\nsummary::-webkit-details-marker{display:none}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Accredited Ayurvedic Wellness at Kairali - A Trusted Retreat</title>\n<meta name=\"description\" content=\"Kairali - The Ayurvedic Healing Village is globally recognized for authentic Ayurveda, ISO certification, Green Leaf accreditation, and eco-friendly wellness practices.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/accreditations/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:title\" content=\"Accreditations\">\n<meta property=\"og:description\" content=\"Kairali - The Ayurvedic Healing Village is globally recognized for authentic Ayurveda, ISO certification, Green Leaf accreditation, and eco-friendly wellness practices.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/accreditations/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/11/our-story.png\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"524\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://ayurvedichealingvillage.com/accreditations/\",\"url\":\"https://ayurvedichealingvillage.com/accreditations/\",\"name\":\"Accredited Ayurvedic Wellness at Kairali - A Trusted Retreat\",\"description\":\"Kairali - The Ayurvedic Healing Village is globally recognized for authentic Ayurveda, ISO certification, Green Leaf accreditation, and eco-friendly wellness practices.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\",\"breadcrumb\":{\"@id\":\"https://ayurvedichealingvillage.com/accreditations/#breadcrumb\"}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/accreditations/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"About Us\",\"item\":\"https://ayurvedichealingvillage.com/about-us/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Awards & Accreditations\",\"item\":\"https://ayurvedichealingvillage.com/awards-and-accreditations/\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Accreditations\",\"item\":\"https://ayurvedichealingvillage.com/accreditations/\"}]},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"}]}\n</script>\n</helmet>\n<div data-screen-label=\"Accreditations — Mobile\" style=\"max-width:430px;margin:0 auto;background:#F7F4EA;box-shadow:0 0 40px rgba(70,50,20,.15);position:relative;box-sizing:border-box\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:20px 0 22px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\">\n    <sc-for list=\"{{ ancestors }}\" as=\"b\" hint-placeholder-count=\"3\">\n      <a href=\"{{ b.canonical }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">{{ b.label }}</a><span aria-hidden=\"true\">/</span>\n    </sc-for>\n    <span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Accreditations</span>\n  </nav>\n  <div style=\"padding-top:4px\">\n    <div style=\"font-weight:700;font-size:12px;letter-spacing:2.4px;color:#8F6212;text-transform:uppercase\">Kairali — The Ayurvedic Healing Village · Since 1908</div>\n    <h1 id=\"page-h1\" style=\"font-family:'Marcellus',serif;font-size:32px;line-height:1.12;margin:10px 0 0;text-wrap:balance\">Accreditations</h1>\n  </div>\n</section>\n<div style=\"width:min(1220px,94%);margin:0 auto\">\n  <img src=\"/ahv/assets/img/AHV-About-Landscape.png\" alt=\"\" width=\"1440\" height=\"524\" style=\"width:100%;height:auto;display:block;border-radius:4px\">\n</div>\n<div style=\"width:min(1220px,94%);margin:0 auto;padding:28px 0 0\">\n  <details style=\"border:1px solid #E0D7C4;border-radius:4px;background:#fff;margin:0 0 32px\">\n    <summary style=\"list-style:none;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px;padding:8px 16px;cursor:pointer;font-weight:700;font-size:13px;letter-spacing:2.4px;color:#8F6212;text-transform:uppercase\"><span>On this page</span><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span></summary>\n    <nav aria-label=\"On this page\" style=\"padding:0 16px 8px\">\n      <ol style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n        <sc-for list=\"{{ toc }}\" as=\"t\" hint-placeholder-count=\"6\">\n          <li style=\"border-bottom:1px solid #E0D7C4\"><a href=\"#{{ t.id }}\" style=\"display:flex;align-items:center;gap:12px;min-height:46px;padding:6px 0;font-size:15.5px;font-weight:600;line-height:1.4;color:#2A2118\">{{ t.label }}</a></li>\n        </sc-for>\n        <li style=\"border-bottom:1px solid #E0D7C4\"><a href=\"#certificates\" style=\"display:flex;align-items:center;gap:12px;min-height:46px;padding:6px 0;font-size:15.5px;font-weight:600;line-height:1.4;color:#2A2118\">Certificates &amp; recognition</a></li>\n      </ol>\n    </nav>\n  </details>\n  <article id=\"accreditations-body\" aria-labelledby=\"page-h1\" style=\"min-width:0\">{{ body }}</article>\n</div>\n\n<section id=\"certificates\" aria-labelledby=\"certificates-h\" style=\"width:min(1220px,94%);margin:24px auto 0;padding:40px 0 56px;border-top:1px solid #E0D7C4;scroll-margin-top:80px\">\n  <p style=\"margin:0 0 6px;font-weight:700;font-size:12.5px;letter-spacing:2.4px;color:#8F6212;text-transform:uppercase;text-align:center\">{{ gallery.eyebrow }}</p>\n  <h2 id=\"certificates-h\" style=\"font-family:'Marcellus',serif;font-size:27px;line-height:1.2;margin:0 0 24px;text-align:center;text-wrap:balance\">{{ gallery.heading }}</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px\">\n    <sc-for list=\"{{ documents }}\" as=\"c\" hint-placeholder-count=\"7\">\n      <li style=\"background:#fff;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden;min-width:0\">\n        <button type=\"button\" data-doc-index=\"{{ c.i }}\" onClick=\"{{ c.open }}\" style=\"display:flex;flex-direction:column;width:100%;height:100%;padding:0;border:0;background:#fff;color:#2A2118;text-align:left\" style-hover=\"color:#006038\">\n          <img src=\"{{ c.src }}\" alt=\"{{ c.label }}\" width=\"{{ c.width }}\" height=\"{{ c.height }}\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-bottom:1px solid #E9E2D3\">\n          <span style=\"display:flex;flex-direction:column;gap:4px;padding:10px 12px 12px;min-height:44px;box-sizing:border-box\"><span style=\"font-weight:700;font-size:14.5px;line-height:1.35\">{{ c.label }}</span><span style=\"display:inline-flex;align-items:center;gap:6px;font-weight:700;font-size:11.5px;letter-spacing:1.6px;text-transform:uppercase;color:#006038\">View<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span></span>\n        </button>\n      </li>\n    </sc-for>\n  </ul>\n</section>\n\n<aside aria-labelledby=\"ctx-h\" style=\"background:#EFE9DA;border-top:1px solid #E0D7C4\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 48px;display:flex;flex-direction:column;gap:28px\">\n    <h2 id=\"ctx-h\" style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.25;margin:0\">{{ ctxHeading }}</h2>\n    <sc-for list=\"{{ groups }}\" as=\"g\" hint-placeholder-count=\"4\">\n      <nav aria-labelledby=\"{{ g.hid }}\" style=\"min-width:0\">\n        <h3 id=\"{{ g.hid }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-family:'Marcellus',serif;font-size:20px;color:#2A2118;border-bottom:2px solid #C1882C\">{{ g.label }}</h3>\n        <ul style=\"list-style:none;margin:6px 0 0;padding:0;display:flex;flex-direction:column\">\n          <sc-for list=\"{{ g.items }}\" as=\"it\" hint-placeholder-count=\"3\">\n            <li style=\"min-width:0\">\n              <sc-if value=\"{{ it.isLink }}\" hint-placeholder-val=\"{{ true }}\"><a href=\"{{ it.href }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;min-height:44px;padding:4px 0;font-size:16.5px;line-height:1.4;color:#2A2118\">{{ it.text }}</a></sc-if>\n              <sc-if value=\"{{ it.isCurrent }}\" hint-placeholder-val=\"{{ false }}\"><span aria-current=\"page\" style=\"display:flex;align-items:center;gap:10px;min-height:44px;padding:4px 0;font-size:16.5px;line-height:1.4;font-weight:700;color:#5A4420\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>{{ it.text }}</span></sc-if>\n            </li>\n          </sc-for>\n        </ul>\n      </nav>\n    </sc-for>\n  </div>\n</aside>\n</main>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n\n<div id=\"doc-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"doc-dialog-title\" onKeyDown=\"{{ dlgKey }}\" style=\"display:{{ dlgDisplay }};position:fixed;inset:0;z-index:200;background:rgba(26,20,12,.96);flex-direction:column;padding:12px;box-sizing:border-box;gap:10px\">\n  <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:10px;color:#F7F4EA\">\n    <div style=\"display:flex;flex-direction:column;gap:2px;min-width:0\"><span aria-live=\"polite\" style=\"font-weight:700;font-size:12px;letter-spacing:1.8px;text-transform:uppercase;color:#E9E2D3\">{{ counter }}</span><span id=\"doc-dialog-title\" style=\"font-family:'Marcellus',serif;font-size:18px;line-height:1.3\">{{ curLabel }}</span></div>\n    <button type=\"button\" id=\"doc-close\" onClick=\"{{ close }}\" aria-label=\"Close document\" style=\"display:inline-flex;align-items:center;justify-content:center;flex:none;width:48px;height:48px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-size:20px\"><span aria-hidden=\"true\">✕</span></button>\n  </div>\n  <div id=\"doc-stage\" style=\"flex:1 1 auto;min-height:0;display:flex;justify-content:center;align-items:flex-start;overflow:auto;border-radius:4px\">{{ viewerImg }}</div>\n  <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px\">\n    <button type=\"button\" id=\"doc-prev\" onClick=\"{{ prev }}\" aria-label=\"Previous document\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-weight:700;font-size:13px;letter-spacing:1.6px;text-transform:uppercase\"><span aria-hidden=\"true\">←</span>Prev</button>\n    <button type=\"button\" id=\"doc-zoom\" aria-pressed=\"{{ zoomPressed }}\" onClick=\"{{ toggleZoom }}\" style=\"display:inline-flex;align-items:center;justify-content:center;min-height:48px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-weight:700;font-size:13px;letter-spacing:1.6px;text-transform:uppercase\">{{ zoomLabel }}</button>\n    <button type=\"button\" id=\"doc-next\" onClick=\"{{ next }}\" aria-label=\"Next document\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;border:1px solid #EEB41E;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:13px;letter-spacing:1.6px;text-transform:uppercase\">Next<span aria-hidden=\"true\">→</span></button>\n  </div>\n</div>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  state = { open: false, i: 0, zoom: false };\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  componentWillUnmount() { document.body.style.overflow = ''; }\n  openAt(idx) {\n    this._opener = idx;\n    const btn = document.querySelector('button[data-doc-index=\"' + idx + '\"]');\n    if (btn) { const r = btn.getBoundingClientRect(); if (r.top < 0 || r.bottom > window.innerHeight) window.scrollTo({ top: window.scrollY + r.top - Math.max(0, (window.innerHeight - r.height) / 2), behavior: 'instant' }); else window.scrollTo({ top: window.scrollY, behavior: 'instant' }); }\n    this.setState({ open: true, i: idx, zoom: false });\n    document.body.style.overflow = 'hidden';\n    setTimeout(() => { const c = document.getElementById('doc-close'); if (c) c.focus(); }, 30);\n  }\n  closeViewer() {\n    const idx = this._opener != null ? this._opener : this.state.i;\n    this.setState({ open: false, zoom: false });\n    document.body.style.overflow = '';\n    setTimeout(() => { const btn = document.querySelector('button[data-doc-index=\"' + idx + '\"]'); if (btn) btn.focus(); }, 30);\n  }\n  renderVals() {\n    const D = window.AHV_ACCREDITATIONS, P = window.AHV_ACCREDITATIONS_RENDER;\n    const A = 'https://ayurvedichealingvillage.com';\n    const guard = (e) => { e.preventDefault(); };\n    if (!D || !P) return { guard, ancestors: [], toc: [], body: null, gallery: {}, documents: [], ctxHeading: '', groups: [], dlgDisplay: 'none', viewerImg: null, counter: '', curLabel: '', zoomLabel: 'Zoom', zoomPressed: 'false' };\n    const docs = D.gallery.documents, n = docs.length, i = this.state.i, cur = docs[i] || docs[0];\n    const go = (d) => this.setState(s => ({ i: (s.i + d + n) % n, zoom: false }));\n    const zoom = this.state.zoom;\n    const viewerImg = this.state.open ? React.createElement('img', { id: 'doc-expanded', key: cur.src + (zoom ? 'z' : 'f'), src: cur.src, alt: cur.label, width: cur.width, height: cur.height,\n      style: zoom ? { display: 'block', width: cur.width + 'px', maxWidth: 'none', height: 'auto', background: '#000' } : { display: 'block', width: 'auto', height: 'auto', maxWidth: '100%', maxHeight: '100%', objectFit: 'contain', background: '#000' } }) : null;\n    return {\n      guard, ancestors: D.breadcrumb.slice(0, -1), toc: P.contents(D), body: P.blocks(D, guard, true),\n      gallery: { eyebrow: D.gallery.eyebrow, heading: D.gallery.heading },\n      documents: docs.map((c, idx) => ({ i: idx, src: c.src, label: c.label, width: c.width, height: c.height, open: () => this.openAt(idx) })),\n      ctxHeading: D.contextNav.heading,\n      groups: D.contextNav.groups.map((g, gi) => ({ hid: 'ctx-g' + gi, label: g.label, items: g.links.map(l => ({ text: l.text, href: A + l.href, isLink: l.href !== D.path, isCurrent: l.href === D.path })) })),\n      dlgDisplay: this.state.open ? 'flex' : 'none', viewerImg, counter: n ? (i + 1) + ' of ' + n : '', curLabel: cur ? cur.label : '',\n      zoomLabel: zoom ? 'Fit' : 'Zoom', zoomPressed: zoom ? 'true' : 'false', toggleZoom: () => this.setState(s => ({ zoom: !s.zoom })),\n      close: () => this.closeViewer(), prev: () => go(-1), next: () => go(1),\n      dlgKey: (e) => {\n        if (e.key === 'Escape') { e.preventDefault(); this.closeViewer(); return; }\n        if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); return; }\n        if (e.key === 'ArrowRight') { e.preventDefault(); go(1); return; }\n        if (e.key === 'Tab') {\n          const f = [...e.currentTarget.querySelectorAll('button')];\n          const first = f[0], last = f[f.length - 1];\n          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }\n          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }\n        }\n      }\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/accreditations-data.js","/ahv/assets/accreditations-render.js"]}