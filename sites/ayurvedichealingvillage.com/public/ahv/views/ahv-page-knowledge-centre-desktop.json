{"id":"ahv-page-knowledge-centre-desktop","file":"AHV Page Knowledge Centre Desktop.dc.html","sourceSha256":"0c29072421734bb88eeaa6687fa1d7c63963db6bcdfdcf74d51cdfa2479fb432","variant":"desktop","template":"\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&amp;family=Mulish:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;display=swap\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Ayurvedic Knowledge Centre – Wisdom, Insights &amp; Holistic Health</title>\n<meta name=\"description\" content=\"Explore Ayurveda’s wisdom with expert insights, seasonal practices & natural remedies. Unlock holistic health & wellness through our Knowledge Centre.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/knowledge-centre/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Ayurvedic Knowledge Centre – Wisdom, Insights &amp; Holistic Health\">\n<meta property=\"og:description\" content=\"Explore Ayurveda’s wisdom with expert insights, seasonal practices & natural remedies. Unlock holistic health & wellness through our Knowledge Centre.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/knowledge-centre/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/09/TREATMENTS-24-min.jpg\">\n<meta property=\"og:image:width\" content=\"772\">\n<meta property=\"og:image:height\" content=\"289\">\n<meta property=\"og:image:type\" content=\"image/jpeg\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://ayurvedichealingvillage.com/knowledge-centre/\",\"url\":\"https://ayurvedichealingvillage.com/knowledge-centre/\",\"name\":\"Ayurvedic Knowledge Centre – Wisdom, Insights & Holistic Health\",\"description\":\"Explore Ayurveda’s wisdom with expert insights, seasonal practices & natural remedies. Unlock holistic health & wellness through our Knowledge Centre.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/knowledge-centre/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Knowledge Centre\",\"item\":\"https://ayurvedichealingvillage.com/knowledge-centre/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Knowledge Centre — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 48px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;gap:8px;align-items:center\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118\">Knowledge Centre</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,min(772px,52%));gap:40px 56px;align-items:end;padding-top:6px\">\n    <div>\n      <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.6vw,54px);line-height:1.12;margin:0;text-wrap:balance\">Knowledge Centre</h1>\n      <p style=\"font-size:19px;line-height:1.65;color:#514a3f;max-width:62ch;margin:20px 0 0;border-left:3px solid #C1882C;padding-left:20px\">Dive into the vibrant realm of Ayurveda via our Knowledge Centre—an organized collection of articles, insights, and timeless wisdom. Discover holistic health, Ayurvedic concepts, seasonal practices, and natural treatments directly from our specialists. Whether you’re an inquisitive student or a health enthusiast, this is your gateway to deeper Ayurvedic understanding.</p>\n    </div>\n    <img src=\"/ahv/assets/img/AHV-Knowledge-Hero.webp\" alt=\"A therapist applying herbal powder during a treatment.\" width=\"772\" height=\"289\" style=\"width:100%;max-width:772px;height:auto;display:block;border-radius:4px;justify-self:end\">\n  </div>\n</section>\n\n<nav aria-label=\"On this page\" style=\"position:sticky;top:0;z-index:40;background:rgba(247,244,234,.97);backdrop-filter:blur(8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;gap:4px 26px;flex-wrap:wrap;align-items:center\">\n    <sc-for list=\"{{ cards }}\" as=\"c\" hint-placeholder-count=\"5\">\n      <a href=\"{{ c.anchor }}\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">{{ c.title }}</a>\n    </sc-for>\n  </div>\n</nav>\n\n<section aria-label=\"Knowledge Centre resources\" style=\"width:min(1220px,94%);margin:0 auto;padding:56px 0 72px\">\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(340px,100%),1fr));gap:36px 32px\">\n    <sc-for list=\"{{ cards }}\" as=\"c\" hint-placeholder-count=\"5\">\n      <li id=\"{{ c.id }}\" style=\"scroll-margin-top:72px;background:#fff;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden;display:flex;flex-direction:column\">\n        <a href=\"{{ c.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;flex:1;color:#2A2118\" style-hover=\"color:#2A2118;text-decoration:none\">\n          <img src=\"{{ c.image }}\" alt=\"{{ c.alt }}\" width=\"{{ c.width }}\" height=\"{{ c.height }}\" loading=\"lazy\" style=\"width:100%;height:auto;display:block\">\n          <span style=\"display:flex;flex-direction:column;gap:14px;padding:22px 24px 24px;flex:1\">\n            <h2 style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.25;color:#2A2118\">{{ c.title }}</h2>\n            <span style=\"margin-top:auto;display:inline-flex;align-items:center;gap:10px;min-height:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#006038\">View<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span>\n          </span>\n        </a>\n      </li>\n    </sc-for>\n  </ul>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:56px;display:flex;justify-content:center;gap:8px 28px;flex-wrap:wrap;border-top:1px solid #E9E2D3;padding-top:22px\">\n    <sc-for list=\"{{ footerLinks }}\" as=\"f\" hint-placeholder-count=\"3\">\n      <a href=\"{{ f.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">{{ f.label }}</a>\n    </sc-for>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_KNOWLEDGE_CENTRE || { cards: [], footerLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      cards: D.cards.map(c => ({ ...c, url: A + c.href, anchor: '#' + c.id })),\n      footerLinks: D.footerLinks.map(f => ({ ...f, url: A + f.href }))\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/knowledge-centre-data.js"]}