{"id":"ahv-page-awards-and-accolades-desktop","file":"AHV Page Awards and Accolades Desktop.dc.html","sourceSha256":"2c5341b937eb6526fa68b3097c4ac4897aab9adef5988d9dd9154d86ee189e38","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nbutton{font-family:inherit;cursor:pointer}\nh1,h2,h3,h4{font-weight:400;margin:0}\nfigure{margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Awards and Accolades</title>\n<meta name=\"description\" content=\"Explore awards, recognition and past certificates for Kairali’s The Ayurvedic Healing Village and the wider Kairali group.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/awards-and-accolades/\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://ayurvedichealingvillage.com/awards-and-accolades/\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://ayurvedichealingvillage.com/fr/prix-et-distinctions/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Awards and Accolades\">\n<meta property=\"og:description\" content=\"Explore awards, recognition and past certificates for Kairali’s The Ayurvedic Healing Village and the wider Kairali group.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/awards-and-accolades/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/11/our-story.png\">\n<meta property=\"og:image:width\" content=\"1440\">\n<meta property=\"og:image:height\" content=\"524\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"@id\":\"https://ayurvedichealingvillage.com/awards-and-accolades/\",\"url\":\"https://ayurvedichealingvillage.com/awards-and-accolades/\",\"name\":\"Awards and Accolades\",\"description\":\"Explore awards, recognition and past certificates for Kairali’s The Ayurvedic Healing Village and the wider Kairali group.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/awards-and-accolades/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"About Us\",\"item\":\"https://ayurvedichealingvillage.com/about-us/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Awards & Accreditations\",\"item\":\"https://ayurvedichealingvillage.com/awards-and-accreditations/\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Awards & Accolades\",\"item\":\"https://ayurvedichealingvillage.com/awards-and-accolades/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Awards &amp; Accolades — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 40px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/about-us/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">About Us</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/awards-and-accreditations/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Awards &amp; Accreditations</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">Awards &amp; Accolades</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px 64px;align-items:end;padding-top:6px\">\n    <div>\n      <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Awards History</div>\n      <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.6vw,54px);line-height:1.12;margin:12px 0 0;text-wrap:balance\">Awards &amp; Accolades</h1>\n    </div>\n    <p style=\"font-size:19px;line-height:1.65;color:#514a3f;max-width:62ch;margin:0;border-left:3px solid #C1882C;padding-left:20px\">Awards and recognition from across the Kairali group, including The Ayurvedic Healing Village.</p>\n  </div>\n</section>\n<div style=\"width:min(1440px,100%);margin:0 auto\">\n  <img src=\"/ahv/assets/img/AHV-Awards-Landscape.png\" alt=\"Palm trees and fields seen from above.\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block\">\n</div>\n\n<nav aria-label=\"On this page\" style=\"position:sticky;top:0;z-index:40;background:rgba(247,244,234,.97);backdrop-filter:blur(8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;gap:4px 26px;flex-wrap:wrap;align-items:center\">\n    <a href=\"#awards\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Awards and recognition</a>\n    <a href=\"#group\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Kairali Group</a>\n    <a href=\"#about\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">About Kairali</a>\n  </div>\n</nav>\n\n<section id=\"awards\" aria-labelledby=\"awards-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:56px 0 0\">\n  <h2 id=\"awards-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:0 0 10px\">Awards and recognition</h2>\n  <p style=\"margin:0 0 32px;color:#514a3f;max-width:62ch\">A collection of awards, features and certificates from different years.</p>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(360px,100%),1fr));gap:32px\">\n    <sc-for list=\"{{ cards }}\" as=\"c\" hint-placeholder-count=\"22\">\n      <li id=\"{{ c.id }}\" style=\"background:#fff;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden;display:flex;flex-direction:column\">\n        <figure style=\"display:flex;flex-direction:column;flex:1\">\n          <button type=\"button\" data-award-index=\"{{ c.i }}\" onClick=\"{{ c.open }}\" style=\"display:flex;flex-direction:column;width:100%;padding:0;border:0;background:#fff;color:#2A2118;text-align:left\" style-hover=\"color:#006038\">\n            <img src=\"{{ c.image }}\" alt=\"{{ c.alt }}\" width=\"{{ c.width }}\" height=\"{{ c.height }}\" loading=\"lazy\" style=\"width:100%;height:auto;display:block\">\n            <span style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:4px 20px 0;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#006038\">View image<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span>\n          </button>\n          <figcaption style=\"padding:4px 20px 22px;font-size:17px;line-height:1.6;color:#2A2118\">{{ c.caption }}</figcaption>\n          <sc-if value=\"{{ c.storyLink }}\" hint-placeholder-val=\"{{ false }}\">\n            <a href=\"https://whyayurveda.org/kairali-the-ayurvedic-healing-village-wins-patwa-international-travel-award-2026-at-itb-berlin/\" rel=\"noopener\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;margin:-12px 20px 16px;font-weight:700;font-size:15.5px\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>Read the PATWA award story</a>\n          </sc-if>\n        </figure>\n      </li>\n    </sc-for>\n  </ul>\n</section>\n\n<section aria-label=\"Related links\" style=\"width:min(1220px,94%);margin:0 auto;padding:64px 0 72px;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:48px 64px;align-items:start\">\n  <div id=\"group\" aria-labelledby=\"group-h\" style=\"scroll-margin-top:60px\">\n    <h2 id=\"group-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);margin:0 0 18px\">Kairali Group</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));gap:0 32px;border-top:1px solid #E9E2D3\">\n      <sc-for list=\"{{ groupLinks }}\" as=\"r\" hint-placeholder-count=\"15\">\n        <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118;line-height:1.4\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n  <div id=\"about\" aria-labelledby=\"about-h\" style=\"scroll-margin-top:60px\">\n    <h2 id=\"about-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(26px,2.4vw,34px);margin:0 0 18px\">About Kairali</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E9E2D3\">\n      <sc-for list=\"{{ aboutLinks }}\" as=\"r\" hint-placeholder-count=\"4\">\n        <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118;line-height:1.4\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n      </sc-for>\n    </ul>\n  </div>\n  <nav aria-label=\"More from Kairali\" style=\"grid-column:1 / -1;margin-top:8px;display:flex;justify-content:center;gap:8px 28px;flex-wrap:wrap;border-top:1px solid #E9E2D3;padding-top:22px\">\n    <sc-for list=\"{{ footerLinks }}\" as=\"f\" hint-placeholder-count=\"3\">\n      <a href=\"{{ f.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">{{ f.label }}</a>\n    </sc-for>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n\n<div id=\"award-dialog\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Awards and recognition\" onKeyDown=\"{{ dlgKey }}\" style=\"display:{{ dlgDisplay }};position:fixed;inset:0;z-index:200;background:rgba(26,20,12,.94);flex-direction:column;align-items:center;justify-content:center;padding:24px;box-sizing:border-box\">\n  <div style=\"width:100%;max-width:1000px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;color:#F7F4EA\">\n    <div aria-live=\"polite\" style=\"font-weight:700;font-size:14px;letter-spacing:2px;text-transform:uppercase;min-height:44px;display:inline-flex;align-items:center\">{{ counter }}</div>\n    <button type=\"button\" id=\"award-close\" onClick=\"{{ close }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 20px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"background:rgba(247,244,234,.12)\">Close image<span aria-hidden=\"true\">✕</span></button>\n  </div>\n  <sc-if value=\"{{ dlgOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <img id=\"award-expanded\" ref=\"{{ curRef }}\" alt=\"{{ cur.alt }}\" width=\"{{ cur.width }}\" height=\"{{ cur.height }}\" style=\"display:block;width:auto;height:auto;max-width:min(1000px,100%);max-height:calc(100vh - 300px);object-fit:contain;margin:20px 0 14px;border-radius:4px;background:#000\">\n  </sc-if>\n  <p style=\"width:100%;max-width:1000px;margin:0 0 18px;color:#F7F4EA;font-size:17px;line-height:1.6\">{{ cur.caption }}</p>\n  <div style=\"width:100%;max-width:1000px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap\">\n    <button type=\"button\" id=\"award-prev\" onClick=\"{{ prev }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 22px;border:1px solid rgba(247,244,234,.5);border-radius:4px;background:transparent;color:#F7F4EA;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"background:rgba(247,244,234,.12)\"><span aria-hidden=\"true\">←</span>Previous image</button>\n    <button type=\"button\" id=\"award-next\" onClick=\"{{ next }}\" style=\"display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:0 22px;border:1px solid #EEB41E;border-radius:4px;background:#EEB41E;color:#2A2118;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase\" style-hover=\"filter:brightness(.94)\">Next image<span aria-hidden=\"true\">→</span></button>\n  </div>\n</div>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  state = { open: false, i: 0 };\n  componentDidMount() {\n    // Both governed hreflang tags must be present; the runtime keeps only one <link rel=\"alternate\"> from helmet, so ensure the en tag too.\n    if (!document.querySelector('link[rel=\"alternate\"][hreflang=\"en\"]')) { const l = document.createElement('link'); l.rel = 'alternate'; l.hreflang = 'en'; l.href = 'https://ayurvedichealingvillage.com/awards-and-accolades/'; document.head.appendChild(l); } document.documentElement.lang = 'en-US'; }\n  componentWillUnmount() { document.body.style.overflow = ''; }\n  openAt(idx) {\n    this.setState({ open: true, i: idx });\n    document.body.style.overflow = 'hidden';\n    setTimeout(() => { const c = document.getElementById('award-close'); if (c) c.focus(); }, 30);\n  }\n  closeViewer() {\n    const idx = this.state.i;\n    this.setState({ open: false });\n    document.body.style.overflow = '';\n    setTimeout(() => { const btn = document.querySelector('button[data-award-index=\"' + idx + '\"]'); if (btn) btn.focus(); }, 30);\n  }\n  renderVals() {\n    const D = window.AHV_AWARDS || { cards: [], groupLinks: [], aboutLinks: [], footerLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    const n = D.cards.length, i = this.state.i;\n    const cur = D.cards[i] || { image: '', alt: '', caption: '', width: 1000, height: 562 };\n    const go = (d) => this.setState(s => ({ i: (s.i + d + n) % n }));\n    const abs = (l) => ({ ...l, url: A + l.href });\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      cards: D.cards.map((c, idx) => ({ ...c, i: idx, storyLink: !!c.storyLink, open: () => this.openAt(idx) })),\n      groupLinks: D.groupLinks.map(abs), aboutLinks: D.aboutLinks.map(abs), footerLinks: D.footerLinks.map(abs),\n      dlgDisplay: this.state.open ? 'flex' : 'none', dlgOpen: this.state.open,\n      cur,\n      // New closure per render, so React re-attaches and assigns the current source each time cur changes.\n      curRef: (el) => { if (el && cur.image) { el.setAttribute('src', cur.image); } },\n      counter: n ? (i + 1) + ' of ' + n : '',\n      close: () => this.closeViewer(),\n      prev: () => go(-1), next: () => go(1),\n      dlgKey: (e) => {\n        if (e.key === 'Escape') { e.preventDefault(); this.closeViewer(); return; }\n        if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); return; }\n        if (e.key === 'ArrowRight') { e.preventDefault(); go(1); return; }\n        if (e.key === 'Tab') {\n          const f = [...e.currentTarget.querySelectorAll('button')];\n          const first = f[0], last = f[f.length - 1];\n          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }\n          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }\n        }\n      }\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/awards-and-accolades-data.js"]}