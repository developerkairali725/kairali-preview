{"id":"ahv-page-attractions-desktop","file":"AHV Page Attractions Desktop.dc.html","sourceSha256":"50584d2a5a2d663aed04b25e5065b5ce368bc3534b90807081c166a685afae05","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n</helmet>\n<div data-screen-label=\"Attractions Reader — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 28px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\">\n    <sc-for list=\"{{ ancestors }}\" as=\"b\" hint-placeholder-count=\"2\">\n      <a href=\"{{ b.canonical }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">{{ b.label }}</a><span aria-hidden=\"true\">/</span>\n    </sc-for>\n    <span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">{{ crumbLabel }}</span>\n  </nav>\n  <div style=\"padding-top:6px\">\n    <div style=\"font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Kairali — The Ayurvedic Healing Village · Since 1908</div>\n    <h1 id=\"page-h1\" style=\"font-family:'Marcellus',serif;font-size:clamp(36px,4vw,56px);line-height:1.1;margin:12px 0 0;max-width:20ch;text-wrap:balance\">{{ h1 }}</h1>\n  </div>\n</section>\n<div style=\"width:min(1220px,94%);margin:0 auto\">\n  <img src=\"/ahv/assets/img/AHV-Attractions-Landscape.webp\" alt=\"\" width=\"1440\" height=\"524\" style=\"width:100%;max-width:1440px;height:auto;display:block;border-radius:4px\">\n</div>\n<div style=\"width:min(1220px,94%);margin:0 auto;padding:56px 0 72px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,3fr);gap:32px 64px;align-items:start\">\n  <sc-if value=\"{{ hasContents }}\" hint-placeholder-val=\"{{ true }}\">\n  <nav aria-labelledby=\"contents-h\" style=\"position:sticky;top:96px\">\n    <h2 id=\"contents-h\" style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;font-family:'Mulish',sans-serif;margin:0 0 6px\">On this page</h2>\n    <ol style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ toc }}\" as=\"t\" hint-placeholder-count=\"5\">\n        <li style=\"border-bottom:1px solid #E0D7C4\"><a href=\"#{{ t.id }}\" style=\"display:flex;align-items:center;gap:12px;min-height:46px;padding:6px 0;font-size:15.5px;font-weight:600;line-height:1.4;color:#2A2118\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ t.label }}</span></a></li>\n      </sc-for>\n    </ol>\n  </nav>\n  </sc-if>\n  <sc-if value=\"{{ noContents }}\" hint-placeholder-val=\"{{ false }}\"><div aria-hidden=\"true\"></div></sc-if>\n  <article id=\"attractions-body\" aria-labelledby=\"page-h1\" style=\"min-width:0\">\n    <div style=\"border-left:3px solid #C1882C;padding-left:22px;max-width:62ch;margin:0 0 48px\">{{ introEl }}</div>\n    <sc-for list=\"{{ sections }}\" as=\"s\" hint-placeholder-count=\"5\">\n      <section id=\"{{ s.id }}\" aria-labelledby=\"{{ s.hid }}\" style=\"padding:40px 0 0;margin:0 0 40px;border-top:1px solid #E0D7C4;scroll-margin-top:96px\">\n        <h2 id=\"{{ s.hid }}\" style=\"font-family:'Marcellus',serif;font-size:clamp(25px,2.2vw,30px);line-height:1.25;margin:0 0 20px;text-wrap:balance\">{{ s.headingEl }}</h2>\n        <div style=\"display:flex;flex-wrap:wrap;gap:24px 40px;align-items:flex-start\">\n          <sc-if value=\"{{ s.hasImage }}\" hint-placeholder-val=\"{{ true }}\">\n          <figure style=\"margin:0;flex:1 1 300px;min-width:0;order:{{ s.imgOrder }}\"><img src=\"{{ s.image.src }}\" alt=\"{{ s.image.alt }}\" width=\"{{ s.image.width }}\" height=\"{{ s.image.height }}\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-radius:4px\"></figure>\n          </sc-if>\n          <div style=\"flex:1 1 300px;min-width:0;max-width:62ch;order:{{ s.txtOrder }}\">{{ s.bodyEl }}</div>\n        </div>\n      </section>\n    </sc-for>\n  </article>\n</div>\n<aside aria-labelledby=\"ctx-h\" style=\"background:#EFE9DA;border-top:1px solid #E0D7C4\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:56px 0 64px\">\n    <h2 id=\"ctx-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(24px,2vw,30px);line-height:1.25;margin:0 0 28px\">Also in Things to Do</h2>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:32px 48px\">\n      <sc-for list=\"{{ groups }}\" as=\"g\" hint-placeholder-count=\"3\">\n        <nav aria-labelledby=\"{{ g.hid }}\" style=\"min-width:0\">\n          <sc-if value=\"{{ g.hasParent }}\" hint-placeholder-val=\"{{ true }}\"><a id=\"{{ g.hid }}\" href=\"{{ g.parent.href }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-family:'Marcellus',serif;font-size:21px;color:#2A2118;border-bottom:2px solid #C1882C\">{{ g.parent.text }}</a></sc-if>\n          <sc-if value=\"{{ g.hasLabel }}\" hint-placeholder-val=\"{{ false }}\"><h3 id=\"{{ g.hid }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-family:'Marcellus',serif;font-size:21px;color:#2A2118;border-bottom:2px solid #C1882C\">{{ g.label }}</h3></sc-if>\n          <ul style=\"list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column\">\n            <sc-for list=\"{{ g.items }}\" as=\"it\" hint-placeholder-count=\"4\">\n              <li style=\"min-width:0\">\n                <sc-if value=\"{{ it.isLink }}\" hint-placeholder-val=\"{{ true }}\"><a href=\"{{ it.href }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;min-height:44px;padding:4px 0;font-size:16.5px;line-height:1.4;color:#2A2118\" style-hover=\"color:#006038\">{{ it.text }}</a></sc-if>\n                <sc-if value=\"{{ it.isCurrent }}\" hint-placeholder-val=\"{{ false }}\"><span aria-current=\"page\" style=\"display:flex;align-items:center;gap:10px;min-height:44px;padding:4px 0;font-size:16.5px;line-height:1.4;font-weight:700;color:#5A4420\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span>{{ it.text }}</span></sc-if>\n              </li>\n            </sc-for>\n          </ul>\n        </nav>\n      </sc-for>\n    </div>\n  </div>\n</aside>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  route() { return window.AHV_ATTRACTIONS_RENDER ? window.AHV_ATTRACTIONS_RENDER.resolveRoute(this.props.route) : null; }\n  componentDidMount() { const R = this.route(); if (R) { window.AHV_ATTRACTIONS_RENDER.applyHead(R); this._head = R.path; } }\n  componentDidUpdate() { const R = this.route(); if (R && R.path !== this._head) { window.AHV_ATTRACTIONS_RENDER.applyHead(R); this._head = R.path; } }\n  renderVals() {\n    const P = window.AHV_ATTRACTIONS_RENDER, D = window.AHV_ATTRACTIONS, R = this.route();\n    const guard = () => {}; /* preview-only nav guard neutralised for the published site */\n    if (!R) return { guard, h1: '', crumbLabel: '', ancestors: [], introEl: null, sections: [], toc: [], hasContents: false, noContents: true, groups: [] };\n    const rhythm = this.props.imageRhythm ?? 'source';\n    const sections = R.sections.map(s => {\n      const imgFirst = rhythm === 'source' ? s.imageFirst : rhythm === 'image-left';\n      return { id: s.id, hid: s.id + '-h', title: s.title, headingEl: P.headingContent(s, guard), bodyEl: P.bodyBlocks(s, guard, false), image: s.image || {}, hasImage: !!s.image, imgOrder: imgFirst ? 1 : 2, txtOrder: imgFirst ? 2 : 1 };\n    });\n    const toc = P.contents(R);\n    const rail = (this.props.contentsRail ?? true) && toc.length >= 4;\n    const groups = P.navGroups(D, R).map(g => ({ id: g.id, hid: g.id + '-h', parent: g.parent || {}, hasParent: !!g.parent, label: g.label || '', hasLabel: !g.parent, items: g.items.map(it => ({ text: it.text, href: it.href, isLink: !it.current, isCurrent: it.current })) }));\n    return {\n      guard, h1: R.h1, ancestors: R.breadcrumb.slice(0, -1), crumbLabel: R.breadcrumb[R.breadcrumb.length - 1].label,\n      introEl: P.introBlocks(R, guard, false), sections, toc, hasContents: rail, noContents: !rail, groups\n    };\n  }\n}\n","props":"{\"route\":{\"editor\":\"enum\",\"default\":\"/attractions-under-10kms/\",\"tsType\":\"string\",\"options\":[\"/attractions-under-10kms/\",\"/attractions-15kms-and-below/\",\"/attractions-25kms-to-50kms/\",\"/attractions-above-50kms/\"],\"section\":\"Prototype route binding (not part of the public design)\"},\"contentsRail\":{\"editor\":\"boolean\",\"default\":true,\"tsType\":\"boolean\",\"section\":\"Reading aids\"},\"imageRhythm\":{\"editor\":\"enum\",\"default\":\"source\",\"tsType\":\"string\",\"options\":[\"source\",\"image-right\",\"image-left\"],\"section\":\"Layout\"}}","scripts":["/ahv/assets/attractions-family-data.js","/ahv/assets/attractions-family-render.js"]}