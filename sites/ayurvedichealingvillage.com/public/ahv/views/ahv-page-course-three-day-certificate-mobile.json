  "template": "\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\nsummary{cursor:pointer;list-style:none;position:relative}summary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";position:absolute;right:4px;top:50%;transform:translateY(-50%);font-size:26px;color:#8F6212;line-height:1}\ndetails[open] summary::after{content:\"–\"}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>3-Day Ayurveda Certificate Program – Learn &amp; Experience Ayurveda</title>\n<meta name=\"description\" content=\"Join Kairali’s 3-day Ayurveda certificate program in Kerala. Gain hands-on training in Ayurvedic therapies, nutrition &amp; holistic healing at a serene retreat.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/three-day-short-term-ayurveda-certificate-program-tap-hv/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"3-Day Ayurveda Certificate Program – Learn &amp; Experience Ayurveda\">\n<meta property=\"og:description\" content=\"Join Kairali’s 3-day Ayurveda certificate program in Kerala. Gain hands-on training in Ayurvedic therapies, nutrition &amp; holistic healing at a serene retreat.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/three-day-short-term-ayurveda-certificate-program-tap-hv/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2024/11/4-17-1.jpg\">\n<meta property=\"og:image:width\" content=\"1400\">\n<meta property=\"og:image:height\" content=\"1000\">\n<meta property=\"og:image:type\" content=\"image/jpeg\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/\",\"url\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/\",\"name\":\"Ayurveda Training Courses & Workshops in Kerala | Kairali\",\"description\":\"Explore Ayurveda training courses and workshops at Kairali in Kerala. Compare course durations, training hours and levels, and enquire about current dates and fees.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"FAQPage\",\"@id\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Who is this training program suitable for?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Our program is suitable for therapists, doctors, dieticians, managers, students, and Ayurveda enthusiasts who wish to deepen their knowledge and skills in Ayurveda.\"}},{\"@type\":\"Question\",\"name\":\"What is the duration of the training program?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The listed course options run for 1, 3, 5, 10 or 20 days, with 3, 9, 15, 40 or 80 training hours respectively.\"}},{\"@type\":\"Question\",\"name\":\"Can I specialize in a specific area of Ayurveda?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Our program allows you to customize your learning experience and focus on specific areas of interest within Ayurveda, such as therapy, nutrition, consultation, or management.\"}}]},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Training Programs\",\"item\":\"https://ayurvedichealingvillage.com/training-programs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"the Three-Day Certificate Program\",\"item\":\"https://ayurvedichealingvillage.com/ayurveda-training-programs/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"the Three-Day Certificate Programs — Mobile\" style=\"max-width:430px;margin:0 auto;background:#F7F4EA;box-shadow:0 0 40px rgba(70,50,20,.15);position:relative;padding-bottom:calc(64px + env(safe-area-inset-bottom,0px));box-sizing:border-box\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:20px 0 32px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;gap:8px;align-items:center;flex-wrap:wrap\"><a href=\"https://ayurvedichealingvillage.com/\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/training-programs/\" style=\"display:inline-flex;align-items:center;min-height:44px\">Training Programs</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118\">Three-Day Ayurveda Certificate Program</span></nav>\n  <div style=\"padding-top:4px\">\n    <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Ayurveda training course · TAP-HV · 3 days</div>\n    <h1 style=\"font-family:'Marcellus',serif;font-size:30px;line-height:1.2;margin:12px 0 0;text-wrap:balance\">Three-Day Ayurveda Certificate Program</h1>\n    <p style=\"font-size:18px;line-height:1.65;color:#514a3f;margin:18px 0 0;border-left:3px solid #C1882C;padding-left:18px\">Three days at the hospital, each with an hour of theory, an hour of practical learning and a personal therapy session — Abhyangam, Shirodhara and Podikizhi — so every therapy is studied and then experienced. A certificate of completion is awarded on the third day.</p>\n  </div>\n  <div style=\"margin-top:28px;background:#43331E;color:#F7F4EA;border-radius:4px;padding:24px 22px\">\n    <h2 style=\"font-family:'Marcellus',serif;font-size:22px;line-height:1.3;color:#fff\">Plan your Ayurveda training</h2>\n    <p style=\"margin:12px 0 18px;font-size:17px;line-height:1.65;color:rgba(247,244,234,.92)\">Tell us about your background and the course you are considering. We can discuss the training options with you.</p>\n    <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"display:flex;justify-content:center;align-items:center;min-height:48px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 16px;font-weight:700;font-size:13.5px;letter-spacing:1.5px;text-transform:uppercase;text-align:center\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Enquire about Ayurveda training</a>\n  </div>\n</section>\n\n<nav aria-label=\"On this page\" style=\"position:sticky;top:64px;z-index:40;background:rgba(247,244,234,.97);backdrop-filter:blur(8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;flex-wrap:wrap;gap:0 22px;align-items:center\">\n    <a href=\"#process\" style=\"display:inline-flex;align-items:center;min-height:48px;min-width:44px;flex:0 0 auto;justify-content:center;font-weight:700;font-size:13px;letter-spacing:1.8px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none\">Process</a>\n    <a href=\"#features\" style=\"display:inline-flex;align-items:center;min-height:48px;min-width:44px;flex:0 0 auto;justify-content:center;font-weight:700;font-size:13px;letter-spacing:1.8px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none\">Features</a>\n    <a href=\"#courses\" style=\"display:inline-flex;align-items:center;min-height:48px;min-width:44px;flex:0 0 auto;justify-content:center;font-weight:700;font-size:13px;letter-spacing:1.8px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none\">Courses</a>\n    <a href=\"#faqs\" style=\"display:inline-flex;align-items:center;min-height:48px;min-width:44px;flex:0 0 auto;justify-content:center;font-weight:700;font-size:13px;letter-spacing:1.8px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none\">FAQs</a>\n    <a href=\"#related\" style=\"display:inline-flex;align-items:center;min-height:48px;min-width:44px;flex:0 0 auto;justify-content:center;font-weight:700;font-size:13px;letter-spacing:1.8px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none\">Related</a>\n  </div>\n</nav>\n\n<section id=\"process\" aria-labelledby=\"process-h\" style=\"scroll-margin-top:184px;width:min(1220px,94%);margin:0 auto;padding:40px 0 0\">\n  <img src=\"/ahv/assets/img/AHV-Ayurveda-Training-Practice.webp\" alt=\"Three-Day Ayurveda Certificate Program — training at Kairali – The Ayurvedic Healing Village\" width=\"580\" height=\"386\" loading=\"lazy\" style=\"width:100%;max-width:580px;height:auto;display:block;border-radius:4px\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;margin-top:26px\">The programme</div>\n  <h2 id=\"process-h\" style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.2;margin:12px 0 16px;text-wrap:balance\">Process Involved In the Three-Day Certificate Program</h2>\n  <p style=\"margin:0 0 20px;font-size:17px\">{{ processLead }}</p>\n  <div style=\"display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n    <sc-for list=\"{{ steps }}\" as=\"st\" hint-placeholder-count=\"5\">\n      <div style=\"display:grid;grid-template-columns:40px minmax(0,1fr);gap:14px;padding:16px 0;border-bottom:1px solid #E0D7C4\">\n        <div style=\"font-family:'Marcellus',serif;font-size:22px;color:#8F6212;line-height:1.2\">{{ st.n }}</div>\n        <p style=\"margin:0;font-size:17px\"><strong style=\"font-weight:700;color:#2A2118\">{{ st.label }}</strong>{{ st.body }}</p>\n      </div>\n    </sc-for>\n  </div>\n</section>\n\n<section id=\"features\" aria-label=\"Features and learning outcomes\" style=\"scroll-margin-top:184px;margin-top:44px;padding:40px 0 44px;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n<div style=\"width:min(1220px,94%);margin:0 auto;display:flex;flex-direction:column;gap:40px\">\n  <div style=\"display:flex;flex-direction:column;gap:20px\">\n    <img src=\"/ahv/assets/img/AHV-Ayurveda-Training-Practice.webp\" alt=\"A therapist pouring oil into a suspended brass vessel.\" width=\"720\" height=\"500\" loading=\"lazy\" style=\"width:100%;max-width:720px;height:auto;display:block;border-radius:4px\">\n    <div>\n      <h2 style=\"font-family:'Marcellus',serif;font-size:24px;line-height:1.2;margin:0 0 14px\">Features of the program</h2>\n      <ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px\">\n        <sc-for list=\"{{ features }}\" as=\"f\" hint-placeholder-count=\"3\">\n          <li style=\"display:flex;gap:12px;align-items:baseline;font-size:17px\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span><strong style=\"font-weight:700\">{{ f.label }}</strong>{{ f.body }}</span></li>\n        </sc-for>\n      </ul>\n    </div>\n  </div>\n  <div style=\"display:flex;flex-direction:column;gap:20px\">\n    <img src=\"/ahv/assets/img/AHV-Ayurveda-Training-Therapies.webp\" alt=\"Therapists applying warm oil along a patient’s leg.\" width=\"720\" height=\"500\" loading=\"lazy\" style=\"width:100%;max-width:720px;height:auto;display:block;border-radius:4px\">\n    <div>\n      <h2 style=\"font-family:'Marcellus',serif;font-size:24px;line-height:1.2;margin:0 0 14px\">Learning outcomes</h2>\n      <ul style=\"margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px\">\n        <sc-for list=\"{{ learning }}\" as=\"f\" hint-placeholder-count=\"3\">\n          <li style=\"display:flex;gap:12px;align-items:baseline;font-size:17px\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span><strong style=\"font-weight:700\">{{ f.label }}</strong>{{ f.body }}</span></li>\n        </sc-for>\n      </ul>\n    </div>\n  </div>\n</div>\n</section>\n\n<section id=\"courses\" aria-labelledby=\"courses-h\" style=\"scroll-margin-top:184px;width:min(1220px,94%);margin:0 auto;padding:44px 0 0\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Five course options</div>\n  <h2 id=\"courses-h\" style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.2;margin:12px 0 10px\">Available Courses</h2>\n  <p style=\"margin:0 0 22px;color:#514a3f;font-size:17px\">Explore the course options below. Contact us to discuss the programme, dates, current fees and inclusions.</p>\n  <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:16px\">\n    <sc-for list=\"{{ courses }}\" as=\"c\" hint-placeholder-count=\"5\">\n      <li style=\"background:#FFFDF7;border:1px solid #E9E2D3;border-top:3px solid #C1882C;border-radius:4px;padding:20px 20px 18px;display:flex;flex-direction:column;gap:8px\">\n        <div style=\"font-size:12.5px;letter-spacing:1.6px;text-transform:uppercase;color:#75695A;font-weight:700\">{{ c.code }}</div>\n        <h3 style=\"font-family:'Marcellus',serif;font-size:21px;line-height:1.3\"><a href=\"{{ c.href }}\" style=\"color:#2A2118\" style-hover=\"color:#006038\">{{ c.name }}</a></h3>\n        <dl style=\"margin:8px 0 0;display:grid;grid-template-columns:auto minmax(0,1fr);gap:6px 14px;font-size:15.5px;border-top:1px solid #EDE5D3;padding-top:12px\">\n          <dt style=\"color:#75695A\">Duration</dt><dd style=\"margin:0;font-weight:600\">{{ c.duration }}</dd>\n          <dt style=\"color:#75695A\">Training hours</dt><dd style=\"margin:0;font-weight:600\">{{ c.hours }}</dd>\n          <dt style=\"color:#75695A\">Level</dt><dd style=\"margin:0;font-weight:600\">{{ c.level }}</dd>\n          <dt style=\"color:#75695A\">Suitable for</dt><dd style=\"margin:0;color:#514a3f\">{{ c.audience }}</dd>\n        </dl>\n        <div style=\"display:flex;margin-top:10px\">\n          <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" aria-label=\"Enquire about this course: {{ c.name }}\" style=\"flex:1;display:flex;justify-content:center;align-items:center;min-height:44px;padding:0 16px;border:1.5px solid #5A4420;color:#5A4420;border-radius:4px;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;text-align:center\" style-hover=\"background:#5A4420;color:#F7F4EA;text-decoration:none\">Enquire about this course</a>\n        </div>\n      </li>\n    </sc-for>\n  </ul>\n  <p style=\"margin:16px 0 0;font-size:15.5px;color:#75695A\">Contact us for current course fees, dates and inclusions.</p>\n</section>\n\n<section aria-label=\"Plan your Ayurveda training\" style=\"position:relative;overflow:hidden;background:#43331E;color:#F7F4EA;margin-top:44px\">\n  <img src=\"/ahv/assets/img/lotus.svg\" alt=\"\" aria-hidden=\"true\" style=\"position:absolute;right:-48px;top:-30px;width:250px;opacity:.08;pointer-events:none\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0;display:flex;flex-direction:column;gap:20px\">\n    <h2 style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.2;color:#fff;text-wrap:balance\">Plan your Ayurveda training</h2>\n    <p style=\"margin:0;color:rgba(247,244,234,.92);font-size:17px;line-height:1.7\">Tell us about your background and the course you are considering. We can discuss the training options with you.</p>\n    <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;justify-content:center;min-height:52px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 16px;font-weight:700;font-size:13.5px;letter-spacing:1.5px;text-transform:uppercase;text-align:center\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Enquire about Ayurveda training</a>\n  </div>\n</section>\n\n<section id=\"faqs\" aria-labelledby=\"faq-h\" style=\"scroll-margin-top:184px;width:min(1220px,94%);margin:0 auto;padding:44px 0 0\">\n  <h2 id=\"faq-h\" style=\"font-family:'Marcellus',serif;font-size:26px;margin:0 0 20px\">Frequently asked questions</h2>\n  <div style=\"display:flex;flex-direction:column;border-top:1px solid #D8D1C0\">\n    <sc-for list=\"{{ faq }}\" as=\"q\" hint-placeholder-count=\"3\">\n      <details style=\"border-bottom:1px solid #D8D1C0\">\n        <summary style=\"font-family:'Marcellus',serif;font-size:19px;line-height:1.4;color:#2A2118;padding:17px 44px 17px 0;min-height:44px;box-sizing:border-box\" style-hover=\"color:#006038\">{{ q.question }}</summary>\n        <p style=\"margin:0;padding:0 0 20px;font-size:17px;line-height:1.7;color:#514a3f\">{{ q.answer }}</p>\n      </details>\n    </sc-for>\n  </div>\n</section>\n\n<section id=\"related\" aria-labelledby=\"related-h\" style=\"scroll-margin-top:184px;width:min(1220px,94%);margin:0 auto;padding:44px 0 56px\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Ayurvedic treatment programmes</div>\n  <h2 id=\"related-h\" style=\"font-family:'Marcellus',serif;font-size:26px;margin:12px 0 18px\">Explore more programmes</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E9E2D3\">\n    <sc-for list=\"{{ related }}\" as=\"r\" hint-placeholder-count=\"8\">\n      <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.href }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118;line-height:1.4\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n    </sc-for>\n  </ul>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:36px;display:flex;flex-direction:column;align-items:center;gap:4px;border-top:1px solid #E9E2D3;padding-top:18px\">\n    <a href=\"https://ayurvedichealingvillage.com/social-responsibilities/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Social Responsibility</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Past Retreats</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">News &amp; Past Events</a>\n  </nav>\n</section>\n</main>\n<div style=\"opacity:{{ barO }};visibility:{{ barV }};pointer-events:{{ barP }};transition:opacity .28s ease,visibility .28s ease;position:fixed;left:0;right:0;bottom:0;z-index:70;max-width:430px;margin:0 auto;padding-bottom:env(safe-area-inset-bottom,0px);display:flex;align-items:stretch;background:#2A2014;box-shadow:0 -8px 24px rgba(0,0,0,.25)\">\n  <a href=\"#courses\" style=\"flex:1;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;color:#F7F4EA;font-weight:700;font-size:12.5px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:rgba(247,244,234,.08);text-decoration:none;color:#F7F4EA\">Courses</a>\n  <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"flex:1.6;min-height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;background:#EEB41E;color:#2A2014;font-weight:700;font-size:12.5px;letter-spacing:1.5px;text-transform:uppercase;text-align:center;padding:0 12px\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2014\">Enquire about Ayurveda training</a>\n</div>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n<div style=\"height:76px;background:#2A2014\" aria-hidden=\"true\"></div>\n</div>\n<section data-rate-reference=\"KTAHV/TRG/EN-INR/20260925-R1\" style=\"width:min(1100px,92%);margin:32px auto;padding:24px 0;line-height:1.7\"><h2>Residential training tariff</h2><p>Rates effective 1 October 2026 to 30 September 2027. Per night, per villa; accommodation, meals, training and taxes included.</p><div style=\"overflow-x:auto\"><table style=\"width:100%;text-align:left;border-collapse:collapse\"><thead><tr><th>Villa</th><th>Single occupancy</th><th>Double occupancy</th></tr></thead><tbody><tr><th scope=\"row\">Deluxe Villa</th><td>₹18,410</td><td>₹30,530</td></tr><tr><th scope=\"row\">Classic Villa</th><td>₹20,855</td><td>₹32,735</td></tr><tr><th scope=\"row\">Royal Villa</th><td>₹25,160</td><td>₹36,620</td></tr><tr><th scope=\"row\">Maharaja Suite</th><td>₹45,110</td><td>₹55,520</td></tr></tbody></table></div><p>3-night course: Deluxe Villa single-occupancy total ₹55,230 (₹18,410 × 3 nights).</p><p>Classes run Monday to Friday. Personal treatments and optional services are charged separately. Group discount: 20% for five or more students.</p><details><summary>Booking and cancellation terms</summary><p>Rates effective 1 October 2026 to 30 September 2027. Per night, per villa, by occupancy; all government taxes included.</p><h3>Booking and payment</h3><ul><li>A 40% deposit secures the booking; the balance is due no later than 30 days before admission</li><li>Requests for a specific villa must be made at least six months in advance and are subject to availability; confirmation requires full payment</li></ul><h3>Admission and discharge</h3><ul><li>Check-in from 12:00 noon; check-out by 10:00</li><li>Early check-in and late check-out are available on request, subject to availability, and may carry a charge</li></ul><h3>Cancellation</h3><ul><li>More than 30 days before admission: full refund</li><li>15 to 30 days before admission: 50% of the amount paid is refunded, less applicable transaction fees and taxes</li><li>Fewer than 15 days before admission, or a change of dates during the stay: no refund</li></ul><h3>Children</h3><ul><li>Under 5 years: complimentary</li><li>5 to 12 years: 50% of the meal charge; extra bed at the standard rate</li><li>Over 12 years: full charge</li><li>Parents or guardians must supervise children at all times. Parts of the facility are treatment areas and are not suitable for children</li></ul><p>See the <a href=\"/documents/\">published tariff</a> for full inclusions, exclusions and terms. KTAHV/TRG/EN-INR/20260925-R1.</p></details></section>",
  "logic": "\nclass Component extends DCLogic {\n  state = { barOn: false };\n  componentDidMount() {\n    document.documentElement.lang = 'en-US';\n    this._onScroll = () => {\n      const y = window.scrollY;\n      const nearEnd = (y + window.innerHeight) > (document.documentElement.scrollHeight - 140);\n      const bar = y > 300 && !nearEnd;\n      if (bar !== this.state.barOn) this.setState({ barOn: bar });\n    };\n    window.addEventListener('scroll', this._onScroll, { passive: true });\n    this._onScroll();\n  }\n  componentWillUnmount() { window.removeEventListener('scroll', this._onScroll); }\n  renderVals() {\n    const D = window.AHV_AYURVEDA_TRAINING || { courses: [], process: [], features: [], learning: [], faq: [], relatedLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    const split = (s) => { const i = s.indexOf(': '); return i > 0 ? { label: s.slice(0, i + 2), body: s.slice(i + 2) } : { label: '', body: s }; };\n    const on = this.state.barOn;\n    return {\n      barO: on ? 1 : 0, barV: on ? 'visible' : 'hidden', barP: on ? 'auto' : 'none',\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      processLead: D.process[0] || '',\n      steps: D.process.slice(1).map((s, i) => ({ n: String(i + 1).padStart(2, '0'), ...split(s) })),\n      features: D.features.map(split),\n      learning: D.learning.map(split),\n      courses: D.courses.map(c => ({ ...c, href: A + c.href, duration: c.days + (c.days === 1 ? ' day' : ' days'), hours: c.hours + ' hours' })),\n      faq: D.faq,\n      related: D.relatedLinks.map(r => ({ label: r.label, href: A + r.href }))\n    };\n  }\n}\n",
