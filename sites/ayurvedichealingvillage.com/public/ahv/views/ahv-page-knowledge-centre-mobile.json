{"id":"ahv-page-knowledge-centre-mobile","file":"AHV Page Knowledge Centre Mobile.dc.html","sourceSha256":"4f6819bee7a2124984eff1b680fcec84eb3dd687e1d75164fc402a1013912b01","variant":"mobile","template":"\n<helmet>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&amp;family=Mulish:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;display=swap\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Ayurvedic Knowledge Centre – Wisdom, Insights &amp; Holistic Health</title>\n<meta name=\"description\" content=\"Explore Ayurveda’s wisdom with expert insights, seasonal practices & natural remedies. Unlock holistic health & wellness through our Knowledge Centre.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/knowledge-centre/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Ayurvedic Knowledge Centre – Wisdom, Insights &amp; Holistic Health\">\n<meta property=\"og:description\" content=\"Explore Ayurveda’s wisdom with expert insights, seasonal practices & natural remedies. Unlock holistic health & wellness through our Knowledge Centre.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/knowledge-centre/\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2023/09/TREATMENTS-24-min.jpg\">\n<meta property=\"og:image:width\" content=\"772\">\n<meta property=\"og:image:height\" content=\"289\">\n<meta property=\"og:image:type\" content=\"image/jpeg\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://ayurvedichealingvillage.com/knowledge-centre/\",\"url\":\"https://ayurvedichealingvillage.com/knowledge-centre/\",\"name\":\"Ayurvedic Knowledge Centre – Wisdom, Insights & Holistic Health\",\"description\":\"Explore Ayurveda’s wisdom with expert insights, seasonal practices & natural remedies. Unlock holistic health & wellness through our Knowledge Centre.\",\"isPartOf\":{\"@id\":\"https://ayurvedichealingvillage.com/#website\"},\"inLanguage\":\"en-US\"},{\"@type\":\"WebSite\",\"@id\":\"https://ayurvedichealingvillage.com/#website\",\"url\":\"https://ayurvedichealingvillage.com/\",\"name\":\"Ayurvedic Healing Village\",\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://ayurvedichealingvillage.com/knowledge-centre/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://ayurvedichealingvillage.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Knowledge Centre\",\"item\":\"https://ayurvedichealingvillage.com/knowledge-centre/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Knowledge Centre — Mobile\" style=\"max-width:430px;margin:0 auto;background:#F7F4EA;box-shadow:0 0 40px rgba(70,50,20,.15);position:relative;box-sizing:border-box\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" narrow=\"true\" style=\"position:sticky;top:0;z-index:80\" hint-size=\"100%,64px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:20px 0 32px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;gap:8px;align-items:center;flex-wrap:wrap\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118\">Knowledge Centre</span></nav>\n  <div style=\"padding-top:4px\">\n    <h1 style=\"font-family:'Marcellus',serif;font-size:30px;line-height:1.2;margin:0;text-wrap:balance\">Knowledge Centre</h1>\n    <p style=\"font-size:18px;line-height:1.65;color:#514a3f;margin:18px 0 0;border-left:3px solid #C1882C;padding-left:18px\">Dive into the vibrant realm of Ayurveda via our Knowledge Centre—an organized collection of articles, insights, and timeless wisdom. Discover holistic health, Ayurvedic concepts, seasonal practices, and natural treatments directly from our specialists. Whether you’re an inquisitive student or a health enthusiast, this is your gateway to deeper Ayurvedic understanding.</p>\n  </div>\n  <img src=\"/ahv/assets/img/AHV-Knowledge-Hero.webp\" alt=\"A therapist applying herbal powder during a treatment.\" width=\"772\" height=\"289\" style=\"width:100%;max-width:772px;height:auto;display:block;border-radius:4px;margin-top:26px\">\n</section>\n\n<nav aria-label=\"On this page\" style=\"position:sticky;top:64px;z-index:40;background:rgba(247,244,234,.97);backdrop-filter:blur(8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px;align-items:center\">\n    <sc-for list=\"{{ cards }}\" as=\"c\" hint-placeholder-count=\"5\">\n      <a href=\"{{ c.anchor }}\" style=\"display:inline-flex;align-items:center;min-height:48px;min-width:44px;font-weight:700;font-size:12.5px;letter-spacing:1.4px;text-transform:uppercase;color:#2A2118;line-height:1.3\" style-hover=\"color:#006038;text-decoration:none\">{{ c.title }}</a>\n    </sc-for>\n  </div>\n</nav>\n\n<section aria-label=\"Knowledge Centre resources\" style=\"width:min(1220px,94%);margin:0 auto;padding:36px 0 56px\">\n  <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:24px\">\n    <sc-for list=\"{{ cards }}\" as=\"c\" hint-placeholder-count=\"5\">\n      <li id=\"{{ c.id }}\" style=\"scroll-margin-top:{{ anchorMargin }};background:#fff;border:1px solid #E9E2D3;border-radius:4px;overflow:hidden\">\n        <a href=\"{{ c.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;color:#2A2118\" style-hover=\"color:#2A2118;text-decoration:none\">\n          <img src=\"{{ c.image }}\" alt=\"{{ c.alt }}\" width=\"{{ c.width }}\" height=\"{{ c.height }}\" loading=\"lazy\" style=\"width:100%;height:auto;display:block\">\n          <span style=\"display:flex;flex-direction:column;gap:10px;padding:18px 20px 20px\">\n            <h2 style=\"font-family:'Marcellus',serif;font-size:24px;line-height:1.25;color:#2A2118\">{{ c.title }}</h2>\n            <span style=\"display:inline-flex;align-items:center;gap:10px;min-height:44px;font-weight:700;font-size:13px;letter-spacing:1.8px;text-transform:uppercase;color:#006038\">View<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span>\n          </span>\n        </a>\n      </li>\n    </sc-for>\n  </ul>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:40px;display:flex;flex-direction:column;align-items:center;gap:4px;border-top:1px solid #E9E2D3;padding-top:18px\">\n    <sc-for list=\"{{ footerLinks }}\" as=\"f\" hint-placeholder-count=\"3\">\n      <a href=\"{{ f.url }}\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">{{ f.label }}</a>\n    </sc-for>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  state = { navH: 96 };\n  componentDidMount() {\n    document.documentElement.lang = 'en-US';\n    // Wrapping chip rows vary by width (2–3 rows at 320–430); measure so anchors clear header + nav.\n    this._measure = () => {\n      const nav = document.querySelector('nav[aria-label=\"On this page\"]');\n      const h = nav ? Math.round(nav.getBoundingClientRect().height) : 96;\n      if (h !== this.state.navH) this.setState({ navH: h });\n    };\n    this._measure();\n    window.addEventListener('resize', this._measure);\n    this._t = setTimeout(this._measure, 800);\n  }\n  componentWillUnmount() { window.removeEventListener('resize', this._measure); clearTimeout(this._t); }\n  renderVals() {\n    const D = window.AHV_KNOWLEDGE_CENTRE || { cards: [], footerLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      anchorMargin: (64 + this.state.navH + 20) + 'px',\n      cards: D.cards.map(c => ({ ...c, url: A + c.href, anchor: '#' + c.id })),\n      footerLinks: D.footerLinks.map(f => ({ ...f, url: A + f.href }))\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/knowledge-centre-data.js"]}