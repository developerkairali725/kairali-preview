{"id": "ahv-template-course-and-fees-desktop", "file": "AHV Template Course and Fees Desktop.dc.html", "sourceSha256": "af71297f6fcdb30665f19d27c79131bdd2746facb3726c01eec0d049883cef84", "variant": "desktop", "template": "\n<helmet>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Marcellus&family=Mulish:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  html, body { margin:0; padding:0; background:#F7F4EA; }\n  *, *::before, *::after { box-sizing: border-box; }\n  body { font-family:'Mulish', sans-serif; color:#2A2118; -webkit-font-smoothing:antialiased; }\n  a { color:#006038; }\n  a:hover { color:#004226; }\n  @media (prefers-reduced-motion: reduce) { * { transition:none !important; animation:none !important; } }\n</style>\n</helmet>\n\n<div style=\"width:100%;background:#F7F4EA;font-family:'Mulish',sans-serif;color:#2A2118;font-size:18px;line-height:1.7;\">\n\n  <dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n\n  <section style=\"padding:40px 0 0;\">\n    <div style=\"width:min(1220px,94%);margin:0 auto;\">\n      <nav aria-label=\"Breadcrumb\" style=\"font-size:14px;line-height:1.5;color:#75695A;margin-bottom:26px;\">\n        <a href=\"https://ayurvedichealingvillage.com/\" style=\"display:inline-flex;align-items:center;justify-content:center;min-height:44px;min-width:44px;margin-left:-8px;padding:0 8px;color:#006038;text-decoration:none;\">Home</a>\n        <span style=\"padding:0 10px;color:#C9BFA8;\">•</span>\n        <a href=\"https://ayurvedichealingvillage.com/ayurveda-training-programs/\" style=\"display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 4px;color:#006038;text-decoration:none;\">Training Courses</a>\n        <span style=\"padding:0 10px;color:#C9BFA8;\">•</span>\n        <span aria-current=\"page\">Training Course Fees</span>\n      </nav>\n      <p style=\"margin:0 0 14px;font-size:12.5px;line-height:1.5;letter-spacing:2.6px;text-transform:uppercase;color:#8F6212;font-weight:700;\">Kairali — The Ayurvedic Healing Village · Since 1908</p>\n      <h1 style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:56px;line-height:1.12;letter-spacing:-0.4px;color:#2A2118;max-width:18ch;\">Training Course Fees</h1>\n      <p style=\"margin:26px 0 0;padding-left:22px;border-left:3px solid #C1882C;font-size:21px;line-height:1.6;color:#514A3F;max-width:56ch;\">Course structure, duration, schedule and fees for study at the Kairali Institute of Ayurveda and Panchakarma Therapy, with accommodation rates listed separately.</p>\n    </div>\n  </section>\n\n  <div style=\"width:100%;margin-top:44px;\">\n    <div style=\"overflow:hidden;width:100%;height:420px;background:#E0D7C4;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;padding:0 24px;\"><img src=\"/ahv/assets/img/article/TREATMENTS-24-min.webp\" alt=\"A therapist pouring warm herbal powder over a patient during an Udwarthanam treatment\" loading=\"eager\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n  </div>\n\n  <main style=\"width:min(1220px,94%);margin:0 auto;padding:64px 0 0;display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:80px;align-items:start;\">\n\n    <div style=\"min-width:0;\">\n\n      <h2 style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:34px;line-height:1.2;color:#2A2118;\">{{ introHeading }}</h2>\n      <div style=\"width:56px;height:2px;background:#C1882C;margin:18px 0 28px;\"></div>\n      <p style=\"margin:0;font-size:18px;line-height:1.7;color:#2A2118;max-width:66ch;\">{{ introBody }}</p>\n\n      <sc-if value=\"{{ showIntroImage }}\" hint-placeholder-val=\"{{ true }}\">\n        <div style=\"overflow:hidden;margin-top:34px;height:300px;background:#E0D7C4;border:1px solid #E9E2D3;border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;padding:16px;\"><img src=\"/ahv/assets/img/article/ayurveda-training-new.webp\" alt=\"Training Course Fees\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"></div>\n      </sc-if>\n\n      <section aria-labelledby=\"fees-h\" style=\"margin-top:56px;padding-top:44px;border-top:1px solid #E9E2D3;\">\n        <h2 id=\"fees-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:30px;line-height:1.22;color:#2A2118;\">Course fees, duration and schedule</h2>\n        <div style=\"width:56px;height:2px;background:#C1882C;margin:18px 0 22px;\"></div>\n        <p style=\"margin:0 0 12px;font-size:18px;line-height:1.7;color:#2A2118;max-width:66ch;\">Rates are charged <strong>per night</strong> and are all-inclusive of accommodation, meals, training and taxes. The rate sheet prints no separate course fee.</p>\n        <p style=\"margin:0 0 26px;font-size:15.5px;line-height:1.6;color:#75695A;max-width:66ch;\">Source: KTAHV Ayurveda Training Courses V2, Ref KAHR/AY-TRG/2026-2027/04/GBL, with effect from 1 October 2026 to 30 September 2027. Figures are shown exactly as held; no totals are calculated here.</p>\n\n        <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;overflow:hidden;\">\n          <table style=\"width:100%;border-collapse:collapse;font-size:16.5px;line-height:1.55;font-variant-numeric:tabular-nums;\">\n            <caption style=\"caption-side:top;text-align:left;padding:16px 20px;background:#EFEADD;border-bottom:1px solid #E9E2D3;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#5A4420;\">Training programmes — KAHR/AY-TRG/2026-2027/04/GBL</caption>\n            <thead>\n              <tr style=\"background:#E0D7C4;\">\n                <th scope=\"col\" style=\"text-align:left;padding:14px 20px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;\">Course</th>\n                <th scope=\"col\" style=\"text-align:left;padding:14px 16px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;\">Duration</th>\n                <th scope=\"col\" style=\"text-align:left;padding:14px 16px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;\">Code</th>\n                <th scope=\"col\" style=\"text-align:left;padding:14px 16px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;\">Schedule</th>\n              </tr>\n            </thead>\n            <tbody>\n              <sc-for list=\"{{ courseRows }}\" as=\"r\" hint-placeholder-count=\"5\">\n                <tr style=\"border-bottom:1px solid #E9E2D3;\">\n                  <th scope=\"row\" style=\"text-align:left;padding:16px 20px;font-size:17px;font-weight:600;color:#2A2118;vertical-align:top;max-width:30ch;\">\n                    {{ r.course }}\n                    <span style=\"display:block;margin-top:6px;font-size:15px;font-weight:400;line-height:1.5;color:#514A3F;\">{{ r.summary }}</span>\n                  </th>\n                  <td style=\"padding:16px;color:#514A3F;vertical-align:top;white-space:nowrap;\">{{ r.duration }}</td>\n                  <td style=\"padding:16px;color:#514A3F;vertical-align:top;white-space:nowrap;\">{{ r.code }}</td>\n                  <td style=\"padding:16px;color:#514A3F;vertical-align:top;\"><span style=\"display:inline-block;padding:2px 8px;background:#F3EEE0;border:1px solid #E9E2D3;border-radius:4px;font-size:12.5px;font-weight:700;letter-spacing:1.2px;color:#8F6212;white-space:nowrap;\">TO CONFIRM</span></td>\n                </tr>\n              </sc-for>\n            </tbody>\n          </table>\n        </div>\n        <p style=\"margin:14px 0 0;font-size:15.5px;line-height:1.6;color:#75695A;max-width:66ch;\">The rate sheet prices per night by villa and occupancy and prints no separate course fee: tuition is inside the nightly rate. Daily timetables are not held in the record, so the schedule column stays <span style=\"color:#8F6212;font-weight:700;\">[TO CONFIRM]</span>.</p>\n      </section>\n\n      <section aria-labelledby=\"villa-h\" style=\"margin-top:56px;padding-top:44px;border-top:1px solid #E9E2D3;\">\n        <h2 id=\"villa-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:30px;line-height:1.22;color:#2A2118;\">Accommodation rates</h2>\n        <div style=\"width:56px;height:2px;background:#C1882C;margin:18px 0 26px;\"></div>\n\n        <p style=\"margin:0 0 18px;font-size:17.5px;line-height:1.7;color:#2A2118;max-width:66ch;\">Per night, all-inclusive of accommodation, meals, training and taxes. Valid 1 October 2026 to 30 September 2027.</p>\n        <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;overflow-x:auto;\">\n          <table style=\"width:100%;border-collapse:collapse;font-size:16px;line-height:1.55;font-variant-numeric:tabular-nums;\">\n            <thead>\n              <tr style=\"background:#E0D7C4;\">\n                <th scope=\"col\" style=\"text-align:left;padding:14px 14px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;white-space:nowrap;\">Villa</th>\n                <th scope=\"col\" style=\"text-align:right;padding:14px 14px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;white-space:nowrap;\">INR single</th>\n                <th scope=\"col\" style=\"text-align:right;padding:14px 14px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;white-space:nowrap;\">INR double</th>\n                <th scope=\"col\" style=\"text-align:right;padding:14px 14px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;white-space:nowrap;\">USD single</th>\n                <th scope=\"col\" style=\"text-align:right;padding:14px 14px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;white-space:nowrap;\">USD double</th>\n                <th scope=\"col\" style=\"text-align:right;padding:14px 14px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;white-space:nowrap;\">EUR single</th>\n                <th scope=\"col\" style=\"text-align:right;padding:14px 14px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;white-space:nowrap;\">EUR double</th>\n              </tr>\n            </thead>\n            <tbody>\n              <sc-for list=\"{{ villaRows }}\" as=\"v\" hint-placeholder-count=\"4\">\n                <tr style=\"border-bottom:1px solid #E9E2D3;\">\n                  <th scope=\"row\" style=\"text-align:left;padding:15px 14px;font-size:17px;font-weight:600;color:#2A2118;white-space:nowrap;\">{{ v.villa }}</th>\n                  <td style=\"padding:15px 14px;text-align:right;color:#2A2118;\">{{ v.inrS }}</td>\n                  <td style=\"padding:15px 14px;text-align:right;color:#2A2118;\">{{ v.inrD }}</td>\n                  <td style=\"padding:15px 14px;text-align:right;color:#514A3F;\">{{ v.usdS }}</td>\n                  <td style=\"padding:15px 14px;text-align:right;color:#514A3F;\">{{ v.usdD }}</td>\n                  <td style=\"padding:15px 14px;text-align:right;color:#514A3F;\">{{ v.eurS }}</td>\n                  <td style=\"padding:15px 14px;text-align:right;color:#514A3F;\">{{ v.eurD }}</td>\n                </tr>\n              </sc-for>\n            </tbody>\n          </table>\n        </div>\n        <p style=\"margin:14px 0 0;font-size:15.5px;line-height:1.6;color:#75695A;max-width:66ch;\">Transcribed from the KTAHV Ayurveda Training Courses V2 rate sheet and independently confirmed by the marketing team.</p>\n      </section>\n\n      <section aria-labelledby=\"incl-h\" style=\"margin-top:56px;padding-top:44px;border-top:1px solid #E9E2D3;\">\n        <h2 id=\"incl-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:30px;line-height:1.22;color:#2A2118;\">What the rate includes</h2>\n        <div style=\"width:56px;height:2px;background:#C1882C;margin:18px 0 24px;\"></div>        <div style=\"margin-bottom:26px;\">\n          <h3 style=\"margin:0 0 12px;font-size:19px;line-height:1.3;color:#2A2118;\">Professional Training &amp; Certification</h3>\n          <ul style=\"display:flex;flex-direction:column;gap:9px;margin:0;padding:0;list-style:none;max-width:70ch;\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Daily theory classes by expert Ayurvedic Doctors</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Hands-on practical training led by Senior Ayurvedic Trainers &amp; Ayurvedic Doctors</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Comprehensive training in authentic Ayurvedic therapies and techniques</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Certification issued by Kairali Institute of Panchakarma Therapies</span></li>\n          </ul>\n        </div>        <div style=\"margin-bottom:26px;\">\n          <h3 style=\"margin:0 0 12px;font-size:19px;line-height:1.3;color:#2A2118;\">Accommodation &amp; Meals</h3>\n          <ul style=\"display:flex;flex-direction:column;gap:9px;margin:0;padding:0;list-style:none;max-width:70ch;\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Villa accommodation (category per package)</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Three wholesome vegetarian Ayurvedic meals daily using organic ingredients</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Daily in-room mineral water and unlimited herbal detox water</span></li>\n          </ul>\n        </div>        <div style=\"margin-bottom:26px;\">\n          <h3 style=\"margin:0 0 12px;font-size:19px;line-height:1.3;color:#2A2118;\">Additional Benefits</h3>\n          <ul style=\"display:flex;flex-direction:column;gap:9px;margin:0;padding:0;list-style:none;max-width:70ch;\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Pool, library, gym, outdoor facilities</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Organic farm tours and cultural immersion</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>All-inclusive pricing with no hidden costs (accommodation, meals, training &amp; taxes)</span></li>\n          </ul>\n        </div>      </section>\n\n      <section aria-labelledby=\"notes-h\" style=\"margin-top:56px;padding-top:44px;border-top:1px solid #E9E2D3;\">\n        <h2 id=\"notes-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:30px;line-height:1.22;color:#2A2118;\">Programme notes</h2>\n        <div style=\"width:56px;height:2px;background:#C1882C;margin:18px 0 24px;\"></div>        <ul style=\"display:flex;flex-direction:column;gap:9px;margin:0;padding:0;list-style:none;max-width:70ch;\">\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Classes Monday to Friday only</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Full advance payment required</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>Group discount 20% for 5 or more students</span></li>\n            <li style=\"display:grid;grid-template-columns:16px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.65;color:#2A2118;\"><span style=\"color:#C1882C\" aria-hidden=\"true\">◆</span><span>No photography or videography during practical sessions</span></li>\n        </ul>\n      </section>\n\n      <section aria-labelledby=\"transport-h\" style=\"margin-top:56px;padding-top:44px;border-top:1px solid #E9E2D3;\">\n        <h2 id=\"transport-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:30px;line-height:1.22;color:#2A2118;\">Transport</h2>\n        <div style=\"width:56px;height:2px;background:#C1882C;margin:18px 0 24px;\"></div>        <p style=\"margin:0 0 18px;font-size:17.5px;line-height:1.7;color:#2A2118;max-width:66ch;\">One-way, air-conditioned, including 5% GST.</p>\n        <div style=\"border:1px solid #E9E2D3;border-radius:4px;background:#FFFFFF;overflow-x:auto;\">\n          <table style=\"width:100%;border-collapse:collapse;font-size:16.5px;line-height:1.55;font-variant-numeric:tabular-nums;\">\n            <thead>\n              <tr style=\"background:#E0D7C4;\">\n                <th scope=\"col\" style=\"text-align:left;padding:14px 18px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;\">From</th>\n                <th scope=\"col\" style=\"text-align:right;padding:14px 16px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;white-space:nowrap;\">MPV</th>\n                <th scope=\"col\" style=\"text-align:right;padding:14px 18px;border-bottom:1px solid #C9BFA8;font-size:12.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#5A4420;white-space:nowrap;\">Sedan</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr style=\"border-bottom:1px solid #E9E2D3;\">\n                <th scope=\"row\" style=\"text-align:left;padding:15px 18px;font-size:17px;font-weight:600;color:#2A2118;\">Palakkad Railway Station (25 km)</th>\n                <td style=\"padding:15px 16px;text-align:right;color:#2A2118;white-space:nowrap;\">₹3,900 <span style=\"color:#75695A\">($56)</span></td>\n                <td style=\"padding:15px 18px;text-align:right;color:#2A2118;white-space:nowrap;\">₹13,649 <span style=\"color:#75695A\">($195)</span></td>\n              </tr>\n              <tr style=\"border-bottom:1px solid #E9E2D3;\">\n                <th scope=\"row\" style=\"text-align:left;padding:15px 18px;font-size:17px;font-weight:600;color:#2A2118;\">Coimbatore Airport (75 km)</th>\n                <td style=\"padding:15px 16px;text-align:right;color:#2A2118;white-space:nowrap;\">₹6,775 <span style=\"color:#75695A\">($97)</span></td>\n                <td style=\"padding:15px 18px;text-align:right;color:#2A2118;white-space:nowrap;\">₹23,711 <span style=\"color:#75695A\">($339)</span></td>\n              </tr>\n              <tr style=\"border-bottom:1px solid #E9E2D3;\">\n                <th scope=\"row\" style=\"text-align:left;padding:15px 18px;font-size:17px;font-weight:600;color:#2A2118;\">Cochin or Calicut Airport (125 km)</th>\n                <td style=\"padding:15px 16px;text-align:right;color:#2A2118;white-space:nowrap;\">₹7,950 <span style=\"color:#75695A\">($114)</span></td>\n                <td style=\"padding:15px 18px;text-align:right;color:#2A2118;white-space:nowrap;\">₹27,824 <span style=\"color:#75695A\">($397)</span></td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <section aria-labelledby=\"policies-h\" style=\"margin-top:56px;padding-top:44px;border-top:1px solid #E9E2D3;\">\n        <h2 id=\"policies-h\" style=\"margin:0;font-family:'Marcellus',serif;font-weight:400;font-size:30px;line-height:1.22;color:#2A2118;\">Booking and payment policies</h2>\n        <div style=\"width:56px;height:2px;background:#C1882C;margin:18px 0 24px;\"></div>        <dl style=\"margin:0;display:grid;gap:0;max-width:70ch;\">\n          <div style=\"display:grid;grid-template-columns:220px minmax(0,1fr);gap:20px;padding:15px 0;border-bottom:1px solid #E9E2D3;\">\n         