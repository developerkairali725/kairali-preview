{"id":"ahv-page-policy-reader-desktop","file":"AHV Page Policy Reader Desktop.dc.html","sourceSha256":"b4d0fc8a8077fe20bcadb8677a1a1a7199187533b400029115938aa1c92d2622","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n</helmet>\n<div data-screen-label=\"Policy Reader — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 28px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;flex-wrap:wrap;gap:0 8px;align-items:center;line-height:1.4\"><a href=\"https://ayurvedichealingvillage.com/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118;display:inline-flex;align-items:center;min-height:44px\">{{ crumbLabel }}</span></nav>\n  <div style=\"padding-top:6px\">\n    <div style=\"font-weight:700;font-size:12.5px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Kairali — The Ayurvedic Healing Village · Since 1908</div>\n    <h1 id=\"page-h1\" style=\"font-family:'Marcellus',serif;font-size:clamp(36px,4vw,56px);line-height:1.1;margin:12px 0 0;max-width:20ch;text-wrap:balance\">{{ h1 }}</h1>\n  </div>\n</section>\n<div style=\"width:min(1220px,94%);margin:0 auto\">\n  <sc-if value=\"{{ bannerPrivacy }}\" hint-placeholder-val=\"{{ false }}\"><img src=\"/ahv/assets/img/AHV-Policy-Privacy-Banner.png\" alt=\"\" width=\"1440\" height=\"459\" style=\"width:100%;max-width:1440px;height:auto;display:block;border-radius:4px\"></sc-if>\n  <sc-if value=\"{{ bannerTerms }}\" hint-placeholder-val=\"{{ false }}\"><img src=\"/ahv/assets/img/AHV-Policy-Terms-Banner.webp\" alt=\"\" width=\"832\" height=\"400\" style=\"width:100%;max-width:832px;height:auto;display:block;border-radius:4px\"></sc-if>\n</div>\n<div style=\"width:min(1220px,94%);margin:0 auto;padding:56px 0 72px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,3fr);gap:32px 64px;align-items:start\">\n  <sc-if value=\"{{ hasContents }}\" hint-placeholder-val=\"{{ false }}\">\n  <nav aria-labelledby=\"contents-h\" style=\"position:sticky;top:96px\">\n    <h2 id=\"contents-h\" style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase;font-family:'Mulish',sans-serif;margin:0 0 6px\">On this page</h2>\n    <ol style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ toc }}\" as=\"t\" hint-placeholder-count=\"5\">\n        <li style=\"border-bottom:1px solid #E0D7C4\"><a href=\"#{{ t.id }}\" style=\"display:flex;align-items:center;gap:12px;min-height:46px;padding:6px 0;font-size:15.5px;font-weight:600;line-height:1.4;color:#2A2118\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span><span>{{ t.label }}</span></a></li>\n      </sc-for>\n    </ol>\n  </nav>\n  </sc-if>\n  <sc-if value=\"{{ noContents }}\" hint-placeholder-val=\"{{ true }}\"><div aria-hidden=\"true\"></div></sc-if>\n  <article id=\"policy-body\" aria-labelledby=\"page-h1\" style=\"max-width:72ch;min-width:0\">{{ body }}</article>\n</div>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  route() { return window.AHV_POLICY_RENDER ? window.AHV_POLICY_RENDER.resolveRoute(this.props.route) : null; }\n  componentDidMount() { const R = this.route(); if (R) { window.AHV_POLICY_RENDER.applyHead(R); this._head = R.path; } }\n  componentDidUpdate() { const R = this.route(); if (R && R.path !== this._head) { window.AHV_POLICY_RENDER.applyHead(R); this._head = R.path; } }\n  renderVals() {\n    const P = window.AHV_POLICY_RENDER; const R = this.route();\n    const guard = () => {}; /* preview-only navigation guard neutralised for the published site: all 91 anchors it is bound to carry real destinations */\n    if (!R) return { guard, h1: '', crumbLabel: '', body: null, toc: [], hasContents: false, noContents: true, bannerPrivacy: false, bannerTerms: false };\n    const toc = P.contents(R);\n    const rail = (this.props.contentsRail ?? true) && toc.length >= 5;\n    return {\n      guard, h1: R.h1, crumbLabel: R.breadcrumb[R.breadcrumb.length - 1].label,\n      bannerPrivacy: R.image.src.includes('Privacy'), bannerTerms: R.image.src.includes('Terms'),\n      body: P.renderBody(R, { guard, mobile: false }),\n      toc, hasContents: rail, noContents: !rail\n    };\n  }\n}\n","props":"{\"route\":{\"editor\":\"enum\",\"default\":\"/cancellation-and-refund-policy/\",\"tsType\":\"string\",\"options\":[\"/cancellation-and-refund-policy/\",\"/cookie-policy/\",\"/disclaimer/\",\"/new-privacy-policy/\",\"/payment-policy-compliance/\",\"/privacy-policy/\",\"/privacy-statement/\",\"/terms-and-conditions/\"],\"section\":\"Prototype route binding (not part of the public design)\"},\"contentsRail\":{\"editor\":\"boolean\",\"default\":true,\"tsType\":\"boolean\",\"section\":\"Reading aids\"}}","scripts":["/ahv/assets/policy-family-data.js","/ahv/assets/policy-family-render.js"]}