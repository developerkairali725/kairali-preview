.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"All Programmes\",\"item\":\"https://ayurvedichealingvillage.com/all-programs/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Yoga & Meditation Programs\",\"item\":\"https://ayurvedichealingvillage.com/yoga-meditation-programs/\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Kairali’s Personalized Yoga Program\",\"item\":\"https://ayurvedichealingvillage.com/yoga-retreats/\"}]}]}\n</script>\n</helmet>\n<div data-screen-label=\"Personalized Yoga Program — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 40px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;gap:8px;align-items:center\"><a href=\"https://ayurvedichealingvillage.com/\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/all-programs/\" style=\"display:inline-flex;align-items:center;min-height:44px\">All Programmes</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/yoga-meditation-programs/\" style=\"display:inline-flex;align-items:center;min-height:44px\">Yoga &amp; Meditation Programs</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118\">Kairali’s Personalized Yoga Program</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:48px;align-items:end;padding-top:6px\">\n    <div>\n      <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Personalised yoga at Kairali</div>\n      <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.6vw,54px);line-height:1.12;margin:12px 0 0;max-width:20ch;text-wrap:balance\">Kairali’s Personalized Yoga Program</h1>\n      <p style=\"font-size:19px;line-height:1.65;color:#514a3f;max-width:62ch;margin:20px 0 0;border-left:3px solid #C1882C;padding-left:20px\">A yoga programme designed around you. Practice, pranayama, and meditation customised to your goals after a doctor’s assessment.</p>\n    </div>\n    <div style=\"background:#43331E;color:#F7F4EA;border-radius:4px;padding:28px 30px\">\n      <h2 style=\"font-family:'Marcellus',serif;font-size:24px;line-height:1.3;color:#fff\">Discuss your personalised yoga programme</h2>\n      <p style=\"margin:12px 0 20px;font-size:17px;line-height:1.65;color:rgba(247,244,234,.92)\">Tell our team about your goals and experience. A doctor’s assessment guides your plan. Enquire about current arrangements and fees for your intended stay.</p>\n      <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:48px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 28px;font-weight:700;font-size:14.5px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Enquire about personalised yoga</a>\n    </div>\n  </div>\n</section>\n\n<nav aria-label=\"On this page\" style=\"position:sticky;top:0;z-index:40;background:rgba(247,244,234,.97);backdrop-filter:blur(8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;gap:4px 26px;flex-wrap:wrap;align-items:center\">\n    <a href=\"#about\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">About</a>\n    <a href=\"#practice\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Practice</a>\n    <a href=\"#faqs\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">FAQs</a>\n    <a href=\"#related\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Related programmes</a>\n  </div>\n</nav>\n\n<section id=\"about\" aria-labelledby=\"about-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:64px 0 0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:56px;align-items:center\">\n  <img src=\"/ahv/assets/img/AHV-Yoga-Retreats-About.png\" alt=\"A group practising yoga outdoors among trees.\" width=\"580\" height=\"386\" loading=\"lazy\" style=\"width:100%;max-width:580px;height:auto;display:block;border-radius:4px\">\n  <div>\n    <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">The programme</div>\n    <h2 id=\"about-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:12px 0 18px;text-wrap:balance\">A yoga programme designed around you</h2>\n    <p style=\"margin:0 0 16px;max-width:60ch\">Explore yoga postures, breathing exercises, meditation and relaxation as part of your practice.</p>\n    <p style=\"margin:0;max-width:60ch\">Your goals and a doctor’s assessment guide the programme. Enquire about the sessions, duration and arrangements for your intended stay.</p>\n  </div>\n</section>\n\n<section id=\"practice\" aria-labelledby=\"practice-h\" style=\"scroll-margin-top:60px;margin-top:64px;padding:56px 0 60px;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n<div style=\"width:min(1220px,94%);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px 56px;align-items:center\">\n  <div>\n    <h2 id=\"practice-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:0 0 24px\">Time for your practice</h2>\n    <div style=\"display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ practices }}\" as=\"p\" hint-placeholder-count=\"3\">\n        <div style=\"display:grid;grid-template-columns:52px minmax(0,1fr);gap:18px;padding:16px 0;border-bottom:1px solid #E0D7C4\">\n          <div style=\"font-family:'Marcellus',serif;font-size:24px;color:#8F6212;line-height:1.2\">{{ p.n }}</div>\n          <div><h3 style=\"font-family:'Marcellus',serif;font-size:21px;line-height:1.3;margin:0 0 4px\">{{ p.title }}</h3><p style=\"margin:0;color:#514a3f;max-width:56ch\">{{ p.text }}</p></div>\n        </div>\n      </sc-for>\n    </div>\n  </div>\n  <img src=\"/ahv/assets/img/AHV-Yoga-Retreats-Practice.jpg\" alt=\"A woman practising a standing yoga pose.\" width=\"720\" height=\"500\" loading=\"lazy\" style=\"width:100%;max-width:720px;height:auto;display:block;border-radius:4px;justify-self:end\">\n</div>\n</section>\n\n<section aria-label=\"Discuss your personalised yoga programme\" style=\"position:relative;overflow:hidden;background:#43331E;color:#F7F4EA;margin-top:64px\">\n  <img src=\"/ahv/assets/img/lotus.svg\" alt=\"\" aria-hidden=\"true\" style=\"position:absolute;right:-60px;top:-50px;width:430px;opacity:.08;pointer-events:none\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:60px 0;display:grid;grid-template-columns:minmax(0,1.4fr) auto;gap:32px 64px;align-items:center\">\n    <div>\n      <h2 style=\"font-family:'Marcellus',serif;font-size:clamp(30px,3vw,42px);line-height:1.18;color:#fff;text-wrap:balance\">Discuss your personalised yoga programme</h2>\n      <p style=\"margin:14px 0 0;color:rgba(247,244,234,.92);font-size:17.5px;line-height:1.75;max-width:60ch\">Tell our team about your goals and experience. A doctor’s assessment guides your plan. Enquire about current arrangements and fees for your intended stay.</p>\n    </div>\n    <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;justify-content:center;min-height:52px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 34px;font-weight:700;font-size:15px;letter-spacing:1.5px;text-transform:uppercase;text-align:center\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Enquire about personalised yoga</a>\n  </div>\n</section>\n\n<section id=\"faqs\" aria-labelledby=\"faq-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:64px 0 0\">\n  <h2 id=\"faq-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);margin:0 0 26px\">Planning your personalised yoga programme</h2>\n  <div style=\"display:flex;flex-direction:column;border-top:1px solid #D8D1C0;max-width:900px\">\n    <sc-for list=\"{{ faqs }}\" as=\"q\" hint-placeholder-count=\"3\">\n      <details style=\"border-bottom:1px solid #D8D1C0\">\n        <summary style=\"font-family:'Marcellus',serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 44px 19px 0;min-height:44px;box-sizing:border-box\" style-hover=\"color:#006038\">{{ q.question }}</summary>\n        <p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f;max-width:70ch\">{{ q.answer }}</p>\n      </details>\n    </sc-for>\n  </div>\n</section>\n\n<section id=\"related\" aria-labelledby=\"related-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:64px 0 72px\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Ayurvedic treatment programmes</div>\n  <h2 id=\"related-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);margin:12px 0 24px\">Explore more programmes</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));gap:0 32px;border-top:1px solid #E9E2D3\">\n    <sc-for list=\"{{ related }}\" as=\"r\" hint-placeholder-count=\"8\">\n      <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.href }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n    </sc-for>\n  </ul>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:44px;display:flex;justify-content:center;gap:8px 28px;flex-wrap:wrap;border-top:1px solid #E9E2D3;padding-top:22px\">\n    <a href=\"https://ayurvedichealingvillage.com/social-responsibilities/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Social Responsibility</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Past Retreats</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">News &amp; Past Events</a>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_YOGA_RETREATS || { practices: [], faqs: [], relatedLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    return {\n      guard: (e) => { e.preventDefault(); },\n      practices: D.practices.map((p, i) => ({ ...p, n: String(i + 1).padStart(2, '0') })),\n      faqs: D.faqs,\n      related: D.relatedLinks.map(r => ({ label: r.label, href: A + r.href }))\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/yoga-retreats-data.js"]}