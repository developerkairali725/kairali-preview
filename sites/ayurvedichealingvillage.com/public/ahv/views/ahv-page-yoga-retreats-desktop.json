{"id":"ahv-page-yoga-retreats-desktop","file":"AHV Page Yoga Retreats Desktop.dc.html","sourceSha256":"1681d02938afde46b3ee1d4d2b1668adfeb8f846711c222dec112b3e5c1870ce","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\na:active,button:active{filter:brightness(.88)}\nh1,h2,h3,h4{font-weight:400;margin:0}\nsummary{cursor:pointer;list-style:none;position:relative}summary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";position:absolute;right:4px;top:50%;transform:translateY(-50%);font-size:26px;color:#8F6212;line-height:1}\ndetails[open] summary::after{content:\"–\"}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Personalized Yoga Program in Kerala | Kairali</title>\n<meta name=\"description\" content=\"Explore Kairali’s personalised yoga programme in Kerala. Practice, pranayama and meditation customised to your goals after a doctor’s assessment.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/yoga-therapy-individual/\">\n<meta name=\"robots\" content=\"index, follow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Personalized Yoga Program in Kerala | Kairali\">\n<meta property=\"og:description\" content=\"Explore Kairali’s personalised yoga programme in Kerala. Practice, pranayama and meditation customised to your goals after a doctor’s assessment.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/yoga-therapy-individual/\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<link rel=\"icon\" href=\"/ahv/assets/img/logo_color-da22eb.svg\" sizes=\"192x192\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"WebPage\", \"@id\": \"https://ayurvedichealingvillage.com/yoga-therapy-individual/\", \"url\": \"https://ayurvedichealingvillage.com/yoga-therapy-individual/\", \"name\": \"Personalized Yoga Program in Kerala | Kairali\", \"description\": \"Explore Kairali’s personalised yoga programme in Kerala. Practice, pranayama and meditation customised to your goals after a doctor’s assessment.\", \"isPartOf\": {\"@id\": \"https://ayurvedichealingvillage.com/#website\"}, \"inLanguage\": \"en-US\"}, {\"@type\": \"WebSite\", \"@id\": \"https://ayurvedichealingvillage.com/#website\", \"url\": \"https://ayurvedichealingvillage.com/\", \"name\": \"Kairali — The Ayurvedic Healing Village\", \"inLanguage\": \"en-US\"}, {\"@type\": \"BreadcrumbList\", \"@id\": \"https://ayurvedichealingvillage.com/yoga-therapy-individual/#breadcrumb\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://ayurvedichealingvillage.com/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"All Programmes\", \"item\": \"https://ayurvedichealingvillage.com/all-programs/\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Yoga & Meditation Programs\", \"item\": \"https://ayurvedichealingvillage.com/yoga-meditation-programs/\"}, {\"@type\": \"ListItem\", \"position\": 4, \"name\": \"Vaiyaktika Yoga Sādhanā — Personalized Yoga\", \"item\": \"https://ayurvedichealingvillage.com/yoga-therapy-individual/\"}]}]}</script>\n</helmet>\n<div data-screen-label=\"Personalized Yoga Program — Desktop\">\n<a href=\"#main-content\" style=\"position:fixed;left:-9999px;top:12px;z-index:120;background:#5A4420;color:#F7F4EA;padding:14px 24px;border-radius:4px;font-weight:700;font-size:15px\" style-focus=\"left:16px\">Skip to main content</a>\n<dc-import name=\"AHV Chrome Header\" hint-size=\"100%,72px\"></dc-import>\n<main id=\"main-content\">\n<section style=\"width:min(1220px,94%);margin:0 auto;padding:32px 0 40px\">\n  <nav aria-label=\"Breadcrumb\" style=\"font-size:15px;color:#75695A;display:flex;gap:8px;align-items:center\"><a href=\"https://ayurvedichealingvillage.com/\" style=\"display:inline-flex;align-items:center;min-height:44px;min-width:44px\">Home</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/all-programs/\" style=\"display:inline-flex;align-items:center;min-height:44px\">All Programmes</a><span aria-hidden=\"true\">/</span><a href=\"https://ayurvedichealingvillage.com/yoga-meditation-programs/\" style=\"display:inline-flex;align-items:center;min-height:44px\">Yoga &amp; Meditation Programs</a><span aria-hidden=\"true\">/</span><span aria-current=\"page\" style=\"color:#2A2118\">Vaiyaktika Yoga Sādhanā — Personalized Yoga</span></nav>\n  <div style=\"display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:48px;align-items:end;padding-top:6px\">\n    <div>\n      <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Personalised yoga at Kairali</div>\n      <h1 style=\"font-family:'Marcellus',serif;font-size:clamp(34px,3.6vw,54px);line-height:1.12;margin:12px 0 0;max-width:20ch;text-wrap:balance\">Vaiyaktika Yoga Sādhanā — Personalized Yoga</h1>\n      <p style=\"font-size:19px;line-height:1.65;color:#514a3f;max-width:62ch;margin:20px 0 0;border-left:3px solid #C1882C;padding-left:20px\">A yoga programme designed around you. Practice, pranayama, and meditation customised to your goals after a doctor’s assessment.</p>\n    </div>\n    <div style=\"background:#43331E;color:#F7F4EA;border-radius:4px;padding:28px 30px\">\n      <h2 style=\"font-family:'Marcellus',serif;font-size:24px;line-height:1.3;color:#fff\">Discuss your personalised yoga programme</h2>\n      <p style=\"margin:12px 0 20px;font-size:17px;line-height:1.65;color:rgba(247,244,234,.92)\">Tell our team about your goals and experience. A doctor’s assessment guides your plan. Enquire about current arrangements and fees for your intended stay.</p>\n      <a href=\"https://ayurvedichealingvillage.com/contact-us/?programme=treatment\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:48px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 28px;font-weight:700;font-size:14.5px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Enquire about personalised yoga</a>\n    </div>\n  </div>\n</section>\n\n<nav aria-label=\"On this page\" style=\"position:sticky;top:0;z-index:40;background:rgba(247,244,234,.97);backdrop-filter:blur(8px);border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;display:flex;gap:4px 26px;flex-wrap:wrap;align-items:center\">\n    <a href=\"#about\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">About</a>\n    <a href=\"#practice\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Practice</a>\n    <a href=\"#faqs\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">FAQs</a>\n    <a href=\"#related\" style=\"display:inline-flex;align-items:center;min-height:50px;min-width:44px;font-weight:700;font-size:13.5px;letter-spacing:2px;text-transform:uppercase;color:#2A2118\" style-hover=\"color:#006038;text-decoration:none;border-bottom:2px solid #C1882C\">Related programmes</a>\n  </div>\n</nav>\n\n<section id=\"about\" aria-labelledby=\"about-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:64px 0 0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:56px;align-items:center\">\n  <img src=\"/ahv/assets/img/AHV-Yoga-Retreats-About.webp\" alt=\"A group practising yoga outdoors among trees.\" width=\"580\" height=\"386\" loading=\"lazy\" style=\"width:100%;max-width:580px;height:auto;display:block;border-radius:4px\">\n  <div>\n    <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">The programme</div>\n    <h2 id=\"about-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:12px 0 18px;text-wrap:balance\">A yoga programme designed around you</h2>\n    <p style=\"margin:0 0 16px;max-width:60ch\">Explore yoga postures, breathing exercises, meditation and relaxation as part of your practice.</p>\n    <p style=\"margin:0;max-width:60ch\">Your goals and a doctor’s assessment guide the programme. Enquire about the sessions, duration and arrangements for your intended stay.</p>\n  </div>\n</section>\n\n<section id=\"yoga-film\" class=\"ahv-yoga-film\" aria-labelledby=\"yoga-film-title\" data-ahv-yoga-film=\"1\">\n<style>.ahv-yoga-film{width:min(1220px,94%);margin:56px auto 0;padding:32px;background:#EAE5D4;box-sizing:border-box;border-radius:4px}.ahv-yoga-film-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:34px;align-items:center}.ahv-yoga-film-poster{display:block;position:relative;padding:0!important;aspect-ratio:16/9;overflow:hidden;border-radius:3px;background:#003c26}.ahv-yoga-film-poster img{position:absolute!important;inset:0;width:100%!important;height:100%!important;max-height:none!important;object-fit:cover;display:block}.ahv-yoga-film-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:#F7F4EA;color:#006038;font-size:24px;padding-left:4px;box-sizing:border-box;box-shadow:0 3px 15px #0003}.ahv-yoga-film h2{font-family:Marcellus,serif;font-size:clamp(27px,3vw,38px);line-height:1.2;font-weight:400;margin:0 0 18px}.ahv-yoga-film p{font-size:17px;line-height:1.75;margin:0 0 16px;color:#2A2118}.ahv-yoga-film .ahv-yoga-film-eyebrow{font:700 12px Mulish,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#80601e;margin-bottom:14px}.ahv-yoga-film-link{min-height:48px;display:inline-flex;align-items:center;gap:8px;font:700 16px Mulish,sans-serif;text-decoration:underline;text-underline-offset:5px;color:#006038}.ahv-yoga-film a:focus-visible{outline:3px solid #80601e;outline-offset:5px}.ahv-yoga-film .ahv-yoga-film-note{font-size:13px;color:#635B4B;margin:6px 0 0}@media(max-width:760px){.ahv-yoga-film{width:calc(100% - 40px);padding:22px;margin-top:40px}.ahv-yoga-film-grid{grid-template-columns:1fr;gap:24px}.ahv-yoga-film h2{font-size:28px}}</style>\n<div class=\"ahv-yoga-film-grid\"><a class=\"ahv-yoga-film-poster\" href=\"https://www.youtube.com/watch?v=ExM6_gMdRHs\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Watch Yoga at the Healing Village — opens YouTube in a new tab\"><img src=\"/ahv/assets/img/gallery-2026-09-24/08-yoga-side-female-patient-02.webp\" alt=\"Yoga practice in Kairali’s bright studio\" width=\"1600\" height=\"1066\" loading=\"lazy\"><span class=\"ahv-yoga-film-play\" aria-hidden=\"true\">▶</span></a><div><p class=\"ahv-yoga-film-eyebrow\">Watch the film</p><h2 id=\"yoga-film-title\">Yoga at the Healing Village</h2><p>Take a closer look at the setting and experience of a yoga retreat at Kairali.</p><a class=\"ahv-yoga-film-link\" href=\"https://www.youtube.com/watch?v=ExM6_gMdRHs\" target=\"_blank\" rel=\"noopener noreferrer\">Watch yoga film <span aria-hidden=\"true\">↗</span></a><p class=\"ahv-yoga-film-note\">Opens on YouTube in a new tab.</p></div></div></section>\n<section data-approved-merger=\"yoga\" aria-labelledby=\"individual-care-h\" style=\"width:min(1220px,94%);margin:0 auto;padding:40px 0 0\"><h2 id=\"individual-care-h\" style=\"font-family:Marcellus,serif;font-size:clamp(26px,3vw,36px);margin:0 0 20px\">Individualised Programmes</h2><p style=\"max-width:78ch;margin:0 0 18px\">Our trained yoga instructors and Ayurvedic doctors collaborate to develop a personalized yoga therapy plan that is tailored to your Prakriti (body constitution) and existing health concerns.</p><p style=\"max-width:78ch;margin:0 0 18px\">Discuss your experience, health goals, dietary needs and any mobility restrictions with the team. The practice can be adapted for beginners and experienced practitioners, with guidance on routines you can continue at home.</p><p style=\"max-width:78ch;margin:0 0 18px\">Any Ayurvedic treatments, dietary arrangements and individual sessions are discussed separately after assessment. Ask the team to confirm what is included, the session duration and applicable charges before admission.</p></section>\n<section id=\"practice\" aria-labelledby=\"practice-h\" style=\"scroll-margin-top:60px;margin-top:64px;padding:56px 0 60px;background:repeating-linear-gradient(0deg,rgba(193,136,44,.045) 0 1px,transparent 1px 8px),#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n<div style=\"width:min(1220px,94%);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px 56px;align-items:center\">\n  <div>\n    <h2 id=\"practice-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);line-height:1.16;margin:0 0 24px\">Time for your practice</h2>\n    <div style=\"display:flex;flex-direction:column;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ practices }}\" as=\"p\" hint-placeholder-count=\"3\">\n        <div style=\"display:grid;grid-template-columns:52px minmax(0,1fr);gap:18px;padding:16px 0;border-bottom:1px solid #E0D7C4\">\n          <div style=\"font-family:'Marcellus',serif;font-size:24px;color:#8F6212;line-height:1.2\">{{ p.n }}</div>\n          <div><h3 style=\"font-family:'Marcellus',serif;font-size:21px;line-height:1.3;margin:0 0 4px\">{{ p.title }}</h3><p style=\"margin:0;color:#514a3f;max-width:56ch\">{{ p.text }}</p></div>\n        </div>\n      </sc-for>\n    </div>\n  </div>\n  <img src=\"/ahv/assets/img/AHV-Yoga-Retreats-Practice.webp\" alt=\"A woman practising a standing yoga pose.\" width=\"720\" height=\"500\" loading=\"lazy\" style=\"width:100%;max-width:720px;height:auto;display:block;border-radius:4px;justify-self:end\">\n</div>\n</section>\n\n<section aria-label=\"Discuss your personalised yoga programme\" style=\"position:relative;overflow:hidden;background:#43331E;color:#F7F4EA;margin-top:64px\">\n  <img src=\"/ahv/assets/img/lotus.svg\" alt=\"\" aria-hidden=\"true\" style=\"position:absolute;right:-60px;top:-50px;width:430px;opacity:.08;pointer-events:none\">\n  <div style=\"width:min(1220px,94%);margin:0 auto;padding:60px 0;display:grid;grid-template-columns:minmax(0,1.4fr) auto;gap:32px 64px;align-items:center\">\n    <div>\n      <h2 style=\"font-family:'Marcellus',serif;font-size:clamp(30px,3vw,42px);line-height:1.18;color:#fff;text-wrap:balance\">Discuss your personalised yoga programme</h2>\n      <p style=\"margin:14px 0 0;color:rgba(247,244,234,.92);font-size:17.5px;line-height:1.75;max-width:60ch\">Tell our team about your goals and experience. A doctor’s assessment guides your plan. Enquire about current arrangements and fees for your intended stay.</p>\n    </div>\n    <a href=\"https://ayurvedichealingvillage.com/contact-us/?programme=treatment\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;justify-content:center;min-height:52px;background:#EEB41E;color:#2A2118;border-radius:4px;padding:0 34px;font-weight:700;font-size:15px;letter-spacing:1.5px;text-transform:uppercase;text-align:center\" style-hover=\"filter:brightness(.94);text-decoration:none;color:#2A2118\">Enquire about personalised yoga</a>\n  </div>\n</section>\n\n<section id=\"faqs\" data-owner-faq=\"20260925\" style=\"scroll-margin-top:84px;width:min(1220px,94%);margin:0 auto;padding:44px 0 0\"><h2 style=\"font-family:Marcellus,serif;font-size:clamp(26px,2.8vw,40px);margin:0 0 24px\">Frequently asked questions</h2><div style=\"border-top:1px solid #D8D1C0\"><details style=\"border-bottom:1px solid #D8D1C0\"><summary style=\"font-family:Marcellus,serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 34px 19px 0;min-height:44px;box-sizing:border-box;cursor:pointer\">How can I find out whether this programme is right for me?</summary><p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f\">Not sure where to start? Speak with Priya or our sales team, share your details for physician review, or request a free consultation by video call, phone or email—whichever is convenient. After you submit your request, a coordinator will contact you to arrange the consultation.</p></details>\n<details style=\"border-bottom:1px solid #D8D1C0\"><summary style=\"font-family:Marcellus,serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 34px 19px 0;min-height:44px;box-sizing:border-box;cursor:pointer\">How is personalised yoga matched to my ability?</summary><p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f\">Tell the team about your yoga experience, goals and any mobility or health restrictions. Discuss the proposed practice, level of instruction and adaptations before admission.</p></details>\n<details style=\"border-bottom:1px solid #D8D1C0\"><summary style=\"font-family:Marcellus,serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 34px 19px 0;min-height:44px;box-sizing:border-box;cursor:pointer\">Can I continue my prescribed medicines?</summary><p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f\">Do not stop or change prescribed medicines on your own. Share a complete list of medicines and supplements with your treating clinicians and discuss any proposed Ayurvedic medicines with them.</p></details>\n<details style=\"border-bottom:1px solid #D8D1C0\"><summary style=\"font-family:Marcellus,serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 34px 19px 0;min-height:44px;box-sizing:border-box;cursor:pointer\">What should I discuss with the physician before treatment?</summary><p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f\">Your consultation is an opportunity to understand the proposed treatment, its expected benefits, possible side effects and available alternatives. Share any concerns with your physician and keep the care team informed about how you feel during treatment.</p></details>\n<details style=\"border-bottom:1px solid #D8D1C0\"><summary style=\"font-family:Marcellus,serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 34px 19px 0;min-height:44px;box-sizing:border-box;cursor:pointer\">What results can I realistically expect, and how long should I stay?</summary><p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f\">Treatment goals and the recommended duration of admission depend on your condition and the physician’s assessment. Your physician will discuss expected progress and review your response during treatment. Individual outcomes vary.</p></details>\n<details style=\"border-bottom:1px solid #D8D1C0\"><summary style=\"font-family:Marcellus,serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 34px 19px 0;min-height:44px;box-sizing:border-box;cursor:pointer\">Can a companion stay with me?</summary><p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f\">Companion stays are considered case by case. Share your accommodation and assistance needs before admission so the team can confirm availability, arrangements and applicable charges.</p></details>\n<details style=\"border-bottom:1px solid #D8D1C0\"><summary style=\"font-family:Marcellus,serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 34px 19px 0;min-height:44px;box-sizing:border-box;cursor:pointer\">What follow-up is included after discharge?</summary><p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f\">Your care includes four remote follow-up consultations with your treating physician within one year after discharge. Please schedule each appointment with your doctor; consultation dates are not fixed when you leave.</p></details>\n<details style=\"border-bottom:1px solid #D8D1C0\"><summary style=\"font-family:Marcellus,serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 34px 19px 0;min-height:44px;box-sizing:border-box;cursor:pointer\">Do I need to submit medical reports before admission?</summary><p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f\">Pre-admission medical reports and physician clearance are required only for severe conditions, on a case-by-case basis. The team will confirm whether they are needed for your admission.</p></details>\n<details style=\"border-bottom:1px solid #D8D1C0\"><summary style=\"font-family:Marcellus,serif;font-size:20px;line-height:1.4;color:#2A2118;padding:19px 34px 19px 0;min-height:44px;box-sizing:border-box;cursor:pointer\">What support is available if I need help getting around or with daily activities?</summary><p style=\"margin:0;padding:0 0 22px;font-size:17px;line-height:1.7;color:#514a3f\">Routine assistance, such as help walking or travelling by wheelchair between your room and the treatment centre, is available without requiring a dedicated attendant. If you need dedicated nursing or attendant support, this can be arranged at an additional cost based on the level of assistance required. Please share your needs before admission so the team can confirm suitable arrangements and charges.</p></details></div></section><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"How can I find out whether this programme is right for me?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Not sure where to start? Speak with Priya or our sales team, share your details for physician review, or request a free consultation by video call, phone or email—whichever is convenient. After you submit your request, a coordinator will contact you to arrange the consultation.\"}}, {\"@type\": \"Question\", \"name\": \"How is personalised yoga matched to my ability?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Tell the team about your yoga experience, goals and any mobility or health restrictions. Discuss the proposed practice, level of instruction and adaptations before admission.\"}}, {\"@type\": \"Question\", \"name\": \"Can I continue my prescribed medicines?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Do not stop or change prescribed medicines on your own. Share a complete list of medicines and supplements with your treating clinicians and discuss any proposed Ayurvedic medicines with them.\"}}, {\"@type\": \"Question\", \"name\": \"What should I discuss with the physician before treatment?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Your consultation is an opportunity to understand the proposed treatment, its expected benefits, possible side effects and available alternatives. Share any concerns with your physician and keep the care team informed about how you feel during treatment.\"}}, {\"@type\": \"Question\", \"name\": \"What results can I realistically expect, and how long should I stay?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Treatment goals and the recommended duration of admission depend on your condition and the physician’s assessment. Your physician will discuss expected progress and review your response during treatment. Individual outcomes vary.\"}}, {\"@type\": \"Question\", \"name\": \"Can a companion stay with me?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Companion stays are considered case by case. Share your accommodation and assistance needs before admission so the team can confirm availability, arrangements and applicable charges.\"}}, {\"@type\": \"Question\", \"name\": \"What follow-up is included after discharge?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Your care includes four remote follow-up consultations with your treating physician within one year after discharge. Please schedule each appointment with your doctor; consultation dates are not fixed when you leave.\"}}, {\"@type\": \"Question\", \"name\": \"Do I need to submit medical reports before admission?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Pre-admission medical reports and physician clearance are required only for severe conditions, on a case-by-case basis. The team will confirm whether they are needed for your admission.\"}}, {\"@type\": \"Question\", \"name\": \"What support is available if I need help getting around or with daily activities?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Routine assistance, such as help walking or travelling by wheelchair between your room and the treatment centre, is available without requiring a dedicated attendant. If you need dedicated nursing or attendant support, this can be arranged at an additional cost based on the level of assistance required. Please share your needs before admission so the team can confirm suitable arrangements and charges.\"}}]}</script>\n\n<section id=\"related\" aria-labelledby=\"related-h\" style=\"scroll-margin-top:60px;width:min(1220px,94%);margin:0 auto;padding:64px 0 72px\">\n  <div style=\"font-weight:700;font-size:13px;letter-spacing:2.6px;color:#8F6212;text-transform:uppercase\">Ayurvedic treatment programmes</div>\n  <h2 id=\"related-h\" style=\"font-family:'Marcellus',serif;font-size:clamp(28px,2.8vw,40px);margin:12px 0 24px\">Explore more programmes</h2>\n  <ul style=\"list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));gap:0 32px;border-top:1px solid #E9E2D3\">\n    <sc-for list=\"{{ related }}\" as=\"r\" hint-placeholder-count=\"8\">\n      <li style=\"border-bottom:1px solid #E9E2D3\"><a href=\"{{ r.href }}\" onClick=\"{{ guard }}\" style=\"display:flex;align-items:center;gap:12px;min-height:52px;padding:6px 0;font-size:16.5px;font-weight:600;color:#2A2118\" style-hover=\"color:#006038\"><span aria-hidden=\"true\" style=\"color:#C1882C;flex:none\">◆</span>{{ r.label }}</a></li>\n    </sc-for>\n  </ul>\n  <nav aria-label=\"More from Kairali\" style=\"margin-top:44px;display:flex;justify-content:center;gap:8px 28px;flex-wrap:wrap;border-top:1px solid #E9E2D3;padding-top:22px\">\n    <a href=\"https://ayurvedichealingvillage.com/social-responsibilities/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Social Responsibility</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive-yoga-retreat/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">Past Retreats</a>\n    <a href=\"https://ayurvedichealingvillage.com/archive/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;min-height:44px;font-size:15.5px;font-weight:700\">News &amp; Past Events</a>\n  </nav>\n</section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" hint-size=\"100%,560px\"></dc-import>\n</div>\n","logic":"\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; }\n  renderVals() {\n    const D = window.AHV_YOGA_RETREATS || { practices: [], faqs: [], relatedLinks: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    return {\n      guard: () => {} /* preview-only nav guard neutralised for the published site */,\n      practices: D.practices.map((p, i) => ({ ...p, n: String(i + 1).padStart(2, '0') })),\n      faqs: D.faqs,\n      related: D.relatedLinks.map(r => ({ label: r.label, href: A + r.href }))\n    };\n  }\n}\n","props":"","scripts":["/ahv/assets/yoga-retreats-data.js"]}
