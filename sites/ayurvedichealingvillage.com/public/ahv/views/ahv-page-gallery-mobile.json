rent=\"page\" style=\"color:#2A2118\">Gallery</span>\n    </nav>\n    <div style=\"display:flex;flex-direction:column;gap:14px;padding-top:4px\">\n      <div>\n        <p style=\"margin:0;font-weight:700;font-size:12px;letter-spacing:1.8px;line-height:1.5;text-transform:uppercase;color:#8F6212\">Kairali — The Ayurvedic Healing Village</p>\n        <h1 style=\"font-family:'Marcellus',serif;font-size:36px;line-height:1.1;margin:6px 0 0\">Gallery</h1>\n      </div>\n      <div>\n        <p style=\"font-size:17.5px;line-height:1.65;color:#514a3f;margin:0;border-left:3px solid #C1882C;padding-left:16px;text-wrap:pretty\">{{ G.intro }}</p>\n      </div>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"featured-h\" style=\"width:min(1220px,94%);margin:0 auto\">\n    <h2 id=\"featured-h\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)\">Featured collections</h2>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:22px\">\n      <li style=\"min-width:0\">\n        <a href=\"{{ lead.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;height:100%;color:#2A2118;text-decoration:none\" style-hover=\"color:#006038;text-decoration:none\">\n          <span style=\"display:block;flex:1;min-height:0;aspect-ratio:4/3;position:relative;overflow:hidden;border-radius:4px;background:#E6DFCD\">\n            <img src=\"{{ lead.cover }}\" alt=\"{{ lead.alt }}\" width=\"1600\" height=\"1067\" fetchpriority=\"high\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ lead.pos }};display:block\">\n          </span>\n          <span style=\"display:flex;align-items:baseline;justify-content:space-between;gap:4px 20px;flex-wrap:wrap;padding:14px 2px 10px;border-bottom:1px solid #E0D7C4\">\n            <span style=\"display:flex;align-items:baseline;gap:14px;flex-wrap:wrap\">\n              <span style=\"font-family:'Marcellus',serif;font-size:25px;line-height:1.2\">{{ lead.name }}</span>\n              <span style=\"font-size:15.5px;color:#5E5446\">{{ lead.meta }}</span>\n            </span>\n            <span style=\"display:inline-flex;align-items:center;gap:9px;min-height:44px;font-weight:700;font-size:13.5px;letter-spacing:1.6px;text-transform:uppercase;color:#006038\">View collection<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span>\n          </span>\n        </a>\n      </li>\n      <sc-for list=\"{{ side }}\" as=\"c\" hint-placeholder-count=\"2\">\n        <li style=\"min-width:0\">\n          <a href=\"{{ c.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;color:#2A2118;text-decoration:none\" style-hover=\"color:#006038;text-decoration:none\">\n            <span style=\"display:block;overflow:hidden;border-radius:4px;background:#E6DFCD\"><img src=\"{{ c.cover }}\" alt=\"{{ c.alt }}\" width=\"1600\" height=\"1067\" style=\"width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;object-position:{{ c.pos }};display:block\"></span>\n            <span style=\"display:flex;align-items:baseline;justify-content:space-between;gap:4px 16px;flex-wrap:wrap;padding:12px 2px 8px;border-bottom:1px solid #E0D7C4\">\n              <span style=\"display:flex;align-items:baseline;gap:12px;flex-wrap:wrap\">\n                <span style=\"font-family:'Marcellus',serif;font-size:22px;line-height:1.2\">{{ c.name }}</span>\n                <span style=\"font-size:15.5px;color:#5E5446\">{{ c.meta }}</span>\n              </span>\n              <span style=\"display:inline-flex;align-items:center;gap:9px;min-height:44px;font-weight:700;font-size:13.5px;letter-spacing:1.6px;text-transform:uppercase;color:#006038\">View collection<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span>\n            </span>\n          </a>\n        </li>\n      </sc-for>\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"more-h\" style=\"width:min(1220px,94%);margin:0 auto;padding:44px 0 0\">\n    <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;border-top:1px solid #D9CFB9;padding-top:22px;margin-bottom:6px\">\n      <h2 id=\"more-h\" style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.18\">More collections</h2>\n      \n    </div>\n    <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0;border-top:1px solid #E0D7C4\">\n      <sc-for list=\"{{ more }}\" as=\"c\" hint-placeholder-count=\"6\">\n        <li style=\"min-width:0\">\n          <a href=\"{{ c.url }}\" onClick=\"{{ guard }}\" style=\"display:grid;grid-template-columns:minmax(96px,34%) minmax(0,1fr);gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid #E0D7C4;color:#2A2118;text-decoration:none\" style-hover=\"color:#006038;text-decoration:none\">\n            <span style=\"display:block;overflow:hidden;border-radius:4px;background:#E6DFCD\"><img src=\"{{ c.cover }}\" alt=\"{{ c.alt }}\" loading=\"lazy\" width=\"1600\" height=\"1066\" style=\"width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:{{ c.pos }};display:block\"></span>\n            <span style=\"display:flex;flex-direction:column;min-width:0\">\n              <span style=\"font-family:'Marcellus',serif;font-size:20px;line-height:1.22\">{{ c.name }}</span>\n              <sc-if value=\"{{ c.hasMeta }}\" hint-placeholder-val=\"{{ true }}\"><span style=\"font-size:15.5px;color:#5E5446;margin-top:2px\">{{ c.meta }}</span></sc-if>\n              <span style=\"display:inline-flex;align-items:center;gap:8px;min-height:44px;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#006038\">View<span aria-hidden=\"true\" style=\"color:#C1882C\">→</span></span>\n            </span>\n          </a>\n        </li>\n      </sc-for>\n    </ul>\n  </section>\n\n  <section aria-labelledby=\"media-h\" style=\"margin-top:48px;background:#0F3A26;color:#F7F4EA;padding:40px 0 44px\">\n    <div style=\"width:min(1220px,94%);margin:0 auto\">\n      <h2 id=\"media-h\" style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.18;color:#F7F4EA\">On film, and a tour on the way</h2>\n      <div style=\"height:20px\"></div>\n      <ul style=\"list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:20px\">\n        <sc-for list=\"{{ media }}\" as=\"m\" hint-placeholder-count=\"2\">\n          <li style=\"min-width:0\">\n            <a href=\"{{ m.url }}\" onClick=\"{{ guard }}\" style=\"display:flex;flex-direction:column;color:#F7F4EA;text-decoration:none;background:#174A31;border-radius:4px;overflow:hidden\" style-hover=\"background:#1C5638;color:#FFFFFF;text-decoration:none\">\n              <span style=\"position:relative;display:block\">\n                <img src=\"{{ m.cover }}\" alt=\"{{ m.alt }}\" loading=\"lazy\" width=\"1400\" height=\"1000\" style=\"width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;object-position:{{ m.pos }};display:block\">\n                <span style=\"position:absolute;left:16px;top:16px;display:inline-flex;align-items:center;gap:8px;background:#F7F4EA;color:#0F3A26;border-radius:4px;padding:7px 12px 7px 10px;font-weight:700;font-size:13px;letter-spacing:1.6px;text-transform:uppercase\">\n                  <sc-if value=\"{{ m.isFilm }}\" hint-placeholder-val=\"{{ true }}\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"1.5\"></rect><path d=\"M3 9h18M3 15h18M8 5v4M16 5v4M8 15v4M16 15v4\"></path></svg></sc-if>\n                  <sc-if value=\"{{ m.isTour }}\" hint-placeholder-val=\"{{ false }}\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><ellipse cx=\"12\" cy=\"12\" rx=\"9\" ry=\"4.5\"></ellipse><path d=\"M12 3v18\"></path><path d=\"M15 16.8l2.2 1.4-1.6 2\"></path></svg></sc-if>\n                  {{ m.tag }}\n                </span>\n              </span>\n              <span style=\"display:flex;flex-direction:column;gap:4px;padding:14px 16px 10px\">\n                <span style=\"font-family:'Marcellus',serif;font-size:23px;line-height:1.2\">{{ m.name }}</span>\n                <span style=\"font-size:16.5px;color:#E4DCC8\">{{ m.meta }}</span>\n                <span style=\"display:inline-flex;align-items:center;gap:9px;min-height:44px;font-weight:700;font-size:13.5px;letter-spacing:1.6px;text-transform:uppercase;color:#F2C955\">{{ m.action }}<span aria-hidden=\"true\">→</span></span>\n              </span>\n            </a>\n          </li>\n        </sc-for>\n      </ul>\n    </div>\n  </section>\n\n  <section aria-labelledby=\"villas-h\" style=\"width:min(1220px,94%);margin:0 auto;padding:36px 0;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;gap:16px 32px;flex-wrap:wrap;border-bottom:1px solid #E0D7C4\">\n    <h2 id=\"villas-h\" style=\"font-family:'Marcellus',serif;font-size:23px;line-height:1.2\">Want to Know more about Our Villas</h2>\n    <a href=\"https://ayurvedichealingvillage.com/our-villas/\" onClick=\"{{ guard }}\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 28px;border:1.5px solid #006038;border-radius:4px;color:#006038;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:#006038;color:#F7F4EA;text-decoration:none\">KNOW MORE<span aria-hidden=\"true\">→</span></a>\n  </section>\n\n  <section aria-label=\"Where we are\" style=\"width:min(1220px,94%);margin:0 auto;padding:36px 0 0\">\n    <h2 style=\"font-family:'Marcellus',serif;font-size:26px;line-height:1.18\">Where we are</h2>\n    <p style=\"margin:8px 0 0\">Kairali sits in Palakkad district, inland Kerala, in the south west of India.</p>\n    <div style=\"display:flex;flex-direction:column;gap:22px;margin:20px 0 26px\">\n      <sc-for list=\"{{ G.maps }}\" as=\"mp\" hint-placeholder-count=\"3\">\n        <figure style=\"margin:0\"><img src=\"{{ mp.src }}\" alt=\"{{ mp.alt }}\" loading=\"lazy\" style=\"width:100%;height:190px;object-fit:contain;display:block\"><figcaption style=\"margin-top:10px;font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:#75695A;text-align:center\">{{ mp.cap }}</figcaption></figure>\n      </sc-for>\n    </div>\n    <figure style=\"margin:0\"><img src=\"/ahv/assets/img/travel/89310cfa7faa54ee1eecf73b427105b0af81fd179ce8fad0e6992eaa563b51c1.jpg\" alt=\"Illustrated aerial map of the grounds, numbering the reception, Ayurvedic hospital, yoga centre, meditation hall, villas, herbal garden and other facilities\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-radius:4px\"><figcaption style=\"margin-top:10px;font-size:15.5px;color:#75695A\">A plan of the grounds, numbering reception, the Ayurvedic hospital, the yoga centre, the herbal garden and the villas.</figcaption></figure>\n  </section>\n\n  <section aria-label=\"Guidance\" style=\"margin-top:44px;padding:40px 0 46px;background:#fff;border-top:1px solid #E9E2D3;border-bottom:1px solid #E9E2D3\">\n    <div style=\"width:min(1220px,92%);margin:0 auto;text-align:center\">\n      <span aria-hidden=\"true\" style=\"display:block;font-family:'Marcellus',serif;font-size:17px;color:#C1882C;margin-bottom:10px\">✳</span>\n      <ul style=\"margin:0 auto 22px;padding:0;list-style:none;display:flex;justify-content:center;flex-wrap:wrap;gap:10px 28px;font-size:16px;font-weight:600;padding:0 4px\">\n        <sc-for list=\"{{ G.trust }}\" as=\"t\" hint-placeholder-count=\"4\"><li style=\"display:flex;gap:10px;align-items:baseline\"><span aria-hidden=\"true\" style=\"color:#C1882C\">◆</span><span>{{ t }}</span></li></sc-for>\n      </ul>\n      <h2 style=\"font-family:'Marcellus',serif;font-size:24px;margin:0 0 10px\">Not sure which programme fits?</h2>\n      <p style=\"margin:0 auto 24px;font-size:17px;line-height:1.7;color:#514a3f;max-width:60ch\">Share your goal in your own words — the patient care team or an Ayurvedic doctor will point you to the right programme.</p>\n      <div style=\"display:flex;flex-direction:column;gap:12px\">\n        <a href=\"https://ayurvedichealingvillage.com/online-consultation/\" onClick=\"{{ guard }}\" style=\"background:#EEB41E;color:#2A2118;border-radius:4px;padding:10px 16px;min-height:52px;text-align:center;box-sizing:border-box;width:100%;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:#D9A317;color:#2A2118;text-decoration:none\">Free Doctor Consultation</a>\n        <a href=\"https://wa.me/919289838797\" target=\"_blank\" rel=\"noopener noreferrer\" onClick=\"{{ guard }}\" style=\"border:1.5px solid #006038;color:#006038;border-radius:4px;padding:10px 16px;min-height:52px;text-align:center;box-sizing:border-box;width:100%;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:#006038;color:#F7F4EA;text-decoration:none\">WhatsApp Patient Care</a>\n        <a href=\"https://ayurvedichealingvillage.com/enquiry-form/\" onClick=\"{{ guard }}\" style=\"border:1.5px solid #5A4420;color:#5A4420;border-radius:4px;padding:10px 16px;min-height:52px;text-align:center;box-sizing:border-box;width:100%;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;letter-spacing:1.5px;text-transform:uppercase\" style-hover=\"background:#5A4420;color:#F7F4EA;text-decoration:none\">Enquire Now</a>\n      </div>\n    </div>\n  </section>\n</main>\n<dc-import name=\"AHV Chrome Footer\" narrow=\"true\" hint-size=\"100%,900px\"></dc-import>\n</div>\n",
  "logic": "\nclass Component extends DCLogic {\n  componentDidMount() { document.documentElement.lang = 'en-US'; if (!window.AHV_GALLERY_2026) this._t = setTimeout(() => this.forceUpdate(), 300); }\n  componentWillUnmount() { clearTimeout(this._t); }\n  renderVals() {\n    const G = window.AHV_GALLERY_2026 || { intro: '', featured: [], more: [], media: [], trust: [], maps: [] };\n    const A = 'https://ayurvedichealingvillage.com';\n    const f = G.featured.map(c => ({ ...c, url: A + c.href }));\n    return {\n      guard: (e) => { e.preventDefault(); },\n      G,\n      lead: f[0] || {}, side: f.slice(1),\n      more: G.more.map(c => ({ ...c, url: A + c.href, hasMeta: !!c.meta })),\n      media: G.media.map(m => ({ ...m, url: A + m.href, isFilm: m.kind === 'film', isTour: m.kind === 'tour' }))\n    };\n  }\n}\n",
