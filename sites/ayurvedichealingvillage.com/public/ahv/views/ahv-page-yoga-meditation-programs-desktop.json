{"id":"ahv-page-yoga-meditation-programs-desktop","file":"AHV Page Yoga Meditation Programs Desktop.dc.html","sourceSha256":"e235eae7c40916027a14b5adea4fc13c27a52088785ee71109db5d5f5a445992","variant":"desktop","template":"\n<helmet>\n<link href=\"/ahv/fonts/ahv-33eeac48ab44.css\" rel=\"stylesheet\">\n<style>\nbody{margin:0;background:#F7F4EA;color:#2A2118;font-family:'Mulish',sans-serif;font-size:18px;line-height:1.7}\na{color:#006038;text-decoration:none}a:hover{color:#004226;text-decoration:underline}\n:focus-visible{outline:3px solid #6B7726;outline-offset:2px;box-shadow:0 0 0 6px rgba(247,244,234,.85)}\nh1,h2,h3,h4,h5,h6{font-weight:400;margin:0}\n@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}\n@media (prefers-reduced-motion:reduce){*{transition:none !important;animation:none !important}}\n</style>\n<title>Yoga and Meditation Program for Holistic Wellness in Kerala</title>\n<meta name=\"description\" content=\"Experience deep relaxation with our yoga & meditation program. Restore balance, enhance well-being, and rejuvenate mind & body at our Kerala retreat.\">\n<link rel=\"canonical\" href=\"https://ayurvedichealingvillage.com/yoga-meditation-programs/\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:title\" content=\"Yoga &amp; Meditation Programs\">\n<meta property=\"og:description\" content=\"Experience deep relaxation with our yoga & meditation program. Restore balance, enhance well-being, and rejuvenate mind & body at our Kerala retreat.\">\n<meta property=\"og:url\" content=\"https://ayurvedichealingvillage.com/yoga-meditation-programs/\">\n<meta property=\"og:site_name\" content=\"Ayurvedic Healing Village\">\n<meta property=\"og:image\" content=\"https://ayurvedichealingvillage.com/wp-content/uploads/2024/11/yoga-meditation.webp\">\n<meta property=\"og:image:width\" content=\"1920\">\n<meta property=