   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6ff5c8a3cf26f250ff8a",
   "sourceHash": "6ff5c8a3cf26f250ff8a85464b53deb231cd231a7218cf67b7632fa0cfdab432",
   "text": "Hable con el equipo de recepción sobre cualquier cosa que requiera atención durante su estancia. También puede llamar al",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
