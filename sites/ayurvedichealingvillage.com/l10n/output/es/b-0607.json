   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d3fa99211a7bce0d7ae3",
   "sourceHash": "d3fa99211a7bce0d7ae3cded6e87acdc908a0ef5db7c7540166827f042a44f84",
   "text": "Para consultar disponibilidad, pedir información sobre programas u obtener ayuda para planificar una estancia, por favor",
