   "text": "Revisión",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_11e82f05851a22f5b062",
   "sourceHash": "11e82f05851a22f5b062e0a4e22605644fc059826fe964adb3f1d1ba1dd2f812",
   "text": "— Los instructores pueden ajustar las sesiones tras valorar la comodidad y la experiencia de cada participante.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_89cba615ef1e4e92ae7d",
   "sourceHash": "89cba615ef1e4e92ae7d26d61d101a9be4054c63d248951798bea27d8455ae19",
