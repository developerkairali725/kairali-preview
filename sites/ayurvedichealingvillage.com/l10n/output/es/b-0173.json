   "sourceHash": "867b1823120be77dae98a8f51a8cfc695fc2cb86d24c3a2746ba022397aab3d1",
   "text": "Un grupo practicando yoga al aire libre entre árboles.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
