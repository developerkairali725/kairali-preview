   "issues": []
  },
  {
   "id": "t_dcb1d3a1e24bb50c617b",
   "sourceHash": "dcb1d3a1e24bb50c617b8964ae8db483925f76f4d5d93e89f0c8d4b310791c13",
   "text": "就已付金额开具抵用凭证，可在自开具之日起的固定期限内用于日后预订。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
