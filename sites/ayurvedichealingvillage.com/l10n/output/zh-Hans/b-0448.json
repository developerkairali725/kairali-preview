   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_06cf91ec02a45efd66f4",
   "sourceHash": "06cf91ec02a45efd66f4564455484d1c6ecc2a056d2aa38328f5654342a50536",
   "text": "金额为已付款项，可在自开具之日起的固定期限内用于日后预订。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
