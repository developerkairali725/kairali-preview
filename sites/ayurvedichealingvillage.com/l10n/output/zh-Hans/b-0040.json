   "sourceHash": "9c91f1b2d91db1d7096dc3609c5d808db19948527072461b35a50b75068a6cd2",
   "text": "走近大自然的药房",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
