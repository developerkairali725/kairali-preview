  {
   "id": "t_6859bec99b53c500ae62",
   "sourceHash": "6859bec99b53c500ae6200fbe29b858efe9ac5e996ac1949d3f05c2c39baf506",
   "text": "在项目全程为您的业务提供指导",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
