   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_44e55c97cd8eb5093079",
   "sourceHash": "44e55c97cd8eb509307968c320d2a0fc1a5221b3c36fdd6f2fa53a484286b959",
   "text": "肌肤更清透，重拾自信：Kairali 皮肤治疗项目的患者故事",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
