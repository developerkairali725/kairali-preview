   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c4de1a6faa8b3494ae84",
   "sourceHash": "c4de1a6faa8b3494ae843686786d2093a4ae137f16a0e4e951d904059d52771e",
   "text": "医生指导",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d5ee3997769029dcace7",
