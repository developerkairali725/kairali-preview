   "text": "双人合住",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_75e61735ea3d36c5e722",
   "sourceHash": "75e61735ea3d36c5e72242a2ac30866340e974c25e1ac39e4ba51d56be8abd47",
   "text": "每人 $4650 AUD",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dab2461387ef587f46a8",
