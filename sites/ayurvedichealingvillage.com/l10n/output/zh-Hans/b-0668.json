   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_da174947354b8eb4c834",
   "sourceHash": "da174947354b8eb4c834894b6524ef60423e181588ba5deec5cafd6ea51d4137",
   "text": "您的美言让我们深感荣幸。感谢您信任我们，将您的护理托付给我们。#阿育吠陀",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
