   ]
  },
  {
   "id": "t_36d205aae1438bd1c2a2",
   "sourceHash": "36d205aae1438bd1c2a2ecc385e5eed82f4dd5b357fb2859de1ed27561a0be1b",
   "text": "初识阿育吠陀",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dc163612eedf4ae5ea8f",
   "sourceHash": "dc163612eedf4ae5ea8f01416002867e92a83330d32c0473071e70ed3cf19f34",
   "text": "阿育吠陀膳食：平衡与健康 | 阿育吠陀疗愈村",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d49e721d77fc424d677a",
   "sourceHash": "d49e721d77fc424d677a624095a1a5cfb2a86015df224954f24462cd9b886487",
   "text": "在阿育吠陀疗愈村品尝阿育吠陀膳食：精选新鲜、有机的时令食材，旨在平衡体质能量（dosha）、促进消化、滋养身体。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a8951e02bacd929fecfc",
   "sourceHash": "a8951e02bacd929fecfc9a9b0714e5e9819472fff581615de13e9f4b36b014fb",
   "text": "Kairali 阿育吠陀疗愈村的阿育吠陀膳食秉承悠久的阿育吠陀饮食传统。从根本上说，阿育吠陀烹饪是一种整体的营养方法，通过精心挑选和制备食材来平衡身体、心智与精神。本部分将展示如何将阿育吠陀的饮食原则轻松融入日常生活，以支持身心和谐、活力与健康。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_25a5ab4bb33030157e7c",
   "sourceHash": "25a5ab4bb33030157e7c8c72f95e237c1cd4d360013d5c38d50431006182bb8d",
   "text": "木托盘上盛放着米粥、红米饭、一道蔬菜配菜和一杯粉色饮品",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_70939bbcff4f64bb02ad",
   "sourceHash": "70939bbcff4f64bb02adec71595948e6055f1ed4fbada3e18dfbf0dcaf6b82e5",
   "text": "阿育吠陀膳食的精髓",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_85c323d839a9679a1975",
   "sourceHash": "85c323d839a9679a1975e0d28aa0dc4af65c9aaa75d6b179f87692f88bfb4a66",
   "text": "阿育吠陀烹饪的基础理念是：食物即良药，我们的饮食对整体健康有着重要影响。它注重营养丰富、易于消化、天然、应季且本地采购的食材。膳食会根据每个人特定的体质能量（dosha）——瓦塔（Vata）、皮塔（Pitta）或卡法（Kapha）——量身定制，以维持或恢复身体的平衡。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b37d68c1fd1d4b5ae6bb",
   "sourceHash": "b37d68c1fd1d4b5ae6bb70b2c48f5f6ce7332f1016abe13d75a0066bcbf06f61",
   "text": "甜、酸、咸、苦、辛、涩六种基本味道在每餐中都经过精心搭配，带来愉悦而均衡的饮食体验。通过这种方式，阿育吠陀饮食有助于促进消化、预防失衡并增进整体健康。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a46f42e2bf0eda6ec21a",
   "sourceHash": "a46f42e2bf0eda6ec21aac1d0640579f0ff429c4df96f9d6e57fa224fe2bc3c2",
   "text": "疗愈村阿育吠陀膳食的特色",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_02e3edf2c539b214e08a",
   "sourceHash": "02e3edf2c539b214e08a1b6b80df2185613744e062d799463ff002aae13e8896",
   "text": "个性化膳食计划",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e457bff4f164dba0c369",
   "sourceHash": "e457bff4f164dba0c369155eebca56c1a6ce377899d36a5be07da1a8004e886d",
   "text": "：疗愈村的膳食会根据每位来访者独特的健康需求和体质能量（dosha）精心制备。这种个性化方式让每一餐都有助于促进身体的自然疗愈与更新过程。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
