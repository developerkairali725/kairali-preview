 "units": [
  {
   "id": "t_5b5c9253ce49f4002640",
   "sourceHash": "5b5c9253ce49f400264057655aa3ff856f2ede715c046f958cd81723020ccfe9",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]关注与压力相关的症状、休息和放松",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b2379deae48acd9472d1",
   "sourceHash": "b2379deae48acd9472d1bb885c1819b26ed0a306141253eadc89cb2fd2b638c7",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]围绕消化和新陈代谢安排饮食和作息",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f2e5982c9c626f2c542d",
   "sourceHash": "f2e5982c9c626f2c542dc95a2f987e2a76f78b3cf37dca70a6ae9327bb6e259a",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]通过瑜伽和冥想获得心灵休憩与平静",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fba8bec6b663e0c411c2",
   "sourceHash": "fba8bec6b663e0c411c2c6138ea085751a0012cceb0deb37ec164e1f6934b18a",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]根据您的体质量身定制的个性化阿育吠陀疗法、饮食和生活方式指导",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_605c751251e180c72c96",
   "sourceHash": "605c751251e180c72c9673a5b0c4db68f8ff969a29001bd3976a63539239cd80",
   "text": "一位患者的焕活与排毒方案",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5195ada98b2d4ebef282",
   "sourceHash": "5195ada98b2d4ebef282cd9b42b0552cb6381f92eb140a14a47438eb70f41130",
   "text": "为戒断康复人士提供由医师指导的整体支持。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f4d62322179ea645f0f6",
   "sourceHash": "f4d62322179ea645f0f6247ffdc5189007476fed2b68575a4ecf20976daf777e",
   "text": "焕活与排毒方案 – Shodhanam Karma",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e08f8f9b65dd6aa8b930",
   "sourceHash": "e08f8f9b65dd6aa8b9301405fa4d9dd2c7130964f77d4cba8dbc6bdbd1cda3c8",
   "text": "Kairali（喀拉拉邦）为高血压提供由医师指导的阿育吠陀照护：草药、瑜伽和饮食，与您的处方治疗配合规划。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_58004e3dd087ef703eb4",
   "sourceHash": "58004e3dd087ef703eb4ee02e7abdf0e848f17e2f1e078972546c99a2175d24a",
   "text": "Kairali – 阿育吠陀疗愈村提供为期 14/21/28 天的阿育吠陀血压治疗。医师评估潜在因素并提供针对性的调理方法。阿育吠陀疗程、草药产品以及 Shirodhara（希罗达拉）、Thakaradhara（塔克拉达拉）和 Abhyangam（阿比扬伽）等按摩，将作为个性化方案的一部分进行选择。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a561ecbed4a64d39b037",
   "sourceHash": "a561ecbed4a64d39b0378091772a8342b5fad6b5a499072eeb6bf34f54bac1c9",
   "text": "消化问题也有影响，方案确保您遵循处方阿育吠陀饮食，以助净化并增强消化力。在宁静环境中进行冥想和瑜伽等放松身心的练习，可以减轻压力。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ea4cd296b4bf77576126",
   "sourceHash": "ea4cd296b4bf775761267202a85a343a79963763de97e776fd22f99681f1ae5e",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]阿育吠陀着眼于整个身体，兼顾身体、心理和情绪健康，以探究高血压的潜在原因。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_67ead57c8700da912cc3",
   "sourceHash": "67ead57c8700da912cc3dbd8ce3068baa5f3e783524d75443f7d56dc988fff92",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]阿育吠陀疗法和草药与您的处方治疗配合使用，而非取而代之。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7ce74ccc13ab30f33590",
   "sourceHash": "7ce74ccc13ab30f33590c7b8303d6d11f3b265aedde4f2bb47d8f7ee31b26549",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]阿育吠陀关注潜在失衡和整体健康，包括通过调整生活方式来管理血压。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_69adda3b86f8ee3e335d",
   "sourceHash": "69adda3b86f8ee3e335d0763917505f447554f820e5040da7715dc71c262e62d",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]照护安排关注血压和压力。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1a12f2e3625b6f122356",
   "sourceHash": "1a12f2e3625b6f122356b2f9a452d1f58fe004d4ec58fb4dc23d391ba33f77cb",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]放松疗法、瑜伽和饮食调理。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9e8f34733f6b30771414",
   "sourceHash": "9e8f34733f6b30771414d21e4626f25ca9089f3ede0b4e3f4d6dc41a1447efe2",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]评估饮食、作息和压力因素。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6712fe2d12fec0c7dcf5",
   "sourceHash": "6712fe2d12fec0c7dcf55e9b67568f0c48c6d3b7cdf3534c121aacb4de2d6dee",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]与您的处方药物配合进行的个性化整体照护。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2e0fee89b4a1874ec7a7",
   "sourceHash": "2e0fee89b4a1874ec7a78aac6cd23aa45e2942cb5603afbc3f9a4ec2d70a0ce1",
   "text": "Kairali 高血压照护患者体验",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_883eae9d123e5f6fe394",
   "sourceHash": "883eae9d123e5f6fe394c2fd780b73dc67a34477a6c7e752f7c2f8ab4f17a07f",
   "text": "血压治疗 – Rakta Samadama Chikitsa（奇基察）",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2eabf4ce20e2c359279f",
   "sourceHash": "2eabf4ce20e2c359279f7e04df8af3ab52f6be5cd6d062399439c0317171e599",
   "text": "Kairali（喀拉拉邦）为骨关节炎和类风湿关节炎提供由医师指导的阿育吠陀照护：草药疗法、瑜伽和饮食，方案为期 14 至 28 天。",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
