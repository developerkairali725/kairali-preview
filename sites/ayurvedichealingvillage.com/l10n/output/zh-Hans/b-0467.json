   "text": "什么是瑜伽",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c2cb4ff3bfdf9fc42bbf",
   "sourceHash": "c2cb4ff3bfdf9fc42bbf6c61eda68b65c26b137c818cfb4922d1b7d5a8072633",
