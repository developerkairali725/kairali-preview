   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_12a8df9ffad18664aaa7",
   "sourceHash": "12a8df9ffad18664aaa7afac9677a9d8ec123ec5add70aa34572a7d119519daa",
   "text": "，进一步巩固了其在阿育吠陀健康与整体疗愈领域的领先地位：",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
