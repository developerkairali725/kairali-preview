   "sourceHash": "901555df10508c8e0d8f753c3ed1c44f7e008473a819d3b4bc373d4dd5d41439",
   "text": "J’ai lu et j’accepte la [[OPEN_1]]politique de confidentialité et les conditions d’utilisation[[CLOSE_1]] de ayurvedichealingvillage.com.",
   "status": "translated",
   "unchangedReason": null,
