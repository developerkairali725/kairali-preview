   "sourceHash": "75a2211a9656e53cae90b95a746ad98be56887eac8e7afd52ea31b2b26c872e5",
   "text": "Gare de Palakkad Junction : 25 km (environ 45 minutes)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7b50708eb8d1b4a7bc48",
