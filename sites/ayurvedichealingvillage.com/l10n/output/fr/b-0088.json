   "issues": []
  },
  {
   "id": "t_cae8cb4b970950243b8e",
   "sourceHash": "cae8cb4b970950243b8e4fe105857cd786d1cb3f4432d6935d10d3dd460b2df0",
   "text": "Le standard répond par un menu automatique — tapez 2 pour les réservations. Ouvert de 8:00 AM à 9:00 PM IST, tous les jours. Le transfert et les éventuels frais sont confirmés par notre équipe lors de la réservation.",
   "status": "translated",
