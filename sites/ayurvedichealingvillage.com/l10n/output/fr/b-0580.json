   "issues": []
  },
  {
   "id": "t_e9cd31a237c23c979f38",
   "sourceHash": "e9cd31a237c23c979f389a6899f7fb871ce26fccab4d68d5d3a48fa81dde23ee",
   "text": "Programme sur mesure — le tarif dépend du plan établi par le médecin. Renseignez-vous sur la durée et les modalités actuelles pour le séjour que vous envisagez.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
