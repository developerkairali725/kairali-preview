   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4e26cf5069d7dc8c79d3",
   "sourceHash": "4e26cf5069d7dc8c79d32b981616f57841c48034b0f75284fc86b68873166b5d",
   "text": "Un ancien temple dédié à Bhagavathy, réputé pour ses boiseries et ses sculptures sur pierre. Selon la tradition locale, le mur d’enceinte serait resté inachevé avant le lever du jour.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_06e2a8c00bd84ef51198",
   "sourceHash": "06e2a8c00bd84ef51198460bbfe6fa87f1202679efd271ca73210fa1f96c33d9",
   "text": "Accès au temple",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c4025965966386aa65eb",
   "sourceHash": "c4025965966386aa65eb4a7728acef5e1ae9cbd6124ca2cf654f52935a3807c2",
   "text": "Un mémorial en bord de rivière dédié à Thunchath Ezhuthachan, dont les adaptations en Malayalam du Ramayana et du Mahabharata ont façonné la tradition littéraire de cette langue. Des manuscrits et des objets associés au poète font partie de son patrimoine.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d47312a2ed00a7e57c70",
   "sourceHash": "d47312a2ed00a7e57c70b5a25667852962f9d1cf2ff752f84431d85daa4c22e6",
   "text": "Accès au Gurumadam",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_de693090534bcae6c8e0",
   "sourceHash": "de693090534bcae6c8e04bf404fb12cf3bf026c6f1665a4cb6f2ac1fb143489e",
   "text": "Temple Sree Rama de Thenari",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_341fea5342b384a2f41c",
   "sourceHash": "341fea5342b384a2f41c3bf409ba475d4d1be742b1a9023e8d7d97429ab5f66b",
   "text": "Un lieu de culte associé au Ramayana, doté d’une source sacrée à côté du temple. Son eau est vénérée par la tradition locale.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ad958e0330118beadbac",
   "sourceHash": "ad958e0330118beadbac0381f4c5acf15b9c544d309df34cc6f959fd9d931a16",
   "text": "Accès au Sree Rama Theertham",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8f35973f837174763166",
   "sourceHash": "8f35973f837174763166fc6afe2a74838dc9553aae194831c6003cf3fbb9556f",
   "text": "Fort de Palakkad · Fort de Tipu",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5dced69efb97ccdace22",
   "sourceHash": "5dced69efb97ccdace2214936c8b976a9206aa799164511720513dd7846dd244",
   "text": "Construit par Hyder Ali en 1766, ce fort protégé est l’un des monuments les plus connus de Palakkad. Ses douves, ses remparts et son enceinte offrent un aperçu de l’histoire de la ville ; le sanctuaire d’Anjaneya se trouve à l’intérieur.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d4cd1e80fc9fd446e502",
   "sourceHash": "d4cd1e80fc9fd446e5026f3361b6a0e3221d6c72954935a3958c94ea50edd7a7",
   "text": "Accès par la route du fort ; accès à pied jusqu’à l’entrée",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
