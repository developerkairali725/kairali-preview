   "unchangedReason": null,
   "issues": [
    "t_3bd305dec965bf4d65c8 banned-term invités"
   ]
  },
  {
   "id": "t_9d3478cc324e4854c56d",
   "sourceHash": "9d3478cc324e4854c56d82d3f66f89e0aff1b066e1e8cc8188acc36ee2c7c62f",
   "text": "Visite de notre propre usine ayurvédique avec les chefs, repas local compris.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7a8e6d38d52bdb370544",
   "sourceHash": "7a8e6d38d52bdb3705443b89287c7fa2484105e1577eb2e30f38fc6c9571240d",
   "text": "Jus ou tisane offert après chaque massage. Tout aliment supplémentaire sera facturé en sus.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9ec22c60af36e599185d",
   "sourceHash": "9ec22c60af36e599185d78eddebffa3b2afc78f13c93acf06ae131371d2f482c",
   "text": "Séance de yoga en groupe offerte chaque matin ; des cours individuels sont disponibles moyennant supplément.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c2e3cd5a0305e94980a0",
   "sourceHash": "c2e3cd5a0305e94980a050930a9c409b279bce56f468507b9b9127469042906b",
   "text": "Séance de méditation en groupe offerte chaque soir ; des cours individuels sont disponibles moyennant supplément.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c0a9c74a462152f79ead",
   "sourceHash": "c0a9c74a462152f79eadbfdd57d4753b0dfdb9a0363aa4030e26f001f460b4b7",
   "text": "Évaluation quotidienne personnalisée du mode de vie et de la condition physique.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9c794b1c3d9ed948964c",
   "sourceHash": "9c794b1c3d9ed948964c9239be4878dfcb88131bace55fc4b6910cb0573770b8",
   "text": "Accès libre à la piscine, à la salle de sport, à la bibliothèque et à toutes les installations intérieures et extérieures.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_93b818c451a401493469",
   "sourceHash": "93b818c451a4014934694d25ababdaff9dfbbd8f02448c620368427242ec37f4",
   "text": "Les médicaments internes prescrits pour votre soin ne peuvent être déterminés qu’au fil de son déroulement et seront facturés en sus.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_08fcb291824bac552f64",
   "sourceHash": "08fcb291824bac552f644486e0ea037f2c1891a56ea8dfce8e4146a1ff154283",
