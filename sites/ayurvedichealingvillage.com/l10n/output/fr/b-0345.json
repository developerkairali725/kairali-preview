 "units": [
  {
   "id": "t_2d664b10352e307b35ed",
   "sourceHash": "2d664b10352e307b35ed7f823748826b62de04a039f722d196fd0f97f538b5af",
   "text": "Nous nous trouvons à III/73 Palayamkadu, P.O. Olassery, Kodumbu, Palakkad District 678551, Kerala. L’aéroport le plus proche est celui de Coimbatore (à environ une heure) et Palakkad Junction est la gare principale la plus proche. Notre page",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Postal address kept verbatim in Latin script. Fragment ends with 'Notre page' so the following link fragment ('Comment venir') reads 'Notre page Comment venir indique…'."
   ]
  },
  {
   "id": "t_d7c5285d8dc506348034",
   "sourceHash": "d7c5285d8dc5063480344eebdb6aba04f42ff6bd4206683e911056ce276d1a10",
   "text": "Comment venir",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7c8c66f58dfc0aa96d83",
   "sourceHash": "7c8c66f58dfc0aa96d833699a36ea17cc552027881abd3329258ae9a5aa6b902",
   "text": "indique l’itinéraire, et nous pouvons organiser un transfert.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_080048d87ffbc28f9b5b",
   "sourceHash": "080048d87ffbc28f9b5b0bdb4b01866e3d79c65f4222d77bfe49c37f5e15a039",
   "text": "Quels sont vos horaires ?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bc6eb88d69c4cb7007cb",
   "sourceHash": "bc6eb88d69c4cb7007cb539c1fd46e6f71f421cb9d17b28257741dd0d72be7f2",
   "text": "Notre ligne téléphonique répond de 8:00 AM à 9:00 PM IST, tous les jours. Notre équipe d’accompagnement des patients répond généralement aux messages WhatsApp et aux e-mails pendant les heures ouvrables, sinon le lendemain matin.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d46a4166e631d6d9f5ed",
   "sourceHash": "d46a4166e631d6d9f5eda3fed7d732d291bf254da4fe4438c3a042628173f0f2",
   "text": "Travaillez-vous avec des agences de voyages et des partenaires ?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4c50577ccf6c645e559b",
   "sourceHash": "4c50577ccf6c645e559b8ce6b321fa5a7040dfd9c88f0a8ca10fe6afeedd3919",
   "text": "Oui — notamment avec des voyagistes spécialisés en Inde, dans la région DACH et en France. Écrivez à",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1b664d7366b1c0a986f2",
   "sourceHash": "1b664d7366b1c0a986f2a15b43830efa596ce8223c64ef31256f7d8bf13af4c6",
   "text": "et notre service partenariats vous contactera.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d6e645b7d2b2da646d44",
   "sourceHash": "d6e645b7d2b2da646d44130464143171935ffa47558b4e36c05df175de7197ba",
   "text": "Appeler",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d80d1fabc858a5b86a50",
   "sourceHash": "d80d1fabc858a5b86a5019c2e7e6322cd87ba57da7abe98495a3566dca09698e",
   "text": "Postulez | Emplois Ayurveda | Carrières | Masseurs",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Retreat' dropped from the title to stay within 60 characters and avoid resort-type framing on a hospital site."
   ]
  },
  {
   "id": "t_da3380bda6b29a695dd5",
   "sourceHash": "da3380bda6b29a695dd581d7719394c9aca68008e97b5dd8989540228b3c168f",
   "text": "Enseignants, masseurs et médecins ayurvédiques talentueux sont toujours recherchés pour nos centres de soins à Delhi, au Kerala et dans le monde.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6cfe85387b7f4760c250",
   "sourceHash": "6cfe85387b7f4760c250a18749b4ac9720de8aa22cb50c3e87f8df50554df515",
   "text": "Détails du poste",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_eddf43c6d489943df931",
   "sourceHash": "eddf43c6d489943df931a5f8395329a0555a269d6de1fd1f978d66d489ebce43",
   "text": "Description du poste",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e456efa71ed6e96966de",
   "sourceHash": "e456efa71ed6e96966de469ee8327385e4d145d85d645cc027586e2e5b0f5a8c",
   "text": "Mener des actions de lancement et de promotion de produits.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5bbe5b46643e8feaad7e",
   "sourceHash": "5bbe5b46643e8feaad7e8a6c28b0cf899565ca37899460340ee6a004cb4fc9d5",
   "text": "Stimuler la croissance de l’activité en identifiant et en pénétrant de nouveaux segments de marché.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4f3cce779c3c0cd8040d",
   "sourceHash": "4f3cce779c3c0cd8040da9f0478560bd23734813404bd8e60c9fbd335825d639",
   "text": "Développer la base de clients",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "t_4f3cce779c3c0cd8040d banned-term clients"
   ]
  },
  {
   "id": "t_cb82f4212c80702091d0",
   "sourceHash": "cb82f4212c80702091d0da2e62757c72b02894877a1bd14d4d84417202264c14",
   "text": "Explorer de nouvelles opportunités commerciales et élargir la base de marché avec de nouveaux clients.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "t_cb82f4212c80702091d0 banned-term clients"
   ]
  },
  {
   "id": "t_3060bb6a8dd1742b7860",
   "sourceHash": "3060bb6a8dd1742b78608de9558db2bc66b808f25f599b4a287a2c8c2f2b03c3",
   "text": "Rédiger des propositions commerciales.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f135967ac03e9a40b035",
   "sourceHash": "f135967ac03e9a40b03598da3fd2ed682c8a2e26c9a472e9b05609a2a9faad42",
   "text": "Suivre les tendances du secteur au niveau local et international.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e8bca26772789b760f58",
   "sourceHash": "e8bca26772789b760f587aaefb558edc4b110bc0802b986282509de09688081e",
   "text": "Rédiger et examiner des contrats.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1546eef7be77f95dd04d",
   "sourceHash": "1546eef7be77f95dd04dd1607dd8f8c756d72aa736984f2751dacef43b8b25dc",
   "text": "Contribuer à la planification des campagnes de vente.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f935463ab029fa72e002",
   "sourceHash": "f935463ab029fa72e0023cc29e659ffe90fc5aa4ba50d3297e97428505c5e905",
   "text": "Réaliser des prévisions et des analyses de ventes et présenter vos conclusions à la direction.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f4a083b45468f8e1a966",
   "sourceHash": "f4a083b45468f8e1a966a3cbd9676eeceaacd2c3bf35efd70a9595fee87241cc",
   "text": "Entretenir des relations solides avec les principaux décideurs, acheteurs, canaux de distribution, détaillants ciblés, clients ou utilisateurs finaux.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "t_f4a083b45468f8e1a966 banned-term clients"
   ]
  },
  {
   "id": "t_a40b46fb84a97f846feb",
   "sourceHash": "a40b46fb84a97f846feb08bcf21724c2d9ab4a05da66bc4c0b0a4475dd634a53",
   "text": "Identifier des opportunités au sein des territoires attribués afin d’élargir le développement commercial.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c9c98c11aa9f8179bb08",
   "sourceHash": "c9c98c11aa9f8179bb08330e5ce3211f9c2125c87437a9bd9a3b1e4c435cf40f",
   "text": "Organiser des visites commerciales conjointes et y participer avec les distributeurs.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
