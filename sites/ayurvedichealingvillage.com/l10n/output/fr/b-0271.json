  },
  {
   "id": "t_dc7469d3b1ce86d6a393",
   "sourceHash": "dc7469d3b1ce86d6a393b3769639daf9fb830ff45c30b04ed3e677d80c7b5590",
   "text": "La mousson vous appelle-t-elle ?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4aebb4473b699cb8ec42",
   "sourceHash": "4aebb4473b699cb8ec423e8e4cd4f46516adb9dc1165e517186bb311195a6365",
   "text": "Ce programme Karkidaka est fait pour vous si votre corps vous murmure — ou vous crie — qu'il ne parvient plus à suivre la vie que vous lui demandez de mener.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_23ede9380dfaf86d0034",
   "sourceHash": "23ede9380dfaf86d00343ec9ae3c3c353c7763d864efa6f067e4e17c460670e4",
   "text": "Vous pouvez venir avec un diagnostic précis ou simplement avec le sentiment que quelque chose « ne va pas » — énergie, humeur, digestion ou sommeil. Si vous êtes prêt à faire une pause, à écouter et à confier votre guérison à des médecins ayurvédiques expérimentés pendant 7, 14 ou 21 jours, cette saison et ce village de soins ont été conçus pour vous.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_775099e551d2928e01ec",
   "sourceHash": "775099e551d2928e01ece6b2de4008598f65659aec0a4daf48dbdde11afd6c4b",
   "text": "Troubles que Karkidaka peut réellement prendre en charge",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
