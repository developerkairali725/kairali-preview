   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_00b8c4cdd8df8073ed8b",
   "sourceHash": "00b8c4cdd8df8073ed8b53bad93e07bb7371fec715b228d7553924003875a876",
   "text": "Approche ayurvédique de la prise en charge des troubles liés au mode de vie",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dfc26b2e0008cbc63b87",
   "sourceHash": "dfc26b2e0008cbc63b87e9ba8173087a7e011f15a23f27b21afa815b44be5247",
   "text": "Remèdes maison et bases des médicaments ayurvédiques",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_55dfc8671b9ef60280ff",
   "sourceHash": "55dfc8671b9ef60280ff198a00958b14f478cd906edcff41cf2bedd427d8ad6d",
   "text": "Roga Pareeksha et Rogi Pareeksha (diagnostic et analyse du patient)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a91d2b27ceb4440f0f3e",
   "sourceHash": "a91d2b27ceb4440f0f3eae1fed5a1806fd8fbc591fe5832789b430d3fb89fa2c",
   "text": "Les candidats reçus pourront être pris en considération pour des postes de consultant en bien-être ayurvédique dans les centres internationaux de Kairali et recevront un certificat de praticien.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e13f018c0a9f7e5011b6",
