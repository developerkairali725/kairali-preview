  {
   "id": "t_187179f865829592260b",
   "sourceHash": "187179f865829592260bea2ed62cafafb28825e2592f280e7dee86191f70638e",
   "text": "Consultez la [[OPEN_1]]grille tarifaire publiée[[CLOSE_1]] pour le détail des prestations incluses, des exclusions et des conditions. KTAHV/AYT/EN-INR/20260925-R1.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b141bc233283615fcccc",
   "sourceHash": "b141bc233283615fcccc5d70d03f56928b9733cc3ed151ae4c74b361c7d40574",
