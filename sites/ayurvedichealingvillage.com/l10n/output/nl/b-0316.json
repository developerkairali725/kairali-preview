   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c94b7f858d3a86b348ae",
   "sourceHash": "c94b7f858d3a86b348aefd7b01d62c9a7ae8d8a8dd209b6fb257d5e6f945a80b",
   "text": "Panchakarma, verjonging en aandoeningsspecifieke zorg, telkens onder leiding van een arts.",
