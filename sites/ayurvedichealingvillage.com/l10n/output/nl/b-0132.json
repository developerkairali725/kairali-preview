{
 "batchId": "b-0132",
 "sourceSetHash": "2bb765198fa14f1818bc2d39e1c2b0b4fbcca43e35fd776b7cdd9a4bea65a84f",
 "locale": "nl",
 "units": [
  {
   "id": "t_317db569db094c5e6b38",
   "sourceHash": "317db569db094c5e6b380a5bebf86433250bb3365f8d88097cf0f7c173012e6e",
   "text": ": De arts voert een grondig onderzoek uit, dat onder meer polsdiagnose, tongonderzoek en vragen over leefstijl en eetgewoonten kan omvatten. Dit helpt om de onderliggende oorzaken en onevenwichtigheden vast te stellen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dd281e5e3579b8292400",
   "sourceHash": "dd281e5e3579b8292400c4a803c82ca743dec8acc8f7a4b10cde5e2f890096bf",
   "text": ": Op basis van de diagnose wordt een persoonlijk behandelplan opgesteld. Dit kan een combinatie omvatten van ayurvedische therapieën, kruidengeneesmiddelen, aanpassingen in de voeding en leefstijladviezen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_787adff347564d7d07dc",
   "sourceHash": "787adff347564d7d07dc399916e7c51c1454c92b67b7c3b324ba722d0f8ebdaf",
   "text": ": De persoon ondergaat specifieke ayurvedische therapieën gericht op sinus- en migraineklachten, zoals Nasyam (toediening van kruidenoliën via de neus), Shirodhara (het gieten van kruidenolie op het voorhoofd) en zachte hoofdmassages om de doorbloeding te verbeteren en verstopping te verlichten.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_17554838839272b297f5",
   "sourceHash": "17554838839272b297f5705ed312caba6c6bceacf37f57ce0008e9f620a83f09",
   "text": "Voedingsadvies",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4e9cf0fcd31260906b2d",
   "sourceHash": "4e9cf0fcd31260906b2db2154f1aaea915bc1567017772de07e191dee319b544",
   "text": ": De arts geeft voedingsrichtlijnen, stelt voedingsmiddelen voor die de verstoorde dosha’s tot rust brengen en raadt aan om uitlokkende stoffen zoals bepaalde specerijen, cafeïne en bewerkte voeding te vermijden.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7e92367630cc56d6f473",
   "sourceHash": "7e92367630cc56d6f473feed9b593b8b348fca1b9e41b53768ecefe0ce202ac9",
   "text": "Leefstijladviezen",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9fc32bfa81bfb6efd5bb",
   "sourceHash": "9fc32bfa81bfb6efd5bb4b7fcd6e4c12d2d4ccfeb367fa15d6eb3c182ffe1b74",
   "text": ": Er worden persoonlijke aanpassingen in de leefstijl geadviseerd, zoals technieken voor stressbeheersing, yoga, meditatie en regelmatige lichaamsbeweging, om het algehele welzijn te ondersteunen en de frequentie en intensiteit van sinus- en migraineaanvallen te verminderen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_75c2167557de1e35a178",
   "sourceHash": "75c2167557de1e35a178d9d738a0326eaf9435a49b7b3de937c80b2d71b5e9f3",
   "text": ": Regelmatige vervolgafspraken met de ayurvedische arts helpen om de vooruitgang te volgen, het behandelplan waar nodig bij te stellen en doorlopende ondersteuning en begeleiding te bieden.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
