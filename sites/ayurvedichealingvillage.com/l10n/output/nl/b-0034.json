  {
   "id": "t_6fa415a039f65949f375",
   "sourceHash": "6fa415a039f65949f375dd92ff1e4488e87d4704eda2a1f437a46cb37ef308b8",
   "text": "Tarieven geldig van 1 april 2025 tot en met 30 september 2027. Per nacht, per villa, naar bezetting; inclusief alle overheidsbelastingen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
