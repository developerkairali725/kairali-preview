   "text": "Fotogalerij-afbeelding 3 openen",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d929c0ec4da9cfa79c8c",
   "sourceHash": "d929c0ec4da9cfa79c8c90465a174e271aa19b205ffeb00758f4822bfb85fc97",
   "text": "Een vrouw in het groen in een hoge uitvalspas met geheven armen op een yogamat",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
