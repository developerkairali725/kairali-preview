   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7d50274aada90cdbc1d7",
   "sourceHash": "7d50274aada90cdbc1d7594047aa1c97512041eaeeb832ec45c361b378d31c7c",
   "text": "Villa in Kerala-stijl van rode baksteen met pannendak, een veranda met pilaren, een fontein en kokospalmen op de achtergrond",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
