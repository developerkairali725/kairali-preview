   "sourceHash": "cc4e632bb18b401c3614399601fb50821eeebe8e91df865f5da0e52340ba2fcd",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]Zachte, op bewijs gebaseerde zorg bij chronische aandoeningen[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
