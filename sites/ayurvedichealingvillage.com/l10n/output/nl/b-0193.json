   "sourceHash": "db498bac921491872ea74caa1f6c13761309a92e75139417b4a049cbe6511a13",
   "text": "Bel ons voor programmadetails",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_32c7a2872a4c65f1b893",
   "sourceHash": "32c7a2872a4c65f1b893ce0ed26522a7542f4753efe7b50ecc4e5e99213b2118",
   "text": "Voor defensie en paramilitaire eenheden",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9d71809080f4c23fcc66",
   "sourceHash": "9d71809080f4c23fcc667666899b96caa3fe5006059887539c6998426dacf7f8",
   "text": "Zij die ons beschermen terwijl wij slapen",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c9f83478a59bbad40a63",
   "sourceHash": "c9f83478a59bbad40a63744a7a5b7c446a44ab7642c84a04529658e5c2009fe7",
   "text": "Welzijn voor defensie en paramilitaire eenheden",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6049e10bb3f5d819e55d",
   "sourceHash": "6049e10bb3f5d819e55d3987a06a899e6baa0a61818e3c8ffdd947d0cf2f7ab6",
   "text": "Jaren van discipline, hoge stress en fysieke belasting laten onzichtbare littekens achter. Heling voor onze verdedigers moet kracht, rust en veerkracht herstellen — niet alleen van het lichaam, maar van de hele mens.",
   "status": "translated",
