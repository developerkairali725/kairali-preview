   "sourceHash": "5f5fa4e793b73fcbd3a7c3c74e23f90b88bb5be94516ff5ad39ac4d06caecbbf",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]Gespecialiseerde zorg voor para-atleten en aangepaste behoeften[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
