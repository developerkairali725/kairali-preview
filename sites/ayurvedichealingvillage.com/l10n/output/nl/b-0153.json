   "issues": []
  },
  {
   "id": "t_c3d9a2715fd355690989",
   "sourceHash": "c3d9a2715fd355690989448e8fa97880c7b145ccc7f87e687ab28c1403575aa5",
   "text": "Informeer de arts over elke slaapdiagnose, voorgeschreven medicijnen en hulpmiddelen zoals een CPAP-apparaat. Bespreek hoe het voorgestelde programma aansluit op uw bestaande slaapzorg.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
