   "text": "Ingrijpende [[OPEN_1]]resultaten[[CLOSE_1]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e528ccc255611a380cb5",
   "sourceHash": "e528ccc255611a380cb5dc1e5590dd14945806ec096354b23da8605492cc8dc1",
   "text": "Natuurlijke ondersteuning voor gezonde luchtwegen",
