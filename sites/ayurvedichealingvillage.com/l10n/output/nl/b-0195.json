 "units": [
  {
   "id": "t_0feabc083bf7e5110135",
   "sourceHash": "0feabc083bf7e5110135a59d503b8c396bece2b898024f71a42527f94d723288",
   "text": "Uitgebreide begeleiding om de resultaten van uw heling thuis te behouden — zodat uw herstel doorgaat, lang nadat u vertrokken bent.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1b19396609c65466e8d4",
   "sourceHash": "1b19396609c65466e8d4b0e0409ee74338b35f8dae90df63f5c6395a7532f2bc",
   "text": "Wij zijn er voor u",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_377e435dbfa9232cf127",
   "sourceHash": "377e435dbfa9232cf127d9620fa18413548cb88fe0ff80feeecae2e8521af6e9",
   "text": "Weet u niet welk programma van toepassing is?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7831a70183b94a4ab633",
   "sourceHash": "7831a70183b94a4ab6338df7715122a280c7dedf2c77ac0884b1be9952961271",
   "text": "Weet u niet welk programma van toepassing is op u of uw familielid?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_31925806acaf16aae09b",
   "sourceHash": "31925806acaf16aae09bc63516aa045cd1f4902ff2526b8b6faeb731730d4f98",
   "text": "Onze artsen begeleiden u met duidelijkheid en zorg.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_66fa43e9e55a7a3f8f35",
   "sourceHash": "66fa43e9e55a7a3f8f3544b20372873736ff240e9be6a7bd9ede06a43ca47b07",
   "text": "Hier is geen druk. Alleen een gesprek — in het tempo dat voor u goed voelt.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b6f3860173635bde5cc2",
   "sourceHash": "b6f3860173635bde5cc2b9374934c5bd9b9ed3068286b4e6d65ffe573dd6c348",
   "text": "Geen kortingen. Geen haast. Alleen eerlijke begeleiding van mensen die om u geven.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_44cb983134a850fb07be",
   "sourceHash": "44cb983134a850fb07be7f4eadd7a9dbade7f4438e7ecf7665f2b49907f9c246",
   "text": "Kruidenbladeren, kurkuma, een stenen vijzel met stamper, olieflessen en een hangend messing vat",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1f36fe75ffd5716bf841",
   "sourceHash": "1f36fe75ffd5716bf84120454e6210201ea6b23217d03f0c0de5639f37de57f0",
