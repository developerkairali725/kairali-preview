   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b4c2c07efbd97badce25",
   "sourceHash": "b4c2c07efbd97badce25bbf5cdeff9101d662442c0e31e1dba481f44b233e6d2",
   "text": "Welzijn voor senioren bij Kairali",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_416544f619f62b2409e7",
   "sourceHash": "416544f619f62b2409e75fbb2f5a13ff4d6c330a1e5eb5d16a3b4104518ccc83",
   "text": "Atleten en herstel",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ccdbf9cebab84ba3dc60",
   "sourceHash": "ccdbf9cebab84ba3dc60a05782a2ee9810ffb159351f58d0d438828e0dc45d4c",
   "text": "Welzijn voor defensiepersoneel",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_da0b36ede66eaea4a756",
   "sourceHash": "da0b36ede66eaea4a756896d95d96a48825c133d23cb48d70ce489901480a30b",
   "text": "Een bus ayurvedische olie van Kairali",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c815508d1d25ae898492",
   "sourceHash": "c815508d1d25ae898492403939225fffce862a10726a9058eeaade1c979f8e60",
   "text": "Therapeuten van Kairali voeren janu vasti uit, een kniebehandeling met warme olie, bij een patiënt",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1e09f4a0e5cedde82ce5",
   "sourceHash": "1e09f4a0e5cedde82ce57942247da8fbe711e1b4ab48d99e0f8c8b377bcd458a",
   "text": "Een patiënt in een zijwaartse strekhouding uit de yoga bij Kairali",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_935300365c3e600ee398",
   "sourceHash": "935300365c3e600ee398b6f773aa88abb765d96a41558583699259f7ed9e953f",
