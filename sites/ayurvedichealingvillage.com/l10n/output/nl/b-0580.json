   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_440ebbbd7e3a138ccfdc",
   "sourceHash": "440ebbbd7e3a138ccfdc807051dd35ed295170dca59fb1ae3d3eef90763482b2",
   "text": "Neem de tijd voor ademhalingsoefeningen, meditatie en ontspanning.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_feb088c73ea9329305ba",
   "sourceHash": "feb088c73ea9329305ba8e288f8ed7077bca6648f798b019a10a564fd8ba02ad",
