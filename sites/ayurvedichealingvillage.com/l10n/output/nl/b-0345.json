 "units": [
  {
   "id": "t_2d664b10352e307b35ed",
   "sourceHash": "2d664b10352e307b35ed7f823748826b62de04a039f722d196fd0f97f538b5af",
   "text": "U vindt ons op III/73 Palayamkadu, P.O. Olassery, Kodumbu, Palakkad District 678551, Kerala. De dichtstbijzijnde luchthaven is Coimbatore (ongeveer een uur rijden) en Palakkad Junction is het dichtstbijzijnde grote treinstation. Op onze pagina",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d7c5285d8dc506348034",
   "sourceHash": "d7c5285d8dc5063480344eebdb6aba04f42ff6bd4206683e911056ce276d1a10",
   "text": "Bereikbaarheid",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7c8c66f58dfc0aa96d83",
   "sourceHash": "7c8c66f58dfc0aa96d833699a36ea17cc552027881abd3329258ae9a5aa6b902",
   "text": "vindt u de routebeschrijving, en wij kunnen vervoer voor u regelen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_080048d87ffbc28f9b5b",
   "sourceHash": "080048d87ffbc28f9b5b0bdb4b01866e3d79c65f4222d77bfe49c37f5e15a039",
   "text": "Wat zijn uw openingstijden?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bc6eb88d69c4cb7007cb",
   "sourceHash": "bc6eb88d69c4cb7007cb539c1fd46e6f71f421cb9d17b28257741dd0d72be7f2",
   "text": "Onze telefoonlijn is elke dag bereikbaar van 8:00 tot 21:00 uur IST. Ons patiëntenzorgteam beantwoordt WhatsApp- en e-mailberichten doorgaans binnen werktijden, en anders de volgende ochtend.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Converted 12-hour AM/PM notation to Dutch 24-hour notation; times unchanged."
   ]
  },
  {
   "id": "t_d46a4166e631d6d9f5ed",
   "sourceHash": "d46a4166e631d6d9f5eda3fed7d732d291bf254da4fe4438c3a042628173f0f2",
   "text": "Werkt u samen met reisbureaus en partners?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4c50577ccf6c645e559b",
   "sourceHash": "4c50577ccf6c645e559b8ce6b321fa5a7040dfd9c88f0a8ca10fe6afeedd3919",
   "text": "Ja — onder meer met gespecialiseerde organisaties in India, de DACH-regio en Frankrijk. Schrijf naar",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1b664d7366b1c0a986f2",
   "sourceHash": "1b664d7366b1c0a986f2a15b43830efa596ce8223c64ef31256f7d8bf13af4c6",
   "text": "en onze afdeling partnerschappen neemt contact met u op.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d6e645b7d2b2da646d44",
   "sourceHash": "d6e645b7d2b2da646d44130464143171935ffa47558b4e36c05df175de7197ba",
   "text": "Bel",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_da3380bda6b29a695dd5",
   "sourceHash": "da3380bda6b29a695dd581d7719394c9aca68008e97b5dd8989540228b3c168f",
   "text": "Getalenteerde docenten, massagetherapeuten en ayurvedische artsen zijn altijd gezocht in onze behandelcentra in Delhi, Kerala en op locaties wereldwijd.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6cfe85387b7f4760c250",
   "sourceHash": "6cfe85387b7f4760c250a18749b4ac9720de8aa22cb50c3e87f8df50554df515",
   "text": "Functiegegevens",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_eddf43c6d489943df931",
   "sourceHash": "eddf43c6d489943df931a5f8395329a0555a269d6de1fd1f978d66d489ebce43",
   "text": "Functieomschrijving",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e456efa71ed6e96966de",
   "sourceHash": "e456efa71ed6e96966de469ee8327385e4d145d85d645cc027586e2e5b0f5a8c",
   "text": "Productlanceringen en promotieactiviteiten uitvoeren.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5bbe5b46643e8feaad7e",
   "sourceHash": "5bbe5b46643e8feaad7e8a6c28b0cf899565ca37899460340ee6a004cb4fc9d5",
   "text": "Bedrijfsgroei realiseren door nieuwe marktsegmenten te identificeren en te betreden.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4f3cce779c3c0cd8040d",
   "sourceHash": "4f3cce779c3c0cd8040da9f0478560bd23734813404bd8e60c9fbd335825d639",
   "text": "Het klantenbestand uitbreiden",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_cb82f4212c80702091d0",
   "sourceHash": "cb82f4212c80702091d0da2e62757c72b02894877a1bd14d4d84417202264c14",
   "text": "Nieuwe zakelijke kansen verkennen en de marktbasis uitbreiden met nieuwe klanten.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3060bb6a8dd1742b7860",
   "sourceHash": "3060bb6a8dd1742b78608de9558db2bc66b808f25f599b4a287a2c8c2f2b03c3",
   "text": "Zakelijke voorstellen schrijven.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f135967ac03e9a40b035",
   "sourceHash": "f135967ac03e9a40b03598da3fd2ed682c8a2e26c9a472e9b05609a2a9faad42",
   "text": "Branchetrends lokaal en internationaal volgen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e8bca26772789b760f58",
   "sourceHash": "e8bca26772789b760f587aaefb558edc4b110bc0802b986282509de09688081e",
   "text": "Contracten opstellen en beoordelen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1546eef7be77f95dd04d",
   "sourceHash": "1546eef7be77f95dd04dd1607dd8f8c756d72aa736984f2751dacef43b8b25dc",
   "text": "Helpen bij het plannen van verkoopcampagnes.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f935463ab029fa72e002",
   "sourceHash": "f935463ab029fa72e0023cc29e659ffe90fc5aa4ba50d3297e97428505c5e905",
   "text": "Verkoopprognoses en -analyses uitvoeren en uw bevindingen presenteren aan het senior management.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f4a083b45468f8e1a966",
   "sourceHash": "f4a083b45468f8e1a966a3cbd9676eeceaacd2c3bf35efd70a9595fee87241cc",
   "text": "Sterke relaties onderhouden met belangrijke beslissers, inkopers, distributiekanalen, doelretailers, klanten of eindgebruikers.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a40b46fb84a97f846feb",
   "sourceHash": "a40b46fb84a97f846feb08bcf21724c2d9ab4a05da66bc4c0b0a4475dd634a53",
   "text": "Kansen binnen de toegewezen regio's signaleren voor verdere bedrijfsontwikkeling.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c9c98c11aa9f8179bb08",
   "sourceHash": "c9c98c11aa9f8179bb08330e5ce3211f9c2125c87437a9bd9a3b1e4c435cf40f",
   "text": "Gezamenlijke verkoopbezoeken met distributeurs organiseren en bijwonen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
