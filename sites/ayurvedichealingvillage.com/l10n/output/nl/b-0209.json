   "sourceHash": "c56f52d00485e79745039bc611280518b5416ae7e5f11ca18c7876d3ec973a77",
   "text": "Een weg van vernieuwing en verandering",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
