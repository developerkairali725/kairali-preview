   "issues": []
  },
  {
   "id": "t_bd346c6d3c9abe1ef677",
   "sourceHash": "bd346c6d3c9abe1ef6771ed10d65780a7c85cfd23e87b4a98c28b133d6c4fe51",
   "text": "Herstellend verblijf na COVID",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Retreat' rendered as 'verblijf' (stay)."
   ]
  },
  {
   "id": "t_9e4a0855018219c922a2",
   "sourceHash": "9e4a0855018219c922a29d027f399723c8921c3abf97a61cc8c5565d06db8d95",
   "text": "“Na COVID-19 overtrof de verjongende Panchakarma-behandeling in uw centrum mijn verwachtingen, met uitstekend personeel en uitstekende voorzieningen, en een werkelijk ontspannende ervaring.”",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Retreat' rendered as 'centrum' to avoid resort framing."
   ]
  },
  {
   "id": "t_6c10ac3d8e4b427341bf",
