   ]
  },
  {
   "id": "t_7d8470561aaa261338c0",
   "sourceHash": "7d8470561aaa261338c02c213938e6ef32ef7ea48265570d84882223615a2c59",
   "text": "“Ons 7-daagse verblijf heeft ons veranderd; we voelden ons verjongd en klaar om een gezondere leefstijl te omarmen.”",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
