   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d13e82941eedb9ffe701",
   "sourceHash": "d13e82941eedb9ffe7019241faa4cf134d7f5e7f2a3360fe2879fe1821807849",
   "text": "U hebt regelmatig contact met de ayurvedische arts om uw voortgang te volgen en de behandeling zo nodig bij te stellen. U krijgt persoonlijk afgestemde therapieën, waaronder massages en kruidenbehandelingen. U ontvangt begeleiding op het gebied van een evenwichtige leefstijl, voeding en stressbeheersing, met doorlopende ondersteuning van de arts voor een veilig en doeltreffend behandeltraject.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'journey' rendered as 'behandeltraject' (treatment process) per the KTAHV language lock."
   ]
  },
  {
   "id": "t_9fac5bf476b112f23420",
   "sourceHash": "9fac5bf476b112f234200e76cdd5a2ef97eb54dc0a4c8c22e666328802860a5a",
   "text": "Na de behandeling",
   "status": "translated",
