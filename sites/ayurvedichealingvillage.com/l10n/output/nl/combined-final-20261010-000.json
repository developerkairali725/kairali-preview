   "text": "Yoga en pranayama",
   "sourceHash": "d7b905d18f1e27e803e89b4bf85c42bb208722c08bad3613cebf1e0d341b945d"
  },
  {
   "id": "t_185524ad6355d4cf18ed",
   "status": "translated",
   "text": "Yoga en pranayama (ademhalingsoefeningen) van 06:30 tot 07:30 uur, volgens advies van uw arts.",
   "sourceHash": "185524ad6355d4cf18ed9d5dcee393c914584c3f5f1835fe68d0c3b74ee8819e"
  },
  {
   "id": "t_07b6ea4cece03a3544df",
   "status": "translated",
   "text": "Ayurvedisch ontbijt van 08:00 tot 09:00 uur: een lichte, voedzame maaltijd zoals gekookte havermout met fruit of een gestoomd groentegerecht.",
   "sourceHash": "07b6ea4cece03a3544df7c69938a327b25efdd7d8cca815b7b194ee4c7a26d92"
  },
  {
   "id": "t_9fdb9f662942ded1f4ca",
   "status": "translated",
   "text": "Ayurvedische therapie in de ochtend",
   "sourceHash": "9fdb9f662942ded1f4cacca74975bc7b7d5d338359a07afba10767e36f4dabd9"
  },
  {
   "id": "t_c18731900ef1583022ab",
   "status": "translated",
   "text": "Ayurvedische therapiesessie 1, gevolgd door rust en, indien gepland, een controle door de arts. Tijdstippen van afspraken, soort en duur van de therapieën volgen het plan van uw arts.",
   "sourceHash": "c18731900ef1583022ab5f8571f6e4289c44904ec832159b0415d9d8c244662b"
  },
  {
   "id": "t_16a82a68d67e40e1405e",
   "status": "translated",
   "text": "Een kookdemonstratie, tuinbezoek, workshop of lezing, wanneer gepland en geschikt voor u; de activiteit wisselt.",
   "sourceHash": "16a82a68d67e40e1405e9800f133eded171921b2cc87de67fb585e47977937c7"
  },
  {
   "id": "t_ab89a4fc4810b7cc4a7a",
   "status": "translated",
   "text": "Ayurvedische therapie in de middag",
   "sourceHash": "ab89a4fc4810b7cc4a7aa5c9496ed2f860a4f3279f0b2b668847a76c3da4a890"
  },
  {
   "id": "t_82a8dddb3711c0631b29",
   "status": "translated",
   "text": "Ayurvedische therapiesessie 2, gevolgd door rust. Tijdstippen van afspraken, soort en duur van de therapieën volgen het plan van uw arts.",
   "sourceHash": "82a8dddb3711c0631b29698a6a9c5e27b3f46f954aa7b30ddab31ffbb4ff8643"
  },
  {
   "id": "t_4dc7cab992369da519f1",
   "status": "translated",
   "text": "Dagelijks 1 therapie per persoon",
   "sourceHash": "4dc7cab992369da519f14092c39530160de3d28d08071895bd42f986c20d12c3"
  },
  {
   "id": "t_63244781cccfd0500710",
   "status": "translated",
   "text": "Uw ayurvedische therapie van de dag, gevolgd door rust en, indien gepland, een controle door de arts. Tijdstip van de afspraak, soort en duur van de therapie volgen het plan van uw arts.",
   "sourceHash": "63244781cccfd050071096659b1c65d7399ef6c861f3682e54d74a15722e3671"
  },
  {
   "id": "t_96585ab51d252ce57e83",
   "status": "translated",
   "text": "Vrije tijd",
   "sourceHash": "96585ab51d252ce57e831f60a903743764d25ac051a0aeee0f197dc1ec3e929e"
  },
  {
   "id": "t_9c2af06d768bd594bc81",
   "status": "translated",
   "text": "Zachte yoga of pranayama, indien geschikt en volgens advies.",
   "sourceHash": "9c2af06d768bd594bc815a92b32b20539cc30652e4336e5187ba7bbb3157b8f3"
  }
 ]
