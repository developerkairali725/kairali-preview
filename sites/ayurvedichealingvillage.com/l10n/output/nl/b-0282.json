   "text": "*tijden kunnen bij aankomst worden gewijzigd*",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_115a1fbd6ccf5ea714de",
   "sourceHash": "115a1fbd6ccf5ea714dea3b70610991c1ab379768936b041fa21c72a517074c3",
   "text": "Volledig gebruik van de voorzieningen, waaronder zwembad, fitnessruimte, bibliotheek en meditatiezaal.",
