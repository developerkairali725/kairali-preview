   ]
  },
  {
   "id": "t_73b24b22f33fe69ff999",
   "sourceHash": "73b24b22f33fe69ff999b778fb0415e7cb1bd2d3e017d6a482c628b4d9ee864a",
   "text": "で、自然に包まれた体験を提供しています。",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Fragment; completes the preceding units."
   ]
  },
  {
   "id": "t_13b595ed5738132c0d34",
