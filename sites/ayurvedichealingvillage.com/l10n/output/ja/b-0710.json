   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_17196a8deb94e0683384",
   "sourceHash": "17196a8deb94e0683384960753e8cae494b53da1fd0560bf076e606da7fb4592",
   "text": "アーユルヴェーダでは、",
