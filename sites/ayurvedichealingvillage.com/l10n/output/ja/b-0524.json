   "text": "– 75 km",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d2565890cb0dcf041f7d",
   "sourceHash": "d2565890cb0dcf041f7d5c5d6b9d034094a2ef10b4a86639169d3155f4b82a41",
   "text": "ヒーリング・ビレッジからの距離 – 75 km",
   "status": "translated",
