   ]
  },
  {
   "id": "t_2c63a96a5540a56c8868",
   "sourceHash": "2c63a96a5540a56c88689d49d8562cd97047ee69371636e3c532e7369204e333",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]睡眠の質と睡眠時間を改善します",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Glossary term 'Duration' = '所要時間' (time required) does not fit 'duration of sleep'; used '睡眠時間' instead."
   ]
  },
  {
   "id": "t_241f11da731f5d6a8d9a",
   "sourceHash": "241f11da731f5d6a8d9a5dbf3da120e027f74ba33110f4d5bb3d498159c750f5",
