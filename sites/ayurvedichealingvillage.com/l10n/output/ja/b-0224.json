   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_477cf8ff62afd8908b55",
   "sourceHash": "477cf8ff62afd8908b5513e701949f16e0f7c4a099a41dabcf190283c3268c06",
