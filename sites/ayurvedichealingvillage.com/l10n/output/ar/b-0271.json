 "units": [
  {
   "id": "t_ff9b310c34401df0da94",
   "sourceHash": "ff9b310c34401df0da94e57f8535931e9bf9f054b27cc6d7c9b3e510b9417bcd",
   "text": "طبيب أيورفيدي يُجري علاجًا بالزيت العشبي الدافئ خلال برنامج كاركيداكا لإزالة السموم في موسم الرياح الموسمية في Kairali.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_53ad7ea5c260205b6b62",
   "sourceHash": "53ad7ea5c260205b6b6275a22bfae5e1ddb328182c17c8af7bee068ca0eae173",
   "text": "علاج أيورفيدي تقليدي للجسم لإزالة السموم في موسم الرياح الموسمية في Kairali، كيرالا.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ded2c692196fbe1597e3",
   "sourceHash": "ded2c692196fbe1597e378d003bb18b371266a4e5d45596e507fa1a2b2a039ab",
   "text": "زخم طبيعي لإزالة السموم",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3ee3dac0ee4365cc545c",
   "sourceHash": "3ee3dac0ee4365cc545c638025ab1e4e167477504e5682256de51bd4ba57e66a",
   "text": "إعادة ضبط الجهاز العصبي",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9bec650cce3cc2735846",
   "sourceHash": "9bec650cce3cc273584641c39e7812fd77e7cd9041462da28fae395aeb318981",
   "text": "طقس كانجي كاركيداكا (Karkidaka Kanji)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ab5f896f7b94a1dbd4bd",
   "sourceHash": "ab5f896f7b94a1dbd4bd5a1f12bef77d3220da8e8a5cd6bf91f261927321c988",
   "text": "مرضى من أعمار مختلفة يتلقّون علاج كاركيداكا الأيورفيدي في موسم الرياح الموسمية في Kairali، كيرالا.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Source 'Guests' rendered as 'مرضى' (patients) per the KTAHV language lock."
   ]
  },
  {
   "id": "t_dc7469d3b1ce86d6a393",
   "sourceHash": "dc7469d3b1ce86d6a393b3769639daf9fb830ff45c30b04ed3e677d80c7b5590",
   "text": "هل يناديك موسم الرياح الموسمية؟",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4aebb4473b699cb8ec42",
   "sourceHash": "4aebb4473b699cb8ec423e8e4cd4f46516adb9dc1165e517186bb311195a6365",
   "text": "برنامج كاركيداكا هذا مناسب لك إذا كان جسدك يهمس لك، أو يصرخ، بأنه لم يعد قادرًا على مجاراة نمط الحياة الذي تطلب منه أن يعيشه.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_23ede9380dfaf86d0034",
   "sourceHash": "23ede9380dfaf86d00343ec9ae3c3c353c7763d864efa6f067e4e17c460670e4",
   "text": "قد تأتي بتشخيص محدّد، أو لمجرد إحساسك بأن شيئًا ما \"ليس على ما يرام\"، سواء في الطاقة أو المزاج أو الهضم أو النوم. إن كنت مستعدًا للتوقّف والإصغاء، وترك أطباء أيورفيديين ذوي خبرة يرعون تعافيك لمدة 7 أو 14 أو 21 يومًا، فإن هذا الموسم وقرية الشفاء هذه قد صُمّما من أجلك.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_775099e551d2928e01ec",
   "sourceHash": "775099e551d2928e01ece6b2de4008598f65659aec0a4daf48dbdde11afd6c4b",
   "text": "حالات يمكن أن يعالجها كاركيداكا على نحو ملموس",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
