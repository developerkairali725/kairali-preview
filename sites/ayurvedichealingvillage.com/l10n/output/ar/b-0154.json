   "id": "t_8d67b7f7761db1806b2b",
   "sourceHash": "8d67b7f7761db1806b2bcdac0e8324fd05652b526715486a545a689c830a05fc",
   "text": "ضغوط ما بعد الصدمة أو عدم التوازن العاطفي",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
