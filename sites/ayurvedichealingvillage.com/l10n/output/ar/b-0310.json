  {
   "id": "t_63a91b513439343c6007",
   "sourceHash": "63a91b513439343c60077969efc70c5fb69d29b10e7a44c77b59517e4ff63bd7",
   "text": "راسل فريقنا الطبي عبر WhatsApp اتصل بنا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0b781b1aa748048bc9f7",
   "sourceHash": "0b781b1aa748048bc9f7ad22e8bedaac89bb564164cfdf146bf1ef1bfc36a011",
   "text": "برامج أيورفيدية للعافية | كايرالي – قرية الشفاء الأيورفيدية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3da55fa024c3c574c849",
   "sourceHash": "3da55fa024c3c574c849b0de584e521b61e76ddffd7d512e79017e4b5faad1d7",
   "text": "برامج مخصّصة في الأيورفيدا والبانشاكارما واليوغا لدى كايرالي لإزالة السموم وتخفيف التوتر وإنقاص الوزن وتعزيز المناعة في بيئة هادئة في كيرالا.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'serene Kerala retreat' rendered as 'a calm setting in Kerala' for length and register."
   ]
  },
  {
   "id": "t_40a2085371b8effbae52",
   "sourceHash": "40a2085371b8effbae526101c0fd639a2ed6604c16513802a0e05bd3d9b8e1b0",
   "text": "الباقات",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_57eeae0c41fbce46fe13",
   "sourceHash": "57eeae0c41fbce46fe1324911f01dc59666a2cddd69943f30e6794d2567a94b2",
   "text": "9 دقائق",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a14e1d26b2755d604a25",
   "sourceHash": "a14e1d26b2755d604a25dd2ad2fe2befd336bc2355e48370c4ef01f8e704a62e",
   "text": "معالج يضغط بصُرر عشبية دافئة على طول رقبة المريض وكتفه",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_430eb97c1c4571d992de",
   "sourceHash": "430eb97c1c4571d992de36134fc04eb039be5728c5c618dfe4f8bf12dfba470d",
   "text": "علاج شامل للتجديد وإزالة السموم",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bc9814f81baba71d72e3",
   "sourceHash": "bc9814f81baba71d72e33f719b430f3f90ce3bf276e8a22353ee239b0be23e79",
   "text": "العلاج للتجديد وإزالة السموم تقدّم قرية الشفاء الأيورفيدية من كايرالي ملاذًا بعيدًا عن",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_492831b15a583fa9378f",
   "sourceHash": "492831b15a583fa9378fae13c07ac7cbb206bcdfb8cf93b39297491b0c6aa7af",
   "text": "احجز الآن اقرأ المزيد",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_521df2f3f1b5b3497566",
   "sourceHash": "521df2f3f1b5b34975663dfd3292922202c84fcfd303e6ab60db9d5124f8ce53",
   "text": "معالجان يدلّكان ظهر المريض بزيت دافئ على طاولة علاج خشبية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2fa0585a957363ca656f",
   "sourceHash": "2fa0585a957363ca656f8179df0bf965c7621e3b7e51b2c75c4288d82f024a24",
   "text": "يتكوّن العلاج الأيورفيدي أساسًا من جزأين، هما: سامشودهانا تشيكيتسا (Samshodhana Chikitsa)، أي علاج التنقية الحيوية، و…",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2ddfa2980498faf02180",
   "sourceHash": "2ddfa2980498faf02180ac89b6c5c61a9db735d7983309b0e455689800f388a1",
   "text": "معالج يدلّك وجه المريض ورقبته بالزيت في غرفة علاج خافتة الإضاءة",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f5b595580f0cc3de614f",
   "sourceHash": "f5b595580f0cc3de614f66663b3736efe1e76db8f62cf6a5d3001d253a0307a9",
   "text": "العلاج الوقائي والتجديدي، المتجذّر في الأيورفيدا التقليدية، يعيد التوازن إلى الدوشات، ويستعيد العافية،…",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_27e9f8dd4230a0144c5b",
   "sourceHash": "27e9f8dd4230a0144c5b9ee22c40ebfb9212e664d7c4d0b490426de57c675552",
   "text": "يدان مرتديتان قفازين تأخذان قراءة سكر الدم من طرف الإصبع، وتظهر القراءة 105 على جهاز قياس السكر",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8288f233c1bb9817a9b0",
   "sourceHash": "8288f233c1bb9817a9b0e1c6dcae9fb9f5dc641b417fe52be95725f1ca00223c",
   "text": "علاج مرض السكري",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f9e4efb710a6e94288b3",
   "sourceHash": "f9e4efb710a6e94288b376c03b5b3ff77ff805e6399102e91ba26ca4e19ec342",
   "text": "السكري مرض مرتبط بنمط الحياة، وكثيرًا ما يمرّ دون أن يُلاحَظ، لكنه قد يكون قاتلًا صامتًا. وقد يؤدي إلى مشكلات في القلب والجهاز العصبي …",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5174ba50ef8590e9680e",
   "sourceHash": "5174ba50ef8590e9680e2a889d33bb25d6a68d73e754650a12b1fb7689afbaaf",
   "text": "معالجان يضعان مسحوقًا عشبيًا على ساقي مريض جالس على طاولة خشبية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9d19b5c41b6a975add19",
   "sourceHash": "9d19b5c41b6a975add19e881fd47f28232907a1a3fb61778f7eff55913f2f653",
   "text": "في كايرالي – قرية الشفاء الأيورفيدية، يمكنك أن تبدأ حياة صحية ولائقة من جديد مع برنامج إنقاص الوزن الأيورفيدي….",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_625c0c7e6e081986f40d",
   "sourceHash": "625c0c7e6e081986f40dea408433be43f2feca0662141abe389c7f6ce9d4536b",
   "text": "امرأة ترتدي ملابس كتانية خضراء تقف في وضعية الشجرة في اليوغا وكفّاها متلاصقتان",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bc383334eb3eea3eb2b2",
   "sourceHash": "bc383334eb3eea3eb2b2b2742d3c8cb510423a66403a3759517ccb3a2a8b179e",
   "text": "كايرالي – قرية الشفاء الأيورفيدية، المختبئة وسط الطبيعة الخضراء في كيرالا، تقدّم تجربة تغيّر مجرى الحيا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_83c349e8ab06e5d795f9",
   "sourceHash": "83c349e8ab06e5d795f9afdbc66e5d2df9064cd84cc64682e7867c34b0cc3198",
   "text": "كايرالي – قرية الشفاء الأيورفيدية، المختبئة وسط الطبيعة الخضراء في كيرالا، تقدّم تجربة تغيّر مجرى الحيا…..",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_02f898d01c8c8022850f",
   "sourceHash": "02f898d01c8c8022850f415b71ab8858426d1ab4f0652808209a162513cd166c",
   "text": "نقدّم لكم برنامج التدريب على الأيورفيدا في كايرالي – قرية الشفاء الأيورفيدية! صُمّم لتمكين الأفرا…",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
