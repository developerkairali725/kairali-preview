 "units": [
  {
   "id": "t_51997374d272fe4cf6c8",
   "sourceHash": "51997374d272fe4cf6c88ad6d06e00902938c01059cd3f13017b3cad74eebe0c",
   "text": "ديناتشاريا (Dinacharya – النظام اليومي)، ريتوتشاريا (Ritucharya – الاحتياطات الموسمية)، تشريح جسم الإنسان ووظائف الأعضاء",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9f0b5a0822a9adb17523",
   "sourceHash": "9f0b5a0822a9adb17523c0beab357dc51c22a75516951bcd570697333f93adcf",
   "text": "تطبيق بودي كيجي (Podikizhi) في وضعية الانبطاح",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_cd3548a03d83a479394d",
   "sourceHash": "cd3548a03d83a479394d3baa7e3b0cbacf6e37a07e06ad07e5dc0fabf5dd6d25",
   "text": "تشريح جسم الإنسان ووظائف الأعضاء – الجزء 2، أودوارتانام (Udwarthanam) – الجزء النظري",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b1218bd2604d0d65a13e",
   "sourceHash": "b1218bd2604d0d65a13e0cb7e675c056f281d58f96f0cbf58db2644add5bd43e",
   "text": "أودوارتانام (Udwarthanam) كاملًا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_782c2ae375f1176d9c11",
   "sourceHash": "782c2ae375f1176d9c11e83cee2de05e0ca04f0911ecad02832c5da132d41a4e",
   "text": "روغا باريكشا (Roga Pareeksha)، طرق روغي باريكشا (Rogi Pareeksha) في الأيورفيدا، مقدمة في البانشاكارما، أودغارشانام (Udhgarshanam) – الجزء النظري",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_49d88612f431a7e639d3",
   "sourceHash": "49d88612f431a7e639d35a387adb7b832a7a291be0328da7afefda5c5d8ce411",
   "text": "أودغارشانام (Udhgarshanam) كاملًا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a86a640155b40a1f6ec7",
   "sourceHash": "a86a640155b40a1f6ec7d075ecec9f74133e36b0e8a1922f2363225fef380030",
   "text": "تعريف البراكريتي (Prakriti)، الأساسيات، استبيان تحليل البراكريتي، تحليل البنية الجسدية، كاتيفاستي (Kativasti) – الجزء النظري",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_acaddd3f0b3754d1c01d",
   "sourceHash": "acaddd3f0b3754d1c01d61f123246df153d89ec3c17e7f4f726e4703c601e451",
   "text": "كاتيفاستي (Kativasti) كاملًا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bdbb9862400d8b3d07e0",
   "sourceHash": "bdbb9862400d8b3d07e0aefaa60cb70b088aecee0f0b8711086bb634e97d26f3",
   "text": "آهارا وفيهارا (Ahara & Vihara – الغذاء ونمط الحياة)، درافياغونا (Dravyaguna – علم التغذية الأيورفيدي)، درافيا غاناس (Dravya Ganas – التصنيف)، تأثيرات الدرافيا (غونا، فيريا، فيباكا وبرابهافا – Guna, Virya, Vipaka & Prabhava)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_26e6efe47f222288c0e9",
   "sourceHash": "26e6efe47f222288c0e9a7a4e139a9b025327ca75e1deb30b7fc5ef217efbf40",
   "text": "تحضير نجافارا Kizhi (كيجي) (Njavara Kizhi)، تحضير إيلا كيجي (Elakizhi)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_de77da75bd9aa9a34830",
   "sourceHash": "de77da75bd9aa9a34830e205007430efba8b8b4ee11a193c0613ba2e360aa3d9",
   "text": "مقدمة في الأدوية الأيورفيدية، المستحضرات المختلفة، المنتجات الكلاسيكية والمنتجات الخاصة المسجلة، عرض توضيحي للمنتجات",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b1bea951e7b65408f968",
   "sourceHash": "b1bea951e7b65408f9686343820e18a5cb404e82e5965c17da06ba844d66a5fc",
   "text": "إيلا كيجي (Elakizhi) – وضعية الاستلقاء على الظهر",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7cd7a510ee658add5c41",
   "sourceHash": "7cd7a510ee658add5c412c2f322dca477f8a9f6d1113a441aed27d6353eca319",
   "text": "مقدمة في البانشاكارما، جانبان (2) من جوانب البانشاكارما: سنيهانام وسويدانام (Snehanam & Swedanam)، عرض توضيحي بالفيديو",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8935ea0e1f7b182880d1",
   "sourceHash": "8935ea0e1f7b182880d1a3614576053c4695ca4999103139460fb0e178d98adb",
   "text": "إيلا كيجي (Elakizhi) – وضعية الانبطاح",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_03c91277430f05859d5c",
   "sourceHash": "03c91277430f05859d5cb3258f6821848d5e278964ba9957b89af78419c4912f",
   "text": "بورفا كارما وباشتشات كارما (Poorva Karma & Pashchatkarma)، فامانام (Vamanam)، فيريتشانام (Virechanam)، ناسيام (Nasyam)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c141fbda17061d5b2a48",
   "sourceHash": "c141fbda17061d5b2a482532e0545808627d1d93c6cafe14b1a811a86a5c492d",
   "text": "نجافارا كيجي (Njavarakizhi) – وضعية الاستلقاء على الظهر",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_87dcfe981d754ffabcb1",
   "sourceHash": "87dcfe981d754ffabcb14cd38aa7294134fd0cc14a3365ebab16d6c187895712",
   "text": "علاج الفاستي (Vasti)، أنواع إجراءات الفاستي، راكتاموكشا (Raktamoksha)، احتياطات البانشاكارما وموانع استعمالها",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_53b36a2c63f29fd0233b",
   "sourceHash": "53b36a2c63f29fd0233be9b350ce298a4123b0a455e392d6b9bb2b07c4f4edbd",
   "text": "نجافارا كيجي (Njavarakizhi) – وضعية الانبطاح",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_96d0e00eaefaad9202d9",
   "sourceHash": "96d0e00eaefaad9202d9fca8fe3e109abfe24303046c7f2795404aa99d515cdb",
   "text": "نادي باريكشا (Nadee Pareeksha – فحص النبض) وأخذ القراءات الحيوية، استشارة العافية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bdd8baae42f5fa894675",
   "sourceHash": "bdd8baae42f5fa894675bd1601e07cd9fc7390c70be4e567a158bab77d7af361",
   "text": "Abhyangam (أبهيانغام) – إعادة",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Source appears truncated ('Repea' → presumably 'Repeat'); translated as 'repeat' (إعادة) — confirm source text."
   ]
  },
  {
   "id": "t_25b14f1937541e3458dd",
   "sourceHash": "25b14f1937541e3458dd5a902f3f8a8475eb8057a73635f6c7fba911986ffa96",
   "text": "الاستشارة الأيورفيدية للعافية، تحليل البنية الجسدية، إعداد البرنامج وفقًا للبنية الجسدية للشخص",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'client' rendered generically as 'الشخص' (the person) to stay within the clinical register."
   ]
  },
  {
   "id": "t_32589c5091c999c125a2",
   "sourceHash": "32589c5091c999c125a278be3f42df8ff3a7697c3441bf76cf51a3c47165b146",
   "text": "الاستشارة مع المريض، إعداد ملف الحالة، إعداد البرنامج",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5ad65571022ab55c6eb5",
   "sourceHash": "5ad65571022ab55c6eb5021da8bee5127490f7239b3f8a24a23a7ea291c5c78f",
   "text": "مراجعة كاملة للجزء النظري بأكمله من KAP-2 HV، جلسة أسئلة وأجوبة",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_582ee103f41ced5d72e5",
   "sourceHash": "582ee103f41ced5d72e548866ee81da5ee779a42a58a8cef55189e2df0cb38fa",
   "text": "جلسة أسئلة وأجوبة حول الجانب العملي",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a063c51fb6a1b7f5e4fd",
   "sourceHash": "a063c51fb6a1b7f5e4fdd3a775b3b7f5736f776158fdc281a1681a8fec43e425",
   "text": "بادا تشاتوشتايام (Pada-chathushtayam)، آداب الممارسة، المتطلبات القانونية، آداب العلاج، عبارات التواصل، مجتمع الأيورفيدا والهيئات التنظيمية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
