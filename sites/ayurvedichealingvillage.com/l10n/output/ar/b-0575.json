   "issues": []
  },
  {
   "id": "t_662c6794c0142e895d26",
   "sourceHash": "662c6794c0142e895d264a8d45a3eba6b82d344edb298635f7e1501ab717ff4b",
   "text": "جنود بزيّ مموّه وأحذية عسكرية يقفون في تشكيل، يظهرون من الركبتين إلى الأسفل",
   "status": "translated",
