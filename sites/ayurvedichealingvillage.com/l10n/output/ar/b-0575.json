   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_caa218039a689075343d",
   "sourceHash": "caa218039a689075343d1a680bb157888cc5e4094b5e53fc80792503d7362245",
   "text": "تعرّف على فريقنا",
   "status": "translated",
