   "text": "أيام",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Concatenated unit word; Arabic plural أيام is correct for 3-10 only; for 20 Arabic uses يومًا. Consider locale-aware pluralisation in script."
   ]
