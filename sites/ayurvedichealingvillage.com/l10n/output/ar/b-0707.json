 "units": [
  {
   "id": "t_413d14c6053e7662a7b3",
   "sourceHash": "413d14c6053e7662a7b3575e33506433ef0d966387cca5fb1522475691011302",
   "text": "تدريب أيورفيدي مكثّف لـ5 أيام في Kairali: Abhyangam (أبهيانغام) وشيرودارا (Shirodhara) وبوديكيزهي وأودفارتانام وكاتي فاستي نظريًا وعمليًا بإشراف، مع شهادة.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9e4c18b7820cc84d6adb",
   "sourceHash": "9e4c18b7820cc84d6adbbc5219896201ef56af3985de673bcfcbe0f66c7b6419",
   "text": "عرض صندوق الإعلان من The Baoli | Kairali – قرية الشفاء",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_91153dbcf66e3e4e199b",
   "sourceHash": "91153dbcf66e3e4e199b937b311482179f8dfe3560650382ce51d363995e4a9d",
   "text": "العرض الخاص من The Baoli | Kairali – قرية الشفاء",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5b2f2e01706020208121",
   "sourceHash": "5b2f2e017060202081216154cb21d79f4faa1aa600e6483aef58a32f55e312d0",
   "text": "سياسة الإلغاء والاسترداد | Kairali - قرية الشفاء الأيورفيدية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7e65a32317c352e5a445",
   "sourceHash": "7e65a32317c352e5a44534653ee25d9aed6fbf30e9aa83330f9b3b7733da559a",
   "text": "إخلاء المسؤولية | Kairali - قرية الشفاء الأيورفيدية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2aecf3d15785af8ddd69",
   "sourceHash": "2aecf3d15785af8ddd6921730dce72000df0d1bfca8aa4abdc2f7256e59ef3a4",
   "text": "تقدّم Kairali Ayurvedic Group إخلاء مسؤولية شاملًا لمرضى قرية الشفاء الأيورفيدية، وهي مركز أيورفيدي في كيرالا ومن مراكز العافية الرائدة في الهند.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f8286a07fd85e9fa1f51",
   "sourceHash": "f8286a07fd85e9fa1f5172c8d1f13a7e91261235f2e3567771b614a3dce58fba",
   "text": "سياسة الخصوصية | Kairali - قرية الشفاء الأيورفيدية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5de94508b94d3b82728f",
   "sourceHash": "5de94508b94d3b82728f1ff25c22217ef38d6be84270d1b9dec4273426987350",
   "text": "سياسة الدفع والامتثال | Kairali - قرية الشفاء الأيورفيدية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9cf97e077eeb8efa2504",
   "sourceHash": "9cf97e077eeb8efa25047f424fa1f1ce072d5fcf9c3d4ceed3c95270cc9edc4a",
   "text": "تقدّم Kairali Ayurvedic Group سياسة دفع شاملة لمرضى قرية الشفاء الأيورفيدية، وهي مركز أيورفيدي في كيرالا ومن مراكز العافية الرائدة في الهند.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0c831411c8ed3ce3907b",
   "sourceHash": "0c831411c8ed3ce3907b13af8da4a5baae1178ad5206f44234a14e3509c57ee7",
   "text": "الشروط والأحكام | Kairali - قرية الشفاء الأيورفيدية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bb37825456f919fcc2dd",
   "sourceHash": "bb37825456f919fcc2dd5d492b4863196ceb8f7146e5b928e94f5b5da990b598",
   "text": "تقدّم Kairali Ayurvedic Group شروطًا وأحكامًا شاملة لمرضى قرية الشفاء الأيورفيدية، وهي مركز أيورفيدي في كيرالا ومن مراكز العافية الرائدة في الهند.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_49629ba4fa6ef9fe560e",
   "sourceHash": "49629ba4fa6ef9fe560e95a81c90c82a46f7775a57bd1ffc853e910c22a15008",
   "text": "تعذّر علينا التأكد من إرسال رسالة التأكيد. إذا لم تصلك خلال بضع دقائق، يُرجى المحاولة مرة أخرى.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f364812a06ec4aee53e3",
   "sourceHash": "f364812a06ec4aee53e39a947b0a1706b73e20a39f456483b1df49f9f725d0d4",
   "text": "تعذّر علينا إتمام تسجيلك. أنت لست مشتركًا بعد. يُرجى المحاولة مرة أخرى. لا يزال بريدك الإلكتروني مُدخلًا هنا.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_677a0e1dd1cc9028bd12",
   "sourceHash": "677a0e1dd1cc9028bd12c4ddbcf72745c7929ba3d5fdc3ecb37960761262907a",
   "text": "قسائم الهدايا قريبًا في Kairali – قرية الشفاء الأيورفيدية. تواصل مع…",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5e3efe86c12b48bb646a",
   "sourceHash": "5e3efe86c12b48bb646a6855e85ad051cf51794c89adf51eb6a414b77e1d488e",
   "text": "النشرة الإخبارية من Kairali",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_835c0be9e8733e5d3e25",
   "sourceHash": "835c0be9e8733e5d3e259e26f7ed042ad330d9ebb02b4649eba62d635f46d3d4",
   "text": "العودة إلى Kairali",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0ffc2115672dd6364dbc",
   "sourceHash": "0ffc2115672dd6364dbc70d831cf91956f5a8a953fd5447b7711f7aaf9291acc",
   "text": "خدمة الاشتراك في النشرة الإخبارية غير متصلة بعد",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_42e66883931122e249d3",
   "sourceHash": "42e66883931122e249d36580e3cf6893ff0dcf5a094af26b4e9b90454cb0d792",
   "text": "لم يُحفظ أو يُرسَل أي شيء. يُرجى المحاولة مرة أخرى لاحقًا.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e79ab65c265da6bbb2d1",
   "sourceHash": "e79ab65c265da6bbb2d195b071b293c6c6c4e3fa2eb8d1b616738a86257b7209",
   "text": "أكّد اشتراكك في النشرة الإخبارية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_67cc01f3e4638c2eb0ce",
   "sourceHash": "67cc01f3e4638c2eb0ce45d711a406b1dda2adb9011c036bd28f47a9d21c5749",
   "text": "اضغط على الزر أدناه لتأكيد رغبتك في تلقي أخبار Kairali وتحديثات البرامج على عنوان البريد الإلكتروني هذا.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6b638989b08a3ef12242",
   "sourceHash": "6b638989b08a3ef12242a28881e67d6bd713076b84622b6a1f7458a8117cf3f4",
   "text": "تأكيد الاشتراك",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8c3a931e8967ec3bf382",
   "sourceHash": "8c3a931e8967ec3bf3822bcbe1a271e7846fdbd46f6b9c803cb33788d70d0480",
   "text": "تم تأكيد اشتراكك",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d9bbb6fb6267ce3cfa95",
   "sourceHash": "d9bbb6fb6267ce3cfa958f5e59476cd1c8b454ac28478e45d16eb17021c44059",
   "text": "شكرًا لك. ستتلقى أخبار Kairali وتحديثات البرامج عبر البريد الإلكتروني.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2480751e2e027b91f471",
   "sourceHash": "2480751e2e027b91f471fac7fa5d5d48a81e65c2f365754747dd1ca3110b3ea0",
   "text": "يمكنك إلغاء الاشتراك في أي وقت عبر هذا الرابط:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_44eea6249edbea3945bb",
   "sourceHash": "44eea6249edbea3945bb96d003c073b49eab8c4bddfe0d84865d4eed3d0dafc9",
   "text": "رابط التأكيد هذا لم يعد صالحًا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
