  },
  {
   "id": "t_e75e6cfebb7ae5fdf677",
   "sourceHash": "e75e6cfebb7ae5fdf6770c9984b92391ac40995a5e24019d2d6eba9a6667beef",
   "text": "التركيبات العشبية: تشمل هذه المنتجات مجموعة من المساحيق والكبسولات والشراب العشبية المُعدّة بخبرة، والتي تتناول طيفًا واسعًا من المشكلات الصحية، بما في ذلك الهضم والمناعة وصحة المفاصل وصفاء الذهن.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'treat' rendered as 'address' (تتناول) to avoid a therapeutic claim; flagged for clinical review."
   ]
  },
  {
   "id": "t_9a87c43f6646a3443af4",
   "sourceHash": "9a87c43f6646a3443af4c60792cb4d5ed564a96f3e79e8e4d4fae964e823a3e9",
   "text": "العناية الشخصية والعناية بالبشرة",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ccab906c397cd5663b67",
   "sourceHash": "ccab906c397cd5663b67816fa95366db94ca482ff3269d7134687606992552c8",
   "text": ": صُمّمت منتجات العناية بالبشرة الأيورفيدية، مثل الزيوت وأقنعة الوجه والمرطبات، لتغذية البشرة ومنحها إشراقة طبيعية. وتحتوي هذه المنتجات على مكونات مثل الكركم وخشب الصندل والصبار، المعروفة بتأثيراتها المنعشة للبشرة.",
