  {
   "id": "t_4d7e2547047ab991e935",
   "sourceHash": "4d7e2547047ab991e93594219160147b774cea21b9ddbd9ddf658a83d0169431",
   "text": "الأسعار والخصومات والشروط ومعايير الأهلية والتوافر والتعرفات وما تشمله الباقات الواردة في المصدر محفوظة كما هي تمامًا وفق بوابات الإصدار المسجّلة لها. ولا يُعرض أي منها على أنه تعرفة حالية معتمدة، ولا يُفترض أي سعر أو تاريخ أو أهلية حالية.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_45d7b37942d934ba88fa",
   "sourceHash": "45d7b37942d934ba88faaf247ea28d4f2758756520b853a1a36d5fe5553ee897",
   "text": "مبادرات الرعاية الخاصة – كايرالي قرية الشفاء الأيورفيدية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e2d2d0396a15a9f6b28d",
   "sourceHash": "e2d2d0396a15a9f6b28d66396db920206e7bc9d88775596f8cf8f7de99321b56",
   "text": "تقدّم كايرالي رعاية أيورفيدية متخصصة لكبار السن، والرياضيين الأولمبيين والبارالمبيين، وأفراد القوات المسلحة. الشفاء مسؤولية، لا وسيلة ترويج.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dca46955a2bf8bf9da6c",
   "sourceHash": "dca46955a2bf8bf9da6c52218f73043c1adc8d046ae1a13d2f820f2e31b4eeb9",
   "text": "في كايرالي، الشفاء",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5e05338bda500c6a08d9",
   "sourceHash": "5e05338bda500c6a08d94e99c5f9d9473e2f12e61b97ea1e5f2a620f5804bd3a",
   "text": "مسؤولية —",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_603b9a8862361b335ab0",
   "sourceHash": "603b9a8862361b335ab01d4724a25b6db795b7593635d61d7d27eb77549a685f",
   "text": "لا وسيلة ترويج.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_05750100f852cdf0381c",
   "sourceHash": "05750100f852cdf0381c6bec754263805e6575660d8f297b9977f38c2810b667",
   "text": "في كايرالي، الشفاء مسؤولية — لا وسيلة ترويج.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_be1dc1b4a55a37b0ffca",
   "sourceHash": "be1dc1b4a55a37b0ffca0983ca5022c11031b179e0271261cc7ac35130ad4cb8",
   "text": "منحونا الحياة — آباؤنا وأمهاتنا وكبارنا وأحباؤنا الذين رعونا في سنواتنا الأولى",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_aaea09057380037b741f",
   "sourceHash": "aaea09057380037b741f6f12e060118f76a93b8dc2069254a3072cdf98c99967",
   "text": "مثّلوا وطننا — الرياضيون الذين حملوا علم الهند على أعظم المنصات العالمية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
