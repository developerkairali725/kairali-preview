{
 "batchId": "b-0068",
 "sourceSetHash": "2bb765198fa14f1818bc2d39e1c2b0b4fbcca43e35fd776b7cdd9a4bea65a84f",
 "locale": "ar",
 "units": [
  {
   "id": "t_e7243cacc0ab2c23bbc8",
   "sourceHash": "e7243cacc0ab2c23bbc82b9d994f08fcdb98ab22fe2f7e6a8c87ff15fcb1d965",
   "text": "برنامج علاج شلل الوجه وإعادة تأهيل الأعصاب",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Package' rendered as 'programme' (برنامج) per the clinical register."
   ]
  },
  {
   "id": "t_29f2f717419a98114985",
   "sourceHash": "29f2f717419a9811498588240eced6df6d0b08cd553becbb0ccea3f3821dc7c8",
   "text": "[[OPEN_1]]السيدة Anita[[CLOSE_1]][[OPEN_2]]★★★★★[[CLOSE_2]][[OPEN_3]]5.0[[CLOSE_3]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_158a5f05c00cd788273f",
   "sourceHash": "158a5f05c00cd788273fe808099bb0579ddb90a240a6cc2e5829ad563b85a7e9",
   "text": "هل يؤثر سبب ضعف الوجه على مدى ملاءمة البرنامج؟",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c41e760dc10a213d4a0a",
   "sourceHash": "c41e760dc10a213d4a0aa475b5026b30ec86bc33455642730761f15ee44aa717",
   "text": "يحتاج سبب ضعف الوجه وتوقيت ظهوره إلى تقييم طبي قبل اختيار البرنامج. قد يكون ضعف الوجه المفاجئ علامة على سكتة دماغية: اطلب المساعدة الطبية الطارئة فورًا بدلًا من انتظار رد عبر الموقع أو موعد دخول مُخطط له. وفي حال وجود تشخيص مؤكد، شارك الطبيب تفاصيل رعايتك الحالية واحتياجاتك من الدعم.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8eb5a2dba9fd1d4c28ca",
   "sourceHash": "8eb5a2dba9fd1d4c28ca457807fea3ad500861ce83c8995c1e9d267359d29579",
   "text": "علاج شلل الوجه والأعصاب في Kairali Ayurveda",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4e3a093c8b0a4aeeda99",
   "sourceHash": "4e3a093c8b0a4aeeda9940aa4ab0d8881d680b2421b15d499f81249906113125",
   "text": "صورة مقرّبة لوجه امرأة مسنّة مع تدلّي أحد جانبي الفم",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6c68cbf2c493b1566f9e",
   "sourceHash": "6c68cbf2c493b1566f9e37541dac057b40defd66f4e2693ea9bb607177c49190",
   "text": "يدا معالِج تدلّكان رقبة وكتف مريض مستلقٍ مغمض العينين",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2791b9209fc136d89e88",
   "sourceHash": "2791b9209fc136d89e8803ffe7203e70962a6642f34abec5ddc97ccd03d4819d",
   "text": "علاج شلل الوجه والمشكلات المرتبطة به من خلال الأيورفيدا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ed26de8f9158824e4d8e",
   "sourceHash": "ed26de8f9158824e4d8e0e955198344d0d56e7a34924cce14df45802ab16122a",
   "text": "فوائد العلاج الأيورفيدي لشلل الوجه",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_22f384711afdf0080643",
   "sourceHash": "22f384711afdf008064363063f23804bdc768cc888a5c535a7253cc90f1b5b2d",
   "text": "الاستشارة الأولية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ad6fa5653556bee10b5c",
   "sourceHash": "ad6fa5653556bee10b5c4edf0502c5ad1b988a52627b53269cee5b70a496d0ba",
   "text": ": يُجري طبيبنا الأيورفيدي ذو الخبرة استشارة مفصّلة لفهم التاريخ الطبي للمريض وأعراضه وعوامل نمط حياته. ويساعد ذلك في تحديد السبب الكامن وراء شلل الوجه ووضع خطة علاجية مخصصة.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6c53a831ce3ad793be78",
   "sourceHash": "6c53a831ce3ad793be781810471e4e80d4862c1de92687beebbde5e83e2a9ab2",
   "text": "التشخيص والتقييم",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5aba97d3ccf734832c6d",
   "sourceHash": "5aba97d3ccf734832c6dbf33c6c4b900714975f04765d5b419caf489b5f5d317",
   "text": ": من خلال فحص دقيق يشمل تشخيص النبض (نادي باريكشا) وتقييم اختلالات الدوشا، يحدد الطبيب الأيورفيدي اختلال الدوشا المحدد المسبب لشلل الوجه، ويتعرّف على الأنسجة والقنوات المتأثرة.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2caff89bc969dba5d108",
   "sourceHash": "2caff89bc969dba5d1087e0185863762814eb50345ca4114f526f2f152b5b94b",
   "text": "خطة علاجية فردية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0fb07a68f2beba86c136",
   "sourceHash": "0fb07a68f2beba86c136f72801132f19cba8b1756f2ca47e27671e6a37cd2c52",
   "text": ": بناءً على التشخيص، تُوضع خطة علاجية مخصصة تراعي بنية المريض وشدة الأعراض وحالته الصحية العامة. وقد تشمل الخطة أدوية عشبية وعلاجات وتوصيات غذائية وتعديلات في نمط الحياة وتمارين محددة.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2b377e872e8e88c1323c",
   "sourceHash": "2b377e872e8e88c1323c988051ac77238883bca04c6922cd1a9ede55d517936c",
   "text": ": تُستخدم علاجات أيورفيدية متنوعة لمعالجة السبب الجذري ودعم التعافي. وقد تشمل Abhyangam (أبهيانغام) (التدليك بالزيوت العشبية)، وشيرودارا (Shirodhara) (صبّ الزيت على الجبهة)، وناسيام (إعطاء الزيوت العشبية عن طريق الأنف)، وعلاجات موضعية تستهدف المنطقة المصابة.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6da9c3d526eadf7a1786",
   "sourceHash": "6da9c3d526eadf7a178678363e6258a033a0741f038ee573982d7af2959e9d4e",
   "text": "الأعشاب والتركيبات الطبية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
