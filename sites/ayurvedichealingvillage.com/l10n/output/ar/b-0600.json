   "sourceHash": "ccafb723948902aaea285dca7e93365a3420d9baa61b9038503844efd1422f29",
   "text": "توجيه المسارات عبر OSRM",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_71dfe975bae89a8a1783",
   "sourceHash": "71dfe975bae89a8a17836b65e3973295afefaa5fbcc198b9b0c5039ccf4abd88",
   "text": ". استخدم روابط الاتجاهات للمسار الذي تختاره.",
