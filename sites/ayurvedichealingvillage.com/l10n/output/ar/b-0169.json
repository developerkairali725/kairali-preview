 "units": [
  {
   "id": "t_0513b9ac5019006402cf",
   "sourceHash": "0513b9ac5019006402cf6261479aced2b9e33b9b67403faa58872a3d5481d810",
   "text": "احجز برنامج اليوغا والتأمل",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_19b25396c648a2249932",
   "sourceHash": "19b25396c648a2249932e4db379ce3046ebfd155611fcf6f184ebe07c0267ea6",
   "text": "Kairali – قرية الشفاء الأيورفيدية حاصلة على اعتماد NABH للبانشاكارما &mdash; الشهادة رقم AH-2024-0250، سارية من 25 أبريل 2024 حتى 24 أبريل 2027.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bf94ffa0bb7603d7bd74",
   "sourceHash": "bf94ffa0bb7603d7bd74f108c5000c0b073aea5670c014ab37843ab5023f64ad",
   "text": "ما يشمله [[OPEN_1]]برنامج اليوغا والتأمل[[CLOSE_1]] لدينا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8310fd73e659013d60a2",
   "sourceHash": "8310fd73e659013d60a21a88920b7a3e0819314573c17db208218cf089b6ec3e",
   "text": "[[OPEN_1]]مزايا[[CLOSE_1]] البرنامج",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_28ac341422ebb42ff11c",
   "sourceHash": "28ac341422ebb42ff11c04a584bbca379e4f45d3cd6d8f84ddd4f7aaf0b0ca49",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]برنامج مكثّف لليوغا والتأمل يقوده مدرّبون متمرّسون.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_27bd98417fa36ee7aa1c",
   "sourceHash": "27bd98417fa36ee7aa1cc91c826b6cf005ef5556b7821fc4d052376c43ee7670",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]دروس يوغا مصمّمة حسب الاحتياج، منها الهاثا والفينياسا، مناسبة لجميع المستويات.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5e2f4911edc593bae46d",
   "sourceHash": "5e2f4911edc593bae46dcb97b3bd2d8976326d8b230f0874c211b95ac260802a",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]جلسات تأمل.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ba2b19a627e65ed24092",
   "sourceHash": "ba2b19a627e65ed240929455f1d5b568311bf9c78cbef6997ffacb48e56fa206",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]طعام أيورفيدي صحي لتغذية الجسم ودعم الممارسة.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c9159ba05c0bdde23414",
   "sourceHash": "c9159ba05c0bdde23414e10c12e4f07f1cc2f96b3f87f722b9509a1dad9cfc28",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]ورش عمل حول الأيورفيدا وإدارة التوتر والعافية الشمولية.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1639d633f74f03acc0cb",
   "sourceHash": "1639d633f74f03acc0cb5c8852cd9e55ff4c940ad4e34c5c9a0b5be818555fa4",
   "text": "خطّط لبرنامجك",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9eda6da7496789ab5761",
   "sourceHash": "9eda6da7496789ab5761f47b194a34db10caf3715ee71ca4da6e793638743b13",
   "text": "برنامجك لليوغا والتأمل",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8e13ec3b028c441ab9ce",
   "sourceHash": "8e13ec3b028c441ab9ce4ac985b13761e73e4ad48a47e649577669c98af6651f",
   "text": "أحضِر معك: ملابس قطنية، وأدويتك، وأحدث تقاريرك الطبية، وذهنًا منفتحًا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3cdcc1afb9511bc71bd1",
   "sourceHash": "3cdcc1afb9511bc71bd123a951fdb1e4f7e9f0ba741b902b434a30b8f6b9f211",
   "text": "[[OPEN_1]]تجارب[[CLOSE_1]] الزوار",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Guest' rendered as 'الزوار' (visitors) per the register lock."
   ]
  },
  {
   "id": "t_2ec8e98087e94064f53f",
   "sourceHash": "2ec8e98087e94064f53f94f9c67a9b1bde8bcb3ce1dc7423d3ef6a2c27e1e580",
   "text": "تعرفة البرنامج",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7e7ba4191be96ebc6d50",
   "sourceHash": "7e7ba4191be96ebc6d50c0c8c8563a93f3a35fd9bfb039cd13debf35122f112c",
   "text": "اطلب عرض سعر لبرنامج فايكتيكا يوغا سادهانا (Vaiyaktika Yoga Sādhanā) بناءً على برنامجك الفردي ومدته والفيلا التي تختارها.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ada948362c0933d5a1ae",
   "sourceHash": "ada948362c0933d5a1ae1d7ce332c0d4f950658d7ed368e0547e40cc947f2d51",
   "text": "لـ[[OPEN_1]]باقة اليوغا والتأمل[[CLOSE_1]] المنشورة تعرفتها وخدماتها المشمولة الخاصة بها. [[OPEN_2]]اطّلع على تعرفات البرامج المنشورة[[CLOSE_2]].",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_724f2336bf690001bb8b",
   "sourceHash": "724f2336bf690001bb8b255444114158e8e9a692b0af2171da53622d03c93746",
   "text": "اطلب عرض سعر",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9856b7433f842da2093b",
   "sourceHash": "9856b7433f842da2093b956811286d51860e05ae3904dc40b36dc709ea298884",
   "text": "الأسئلة الشائعة",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_491f754f68f8d42068a8",
   "sourceHash": "491f754f68f8d42068a8c7a03d47bc17a1cc38bf30eefff35f6030be73543ce6",
   "text": "فيما يلي الأسئلة التي يطرحها الزوار في أغلب الأحيان قبل بدء برنامج اليوغا والتأمل.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'guests' rendered as 'الزوار' (visitors) per the register lock."
   ]
  },
  {
   "id": "t_bf5bbcd895f7ee2ba0cb",
   "sourceHash": "bf5bbcd895f7ee2ba0cb7dd45c52d3feb35d89b732348c87d9db779b69b04546",
   "text": "المزيد من البرامج",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6b80524c5a58149cb8da",
   "sourceHash": "6b80524c5a58149cb8da25ada0ba94f52d8a855819812d3115692de3875eb1eb",
   "text": "اكتشف المزيد من البرامج القابلة للتخصيص",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6bd218d96d798769804d",
   "sourceHash": "6bd218d96d798769804db250317dcdb2efc65f2e45f6acd895f7b2cd26e6c188",
   "text": "باقة اليوغا والتأمل من كايرالي – دهيانا يوغا شيبيرام (Dhyana - Yoga Shibiram)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5f56a8a7d90f20ff23bc",
   "sourceHash": "5f56a8a7d90f20ff23bc51f449659eb01f9538de85bc0ae487c0bd09fd43364f",
   "text": "برنامج اليوغا والتأمل والأيورفيدا في كيرالا، الهند | Kairali",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Source title is keyword-stacked and far over 60 characters; condensed to a natural title within the limit. 'Retreat' rendered as 'برنامج' (programme) to avoid resort connotations."
   ]
  },
  {
   "id": "t_501f0ded635c7b8c3e0b",
   "sourceHash": "501f0ded635c7b8c3e0bb483fe8529be49ae991f28955e3dbf1e3f77c198fad9",
   "text": "ماذا لو كنت مبتدئًا؟",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1e667e8f3d1739b6325e",
   "sourceHash": "1e667e8f3d1739b6325efe501807059af452fb48dd31657469ebe3bda98a0021",
   "text": "يناسب برنامجنا المشاركين من جميع المستويات، بمن فيهم المبتدئون. ويقدّم مدرّبونا التوجيه والتعديلات المناسبة.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
