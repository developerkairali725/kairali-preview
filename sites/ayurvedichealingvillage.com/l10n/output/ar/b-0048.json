   "sourceHash": "7d4bb86a72e990da15efc3f58537f2e3a9f8f5a8c62a6219624f895be50a89bd",
   "text": "نهجنا [[OPEN_1]]في علاج تخفيف آلام الظهر المزمنة[[CLOSE_1]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
