 "units": [
  {
   "id": "t_9d2c7caf09f8af29adc9",
   "sourceHash": "9d2c7caf09f8af29adc99f52e88e01e6f0199d5de919032b2542a5dcc219f321",
   "text": "المعالم (أكثر من 50 كم)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_22fa83338273a73e2ef3",
   "sourceHash": "22fa83338273a73e2ef3b03267f1467ac014d7581e488409dfb1a0db2315c616",
   "text": "بفضل مناظرها الطبيعية المتنوعة وعجائبها التي صنعها الإنسان، رسّخت بالاكاد مكانتها على خريطة السياحة في كيرالا. وإلى جانب المعالم الموجودة داخل حدود بالاكاد وبالقرب منها، ثمة أماكن أخرى تستحق الزيارة إن كنت مستعدًا للتوغّل أبعد قليلًا في البرية.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5cd4017de1b69839569e",
   "sourceHash": "5cd4017de1b69839569eb0c7e1852753fb777ad1946c56df3810983ae2871c6a",
   "text": "أماكن على بُعد أكثر من 50 كم",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1642a755babf48b51e13",
   "sourceHash": "1642a755babf48b51e1373898a1c2ddecd00fb69d2b5415e7244d8ced44f43c9",
   "text": "نيليامباثي",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_902bb9e864db7046caa0",
   "sourceHash": "902bb9e864db7046caa049fa6cbed474fdacc93dd1e0983eac429408ce14f49f",
   "text": "75 كم",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2f75a6cfbf5636c0a33c",
   "sourceHash": "2f75a6cfbf5636c0a33c1685af370144ad0060bee898253ddce8fbda5305dfc4",
   "text": "نيليامباثي، «ملكة تلال بالاكاد»، مكان جميل تحيط به السحب الرقيقة، وله سحره الخاص.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_334c99ce7eb0e242c5cc",
   "sourceHash": "334c99ce7eb0e242c5ccac74b47e0c5b78c3bac37b3fe00c2ffc156b3b368449",
   "text": "هواء التلال",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7cb197f4065387c15b5c",
   "sourceHash": "7cb197f4065387c15b5c1db8b33922dd0bc58854d0a1c48bfb9a532ea42201fc",
   "text": "مزارع الشاي والقهوة",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d7f0262f09a0ed672f56",
   "sourceHash": "d7f0262f09a0ed672f566b7fb98098a4ef877e24ff5ee6ef5e5cd39f6f2f2ac1",
   "text": "المشي لمسافات طويلة",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8d0a5d980fa42f8528ef",
   "sourceHash": "8d0a5d980fa42f8528efef0411a8af0f16bfaaf61598286b3609f80ba5a0a04a",
   "text": "كالاماندالام",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f77c354c6dae0190220c",
   "sourceHash": "f77c354c6dae0190220cef6a5726f738ecf20e9e73277811fb16574fa1a4dd9f",
   "text": "70 كم",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d9214588c9ea71fa82cd",
   "sourceHash": "d9214588c9ea71fa82cdf67b18097b3149d3ba7241acd700e24c24cd4971e707",
   "text": "تقع كالاماندالام، وهي منشأة ذات شهرة عالمية لتعليم فن الكاثاكالي، بالقرب من قرية تشيروثوروثي. أسّسها الشاعر فالاتول نارايانا مينون عام 1930.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_01a5c686dd6354595b3f",
   "sourceHash": "01a5c686dd6354595b3f2538422d77c9b81eb53e7fc95047d3ac084bf2bf30c1",
   "text": "فنون الأداء الكلاسيكية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_10fb068ff0bd6208f687",
   "sourceHash": "10fb068ff0bd6208f68733070b0cee72667a0b01e4458552cdab8784f097e4b6",
   "text": "تريثالا",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c12dda74be2a0f0b8cbc",
   "sourceHash": "c12dda74be2a0f0b8cbcf400e9b8696b1e5c4e07789387df874bb271f851564e",
   "text": "تشتهر تريثالا بأطلالها التي تعود إلى العصور الوسطى، وتحظى بأهمية أثرية كبيرة. ومن أبرز معالمها حصن طيني ضخم يحيط به خندق من حجر اللاتيرايت، ومعبد شيفا.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7a50bcaf1c94a0758635",
   "sourceHash": "7a50bcaf1c94a0758635fd4bb83d639ba76c12ba50f0bfcf05abfa21c39bc75b",
   "text": "علم الآثار",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_22ca9653a83ec7845c76",
   "sourceHash": "22ca9653a83ec7845c769ce6ff79eec35f4f4975b416007e0c8c23c1a3d1c4b2",
   "text": "أطلال من العصور الوسطى",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_cd86db94826a672ad929",
   "sourceHash": "cd86db94826a672ad929ed764a8affef0c9fd56aecf9a7e06620d91a9597f6a2",
   "text": "أتابادي (وادٍ جبلي)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_443c7e0d74be53e2dd6a",
   "sourceHash": "443c7e0d74be53e2dd6a08888f062d4916a45e40d6aa9b38e6ec84063eff8fb0",
   "text": "80 كم",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0dc589429b8e760b3f80",
   "sourceHash": "0dc589429b8e760b3f804d4c2dade23700de93d580f9cffa65b2506d980c70b4",
   "text": "أتابادي وادٍ جبلي واسع يقع قرب منابع نهر بهافاني، أسفل تلال نيلغيري في سلسلة الغات الغربية.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_77801205771e92749e61",
   "sourceHash": "77801205771e92749e613254053c85c12e79b33764312a8eaa6d8ce8b2f26eba",
   "text": "مناظر الوادي",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_53dc2c51f0af8b55380e",
   "sourceHash": "53dc2c51f0af8b55380e4920e07245349d69ab09bb4423c39cca03ebab4bffcb",
   "text": "النباتات والحياة البرية",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8424fc257ed18a8ba7ea",
   "sourceHash": "8424fc257ed18a8ba7ea665b928494fbe85f78e9889b7ffd3fa7af0e90b05081",
   "text": "منتزه سايلنت فالي الوطني",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b8b59925f9c0e2091177",
   "sourceHash": "b8b59925f9c0e2091177f88d97d0cdcc3ca14f5cca0f34c76c9f7c3ee143f61e",
   "text": "منتزه سايلنت فالي الوطني هو ثاني أكبر منتزه وطني في كيرالا، وأحد آخر المناطق البكر في جنوب غرب سلسلة الغات الغربية. ولا تصل الطرق البرية إلا إلى موكالي، على بُعد 24 كم من المنتزه.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_32d83b19bf440031b302",
   "sourceHash": "32d83b19bf440031b30232663ec470bb5c650ca6ea2a232a58b1264b1bfc0487",
   "text": "غابة مطيرة",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
