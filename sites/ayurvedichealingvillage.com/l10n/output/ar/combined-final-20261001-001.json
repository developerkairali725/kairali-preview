  "units": [
    {
      "id": "t_8bd0b436b489560e73e4",
      "status": "translated",
      "text": "يورو",
      "sourceHash": "8bd0b436b489560e73e403e055dd0a15518a254cad0d9e2aa4771d1b561d78f6"
    },
    {
      "id": "t_6a00dfc1dc867e8454c2",
      "status": "translated",
      "text": "الاثنين",
      "sourceHash": "6a00dfc1dc867e8454c2c8856e1512d9bf02a76710e3411c0972aec886c76c61"
    },
    {
      "id": "t_7d8af1de1262f150187d",
      "status": "translated",
      "text": "الثلاثاء",
      "sourceHash": "7d8af1de1262f150187d5938bf649d6c35726970685f916d1ec6392a801b9762"
    },
    {
      "id": "t_c0a6cc829cd087352947",
      "status": "translated",
      "text": "الأربعاء",
      "sourceHash": "c0a6cc829cd08735294765c75938a7da2b0f222d52e98bff13cb237cd99deaac"
    },
    {
      "id": "t_fc2662062ffdef961002",
      "status": "translated",
      "text": "الخميس",
      "sourceHash": "fc2662062ffdef9610020183ea2b087c21d71150d78a7c7463be8a9050bd3ac9"
    },
    {
      "id": "t_e21f3f372a46d4be7b49",
      "status": "translated",
      "text": "الجمعة",
      "sourceHash": "e21f3f372a46d4be7b49f6809fc91baefeadae004af06485518e124a142c0271"
    },
    {
      "id": "t_dbe35c7363c2f7ec747b",
      "status": "translated",
      "text": "السبت",
      "sourceHash": "dbe35c7363c2f7ec747b902fb240907fc58ae00b98f107be2d4c7b9cd7f6226e"
    },
    {
      "id": "t_873fef760e5d001ba0a8",
      "status": "translated",
      "text": "الأحد",
      "sourceHash": "873fef760e5d001ba0a843bf1846713fd92538699f323ef00d51f97a2ad2756c"
    },
    {
      "id": "t_8888a029aaf60b705746",
      "status": "translated",
      "text": "فردي",
      "sourceHash": "8888a029aaf60b70574640efd1655343d1c46c692918c113c16f44f606477253"
    },
    {
      "id": "t_529441523bec75ececf4",
      "status": "translated",
      "text": "مزدوج",
      "sourceHash": "529441523bec75ececf4b98d5c326b733439d0312de1a334fa01e3f6720d1425"
    },
    {
      "id": "t_7547ec0bfc96015666e7",
      "status": "translated",
      "text": "الفيلا من الفئة المحجوزة، وجميع الضرائب الحكومية",
      "sourceHash": "7547ec0bfc96015666e729669d5212e4cd380db13979098e849b739286c962b4"
    },
    {
      "id": "t_48f7389012291855fd51",
      "status": "translated",
      "text": "ثلاث وجبات نباتية أو نباتية صرفة يومياً، وفق الوصفة الغذائية",
      "sourceHash": "48f7389012291855fd5139987e90a4681322e81047a553270de56af8b8183b25"
    },
    {
      "id": "t_eba13c706baa550db8e4",
      "status": "translated",
      "text": "استشارة ومتابعة يومية من قِبل الطبيب المعالج",
      "sourceHash": "eba13c706baa550db8e40b35f6e11fad4bb2bf1813de1d72acb1e0cd5e7eb4bd"
    },
    {
      "id": "t_27f8f70a90a21156a238",
      "status": "translated",
      "text": "يوغا جماعية كل صباح وتأمل موجَّه كل مساء",
      "sourceHash": "27f8f70a90a21156a238245881acd5c5b4f2bcd7603cbf20965133d374ce508d"
    },
    {
      "id": "t_ccac20fad2690e5f9d98",
      "status": "translated",
      "text": "ورشة عمل أسبوعية، وعرض طهي، ونزهة في المزرعة أو القرية أو الطبيعة",
      "sourceHash": "ccac20fad2690e5f9d98437ddedf4c069d95ecef875d86a11496fe7514f598ff"
    },
    {
      "id": "t_78c98b45071367dba0f4",
      "status": "translated",
      "text": "المسبح والمكتبة والصالة الرياضية والمرافق الخارجية؛ ومياه معدنية ومياه منقوعة بالأعشاب وشاي أو عصائر بعد كل جلسة",
      "sourceHash": "78c98b45071367dba0f4360be9b8be3a3f24ef5d4a024b916a1663fa4f4c775f"
    },
    {
      "id": "t_2467eeed6339c6239ea9",
      "status": "translated",
      "text": "الأدوية العشبية الداخلية، والفحوص المخبرية، والعلاجات المتخصصة، التي توصف مع تقدّم العلاج",
      "sourceHash": "2467eeed6339c6239ea93bd42d51392aa47e26223b3944e1097fefd6e6b5c531"
    },
    {
      "id": "t_07a775424e4a5285880b",
      "status": "translated",
      "text": "الطعام الإضافي خارج الوجبات الموصوفة",
      "sourceHash": "07a775424e4a5285880b3f7a070914aaf06530f664537bdc60a9817bed91b4b8"
    },
    {
      "id": "t_fbed459d20fbab4317b4",
      "status": "translated",
      "text": "جلسات اليوغا أو التأمل الخاصة",
      "sourceHash": "fbed459d20fbab4317b433cec4f1560298a57d6d6561f796b07338e0e89d730a"
    },
    {
      "id": "t_0770da0696cb4524b2cc",
      "status": "translated",
      "text": "الغسيل والهاتف والإنترنت والنقل",
      "sourceHash": "0770da0696cb4524b2cccd1b78fc9055acaeb9fd7dc8b4b2da6b06f2c9c0ca95"
    },
    {
      "id": "t_249a6809d6ee509e04aa",
      "status": "translated",
      "text": "تسجيل الوصول المبكر وتسجيل المغادرة المتأخر، حيثما يُسمح بهما",
      "sourceHash": "249a6809d6ee509e04aa8f530dd76c8587265d3cabd8abbdcb27c75620eff3dc"
    },
    {
      "id": "t_8f2364e11b8be3ff008f",
      "status": "translated",
      "text": "اليوم",
      "sourceHash": "8f2364e11b8be3ff008f32b3dedb54e659362429bcc9e3eb6acb6070de4ffbff"
    },
    {
      "id": "t_bea9920db04efbb3e9a6",
      "status": "translated",
      "text": "علاج أيورفيدي واحد يومياً، بما في ذلك البخار العشبي حيثما كان ذلك مستطبّاً",
      "sourceHash": "bea9920db04efbb3e9a6f153865544303a9f76e67487de6e3a13e72be2d3a4ee"
    },
    {
      "id": "t_4550f480791696d7bf3b",
      "status": "translated",
      "text": "جلسة يوغا خاصة عند شروق الشمس وجلسة تأمل موجَّه خاصة كل يوم",
      "sourceHash": "4550f480791696d7bf3ba4b2fb38358c72f34bb987e2ca472727d496e51df90c"
    },
    {
      "id": "t_2881bd9199222e7ebb1e",
      "status": "translated",
      "text": "ورشة عمل أسبوعية، وعرض طهي، ونزهة في المزرعة أو القرية",
      "sourceHash": "2881bd9199222e7ebb1e7473ec0fbcc61a7a3a14d603a99ab9bf604b6ad6113f"
    }
  ]
}