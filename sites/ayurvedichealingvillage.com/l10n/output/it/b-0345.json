   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_080048d87ffbc28f9b5b",
   "sourceHash": "080048d87ffbc28f9b5b0bdb4b01866e3d79c65f4222d77bfe49c37f5e15a039",
   "text": "Quali sono i vostri orari?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bc6eb88d69c4cb7007cb",
   "sourceHash": "bc6eb88d69c4cb7007cb539c1fd46e6f71f421cb9d17b28257741dd0d72be7f2",
   "text": "La nostra linea telefonica risponde dalle 8:00 AM alle 9:00 PM IST, tutti i giorni. Il nostro team di assistenza ai pazienti risponde di solito ai messaggi WhatsApp e alle e-mail entro l’orario di lavoro, altrimenti la mattina successiva.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d46a4166e631d6d9f5ed",
   "sourceHash": "d46a4166e631d6d9f5eda3fed7d732d291bf254da4fe4438c3a042628173f0f2",
   "text": "Collaborate con agenzie di viaggio e partner?",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "t_d46a4166e631d6d9f5ed banned-term viaggio"
   ]
  },
  {
