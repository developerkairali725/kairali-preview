   "sourceHash": "95029e2e03a50e1bf48a09e17c2a8fd3434fb15dcb065e906d51dbdcc5d22193",
   "text": ": maggiore flessibilità, meno dolori articolari e una postura migliore.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0e55221988fcf39c8fd5",
   "sourceHash": "0e55221988fcf39c8fd532815dd1412942db653b8a50e353be2adde1adaddf72",
   "text": "Mentali: meno stress, migliore attenzione e maggiore resilienza emotiva.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
