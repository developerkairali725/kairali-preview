  {
   "id": "t_d0d90cfa5472634776d6",
   "sourceHash": "d0d90cfa5472634776d64270888245e9b74819ac067e7ec27849e6f98cc3dc09",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]Programmi di benessere a lungo termine per i veterani[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b9a960b1fbe5fcd6ac42",
   "sourceHash": "b9a960b1fbe5fcd6ac42a7b93592913efb0f1946fb0f00bbaaa456e6f291fba8",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]Assistenza riservata e dignitosa in un ambiente privato[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b4f5bc9364657bfc7cf0",
   "sourceHash": "b4f5bc9364657bfc7cf0f8612ea9a80d3e815e4081216c871f1e6a511416ecd6",
   "text": "Le nostre basi terapeutiche",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_964b7520c498824fb90a",
   "sourceHash": "964b7520c498824fb90a07872727445223bdd73e84713bfd3721bb6d1c52c740",
   "text": "Un'unica filosofia terapeutica. Personalizzata per ogni percorso di vita.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_85448cd0a4d73be5db5b",
   "sourceHash": "85448cd0a4d73be5db5bd6cd2b56b57417c49d722aca8aaa1a9262e735d76f90",
   "text": "Chiunque Lei sia e qualunque programma cerchi, le basi di ogni trattamento presso Kairali restano invariate.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e06186578b7257b7d4f1",
   "sourceHash": "e06186578b7257b7d4f16b7ee4e3331fd649149667ef1c02f285f28b166dc560",
   "text": "Ayurveda guidato dal medico",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_32ff5b1d3ff102ee2a42",
   "sourceHash": "32ff5b1d3ff102ee2a428fc05517ff3c2746be1800ca1ce08d57e25ebdaad6fe",
   "text": "Protocolli individualizzati",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6d515e675053bc9704f5",
   "sourceHash": "6d515e675053bc9704f59a6a9585b7ae6fa75f8737d4591f2efe2635a5b36b6b",
   "text": "Un approccio terapeutico etico e non commerciale",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0acaea3c242de37d1cf3",
   "sourceHash": "0acaea3c242de37d1cf3d86a2c0817c1b99aaafa59b2b738defde54ff8d30d58",
   "text": "Non si tratta di offerte promozionali. Sono impegni assunti nello spirito dell'Ayurveda: servire chi più lo merita.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_77b543ba75eb84c218bb",
   "sourceHash": "77b543ba75eb84c218bbc056e7efd3213f29730a81f1f465ba99671da5a43e54",
   "text": "Un ambiente tranquillo e raccolto",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_63db53c2d2d7de396881",
   "sourceHash": "63db53c2d2d7de3968815ac1c7d807f87162232211966e25a671454a6b272ce5",
   "text": "Quattordici acri di pace a Palakkad, nel Kerala. Niente rumore, niente fretta: solo le condizioni in cui un autentico processo di guarigione diventa possibile.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1472cd097c5aeff7d847",
   "sourceHash": "1472cd097c5aeff7d8478d714abcdbbb6ad0b57cb12456f9919d8c14f0c1f59a",
   "text": "Un processo semplice e senza fretta, pensato perché Lei possa concentrarsi sul momento presente, non sulle pratiche burocratiche.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_03c206191210116f7f84",
   "sourceHash": "03c206191210116f7f8462bb6a5323f538496b700dbe97f5031477c48a497bf8",
   "text": "Consultazione medica",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8e513fabd68c99ef80ad",
   "sourceHash": "8e513fabd68c99ef80ad0f5a6582104ea2d648d06b84fae17d2a9aed99cc4dd3",
   "text": "Una valutazione approfondita da parte del nostro medico ayurvedico: la Sua storia clinica, le condizioni attuali e i Suoi obiettivi vengono esaminati con piena attenzione.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5c500c0f8d63bf24017d",
   "sourceHash": "5c500c0f8d63bf24017dd2fdcba7f49f9d22e243659955584de2728c352cdc30",
   "text": "Piano di cura personalizzato",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8a9516a8e922af029c31",
   "sourceHash": "8a9516a8e922af029c31e6aa25208ea008d5df67925ec39272668b1d40f1055b",
   "text": "Un programma pensato appositamente per Lei (terapie, alimentazione, routine quotidiana e durata), adattato alla Sua costituzione unica.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f005f5c85a26dc6a4210",
   "sourceHash": "f005f5c85a26dc6a42108370139d64d2ee14cc754584920c2b0a473bc9e9d615",
   "text": "Terapie guidate e soggiorno",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ea1540dca992e5dbbbaf",
   "sourceHash": "ea1540dca992e5dbbbaf721c9a6df4d74076d851d0117470032c4db98dff1687",
   "text": "Terapie delicate, somministrate da esperti in un ambiente sereno. Il Suo comfort e la Sua sicurezza vengono monitorati per tutta la durata del soggiorno.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8fb571890cb22e6a7014",
   "sourceHash": "8fb571890cb22e6a70148e71900d0f9daa5bdd0b5d3318b4affdd5c6bd3a880d",
   "text": "Indicazioni dopo il programma",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
