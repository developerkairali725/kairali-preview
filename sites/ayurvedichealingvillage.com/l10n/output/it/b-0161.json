   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9eadc93d42484ffcdc12",
   "sourceHash": "9eadc93d42484ffcdc12f0a755f7519f6d0f5e571ee47131d8417d0cf4047a2d",
   "text": "Discuta qualsiasi trattamento complementare proposto con il Suo team oncologico prima di apportare modifiche o di mettersi in viaggio. Chieda a entrambi i team se un soggiorno sia appropriato nell’attuale fase del Suo trattamento.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "t_9eadc93d42484ffcdc12 banned-term viaggio"
   ]
  },
  {
