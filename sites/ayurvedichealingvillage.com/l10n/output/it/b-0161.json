   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5c51370e656f95a6eb03",
   "sourceHash": "5c51370e656f95a6eb03b868cd52c33a43740393de8620be2f63823fec2fb48d",
   "text": "Posso partecipare durante la chemioterapia, la radioterapia o altri trattamenti oncologici?",
