   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_99c06646235c8b100e5e",
   "sourceHash": "99c06646235c8b100e5e127e5ebe3cba2049dcb40f592b8dc7eec560a0d2d4ca",
   "text": "Individuell abgestimmte Heilbehandlung",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0eb895ae08f67a936d77",
   "sourceHash": "0eb895ae08f67a936d77f88b417013b6cbf81f00d0e42f5fc6b597043046d7b1",
   "text": "Die Prakriti-Bestimmung prägt Ihren gesamten Aufenthalt – jede Behandlung, jede Mahlzeit und jede Aktivität richtet sich nach Ihrer individuellen Konstitution.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bfdae037429919a8dd88",
   "sourceHash": "bfdae037429919a8dd880cc6a8a0aa51b8c7f8f34f71de8b748bb349ab7d5cd7",
   "text": "Ganzheitliche Integration",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_554a898dae8655b30761",
   "sourceHash": "554a898dae8655b307611e7deb46b33ef94c9e03b91c07ccbb9fe2a6a59d494e",
   "text": "Ernährung, Yoga und Behandlungen wirken als ein einheitliches System zusammen – nichts steht für sich allein. Ihr Wohlbefinden wird umfassend berücksichtigt.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_03c9befe03d578963e5a",
   "sourceHash": "03c9befe03d578963e5a97ba88b2700d137c3126a7a45da98e6057e1220b099c",
   "text": "Individuell abgestimmtes Wohlbefinden",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e5ac06f803adc6225059",
   "sourceHash": "e5ac06f803adc6225059235a1e0f330a186897556f5537b3b9ae263c26ea62cf",
   "text": "5.000 Jahre Ayurveda, auf Sie abgestimmt – bewährte Traditionen, verbunden mit einem zeitgemäßen Verständnis von Wohlbefinden.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d4a4d2c9095d91242235",
   "sourceHash": "d4a4d2c9095d9124223578ab073d127b6fef03af4283f2028742d97fb7ca24c0",
