 "units": [
  {
   "id": "t_84ff4f82f99cae959c6f",
   "sourceHash": "84ff4f82f99cae959c6fb71dd20f2a2d6ed9ace4af90786dcc1b3f1950b6b4b3",
   "text": "Dr. Anagha",
   "status": "translated",
   "unchangedReason": "Person's name with title.",
   "issues": []
  },
  {
   "id": "t_8cf1472f0ffb9f6c5fdc",
   "sourceHash": "8cf1472f0ffb9f6c5fdce24a28deb726022bacb3689d2ce1606388f87ff851cd",
   "text": "Was Karkidaka für unsere Patientinnen und Patienten bewirkt hat",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Guests' rendered as 'Patientinnen und Patienten' per the clinical language lock."
   ]
  },
  {
   "id": "t_15bf3daed3cf826c6cf5",
   "sourceHash": "15bf3daed3cf826c6cf54821f7d5a0fca9843ac06298834b338634e16b672c96",
   "text": "Verifizierte Ergebnisse, geteilt von Patientinnen und Patienten, die ihr Karkidaka-Programm bei Kairali abgeschlossen haben.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'guests' rendered as 'Patientinnen und Patienten' per the clinical language lock. 'Verified outcomes' is a source claim that may need verification."
   ]
  },
  {
   "id": "t_ad1f059b4ba254120e1e",
   "sourceHash": "ad1f059b4ba254120e1e2370b6d4592737de5f172335f9216110e2b17e49b73e",
   "text": "Google-Bewertungen – Kairali Ayurvedic Healing Village",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_61a2ac4f95e350b7ed5f",
   "sourceHash": "61a2ac4f95e350b7ed5f37724bdf835d8becd27a35487a367d14a4b0b8babd31",
   "text": "TripAdvisor-Bewertungen – Kairali Ayurvedic Healing Village",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_10cd51e073108e8da5b7",
   "sourceHash": "10cd51e073108e8da5b7de4a70ff098519c877017946b45e2ed51f7fd52c7873",
   "text": "„Meine CRP-Werte sind von 18 auf 5 gesunken.“",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Individual patient testimonial with clinical outcome figures; translated faithfully — medical content requiring clinical sign-off."
   ]
  },
  {
   "id": "t_7e55f353e328da0dba55",
   "sourceHash": "7e55f353e328da0dba5550670fc81668973f5c68ada968659c2e277b23a29f05",
   "text": "Nach 14 Tagen Monsun-Panchakarma bei rheumatoider Arthritis sind meine CRP-Werte von 18 auf 5 gesunken, und ich nehme seit 6 Monaten keine täglichen NSAR mehr ein.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Individual patient testimonial with clinical outcome figures; 'NSAIDs' rendered as the German abbreviation 'NSAR' — medical content requiring clinical sign-off."
   ]
  },
  {
   "id": "t_6b5ad7df3bfb9705ac82",
   "sourceHash": "6b5ad7df3bfb9705ac827ea59193ea30b84d95bd88fa082ec19d104fc7bd7774",
   "text": "„Ich schlafe 7–8 Stunden ohne Medikamente.“",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_61c14b375ac4bf8b053a",
   "sourceHash": "61c14b375ac4bf8b053a70b0a899c2e7d259abf56e42a6824cd67450247da56d",
   "text": "Ich kam erschöpft an und schlief kaum 4 Stunden pro Nacht. Am 10. Tag meines Karkidaka-Programms schlief ich 7–8 Stunden ohne Medikamente, und mein Nüchternblutzucker war von 152 auf 112 gesunken.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Individual patient testimonial with clinical outcome figures — medical content requiring clinical sign-off."
   ]
  },
  {
   "id": "t_fee9c50cd95f637f8af8",
   "sourceHash": "fee9c50cd95f637f8af84be9cfb0d9877e565513bd95cf5e037e70deb882a9ae",
   "text": "„Nacken- und Rückenschmerzen von 8/10 auf 2/10.“",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6737bf6ee01c8cea2556",
   "sourceHash": "6737bf6ee01c8cea25569bc498a13f91b161eb5b4e216f7470e39244a7c462e4",
   "text": "Einundzwanzig Tage hier haben meine chronischen Nacken- und Kreuzschmerzen an den meisten Tagen von 8/10 auf 2/10 gesenkt. Ich kann wieder arbeiten, reisen und Yoga praktizieren, ohne Angst vor einem erneuten Schub.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f83675916d8422a0c690",
   "sourceHash": "f83675916d8422a0c6909a76aebfd56f7368a75b475d1d17503c1b6852c44799",
   "text": "Fragen, ohne Ausflüchte beantwortet",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_588d434afc09f5e785ae",
   "sourceHash": "588d434afc09f5e785aedb5b3ac9e5c009e13e7668fb967bea11ed0684cb11ca",
   "text": "Ehrliche, direkte Antworten für alle, die ein Karkidaka-Programm in Erwägung ziehen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'guests' rendered neutrally ('für alle, die …') per the clinical language lock."
   ]
  },
  {
   "id": "t_743a6abd1ec6f734a03a",
   "sourceHash": "743a6abd1ec6f734a03a416dba7921c43790ca9f0d46f29f1fae2f00e64d7d6f",
   "text": "Beginnen Sie Ihren Karkidaka-Heilungsweg",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Journey' rendered as 'Heilungsweg' (path) per the clinical language lock."
   ]
  },
  {
   "id": "t_329545ee62e5e1cb36a5",
   "sourceHash": "329545ee62e5e1cb36a592955d2e212eedfb189965546f43b80c8cdf912d09e3",
   "text": "Erzählen Sie uns ein wenig über sich, und lassen Sie unsere Ayurveda-Ärztinnen und -Ärzte ein Karkidaka-Protokoll erstellen, das auf Ihren Körper, Ihren Rhythmus und Ihre Bedürfnisse eingeht.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e2ebfeae9f45f6f926f3",
   "sourceHash": "e2ebfeae9f45f6f926f32ffa83201a94147c1148bc7d1edadc68ebf0bb14ddb7",
   "text": "Eine unserer BAMS-Ärztinnen oder einer unserer BAMS-Ärzte meldet sich innerhalb von 24 Stunden persönlich bei Ihnen. Unverbindlich und ohne Druck – einfach ein Gespräch über Ihr Wohlbefinden.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_30750d3b9f821c73caa0",
   "sourceHash": "30750d3b9f821c73caa0726f298312feaf389cadd2e2d9157e0d7df5a6d07e54",
   "text": "Live-Erfassung, beschädigte Stellen wiederhergestellt",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
