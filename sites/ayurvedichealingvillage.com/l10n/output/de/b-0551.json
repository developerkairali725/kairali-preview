   "sourceHash": "4118527bcc792b57352e359ee1a75f77dccdfe194bd0f44ccf310686f6e067db",
   "text": "1. OAP (eintägiges Ayurveda-Programm)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_435dc2eca75897e7252f",
   "sourceHash": "435dc2eca75897e7252fe41fe7a703eaf7c9a0865e0f995b369aed65da63518a",
   "text": "Lernen Sie die Grundlagen des Ayurveda kennen – seine Geschichte, seine zentralen Prinzipien und seine Anwendung im Alltag – mit einer Präsentation, einer Vorführung und einer praktischen Abhyangam-Massageeinheit.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fe7e0ba6a47e06a6bc3d",
   "sourceHash": "fe7e0ba6a47e06a6bc3dcee6fdbdc2ecfb36fd9a416ab44d17e88bce0e885994",
   "text": "2. TAP (dreitägiges Ayurveda-Programm)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6b11359b3c22e25719ad",
   "sourceHash": "6b11359b3c22e25719ad51c0db99d784fe69c6e3f223ccf481d690e1d05a1545",
   "text": "Vertiefen Sie Ihr Wissen mit einer Kombination aus Theorie und praktischer Ausbildung, mit Schwerpunkt auf entspannenden und regenerierenden Therapien wie Abhyangam, Shirodhara und Podikizhi.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_529d5f533a76761c669e",
   "sourceHash": "529d5f533a76761c669e3ad1fad491dbb6f1f34e369e5bb8a2d4ce6f166d6533",
   "text": "3. WAP (fünftägiges Ayurveda-Programm)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b89faeb7843203896d81",
   "sourceHash": "b89faeb7843203896d814123cf7ff029f29f0a67a1e1358300951c3b46ab410e",
   "text": "Lernen Sie die Grundlagen des Ayurveda und erhalten Sie eine praktische Ausbildung in fünf zentralen Therapien: Abhyangam, Shirodhara, Podikizhi, Udhwarthanam und Kativasthi.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9495cc4c611c03cc4184",
   "sourceHash": "9495cc4c611c03cc41843dede947e5d35abb89ec9b55a9a408c7bb9ced09968d",
   "text": "4. AATP (10-tägiges Ayurveda-Programm)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1532e679691c5a277cfd",
   "sourceHash": "1532e679691c5a277cfd8f39ccda56560c0f23f6aa49ae993d84f66c6467137e",
   "text": "Ein umfangreicherer Lehrplan, der Tagesroutinen (Dinacharya), jahreszeitliche Praktiken (Ritucharya), Anatomie sowie die ausführliche praktische Anwendung von sechs zentralen ayurvedischen Therapien umfasst.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c28bdd9926bdc950f816",
   "sourceHash": "c28bdd9926bdc950f816953a37cd1e083a433eb2aca456e987cddbe977da5683",
   "text": "5. AALCT (20-tägiges Ayurveda-Programm)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2268b70a7cfe2f5451cb",
   "sourceHash": "2268b70a7cfe2f5451cb0c12f36c1d1cbe91b5c680e07f7957f82e6196d685f4",
   "text": "Ein fortgeschrittener, umfassender Kurs mit Prakriti-Analyse (Körperkonstitution), dem Umgang mit Lebensstilerkrankungen, Ernährungsrichtlinien, Heilmitteln sowie der Ausbildung in neun wichtigen ayurvedischen Therapien.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_da4f7ea58d963b1a302b",
   "sourceHash": "da4f7ea58d963b1a302b76b8fa5570190106c673b9cf2975468b8caea5e27384",
   "text": "Hinweise:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f8c0fbd6bc413b3982ce",
   "sourceHash": "f8c0fbd6bc413b3982ce5b35458fe43019a7fa042addcf913ba8a9907e780352",
   "text": "Der Theorieunterricht wird von erfahrenen ayurvedischen Ärztinnen und Ärzten gehalten.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
