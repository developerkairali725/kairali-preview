 "units": [
  {
   "id": "t_aa038fd1013e6ec08069",
   "sourceHash": "aa038fd1013e6ec080691e259f17906457f348fadd3a0d23efadecde53b65d06",
   "text": "oder in Ihrem WhatsApp-Chat mit Priya.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_81dd646fdca44c9f30f1",
   "sourceHash": "81dd646fdca44c9f30f1c023b03be034d0c338e0e40f58b768b30cc7b51a63e4",
   "text": "Kann ich die Geschäftsleitung kontaktieren, ohne eine öffentliche Bewertung abzugeben?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9afac8057eec876d358e",
   "sourceHash": "9afac8057eec876d358ed875b03fce259d81ad659a4957e12be3ff6e4d84254e",
   "text": "Ja. Schreiben Sie der Geschäftsleitung eine E-Mail oder senden Sie Priya direkt eine Nachricht. Unabhängig davon können Sie auch eine öffentliche Bewertung hinterlassen; die beiden Möglichkeiten hängen nicht voneinander ab.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_93ea8b0694923954f525",
   "sourceHash": "93ea8b0694923954f52503a6ba651d88303133b2742fb9c57e8194b12307f496",
   "text": "Bin ich hier mit einer Buchungsanfrage richtig?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d3fa99211a7bce0d7ae3",
   "sourceHash": "d3fa99211a7bce0d7ae3cded6e87acdc908a0ef5db7c7540166827f042a44f84",
   "text": "Bei Fragen zur Verfügbarkeit, zu Programmen oder zur Planung Ihres Aufenthalts",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Fragment continues into the linked text; 'please' moved into the next unit ('wenden Sie sich bitte an …') for German word order."
   ]
  },
  {
   "id": "t_be6fba060d1b54d9e88c",
   "sourceHash": "be6fba060d1b54d9e88ced0659b068cd37b49183d78cf433ce15c96f4cd49925",
   "text": "wenden Sie sich bitte an unser Patientenbetreuungsteam",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Carries the 'please' of the preceding fragment for German word order."
   ]
  },
  {
   "id": "t_be6b316ba3cf047c3043",
   "sourceHash": "be6b316ba3cf047c30431aa67a3b55b5d9616229cb8a915b59b1986a0af0ff3d",
   "text": ". Auf dieser Seite können Sie uns Rückmeldung zu Ihren Erfahrungen mit Kairali geben.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d2c5e9da918bf6b64edc",
   "sourceHash": "d2c5e9da918bf6b64edc90decf0917cbcb78cbc5590b75f79ac4400a92ac8757",
   "text": "Brauchen Sie während Ihres Aufenthalts Hilfe?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6ff5c8a3cf26f250ff8a",
   "sourceHash": "6ff5c8a3cf26f250ff8a85464b53deb231cd231a7218cf67b7632fa0cfdab432",
   "text": "Bitte wenden Sie sich bei allem, was während Ihres Aufenthalts Aufmerksamkeit erfordert, an das Team an der Rezeption. Telefonisch erreichen Sie uns auch unter",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Fragment is followed by a phone number; rephrased as 'erreichen Sie uns auch unter' so the sentence ends correctly before the number."
   ]
  },
  {
   "id": "t_dfe36467102a316b3e0a",
   "sourceHash": "dfe36467102a316b3e0a39cf43179f315f04ed649429d4e91d3c1a70db7bd62a",
   "text": "Ihre Rückmeldung verfassen",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0059798b7f7023e4d9e5",
   "sourceHash": "0059798b7f7023e4d9e5c4595f7b9ba7ee64f69993ee524824d57e5a48b1228c",
   "text": "(optional)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ac5192e52a7f07bcead8",
   "sourceHash": "ac5192e52a7f07bcead850a16cabf8ce31fd38f25703543bdc255b0584db6d2a",
   "text": "Aufenthaltsdaten oder Buchungsnummer",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a7e31835e805c2c27945",
