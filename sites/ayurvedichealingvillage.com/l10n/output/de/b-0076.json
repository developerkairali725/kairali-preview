  },
  {
   "id": "t_09289b5dba4a7e19c345",
   "sourceHash": "09289b5dba4a7e19c34560c07683eb9763a072c736a8277b98cfc67c9710ad03",
   "text": "Wie erreicht man Kairali am besten von großen indischen Städten aus?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fd42bbd25ed3a660923f",
   "sourceHash": "fd42bbd25ed3a660923fdfab7b3a2b65f9ce7811679c5c2a1b5ddd9babdd95f7",
   "text": "Von Delhi, Mumbai, Bengaluru oder Chennai: Fliegen Sie nach Coimbatore und nutzen Sie unseren Flughafentransfer. Innerhalb von Kerala: Nehmen Sie den Zug nach Palakkad Junction oder fahren Sie direkt zum Krankenhaus – eine ausführliche Wegbeschreibung erhalten Sie bei der Buchung.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3b7d4d193c691f021437",
   "sourceHash": "3b7d4d193c691f02143702aa6dfd045fcef869db0f87c1c9e75a8dd799666b12",
   "text": "Wie weit ist Kairali von nahe gelegenen Sehenswürdigkeiten entfernt?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c146756b6b9681a606ae",
   "sourceHash": "c146756b6b9681a606aea132c89ab4ec4d517056e8eb75d4a41bf1b4f3def775",
   "text": "Die Entfernungen sind je nach Sehenswürdigkeit unterschiedlich; hier einige Beispiele, wie sie derzeit auf unseren Seiten zu Sehenswürdigkeiten aufgeführt sind:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_13f28ad0954c6c3a5871",
   "sourceHash": "13f28ad0954c6c3a5871d4dcc02179e03778ce1001adafec1dafa4592affbb18",
