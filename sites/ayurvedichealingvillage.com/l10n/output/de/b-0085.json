  },
  {
   "id": "t_6e57f2c60d8fb1519db1",
   "sourceHash": "6e57f2c60d8fb1519db151fbef00ba9bc2ad66e73296cfa9d07334fe2f780ec2",
   "text": "Kairali – The Ayurvedic Healing Village ist ein NABH-akkreditiertes ayurvedisches Krankenhaus in der Nähe von Palakkad, Kerala, in Südindien. Auf dieser Seite erfahren Sie, welchen Flughafen Sie wählen sollten, wie unsere Transfers ablaufen und was Sie ab dem Moment Ihrer Landung genau erwartet.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0533ad6a08f2b0185097",
