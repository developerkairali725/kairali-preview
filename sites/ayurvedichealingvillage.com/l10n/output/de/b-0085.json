   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d62f3c08ef75c768fcb2",
   "sourceHash": "d62f3c08ef75c768fcb265df2d1713442c954082d15429180f12cc10fd9fe16b",
   "text": "III/73 Palayamkadu, P.O. Olassery, Kodumbu, Palakkad District – 678551, Kerala, India",
   "status": "translated",
   "unchangedReason": "Postal address kept verbatim in Latin script for courier use.",
   "issues": []
  },
  {
   "id": "t_f58f6d5a4b0ab6fa4af9",
   "sourceHash": "f58f6d5a4b0ab6fa4af995beb9447e7739e6ae33fc71f8aca3ddc2f9f9139438",
