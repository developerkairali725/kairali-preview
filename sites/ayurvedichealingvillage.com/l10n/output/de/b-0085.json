   "sourceHash": "e6a1cbe46e5406975ebf13ece37b89600171cdf56491c9a619dd3549a66f232c",
   "text": "Der einfachste Weg zu uns",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_176ae01054c30573c0e3",
   "sourceHash": "176ae01054c30573c0e3b301139462f8b8ec315d03aff2d4f6595af0f33353e9",
