 "units": [
  {
   "id": "t_00bd44a635889ecbfe4d",
   "sourceHash": "00bd44a635889ecbfe4d8aa00e86944e1452eba0c689574192c72b9c92b17305",
   "text": "Ihr Feedback | Kairali – The Ayurvedic Healing Village",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_754b84fdbfa933039e6f",
   "sourceHash": "754b84fdbfa933039e6fb08d37567a1f5ba9a0f56356e119580bbdc33c4aa911",
   "text": "Schreiben Sie eine öffentliche Bewertung, senden Sie eine E-Mail an die Leitung von Kairali oder schreiben Sie Priya per WhatsApp. Bereiten Sie Ihr Feedback hier vor und senden Sie es über den Kanal Ihrer Wahl.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9a9472f2ca42ac75c891",
   "sourceHash": "9a9472f2ca42ac75c891e3088d43c2ec8c64c9f550a1fefc3f2394ba141d1c62",
   "text": "Direkt zu den Feedback-Optionen",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2af5686738876d507117",
   "sourceHash": "2af5686738876d5071175bcf285bfda4f829eb051a26348771b7f51ac2e12a5f",
   "text": "Feedback geben",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_47ec5f64ce3e6fbe0d84",
   "sourceHash": "47ec5f64ce3e6fbe0d84d4c71dd7ebd103155d6dff562721b4082e554f803ac7",
   "text": "Wir hören Ihnen zu",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6001758aa5ef9c446d24",
   "sourceHash": "6001758aa5ef9c446d24298e6ebc96187cb233a04d18357dcab648dd5bbf176b",
   "text": "Teilen Sie Ihre Erfahrungen mit uns.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bb8163fab5f9bf768eb7",
   "sourceHash": "bb8163fab5f9bf768eb75ff702ea1073c8dc92211b48c869968037c246bc1aa9",
   "text": "Helfen Sie uns, noch besser für Sie zu sorgen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_56b530e545091e823252",
   "sourceHash": "56b530e545091e82325240eb867dffe02886e81537214ff822e9a7b368a4f3e1",
   "text": "Erzählen Sie uns, was Ihren Aufenthalt besonders gemacht hat, was hätte besser sein können oder was wir aus Ihrer Sicht in Ordnung bringen sollten. Bedanken Sie sich bei einem Teammitglied, teilen Sie einen Vorschlag mit oder äußern Sie ein Anliegen – wir freuen uns über Ihre ehrliche Rückmeldung.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d1afdda0fcf21ab32344",
   "sourceHash": "d1afdda0fcf21ab323443c2ac3873e8ac8244f9415f529d0174884bacfb973e3",
   "text": "Unserem Team per E-Mail oder WhatsApp schreiben ↓",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8a4886fddd6be9f872a5",
   "sourceHash": "8a4886fddd6be9f872a5b658248866d3d6eb56fe6fb428ce2a6464bfcacef07a",
   "text": "Öffentliche Bewertung schreiben ↓",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f424efcd5a5af58f6305",
   "sourceHash": "f424efcd5a5af58f6305a7a1a2a312ddcf255b6990c4302b7287441da9091e6c",
   "text": "Nachricht vorbereiten ↓",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_38fcc44adb59326fa749",
   "sourceHash": "38fcc44adb59326fa7497a1bdb86f91830bf4e25593569c4f3a692b05dcbcc01",
   "text": "Ein vertrauliches Gespräch",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7944b6e97c884f32802b",
   "sourceHash": "7944b6e97c884f32802b00654a79260a8fa7c9f55dfe4577c55d478f9debd7a0",
   "text": "Wenden Sie sich direkt an unser Team",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ecb8194fc0a13dc5c62b",
   "sourceHash": "ecb8194fc0a13dc5c62bd88291b1e7e46606950ac4e62919e5d46b1b3cd6458e",
   "text": "Für ein Anliegen zu Ihrem Aufenthalt, ein persönliches Dankeschön oder einen Vorschlag wählen Sie E-Mail oder WhatsApp. Wenn Sie eine Antwort der Leitung wünschen, vermerken Sie dies bitte in Ihrer Nachricht.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_54bc5c7aed742e0672e7",
   "sourceHash": "54bc5c7aed742e0672e789ce2e79ad69795664fd5605a2f2d96758965bc8649c",
   "text": "E-Mail · Vertrauliches Feedback",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5acd0a6935994e2bf5c5",
   "sourceHash": "5acd0a6935994e2bf5c5d35ac6ffcd2e2187e2fc9f8236c480f9ab838df0b602",
   "text": "An die Leitung schreiben",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4703f74950e6cd3897ed",
   "sourceHash": "4703f74950e6cd3897edafbbb5de2a45f9b11fa61ed7a25fa107027e7da9171e",
   "text": "Schildern Sie uns die Einzelheiten in Ihren eigenen Worten. Geben Sie Ihre Aufenthaltsdaten oder Ihre Buchungsnummer an, was geschehen ist und wie wir Ihnen helfen können. Ihre E-Mail geht an info@kairali.com mit einem Betreff zu Händen der Leitung.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a85fab5ac667a73e4615",
   "sourceHash": "a85fab5ac667a73e461523bae9f745a493235f49cad3a352f5540049c247843e",
   "text": "E-Mail an die Leitung ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d2fe743271dd11f1ee61",
   "sourceHash": "d2fe743271dd11f1ee610c7789943f44a2974efca43700057f435e59e12ca76a",
   "text": "Öffnet einen vorausgefüllten Entwurf in Ihrem E-Mail-Programm.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_df4b8530bf4d38f91157",
   "sourceHash": "df4b8530bf4d38f91157eda9f3ae46edc077cb18d12c51d9986617ec55f9adf2",
   "text": "WhatsApp · Vertrauliches Feedback",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f4da2d88fcf553592ffc",
   "sourceHash": "f4da2d88fcf553592ffc3b99a46d991cf3d5c26ada5d58e507e17984e3f5dbee",
   "text": "Priya schreiben",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_545a7b500ac3282e03ce",
   "sourceHash": "545a7b500ac3282e03cefe9c35695a01c784e0fb3973d13ca526e00cf3a71514",
   "text": "Sie möchten lieber ein Gespräch führen? Schreiben Sie Priya, unserer Ansprechpartnerin für die Patientenbetreuung, per WhatsApp. Feedback, das Sie mit Priya teilen, wird automatisch an die Leitung weitergegeben – einschließlich aller Anliegen, um die sich das Team kümmern soll.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_afb5e4c47d7a7c5d7d69",
   "sourceHash": "afb5e4c47d7a7c5d7d69c46df48b2e819efc24c2d52c4333a457ef135c11a44a",
   "text": "Priya per WhatsApp schreiben ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f782f9db93e17f65eea4",
   "sourceHash": "f782f9db93e17f65eea486d9e83684aff7e8e1c2876c34a4b7d093062a8fbbe9",
   "text": "Öffnet WhatsApp mit einer bearbeitbaren Nachricht.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ca7af6ae83775cde8155",
   "sourceHash": "ca7af6ae83775cde8155b0e387731e055f13ca14bae61b6df40aafd345aae20f",
   "text": "Helfen Sie künftigen Patientinnen und Patienten",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Banned term 'guests' replaced with 'Patientinnen und Patienten' (patients) per KTAHV language lock."
   ]
  }
 ]
}
