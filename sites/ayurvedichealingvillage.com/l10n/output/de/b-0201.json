   "sourceHash": "7b599573401f0f8818446edbfe4b39da89e858bdea350294019439dd39db005d",
   "text": "[[OPEN_1]]Startseite[[CLOSE_1]] [[OPEN_2]]•[[CLOSE_2]] [[OPEN_3]]Produktsortiment[[CLOSE_3]]",
   "status": "translated",
   "unchangedReason": null,
