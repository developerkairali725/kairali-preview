   "sourceHash": "901555df10508c8e0d8f753c3ed1c44f7e008473a819d3b4bc373d4dd5d41439",
   "text": "Ich habe die [[OPEN_1]]Datenschutz- und Nutzungsbedingungen[[CLOSE_1]] von ayurvedichealingvillage.com gelesen und stimme ihnen zu.",
   "status": "translated",
   "unchangedReason": null,
