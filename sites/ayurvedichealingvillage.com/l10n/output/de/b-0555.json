  {
   "id": "t_2a3f5a25ce17ec0aa7f0",
   "sourceHash": "2a3f5a25ce17ec0aa7f04a62155e27455b8416bc5472809752a50c4c212e50db",
   "text": "Das Intensive Ayurveda-Ausbildungsprogramm (WAP-HV) bietet eine fundierte theoretische und praktische Ausbildung in Ayurveda mit Schwerpunkt auf fünf zentralen Therapien und den philosophischen Grundlagen des ayurvedischen Wohlbefindens. Nachfolgend finden Sie einen ausführlichen Lehrplan und Tagesablauf, der alle Programmbestandteile im Rahmen der Bildungsvision der Kairali Ayurvedic Group vereint.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_19b85c1debcacde9dbd4",
   "sourceHash": "19b85c1debcacde9dbd4d8c30842063016356f0366ad944daa83792b8b6a050b",
