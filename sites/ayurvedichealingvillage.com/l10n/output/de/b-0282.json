   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_70d85e86e6153b8e0f0c",
   "sourceHash": "70d85e86e6153b8e0f0c6a3415c11d705e74490015a1fa18ecb0cf53da56936f",
   "text": "Pranayama, die formale Praxis der Atemlenkung, gilt als Quelle unserer grundlegenden Lebensenergie. Wir konzentrieren uns auf das Üben von Pranayama-Übungen, Atemtechniken und Abläufen.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
