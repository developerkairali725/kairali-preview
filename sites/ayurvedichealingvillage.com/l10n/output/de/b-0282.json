  {
   "id": "t_92f188c8382d0fbb481b",
   "sourceHash": "92f188c8382d0fbb481be592c188f21df72927d628da95a6fc3bab66bf517f10",
   "text": "Die Nachmittagseinheit gliedert sich in zwei Themenbereiche.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b9dc89585795108dc9a0",
   "sourceHash": "b9dc89585795108dc9a0183bb159eef6546b4b2cd4d85780977949abb28c4901",
   "text": "Erster Bereich:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dccf43be743c61b01548",
   "sourceHash": "dccf43be743c61b0154817caa1488317014078c21f04f9b22bd3cb5a2420ab16",
   "text": "Unser Schwerpunkt liegt auf der Meditation, dem Verweilen in der Stille. Wer sich auf die Stille einlässt, stärkt seine Fähigkeit zur Selbstreflexion und kann aufkommende Gedanken, Gefühle und Wünsche beobachten, ohne sofort darauf zu reagieren. Dreimal pro Woche führen wir eine geführte Meditation durch, die sich auf das Herzchakra, das Solarplexuschakra und das Wurzelchakra konzentriert.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d116d3c35ffbd1ce9331",
   "sourceHash": "d116d3c35ffbd1ce93312b4768e720457c3fbab540a92eb478974e93d0e18922",
