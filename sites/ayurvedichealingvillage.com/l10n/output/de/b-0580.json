  },
  {
   "id": "t_e9cd31a237c23c979f38",
   "sourceHash": "e9cd31a237c23c979f389a6899f7fb871ce26fccab4d68d5d3a48fa81dde23ee",
   "text": "Individuell abgestimmtes Programm – die Kosten richten sich nach dem Plan des Arztes. Erkundigen Sie sich nach der Dauer und den aktuellen Konditionen für Ihren geplanten Aufenthalt.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
