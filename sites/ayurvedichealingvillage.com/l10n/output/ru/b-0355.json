   "issues": []
  },
  {
   "id": "t_53c2834984d57d615fb1",
   "sourceHash": "53c2834984d57d615fb14de6ead4121be24dc323e2226f29ad99dfb54d4bd27b",
   "text": "Перенаправление, автоматическая консолидация и сопоставление с преемником не заявлены.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
