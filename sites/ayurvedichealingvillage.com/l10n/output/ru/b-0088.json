 "units": [
  {
   "id": "t_b1b3ca0246e503f912aa",
   "sourceHash": "b1b3ca0246e503f912aa6279e53895a961845c2fd4686ba57d054813348353d4",
   "text": "Количество путешествующих пациентов",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f18cfb73517c3f9f95b9",
   "sourceHash": "f18cfb73517c3f9f95b99fc91b9a97b09db9ca1f0ef2b0d4449f00bf5520ed74",
   "text": "Любые потребности, связанные с мобильностью или здоровьем",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f930cc4623627d877de8",
   "sourceHash": "f930cc4623627d877de8d064e12257ea618093c7443835e3bb2455b0eaf80610",
   "text": "Написать Priya в WhatsApp",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_cae8cb4b970950243b8e",
   "sourceHash": "cae8cb4b970950243b8e4fe105857cd786d1cb3f4432d6935d10d3dd460b2df0",
   "text": "На звонки по основному номеру отвечает автоматическое меню — нажмите 2 для бронирования. Работает ежедневно с 8:00 до 21:00 IST. Трансфер и возможную оплату за него подтверждает наша команда при бронировании.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e5aa9db616f4c66277d0",
   "sourceHash": "e5aa9db616f4c66277d099dfd5023ac3ce59a203e73029c4417d22ab55f9cd05",
   "text": "WhatsApp · поддержка пациентов",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e21f935f11d7e966dbba",
   "sourceHash": "e21f935f11d7e966dbbae78da9daa378fe8142a14e7c0cd7434183005faa6c5c",
   "text": "Копировать",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f8e19c7da76398f3c713",
   "sourceHash": "f8e19c7da76398f3c71385b630d73e599b73f60935874b254216610bd2e22c78",
   "text": "Основной номер",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2e0b34e126e54a74ebb4",
   "sourceHash": "2e0b34e126e54a74ebb40a69db7379ebadac6b25e4d40342d6c21d76cecb771c",
   "text": "Впервые в Индии",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7278fa8232b492460161",
   "sourceHash": "7278fa8232b492460161a24baae9f73e353b7b4c3ed9c971562794aa97d36581",
   "text": "Ваше прибытие в Индию",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_10ae4180c2cd49887226",
   "sourceHash": "10ae4180c2cd498872266c64ad1f03f26aa553c2bb5dbbedcf9e2d60d9286305",
   "text": "Ваше прибытие шаг за шагом",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3d4b25cd8489cee5de23",
   "sourceHash": "3d4b25cd8489cee5de2374f6c378b2b683a521d42862ac8d4470d5c715b99a51",
   "text": "Пройдите иммиграционный контроль и получите багаж.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_102a65a79a874cd78f50",
   "sourceHash": "102a65a79a874cd78f5087e10fcfd63799495f82996eb260554267c4924517b6",
   "text": "Выйдите через выход зоны прилёта.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2142ce491635124da9f2",
   "sourceHash": "2142ce491635124da9f2ee774e67eb06bfbf6627454536aa46ae36365364543f",
   "text": "[[OPEN_1]]Вас встречает представитель Kairali[[CLOSE_1]] с табличкой с вашим именем. Имя водителя и данные автомобиля вы получите ещё до приземления.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1080047e065e780d8f00",
   "sourceHash": "1080047e065e780d8f00268f5731fdc59333039c3f8417d9420e919bdaa7737f",
   "text": "Водитель поможет с багажом и доставит вас прямо в больницу.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_91db61e2300bf596d32a",
   "sourceHash": "91db61e2300bf596d32a241a4d52d76fb98dfc0406f75900558bcfc29e5f57e8",
   "text": "Если вы не можете найти водителя, позвоните или напишите на номер для встречи и ожидайте внутри терминала.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_aab7685123cf4b021c62",
   "sourceHash": "aab7685123cf4b021c62a41c905fdc381aaa3ae8e944299e4cdf58955258f445",
   "text": "Полезно знать",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ac3c1b76830b25c95394",
   "sourceHash": "ac3c1b76830b25c953940ac606755874911b471adec3c6a40744bc40b9bc55a9",
   "text": "Местная SIM-карта / eSIM",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_02e37775183b5f82f93e",
   "sourceHash": "02e37775183b5f82f93e2e4aa7e6ecaf65af2534b0663329b640401f30bc17e6",
   "text": "Можно приобрести в аэропорту — пригодится с момента приземления.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3b6b20fb40a3ce42fd12",
   "sourceHash": "3b6b20fb40a3ce42fd12daff046c62fee0d9531374f5f4b7b933e10dc1869e78",
   "text": "Через него мы координируем вашу встречу и остаёмся на связи с вами всё время.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9720a901927482301248",
   "sourceHash": "9720a901927482301248de73d26ebe58e67449dd8a049e34ed367d69f7342cbb",
   "text": "Индийская рупия (₹). Банкоматы есть в обоих аэропортах.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5c6e71193e323ac140b6",
   "sourceHash": "5c6e71193e323ac140b6cc7f75122c1452a44dc153d8b5ac24d990bb8634b85b",
   "text": "Широко распространён в Керале; наша команда общается на английском.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2944b14eaa54b4daad29",
   "sourceHash": "2944b14eaa54b4daad29b32f243d11c4c01cf005fd77a6055b0254e4f520273e",
   "text": "[[OPEN_1]]Прибытие поздно ночью.[[CLOSE_1]] Настоятельно рекомендуем заранее заказать трансфер — после наступления темноты на местных дорогах малолюдно. Перед выездом сообщите данные водителя и автомобиля кому-нибудь из близких дома.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c3b239786cee5b7a8d4c",
   "sourceHash": "c3b239786cee5b7a8d4cfe4f7cf0aef89109d487b2d510ac89bad159496265d7",
   "text": "[[OPEN_1]]Если у вас есть потребности, связанные с мобильностью или здоровьем.[[CLOSE_1]] Можно организовать автомобиль, приспособленный для инвалидной коляски, остановки в пути и сопровождение сиделки — пожалуйста, сообщите нам об этом при бронировании.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_85c7b839d213e296b7d0",
   "sourceHash": "85c7b839d213e296b7d0def0da12af8d11a87efabf1cb8f8b9d3e04d59f744c9",
   "text": "[[OPEN_1]]Виза и въезд.[[CLOSE_1]] Большинству иностранных посетителей нужны действующий паспорт и индийская виза или подходящая электронная виза (e-Visa). Требования зависят от гражданства и могут меняться — перед поездкой проверьте их на официальном визовом портале Правительства Индии. [[OPEN_2]]Визовый портал Правительства Индии[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_63241c0296c3eb3fba3b",
   "sourceHash": "63241c0296c3eb3fba3b0b5e6fe11c28dd2d4ad6dd7ad1795a51a4a3b96f5dbf",
   "text": "Расстояния вкратце",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
