 "units": [
  {
   "id": "t_c1f1a53c493fa0c2470f",
   "sourceHash": "c1f1a53c493fa0c2470f8ddad8dd6c8e251926baa4ac2e4e5117c084417c11ad",
   "text": "Ваш опыт важен для нас",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c125a984b5bb6904a90c",
   "sourceHash": "c125a984b5bb6904a90c7a903aa1857ebee0cc70df1922dc5e0259f94a48eadf",
   "text": "Вы уже проходили лечение у нас?",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'stayed with us' rendered as 'проходили лечение у нас' (were treated with us) to keep the clinical register; a literal 'останавливались у нас' would sound like a hotel."
   ]
  },
  {
   "id": "t_25df085a6508d0ba577a",
   "sourceHash": "25df085a6508d0ba577a414176cec4e2a2ad99bc7f94cfc4b4758bfa9d8279d1",
   "text": "Расскажите, что вам понравилось и что мы могли бы улучшить. Мы ценим каждый честный отзыв.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f3ce3fc0d023d3e40a89",
   "sourceHash": "f3ce3fc0d023d3e40a892ad29889d0ae62032656634106bbfc08496c851cbfa6",
   "text": "Оставить отзыв для Kairali",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fd90a84103aa1e549a65",
   "sourceHash": "fd90a84103aa1e549a65b0f4293cdeba0c4eb3f1b1882b9343dd73b36fed0d89",
   "text": "Оставить отзыв на Google Maps ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e15b06ca0eab188cdccc",
   "sourceHash": "e15b06ca0eab188cdcccf8243469d2f83f848583f6ae5c68e9503346a76aab79",
   "text": "Оставить отзыв на Tripadvisor ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_77eb5e9c5aa1f0f1b546",
   "sourceHash": "77eb5e9c5aa1f0f1b54615c18d82f4fef43adf5854a6b77d60ce1df8e60f1325",
   "text": "Планируете своё пребывание?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e4232a83390f05c1d79b",
   "sourceHash": "e4232a83390f05c1d79be8a442fed41dc563969cf417181f3e0933092f530156",
   "text": "Давайте обсудим, что вам нужно",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_58410930e246832f2ccc",
   "sourceHash": "58410930e246832f2ccc81b5119f701a61c7420e3b3df5227a739e17bb6fefc5",
   "text": "Наша служба заботы о пациентах ответит на ваши вопросы, поможет с размещением и подскажет следующий шаг к консультации аюрведического врача.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b560b1c1bc37b147b61f",
   "sourceHash": "b560b1c1bc37b147b61f16cdb652078e9bddd07cfab71307bcbd77f81b051aac",
   "text": "Бесплатная консультация врача",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4b9e45a7849e3a481eb5",
   "sourceHash": "4b9e45a7849e3a481eb59e363b9fe349385fbba7c61fca4ee98ead4e5bfc466f",
   "text": "Служба заботы о пациентах в WhatsApp ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_06d6614ba9f841e1295b",
   "sourceHash": "06d6614ba9f841e1295bea157d269767edd51fdfa7e5053640561e6706af98b0",
   "text": "Из Индии. Со всего мира.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "The glossary entry 'From' = 'Откуда' is a form label; here 'From' means origin in a headline, so 'Из' is used instead."
   ]
  },
  {
   "id": "t_02ae17f5ec4fb4b4d6bd",
   "sourceHash": "02ae17f5ec4fb4b4d6bd49aa749e1752273e0788c3524fe7ab11d461510106c3",
   "text": "Найдите историю, близкую именно вам",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0ad7d0a61227eb0a2496",
   "sourceHash": "0ad7d0a61227eb0a249666f105827ed1f35a3c57dc3aa1f59f3abe4e4683e8d4",
   "text": "Читать отрывки на языке:",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Fragment that precedes a language selector. Worded so a nominative language name can follow it."
   ]
  },
  {
   "id": "t_e9a5a16504f86acb8edf",
   "sourceHash": "e9a5a16504f86acb8edf4c5ff481d8b67999ebeabb483cf00c14eed0b5a31a40",
   "text": "историй ·",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Fragment that follows a number. It uses the genitive plural 'историй', which is correct for 5+ and most counts; the forms for 1 (история) and 2–4 (истории) would need plural handling in code."
   ]
  },
  {
   "id": "t_f216d206c094d3dc2323",
   "sourceHash": "f216d206c094d3dc232375413a9b587789c596b4a9ee762aa8ad43ed96739c07",
   "text": "Оригинальные отрывки на английском",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_27522f2891dfb74acba1",
   "sourceHash": "27522f2891dfb74acba1ae14482c02d2dc25b46f0d829918767574545fdde284",
   "text": "Переведённые отрывки · оригинал на английском доступен в каждой карточке",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
