 "units": [
  {
   "id": "t_317db569db094c5e6b38",
   "sourceHash": "317db569db094c5e6b380a5bebf86433250bb3365f8d88097cf0f7c173012e6e",
   "text": ": врач проводит тщательный осмотр, который может включать пульсовую диагностику, осмотр языка и вопросы об образе жизни и пищевых привычках. Это помогает выявить глубинные причины и дисбалансы.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dd281e5e3579b8292400",
   "sourceHash": "dd281e5e3579b8292400c4a803c82ca743dec8acc8f7a4b10cde5e2f890096bf",
   "text": ": на основании диагноза составляется индивидуальный план лечения. Он может включать сочетание аюрведических процедур, растительных препаратов, коррекции питания и рекомендаций по образу жизни.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_787adff347564d7d07dc",
   "sourceHash": "787adff347564d7d07dc399916e7c51c1454c92b67b7c3b324ba722d0f8ebdaf",
   "text": ": пациент проходит специальные аюрведические процедуры, направленные на облегчение синусита и мигрени, такие как Насьям (введение травяных масел через нос), Широдхара (Shirodhara) (поливание лба травяным маслом) и мягкий массаж головы для улучшения кровообращения и уменьшения заложенности.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_17554838839272b297f5",
   "sourceHash": "17554838839272b297f5705ed312caba6c6bceacf37f57ce0008e9f620a83f09",
   "text": "Рекомендации по питанию",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4e9cf0fcd31260906b2d",
   "sourceHash": "4e9cf0fcd31260906b2db2154f1aaea915bc1567017772de07e191dee319b544",
   "text": ": врач даёт рекомендации по питанию, предлагая продукты, успокаивающие нарушенные доши, и советуя избегать провоцирующих веществ, таких как некоторые специи, кофеин и продукты промышленной переработки.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7e92367630cc56d6f473",
   "sourceHash": "7e92367630cc56d6f473feed9b593b8b348fca1b9e41b53768ecefe0ce202ac9",
   "text": "Рекомендации по образу жизни",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9fc32bfa81bfb6efd5bb",
   "sourceHash": "9fc32bfa81bfb6efd5bb4b7fcd6e4c12d2d4ccfeb367fa15d6eb3c182ffe1b74",
   "text": ": рекомендуются индивидуальные изменения образа жизни — техники управления стрессом, йога, медитация и регулярные физические упражнения — для поддержки общего самочувствия и снижения частоты и интенсивности приступов синусита и мигрени.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_75c2167557de1e35a178",
   "sourceHash": "75c2167557de1e35a178d9d738a0326eaf9435a49b7b3de937c80b2d71b5e9f3",
   "text": ": регулярные повторные консультации с аюрведическим врачом помогают отслеживать динамику, при необходимости корректировать план лечения и обеспечивать постоянную поддержку и сопровождение.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4e03e8529aa4a224b5ee",
   "sourceHash": "4e03e8529aa4a224b5eefe391f36aaaaf6b7bb1223ccd1a01842c92338afb7d6",
