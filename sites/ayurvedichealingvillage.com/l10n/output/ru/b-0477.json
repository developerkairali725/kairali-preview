 "units": [
  {
   "id": "t_90cc23e40edf3cbc8013",
   "sourceHash": "90cc23e40edf3cbc8013de7bc8e72f37418af386ad25ef01d61d1a9e8ce0230e",
   "text": ": глубже познакомьтесь с уникальным биоразнообразием региона благодаря экскурсиям с гидом и рассказам специалистов.",
   "status": "translated",
