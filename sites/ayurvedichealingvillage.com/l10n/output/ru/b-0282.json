 "units": [
  {
   "id": "t_a9ddccdb609ec76485ef",
   "sourceHash": "a9ddccdb609ec76485ef6416e5d0547dbc32b0bb2d24367433873b58c5885e54",
   "text": "РАСПИСАНИЕ ЗАНЯТИЙ ЙОГОЙ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f80591aa09df97dc7217",
   "sourceHash": "f80591aa09df97dc7217a30f95a4577fc3c8cf659b24d4650fe012f917c0fe43",
   "text": "К программе могут присоединиться как начинающие, так и опытные практикующие. Занятия проходят каждый день. Недельные курсы длятся с субботы (знакомство и приветствие) до вечера пятницы.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0c546e974c00bb22f24b",
   "sourceHash": "0c546e974c00bb22f24b11302b82b18690b80fef56bb1be81f1d2057c1015113",
   "text": "07.00 am – 08:00 am – аштанга-йога",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2945f173b5a78ec63809",
   "sourceHash": "2945f173b5a78ec63809473f11434e5bd12a452d5020128f7b4766bb33e4353a",
   "text": "09:30 am – 12:30 pm – аюрведический массаж и процедура (1-часовой слот на человека)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bb82c5a95e67599cc4e6",
   "sourceHash": "bb82c5a95e67599cc4e639414de1063eca25990449bd87b72858e67b806fc6ea",
   "text": "12.30 pm – 1.30 pm – обед",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_abeddad7f3d7a1d30606",
   "sourceHash": "abeddad7f3d7a1d30606e59360396024b579b231138e7b166429a427095fdf37",
   "text": "1:30 pm – 5:30 pm – свободное время / второй аюрведический массаж",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6d52732864476f147258",
   "sourceHash": "6d52732864476f1472584c268fff5ec8efd9bcbed072f9e7e9e93d53fd82b490",
   "text": "6:00 pm – 7:00 pm – медитация / пранаяма",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_37eecfb8d610a1b6d949",
   "sourceHash": "37eecfb8d610a1b6d94987b893c83e13e463653e3a678fed73dbb9c4987b014f",
   "text": "7:00 pm – 8.00 pm – ужин",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e00bfb616b2c8c921a68",
   "sourceHash": "e00bfb616b2c8c921a685817ce9d4b2bf432535c235eafa868b91d8bdb40106c",
   "text": "*время может быть изменено по прибытии*",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_115a1fbd6ccf5ea714de",
   "sourceHash": "115a1fbd6ccf5ea714dea3b70610991c1ab379768936b041fa21c72a517074c3",
   "text": "Полный доступ к инфраструктуре центра, включая бассейн, тренажёрный зал, библиотеку и зал для медитации.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5f46357a609ae01c6310",
   "sourceHash": "5f46357a609ae01c63101ce1745a75f45b7bd19a62d8507772ad88875c4cdd28",
   "text": "Изображение из трёх частей: практика йоги и массаж головы",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4ca77afe3fd9b4b3080f",
   "sourceHash": "4ca77afe3fd9b4b3080f70f54c921369de80bae8a8467ed0ff384db6e8a62feb",
   "text": "Утренние занятия",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4ff60280b95df8e2b869",
   "sourceHash": "4ff60280b95df8e2b869be1dcbbc00b1a30e42ca0d74324c03a4586dd0670027",
   "text": "Утренние занятия аштанга-йогой проводятся в мягком темпе. Мы сосредоточимся на дыхании и будем двигаться вместе с ним. Движение и дыхание напоминают танец, творческий путь, ведущий нас к сути нашего существования, где мы обретаем спокойствие, свободу и тишину внутри себя и в единении со всем, что нас окружает.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'creative journey' rendered as 'творческий путь' (path) per the clinical-register lock."
   ]
  },
  {
   "id": "t_0163d99d8569d07e829b",
   "sourceHash": "0163d99d8569d07e829bee2fee86e2a64087822e0d4e3c73e8a42839580affe2",
   "text": "Дневные занятия",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_92f188c8382d0fbb481b",
   "sourceHash": "92f188c8382d0fbb481be592c188f21df72927d628da95a6fc3bab66bf517f10",
   "text": "Дневное занятие состоит из двух тематических частей.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b9dc89585795108dc9a0",
   "sourceHash": "b9dc89585795108dc9a0183bb159eef6546b4b2cd4d85780977949abb28c4901",
   "text": "Первая часть:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dccf43be743c61b01548",
   "sourceHash": "dccf43be743c61b0154817caa1488317014078c21f04f9b22bd3cb5a2420ab16",
   "text": "Основное внимание мы уделим медитации — пребыванию в тишине и покое. Практика молчания развивает способность к самонаблюдению: вы учитесь замечать возникающие мысли, чувства и желания, не реагируя на них сразу. Три раза в неделю мы проводим медитацию под руководством инструктора, сосредоточенную на сердечной чакре, чакре солнечного сплетения и корневой чакре.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d116d3c35ffbd1ce9331",
   "sourceHash": "d116d3c35ffbd1ce93312b4768e720457c3fbab540a92eb478974e93d0e18922",
   "text": "Вторая часть:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_70d85e86e6153b8e0f0c",
   "sourceHash": "70d85e86e6153b8e0f0c6a3415c11d705e74490015a1fa18ecb0cf53da56936f",
   "text": "Пранаяма — формальная практика управления дыханием — служит источником нашей жизненной энергии. Мы сосредоточимся на выполнении упражнений пранаямы, дыхательных техник и последовательностей.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a20a1d550bb82c13b9de",
   "sourceHash": "a20a1d550bb82c13b9dead4f9fbbb2380eea01235c252fd9e5f58381a64a6f08",
   "text": "Пакет «1 процедура» включает:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_99c181b2c3d69a64fad0",
   "sourceHash": "99c181b2c3d69a64fad01b3e5aa41bdb47bd4cbd086d5457d7d7e7b0613c0a34",
   "text": "Ежедневно один аюрведический массаж — Abhyangam (Абхьянгам)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_de44936716da33b25fd8",
   "sourceHash": "de44936716da33b25fd84b1e78e86c23fa35843e746e341c4e847f632e08daf6",
   "text": "Пакет «2 процедуры» включает:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1294de84a88de4cb91a6",
   "sourceHash": "1294de84a88de4cb91a6fa944bea5b58a6e451da2611cc2aea555d803c9dbbd7",
   "text": "Один Abhyangam (Абхьянгам) и одна дополнительная аюрведическая процедура по назначению врача (например, широдхара, пижичил, травяной скраб и т. д.)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fd824fcedd245e55871c",
   "sourceHash": "fd824fcedd245e55871c74cb48ebbad02dab9bc4b9370433b609d6022ece7a73",
   "text": "image/jpeg",
   "status": "translated",
   "unchangedReason": "MIME type; language-neutral technical value.",
   "issues": []
  },
  {
   "id": "t_e45d2d47aff322a53363",
   "sourceHash": "e45d2d47aff322a53363fa3d39f14a0014e1372bfd7ca959d861c069380a717f",
   "text": "Достопримечательности в 15 км | Керала | Палаккад",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Trimmed redundant 'Tourist Attractions' tail to stay within 60-character seo.title limit."
   ]
  }
 ]
