  "units": [
    {
      "id": "t_221938a33b844a9b108f",
      "status": "translated",
      "text": "Отзыв посетителя",
      "sourceHash": "221938a33b844a9b108fa8e75611cc84e6e2cd00c8e931ae508719701dfe36a3"
    },
    {
      "id": "t_ce770667e5f9b0d8f553",
      "status": "translated",
      "text": "Google",
      "unchangedReason": "Brand name kept unchanged",
      "sourceHash": "ce770667e5f9b0d8f55367bb79419689d90c48451bb33f079f3a9a72ae132de8"
    },
    {
      "id": "t_8e52d2fc377d96521a94",
      "status": "translated",
      "text": "Сентябрь 2024",
      "sourceHash": "8e52d2fc377d96521a94f196ee3a5971ab4aaea832f07b705315e3e29e7bedd6"
    },
    {
      "id": "t_a2482ebefe508b39f706",
      "status": "translated",
      "text": "Архив отзывов Kairali",
      "sourceHash": "a2482ebefe508b39f706aae139debe569d7bea3ffbf50498fa4f515e276ec3f5"
    },
    {
      "id": "t_1f59afa7457f3212e9d7",
      "status": "translated",
      "text": "Архивный отзыв · дата визита не указана",
      "sourceHash": "1f59afa7457f3212e9d7d83013242887a4832d8b3be31718e7eb70859ef5090b"
    },
    {
      "id": "t_c0e7723a15dcae5ef14e",
      "status": "translated",
      "text": "В его опубликованном отзыве отмечаются ландшафтный дизайн, окружение и индивидуальное внимание во время его пребывания.",
      "sourceHash": "c0e7723a15dcae5ef14eb9dccb2812f97847fb5baf1a93ab58019f2d07989fcd"
    },
    {
      "id": "t_1c743d3d622258955701",
      "status": "translated",
      "text": "Лондон, Великобритания",
      "sourceHash": "1c743d3d6222589557015d0cc6b1f4b5e47ad3d2bbcd4d9f4d2dcef83648aea5"
    },
    {
      "id": "t_12e8ff7e8f91890ac81e",
      "status": "translated",
      "text": "Пара рассказывает о трёхнедельном пребывании и о своём желании вернуться в деревню.",
      "sourceHash": "12e8ff7e8f91890ac81ec4395f33a9a7f48533c40550b2b71e51f35365a3dcc4"
    },
    {
      "id": "t_44bf1bccdfb5d13c5119",
      "status": "translated",
      "text": "Нью-Дели, Индия",
      "sourceHash": "44bf1bccdfb5d13c5119e82070dac524af219926400e3cd38e0a8fa42209e752"
    },
    {
      "id": "t_13d3878bde0643d50b05",
      "status": "translated",
      "text": "Опубликованный отзыв пациента, в котором отмечаются условия и качество обслуживания.",
      "sourceHash": "13d3878bde0643d50b0525815ce77242f3d243f204c7a41a5cbaec5ed137868a"
    },
    {
      "id": "t_98c62b02c44ebe60f294",
      "status": "translated",
      "text": "Англия, Великобритания",
      "sourceHash": "98c62b02c44ebe60f294c6590d687201bd182b0e6522e51d5b2f4a18e4446932"
    },
    {
      "id": "t_e29f69fb3134639709b3",
      "status": "translated",
      "text": "В архивном отзыве дизайнера описано, как она себя чувствовала в конце своего пребывания.",
      "sourceHash": "e29f69fb3134639709b3a37ad10d0f9b94a2cc949d0400f0615072e5fae1e626"
    },
    {
      "id": "t_a7326fa7b95f006d26bc",
      "status": "translated",
      "text": "Октябрь 2024",
      "sourceHash": "a7326fa7b95f006d26bc8dd20ec769b5af92bffc8f6cf2a92b296689db2e6e2b"
    },
    {
      "id": "t_e4ca9ad86ca85c5b7a47",
      "status": "translated",
      "text": "Отзыв семьи посвящён радушной команде и привычкам, которые они увезли с собой домой.",
      "sourceHash": "e4ca9ad86ca85c5b7a4762afb3f67eaa1e6195a3ef545aab9c7576fced06a959"
    },
    {
      "id": "t_6b63b80df0e0d8ce377f",
      "status": "translated",
      "text": "Краткий отзыв после аюрведического ретрита продолжительностью семь ночей.",
      "sourceHash": "6b63b80df0e0d8ce377f87ccef4b7353b8fc92f668ce27bfd4d73f65a6cc2ddb"
    },
    {
      "id": "t_76b1ce78ee504cb64c94",
      "status": "translated",
      "text": "Пребывание — их собственными словами",
      "sourceHash": "76b1ce78ee504cb64c943d18718d86acfb4179aedb3e75a204e455371aef7edd"
    },
    {
      "id": "t_0c5ae8340fe27f3bb57b",
      "status": "translated",
      "text": "Видео пациента · YouTube-канал Kairali",
      "sourceHash": "0c5ae8340fe27f3bb57b2cfeeb4468eb3a3ae7442919ea115347a6186cacdc70"
    },
    {
      "id": "t_bcff43c9560ecbcb9074",
      "status": "translated",
      "text": "Взгляд пациента из Парижа",
      "sourceHash": "bcff43c9560ecbcb9074d4cfda68c7edfd92fbc4d1127bc4975f41aa707c48f8"
    },
    {
      "id": "t_1b69c1de39b2d2ef2894",
      "status": "translated",
      "text": "Париж, Франция · указано в оригинальном фильме",
      "sourceHash": "1b69c1de39b2d2ef28946e28731b4afe48a924f3ed06c2f15c9ea477327b2bd1"
    },
    {
      "id": "t_dbdc49010a0bc5a9d01b",
      "status": "translated",
      "text": "Время в лечебной деревне",
      "sourceHash": "dbdc49010a0bc5a9d01b82a4a4cfe75baec9460fcbfee695e1bb0c821409c63f"
    }
  ]
}