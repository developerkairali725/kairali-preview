 "units": [
  {
   "id": "t_f7ffd249f46bcddc6a7a",
   "sourceHash": "f7ffd249f46bcddc6a7a7e306e6c7b8cb326b134c53f93699a137814296eedaa",
   "text": "Более длительные поездки в Западные Гаты; порядок посещения стоит уточнить заранее.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0afe1a00f23d90b9dd10",
   "sourceHash": "0afe1a00f23d90b9dd104b0716e926a9dd63b21bd39cda5a5a6b3bd18fc1e9c5",
   "text": "Перейти к путеводителю по достопримечательностям",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6083305291cb48b5bc14",
   "sourceHash": "6083305291cb48b5bc149b422aaad15d258b8aa1d40c6aa44b4271ad64d4479e",
   "text": "Палаккад и окрестности",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4b504c9e85ffa4c45ce2",
   "sourceHash": "4b504c9e85ffa4c45ce2b84a015cd4c0cef7bcc36f0d3b6af732349209330701",
   "text": "Откройте для себя храмы, речные пейзажи и лесистые холмы вокруг нас. Выбирайте из 22 мест для посещения; для удобства планирования указаны примерные расстояния по дорогам от Аюрведической лечебной деревни.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6a71f6245786b01b208e",
   "sourceHash": "6a71f6245786b01b208e9d653e2de01128cb5f5c2757e2709fcbea5f2e854513",
   "text": "Планируете поездку во время пребывания? Обратитесь на ресепшн, чтобы договориться о транспорте и согласовать поездку с графиком ваших процедур и приёмов.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_29b6725edbd31dd9a4b9",
   "sourceHash": "29b6725edbd31dd9a4b9f1ba3e2ef234e0cc9d85eca7bcdd64930f3de48b58ef",
   "text": "/ Обзор",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f56061681216936168c3",
   "sourceHash": "f56061681216936168c376f8d39a54d4ba93c3b98ddc19cd5f91b0e0e28a28d0",
   "text": "Около",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1f34503f65b4a355a94e",
   "sourceHash": "1f34503f65b4a355a94ee54da8e34541007cc66ec548c61b8dafbea21a1a0787",
   "text": "км",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_34c7fccac0b09ba8591a",
   "sourceHash": "34c7fccac0b09ba8591ae7dc2e714905ee7a162eb222db052f8d0c2003a082c6",
   "text": "по дороге от Kairali",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d00003f1ce9f0c1d8708",
   "sourceHash": "d00003f1ce9f0c1d87082459d16b6631a502c0ef864fbac97d4ee73177ae56c4",
   "text": "Расстояние до:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d43fd6a9ef44719db0ae",
   "sourceHash": "d43fd6a9ef44719db0aee66fd663095ed5da11877cfeb142b3b655eab1b26a8f",
   "text": "Открыть маршрут ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9d950b4bb9b4bba27b3b",
   "sourceHash": "9d950b4bb9b4bba27b3b17a8aa39dd8ae950ee33cde897e6e859d7c805c1ddef",
   "text": "Актуальная информация для посетителей ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_20c6f1f72b5615c0973c",
   "sourceHash": "20c6f1f72b5615c0973c84975c756e51cdc523926bb820099562e02b73eccd5e",
   "text": "Немного планирования — и день пройдёт легче",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_43b0e05b6172263157dc",
   "sourceHash": "43b0e05b6172263157dc7e5d5a6a65454f957082a2c4d8493c80d2f0d53d7f4b",
   "text": "Расстояния указаны приблизительно — это оценки пути в одну сторону по дорогам от Kairali в Олассери, проверенные 24 сентября 2026. Они округлены и могут меняться в зависимости от маршрута, дорожных ограничений и выбранного входа. Пешие переходы, транспорт по парку и перемещения внутри крупных мест посещения — дополнительно.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3cee3cb8aaf12a46c7c3",
   "sourceHash": "3cee3cb8aaf12a46c7c3b941b1ee06e91afb2e145ddaaa3ae0308d57d06bf435",
   "text": "Перед поездкой уточните часы работы, билеты и необходимые разрешения. Правила посещения храмов и требования к одежде различаются. Посещение лесов может требовать предварительного бронирования, а погода может влиять на доступ к водопадам и горным дорогам.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ca90de90b5dcdc6c660c",
   "sourceHash": "ca90de90b5dcdc6c660c97a388bb4d6de6771b2d9ce6c7fb876598abef43552e",
   "text": "Спросите нашу команду о поездке →",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_74826838917aaee3b722",
   "sourceHash": "74826838917aaee3b7227252bf689c07ab0ef449eee0c2d88dfdb5a6080440cd",
   "text": "Сафари по заповедникам →",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f1c9500f7235f7a2fadf",
   "sourceHash": "f1c9500f7235f7a2fadfc95b657482da92bb93c600f3c89ff09fefcfa4275a9b",
   "text": "Прогулки на плавучих домах →",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c97f41f5506d5235f5f6",
   "sourceHash": "c97f41f5506d5235f5f6bfa3b6184e21c6fa7f947f879609b7cbb1fa05127d83",
   "text": "Чем ещё заняться в Керале →",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_36c07f5bdb0817b7f35c",
   "sourceHash": "36c07f5bdb0817b7f35cf57590f0e995fee3cd0c6ae66ec2527f34222612e737",
   "text": "Источник оценок расстояний по дорогам:",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Fragment followed by OpenStreetMap attribution and OSRM link; rendered with a colon so the following fragments fit."
   ]
  },
  {
   "id": "t_d2ad7dc1514438f07ceb",
   "sourceHash": "d2ad7dc1514438f07ceb2e3dd0dbc4373967a9c0e9136081ad495d6e7ffed220",
   "text": "© участники OpenStreetMap",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ccafb723948902aaea28",
   "sourceHash": "ccafb723948902aaea285dca7e93365a3420d9baa61b9038503844efd1422f29",
   "text": "маршрутизация OSRM",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_71dfe975bae89a8a1783",
   "sourceHash": "71dfe975bae89a8a17836b65e3973295afefaa5fbcc198b9b0c5039ccf4abd88",
   "text": ". Для выбранного маршрута используйте ссылки «Открыть маршрут».",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4c07f3c2d02fb71c3aab",
   "sourceHash": "4c07f3c2d02fb71c3aabffd2493e61b8c3afef93a508e20b8b94d951318227f8",
   "text": "Смотрите историю Kairali, занятия йогой в Healing Village и короткие фильмы об аюрведических процедурах, виллах и жизни деревни. Просматривайте настоящие превью видео и их продолжительность.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_869bfb3f81540deb6ea6",
   "sourceHash": "869bfb3f81540deb6ea6bb744c5cb9e59849ce3dffcc4e0ab22b56af4f62bdb8",
   "text": "Рисовые поля и пальмы вокруг Kairali в Палаккаде",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
