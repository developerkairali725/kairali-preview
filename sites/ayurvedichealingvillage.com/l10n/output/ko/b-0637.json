 "units": [
  {
   "id": "t_b6873c25216fdbc598da",
   "sourceHash": "b6873c25216fdbc598da7e4fa0d88e6d073aee376911c1588531d6e2387af05e",
   "text": "Kairali – The Ayurvedic Healing Village(케랄라)의 예방 및 재생 요법, 식단, 일과로 구성된 의사 지도 아래의 아유르베다 프로그램.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_be96f66e7d47950c9b27",
   "sourceHash": "be96f66e7d47950c9b2752f8a0493bf1e779a90dddd5f5e34adfecb963c4c46d",
   "text": "전통 아유르베다에 뿌리를 둔 Kairali – The Ayurvedic Healing Village의 재생 웰니스 치료는 도샤의 균형을 되찾고 전반적인 웰빙을 돕는 것을 목표로 합니다. 이 예방적 접근은 휴식, 활력 회복, 건강한 일상 습관에 중점을 둡니다. 매일의 Abhyangam (아비양감) 마사지와 기타 요법이 프로그램에 포함됩니다. 처방되는 채식 식단은 아유르베다 원칙에 따릅니다. 고요한 서고츠 산맥에서 요가 및 명상에 몰입하며 세상과 잠시 떨어져 내면의 자신과 다시 연결되어 보십시오. 바스투 샤스트라 원칙에 따라 설계되고 별자리에 따라 배정되는 객실이 치유 경험을 더욱 깊게 합니다. 이 리트리트는 평온한 분위기 속에서 회복과 활력을 북돋우는 충실한 체류를 제공합니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8ccdc5682edac1b41c3c",
   "sourceHash": "8ccdc5682edac1b41c3cffe414322ea0c6dfe0384604b5453bf074d1c1ce81c2",
   "text": "아유르베다 전통에 뿌리를 둔 재생 바디 디톡스 프로그램은 예방과 활력 회복을 결합하여 건강에 전인적으로 접근합니다. 예방적 케어는 도샤의 불균형을 파악하고 약초 처방, 식단 조정, 요가, 명상, 생활 습관 변화를 통해 균형을 유지하는 것입니다. 재생 요법에는 아유르베다 정화 요법과 담당 의사가 선택한 특수 약초가 포함됩니다. Abhyangam (아비양감), 시로다라(Shirodhara) 같은 아유르베다 마사지는 이완과 편안함을 위해 사용됩니다. 이 접근은 균형을 키우고 집에서도 이어갈 수 있는 자기 관리 습관을 길러 줍니다. 오랜 세월 검증된 아유르베다 원칙이 프로그램의 모든 단계를 이끕니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9f7ce5467a362afae721",
   "sourceHash": "9f7ce5467a362afae721856329838b79fbed182d1f3f83cf87ffe5db86c0df2c",
   "text": "예방 및 재생 아유르베다 요법은 일상 건강과 일상적 피로로부터의 회복을 돕는 데 중점을 둡니다. Kairali – The Ayurvedic Healing Village는 이 전인적 접근에 고대 아유르베다 실천과 현대적 웰니스 기법을 통합합니다. 과정을 단계별로 소개합니다:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f701cf2c2bb9a590c817",
   "sourceHash": "f701cf2c2bb9a590c817494baa96196f3a7b5b58187093f11202a2ddb6ead627",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]일상의 건강과 웰빙을 위한 의사의 지도에 따른 예방적 접근입니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3147eaa2f5e8809fa9b2",
   "sourceHash": "3147eaa2f5e8809fa9b293a4bc5dbcdd6047883de53daac38976b62ebd1c49a4",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]Abhyangam (아비양감) 등의 매일 요법은 휴식과 재충전을 돕도록 선택됩니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e366984596416688747b",
   "sourceHash": "e366984596416688747bf0d3a7750a2e93f0f375f00b6069682e5ce618f327d6",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]식단, 요가, 일과는 체질과 건강 목표에 맞춰 계획됩니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ec96ba2c68a8ef44cb69",
   "sourceHash": "ec96ba2c68a8ef44cb696e7bf27d123a1a3e3ad38423d23c906d74eac761983e",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]명상과 차분한 환경이 이완과 스트레스 관리를 돕습니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_84fcc230263bad33d60a",
   "sourceHash": "84fcc230263bad33d60ab2cd9bd087a75222d8ee0017e9cd2d8c958df4350087",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]아유르베다 전통에 뿌리를 두고, 집에서도 이어갈 수 있는 건강한 습관을 만들도록 돕습니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e505b18f9541413d7eed",
   "sourceHash": "e505b18f9541413d7eedd7f4aa194c7831a1faf1c390251e2fd1807299e19107",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]휴식과 활력 회복을 위한 의사의 지도에 따른 요법.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0e3dbcad7498de07513b",
   "sourceHash": "0e3dbcad7498de07513b7af85e42b63b4983507fd2334f194088a49132e56fe1",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]일상의 건강과 균형을 위한 예방적 접근.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f7f0eabee317dcf2de08",
   "sourceHash": "f7f0eabee317dcf2de08d1405ac6ab625b08ee23c92ab251d1e5f87f37bc90e7",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]이완 실천과 개인 맞춤 요법 계획.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_be50ade1f2cc0a75edff",
   "sourceHash": "be50ade1f2cc0a75edff71f6a4ffe4e1f60e0a118babbd89e1566c802318e358",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]집에서 이어갈 식단과 일과에 대한 아유르베다 지도.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b2e59e2fc4e43df8caf2",
   "sourceHash": "b2e59e2fc4e43df8caf261c2667f7588d3ef6d2cc1e46cb238419ac9030b010b",
   "text": "부비동 막힘과 두통에 대해 부드럽고 진정 효과가 있는 요법으로 제공하는, 의사의 지도에 따른 케어.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4a764af2a5f156dd6972",
   "sourceHash": "4a764af2a5f156dd697236d49488f19cfee55bce8378fc94e328eb2a26b2ca66",
   "text": "예방 및 재생 프로그램 – Swasthya Rakshana Chikitsa (스와스티야 락샤나 치키트사)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3721989fe05791c10c3f",
   "sourceHash": "3721989fe05791c10c3f66f8ea621b3595543b9b3d73c35facf7158be2958bd3",
   "text": "아유르베다 원칙에 기반한 맞춤 식단 계획이 준비됩니다. 참여자는 일상 건강을 위한 생활 습관도 배웁니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_92164e51fc450779e9f0",
   "sourceHash": "92164e51fc450779e9f01b1a3effc8d58ca72be171212b7d430c409906b8712b",
   "text": "재생 바디 디톡스 프로그램은 이완과 일상 스트레스 완화에 중점을 둡니다. 자체 제조한 허브 오일 요법(Abhyangam (아비양감))과 요가 수련 등이 포함됩니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7828a73246f3cbdfd7a4",
   "sourceHash": "7828a73246f3cbdfd7a473f02a31b30445511a66a9e6828059ecbdc62642f9fe",
   "text": "경과를 면밀히 모니터링하며, 변화하는 필요에 맞게 프로그램을 조정합니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
