   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ba2b19a627e65ed24092",
   "sourceHash": "ba2b19a627e65ed240929455f1d5b568311bf9c78cbef6997ffacb48e56fa206",
   "text": "[[OPEN_1]]◆[[CLOSE_1]]몸에 영양을 공급하고 수련을 돕는 건강한 아유르베다 식사.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
