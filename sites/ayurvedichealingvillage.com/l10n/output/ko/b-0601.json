   "sourceHash": "5dac0b47f5529b70e77633f3c54c99c155af11ff9185f5fd88a80f2765c3eccc",
   "text": "계속 둘러보기",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_289059b2179bfa35c24f",
   "sourceHash": "289059b2179bfa35c24fe5652c3d92eaffb388f594a9789e1b477824c37170aa",
