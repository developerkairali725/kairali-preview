   "unchangedReason": null,
   "issues": [
    "Patient testimonial with individual outcome claim (4kg in 7 days) translated faithfully without strengthening."
   ]
  },
  {
   "id": "t_4dcd3f42ce0b717dd856",
   "sourceHash": "4dcd3f42ce0b717dd85609018d469ffb39b00026185f309de3f03df8629ae724",
