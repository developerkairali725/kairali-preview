   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a555ad23aa5db5b8cf4b",
   "sourceHash": "a555ad23aa5db5b8cf4becc92cccf98a6bcda07878b3ee08aff3b434a5ef1724",
   "text": "스위트 식사 및 좌석 공간",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_42f2e4abe4f65e6af7ce",
   "sourceHash": "42f2e4abe4f65e6af7ce18f53da8d25e14f075d20b62be2286d03f78e6a7d329",
