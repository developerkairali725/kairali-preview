   ]
  },
  {
   "id": "t_a307d92ad6a33840c21f",
   "sourceHash": "a307d92ad6a33840c21f03a302ab9b27985ad05f49d94c2fc5bcff95395e9b7d",
   "text": "케랄라 가족 아유르베다 프로그램",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_485ccd83dd1e971e3ece",
   "sourceHash": "485ccd83dd1e971e3ecebe8efb033e76532795c022ee724f4f43a29279914885",
   "text": "케랄라 아유르베다 치료 패키지",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c72fd96271f86b085291",
   "sourceHash": "c72fd96271f86b085291f7a3cdfd4ac1a1f4d89b73b926d252723294f8c79ca2",
   "text": "케랄라 아유르베다 병원 및 해독 치료",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_55b56d6fb69a98862151",
   "sourceHash": "55b56d6fb69a98862151c3189115aaead63281e75a99f2ef1c5008ccdc4a8dec",
   "text": "아유르베다 통증 관리",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_29b3f347dd63da838769",
   "sourceHash": "29b3f347dd63da838769f8540725405e7e1a7ee489730d03949192e3838d1e55",
   "text": "케랄라 판차카르마 치료",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_00b33803b52886e0a35c",
   "sourceHash": "00b33803b52886e0a35c57a65badbc4ae22e37b9636d028364807f7f0adca3a4",
   "text": "예방적 활력 회복 및 해독",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fb7ffe1aa38aa712f3dd",
   "sourceHash": "fb7ffe1aa38aa712f3dde1ab1588989b06ed358e4073542794c99e924a7f534a",
   "text": "아유르베다 체중 감량",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0af907d49b0b27d78520",
   "sourceHash": "0af907d49b0b27d7852063407f3e0792346bec0ae48df827bb610fce0d5ca01c",
   "text": "케랄라 아유르베다 치유",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0501afc1bfa3295b817a",
   "sourceHash": "0501afc1bfa3295b817a9ca7e240717029a78d69e5717df69ba25934ddef9839",
   "text": "티루발라투르 사원",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4e26cf5069d7dc8c79d3",
   "sourceHash": "4e26cf5069d7dc8c79d32b981616f57841c48034b0f75284fc86b68873166b5d",
   "text": "목공예와 석조 조각으로 알려진 유서 깊은 바가바티 사원입니다. 지역 전승에 따르면 사원을 둘러싼 담장이 동이 트기 전까지 완성되지 못한 채 남겨졌다고 합니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_06e2a8c00bd84ef51198",
   "sourceHash": "06e2a8c00bd84ef51198460bbfe6fa87f1202679efd271ca73210fa1f96c33d9",
   "text": "사원 진입로",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c4025965966386aa65eb",
   "sourceHash": "c4025965966386aa65eb4a7728acef5e1ae9cbd6124ca2cf654f52935a3807c2",
   "text": "강변에 자리한 툰차트 에주타찬의 기념지입니다. 그가 말라얄람어로 다시 쓴 라마야나와 마하바라타는 이 언어의 문학 전통을 형성했습니다. 시인과 관련된 필사본과 유물이 이곳 유산의 일부를 이룹니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d47312a2ed00a7e57c70",
   "sourceHash": "d47312a2ed00a7e57c70b5a25667852962f9d1cf2ff752f84431d85daa4c22e6",
   "text": "구루마담 진입로",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_de693090534bcae6c8e0",
   "sourceHash": "de693090534bcae6c8e04bf404fb12cf3bf026c6f1665a4cb6f2ac1fb143489e",
   "text": "테나리 스리 라마 사원",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_341fea5342b384a2f41c",
   "sourceHash": "341fea5342b384a2f41c3bf409ba475d4d1be742b1a9023e8d7d97429ab5f66b",
   "text": "라마야나와 연관된 예배 장소로, 사원 옆에 신성한 샘이 있습니다. 이 샘물은 지역 전통에서 신성하게 여겨집니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ad958e0330118beadbac",
   "sourceHash": "ad958e0330118beadbac0381f4c5acf15b9c544d309df34cc6f959fd9d931a16",
   "text": "스리 라마 티르탐 진입로",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8f35973f837174763166",
   "sourceHash": "8f35973f837174763166fc6afe2a74838dc9553aae194831c6003cf3fbb9556f",
   "text": "팔라카드 요새 · 티푸 요새",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5dced69efb97ccdace22",
   "sourceHash": "5dced69efb97ccdace2214936c8b976a9206aa799164511720513dd7846dd244",
   "text": "1766년 하이더 알리가 건설한 이 보호 요새는 팔라카드에서 가장 잘 알려진 명소 중 하나입니다. 해자와 성벽, 부지를 통해 도시의 역사를 엿볼 수 있으며, 내부에는 안자네야 사당이 있습니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d4cd1e80fc9fd446e502",
   "sourceHash": "d4cd1e80fc9fd446e5026f3361b6a0e3221d6c72954935a3958c94ea50edd7a7",
   "text": "요새 도로 진입로, 입구까지 도보 이동",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
