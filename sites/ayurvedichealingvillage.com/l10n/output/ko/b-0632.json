   "issues": []
  },
  {
   "id": "t_605c751251e180c72c96",
   "sourceHash": "605c751251e180c72c9673a5b0c4db68f8ff969a29001bd3976a63539239cd80",
   "text": "한 환자의 활력 회복 및 해독 프로그램",
