 "units": [
  {
   "id": "t_1c9028ebdc616b81342d",
   "sourceHash": "1c9028ebdc616b81342db01ccde0f4d35e91836f28b5cd3a7b4afc121a68af79",
   "text": "생활 습관 및 식단 권고",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b031a5edc5b287ccbb8e",
   "sourceHash": "b031a5edc5b287ccbb8e1561789dc92e6be45ee6c9f46ea902fb7e2909155d74",
   "text": ": 환자에게 균형 잡힌 일과를 유지하고, 스트레스 관리 기법을 실천하며, 회복을 촉진하고 도샤의 균형을 맞추는 식단을 따르도록 안내합니다. 이는 치료 효과를 최적화하고 향후 불균형을 예방하는 데 도움이 됩니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f77bf08f572543fbef8b",
   "sourceHash": "f77bf08f572543fbef8be3f0e65ada82209d65a623580fab2dcbc45673f4cf2f",
   "text": "정기 추적 관찰",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2c8d9cd6efc795800283",
   "sourceHash": "2c8d9cd6efc79580028371dc92b215e38f618034ae20b4b90023a343b23e127c",
   "text": ": 아유르베다 의사와의 정기 추적 상담을 통해 경과를 확인하고, 필요에 따라 치료 계획을 조정하며, 지속적인 지원과 안내를 제공합니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_abb39230fb25aaf070c6",
   "sourceHash": "abb39230fb25aaf070c66922fd7d5a63e254863859c2375baab948b504a65a86",
   "text": "전인적 접근",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dd3f187e88c1c4711272",
   "sourceHash": "dd3f187e88c1c4711272a48df89d5ba5bd50b2e433ab91c52acbb5d50f1a7bb3",
   "text": ": 아유르베다는 몸과 마음의 연결을 중시하므로, 전반적인 웰빙을 증진하고 회복 과정을 돕기 위해 명상, 호흡 수련(프라나야마, pranayama), 요가 등의 수련이 치료에 포함될 수도 있습니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_42400299f5121f329956",
   "sourceHash": "42400299f5121f32995631cb7d48c79531fb246258f351f99bcf5c5cf7e9109c",
