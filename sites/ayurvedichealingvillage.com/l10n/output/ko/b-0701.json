   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f728638ead24cb2dcc4e",
   "sourceHash": "f728638ead24cb2dcc4e7ee9cf16c3a365e625b727cc6f4ebdc1b5ded40b47b9",
   "text": "하루 일과",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9f1652cd3deb8ec198e5",
   "sourceHash": "9f1652cd3deb8ec198e50c92b3ca808a21f2700ea0e75325e0ec589b212cf5c3",
   "text": "몸을 다시 리듬으로 되돌리도록 구성된 하루.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8404ef7ccec418e7d3f7",
   "sourceHash": "8404ef7ccec418e7d3f7ee4cea0c414c4b6ba75f4eef1fa678709150ac0d9a65",
