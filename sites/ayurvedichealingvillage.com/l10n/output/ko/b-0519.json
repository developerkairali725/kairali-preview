 "units": [
  {
   "id": "t_535d423203c8ffb01cda",
   "sourceHash": "535d423203c8ffb01cda7635db2ad98f6f16e93d02861363930dc84943051107",
   "text": "금연 환경의 중요성",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dd5bd389fe0de61ae212",
   "sourceHash": "dd5bd389fe0de61ae212e09293004c0860f1d6313ca0c0a1c748b73f816a3a4b",
   "text": "금연 정책은 Kairali의 고요하고 건강 중심적인 분위기를 유지하는 데 필수적입니다. 흡연은 몸에 독소를 들여오고, 자연스러운 균형(",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_745f1c6a2f85d5c5dd30",
   "sourceHash": "745f1c6a2f85d5c5dd301aaa8bba90f0ac93739f922cf2c3bd1a1d6f648b019a",
   "text": "흡연을 하지 않으면 면역 체계가 강화되고 호흡기 건강이 개선되며 정신적 명료함이 높아집니다. 이는 몸, 마음, 영혼 사이의 균형과 조화를 중시하는 아유르베다 철학과 일치합니다. 니코틴과 같은 해로운 물질에 대한 노출을 없애면 몸은 자연스러운 리듬과 활력을 되찾을 수 있습니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2aadf4f823a05241be35",
   "sourceHash": "2aadf4f823a05241be357a74e0b156bfac67c5942aeb39494e61673a7b7743c0",
   "text": "Kairali의 치유에서 자연이 하는 역할",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ac314d4f211c21c20e9f",
   "sourceHash": "ac314d4f211c21c20e9f31577bb1845db4ec93c45eb1f613615b62b0e6fb8771",
   "text": "아유르베다 원칙과 흡연의 해로운 영향",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5c7122b7a5c8700a2ae3",
   "sourceHash": "5c7122b7a5c8700a2ae3f95bfe5f34eabf0b12b2896f3ae0206b802653c859dd",
   "text": "아유르베다 원칙에 따라 Kairali는 흡연이 몸과 마음에 미치는 부정적인 영향을 인식하고 있습니다. 흡연은 도샤를 악화시켜 신체적·정신적 건강 문제로 나타나는 불균형을 일으킵니다. 또한 흡연은 의존성을 만들어 정신적 명료함을 떨어뜨리고 무기력의 원인이 됩니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_033fd1cb0e93341e84e6",
   "sourceHash": "033fd1cb0e93341e84e63a00c5b161e3bff2cc1b7fa1c3b96c7da49479650d3e",
   "text": "금연 환경이 지닌 변화의 힘",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Retreat' rendered as 환경 (setting) per the clinical register."
   ]
  }
 ]
}
