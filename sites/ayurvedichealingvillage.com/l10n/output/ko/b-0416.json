   "sourceHash": "d445d1bb869f810b2d2fa9d244752b661fc1cfef82f9f0b84afed3f5da2484a0",
   "text": "아유르베다 입문",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
