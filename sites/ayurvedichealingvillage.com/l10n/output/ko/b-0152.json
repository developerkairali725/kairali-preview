 "units": [
  {
   "id": "t_0920cfc599b3dc1c4e75",
   "sourceHash": "0920cfc599b3dc1c4e75a501f0711a809a367ddcc9b381a97df99063863a7231",
   "text": "프리미엄 아유르베다 치료",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_49c64df771c7ecf2476c",
   "sourceHash": "49c64df771c7ecf2476cb23fd3db41500fdf663b91766e897c587876dd785369",
   "text": ": 잘 알려진 저희 치유 시설에서는 판차카르마(Panchakarma) 해독과 전문 피부 치료를 포함하여 정통적이고 품질 높은 아유르베다 치료를 제공합니다. 숙련된 치료사가 평온한 치유 환경에서 이러한 치료를 시행합니다.",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'retreat' rendered as '치유 시설' (healing facility) to keep the clinical register."
   ]
  },
  {
   "id": "t_0798f8bd3606bf44994a",
   "sourceHash": "0798f8bd3606bf44994a17a68018434b8cab6d999233c8a5ce3b688cf5ba614d",
