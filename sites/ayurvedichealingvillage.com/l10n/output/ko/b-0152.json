   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_49367ec37064b26db9a6",
   "sourceHash": "49367ec37064b26db9a66930be4fb482bdabf2bf456229effea3cda63a10e737",
