   "sourceHash": "ce239b0bfaa8936f4909daf95101e2176a099ffc9d506cee6c0b13d42cc9ba3c",
   "text": "디야나(명상):",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d56d975f3c644bed0621",
   "sourceHash": "d56d975f3c644bed062140f5501ee78671b85dc33694659c038311da1e09b023",
