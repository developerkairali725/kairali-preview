   "sourceHash": "619a17032b4b555b8dcdbd1f51f33cf3cdb1f060a8e8f027bdcb7958af3feda9",
   "text": "왜 Kairali에서 요가를 시작해야 할까요?",
   "status": "translated",
   "unchangedReason": null,
