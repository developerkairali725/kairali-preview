   "sourceHash": "95bb81ce5c135af0dc7d1516b56b3700d307718dbce9f91eaaf249a9503b6327",
   "text": "정통 치료",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_22d1241bd57c6c75e312",
   "sourceHash": "22d1241bd57c6c75e312adb05e0884884314fed692d819dac3c73e20afd2222c",
   "text": ": 전통 아유르베다의 지혜에 뿌리를 둔 요법을 경험해 보십시오.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
