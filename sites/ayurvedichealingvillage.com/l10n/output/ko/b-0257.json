  {
   "id": "t_4df610c9e5383a60c750",
   "sourceHash": "4df610c9e5383a60c7501bf925888dfec343e9fb8340dd1205e11c3658091509",
   "text": "홈 – 아유르베다 오퍼",
   "status": "translated",
