   "sourceHash": "34c7fccac0b09ba8591ae7dc2e714905ee7a162eb222db052f8d0c2003a082c6",
   "text": "Kairali에서 도로 기준",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d00003f1ce9f0c1d8708",
   "sourceHash": "d00003f1ce9f0c1d87082459d16b6631a502c0ef864fbac97d4ee73177ae56c4",
