   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4c07f3c2d02fb71c3aab",
   "sourceHash": "4c07f3c2d02fb71c3aabffd2493e61b8c3afef93a508e20b8b94d951318227f8",
   "text": "Veja a história da Kairali, o yoga na Healing Village e curtos filmes sobre terapias ayurvédicas, moradias e a vida na aldeia. Explore pré-visualizações reais dos vídeos e as respetivas durações.",
   "status": "translated",
