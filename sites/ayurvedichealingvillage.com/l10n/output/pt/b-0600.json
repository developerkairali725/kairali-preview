   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6a71f6245786b01b208e",
   "sourceHash": "6a71f6245786b01b208e9d653e2de01128cb5f5c2757e2709fcbea5f2e854513",
   "text": "Está a planear uma saída durante a sua estadia? Fale com a receção sobre o transporte e sobre como conciliá-la com as suas marcações.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
