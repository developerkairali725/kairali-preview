   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a296108b52f3ecaccacd",
   "sourceHash": "a296108b52f3ecaccacd475608f4893604c0458bf282a6d607b67b88aad881d2",
   "text": "Incluído: Uma terapia ayurvédica por dia, incluindo vapor de ervas quando indicado",
