   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_38fcc44adb59326fa749",
   "sourceHash": "38fcc44adb59326fa7497a1bdb86f91830bf4e25593569c4f3a692b05dcbcc01",
