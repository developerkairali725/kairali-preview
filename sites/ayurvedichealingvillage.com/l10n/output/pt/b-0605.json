   "sourceHash": "7944b6e97c884f32802b00654a79260a8fa7c9f55dfe4577c55d478f9debd7a0",
   "text": "Fale diretamente com a nossa equipe",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ecb8194fc0a13dc5c62b",
   "sourceHash": "ecb8194fc0a13dc5c62bd88291b1e7e46606950ac4e62919e5d46b1b3cd6458e",
