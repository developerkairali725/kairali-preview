   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_56b530e545091e823252",
   "sourceHash": "56b530e545091e82325240eb867dffe02886e81537214ff822e9a7b368a4f3e1",
   "text": "Diga-nos o que tornou a sua estadia especial, o que poderia ter sido melhor ou o que gostaria que corrigíssemos. Agradeça a um membro da equipe, partilhe uma sugestão ou manifeste uma preocupação — valorizamos o seu relato sincero.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d1afdda0fcf21ab32344",
   "sourceHash": "d1afdda0fcf21ab323443c2ac3873e8ac8244f9415f529d0174884bacfb973e3",
