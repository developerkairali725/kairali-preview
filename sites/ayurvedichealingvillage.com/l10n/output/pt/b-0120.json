   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_51e27aa59d2206645cd3",
   "sourceHash": "51e27aa59d2206645cd34032748e231ae22d87040f72d5640ac35d83c4b63e72",
   "text": ": os especialistas em Ayurveda realizam uma avaliação detalhada para determinar a causa, o tipo e a gravidade da paralisia. Com base nela, é elaborado um plano de tratamento personalizado.",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
