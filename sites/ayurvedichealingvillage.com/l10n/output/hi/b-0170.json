 "units": [
  {
   "id": "t_748c5ef297155e398440",
   "sourceHash": "748c5ef297155e3984403f84f009940d0c143b874de7a6ea9217cd8874bd2fcf",
   "text": "यदि मुझे कोई शारीरिक सीमा या चोट है, तो क्या मैं भाग ले सकता/सकती हूँ?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fa7d7680e7eb33e57352",
   "sourceHash": "fa7d7680e7eb33e57352b78cad0f5a2b768bf6fb72bce33560202e6cd7e0fa12",
   "text": "हमारे प्रशिक्षक व्यक्तिगत सीमाओं या चोटों के आधार पर अभ्यास में बदलाव सुझा सकते हैं। कृपया भाग लेने से पहले अपनी स्वास्थ्य संबंधी प्रासंगिक जानकारी साझा करें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9d2fe270c91696f02d5b",
   "sourceHash": "9d2fe270c91696f02d5bb5e5d7f1e5446aa067073149e984617ba575108a9e72",
   "text": "किन योग शैलियों को शामिल किया गया है?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d29e488bbfef33a5583b",
   "sourceHash": "d29e488bbfef33a5583b321ef96aaf4e60c0e2889d063642ed20ae3af895575c",
   "text": "हम हठ और विन्यास सहित कई योग शैलियाँ प्रदान करते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_cfbe7d40c57c14ca4d89",
   "sourceHash": "cfbe7d40c57c14ca4d89b7740c0ad1c21be2a479a152b2727cf788f50e7fce4c",
   "text": "यदि मैंने पहले कभी ध्यान नहीं किया है, तो क्या होगा?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8675cd6386ca14ae2f0c",
   "sourceHash": "8675cd6386ca14ae2f0c0e5e8731a7f088fb30c119d72ba3d542156329783abc",
   "text": "हमारे ध्यान सत्र शुरुआती लोगों के लिए उपयुक्त हैं। मार्गदर्शक प्रोग्राम में प्रयुक्त तकनीकों से आपका परिचय कराते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_db35433de9227afb9221",
   "sourceHash": "db35433de9227afb9221e80e8f520749d640e4dfa825865808515b0434d4967f",
   "text": "Kairali योग हॉल में हरे कुर्ते में एक मरीज़ टील रंग की चटाई पर पालथी मारकर ध्यान में बैठी हैं, आँखें बंद हैं और हाथ घुटनों पर टिके हैं",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6acab8c57e509daeef76",
   "sourceHash": "6acab8c57e509daeef7620d41ae6b186f928e094125f6256fb589a92ca0b7433",
   "text": "योग हॉल के शीशे के दरवाज़ों और सफ़ेद रेलिंग के सामने, हरे कुर्ते में एक मरीज़ टील रंग की चटाई पर लो क्रेसेंट लंज मुद्रा में, एक हाथ ऊपर उठाए हुए",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_28bb3540aa73e68246f0",
   "sourceHash": "28bb3540aa73e68246f0629414a635cc7f9e4c9c311134cd82a4b871ff16ee81",
   "text": "Kairali योग हॉल में हरे कुर्ते में एक मरीज़ टील रंग की चटाई पर घुटने टेककर लंज मुद्रा में, हाथ ऊपर उठाकर हथेलियाँ सिर के ऊपर जोड़े हुए, ऊपर की ओर देखती हुई",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a0b04904eaab67b659fb",
   "sourceHash": "a0b04904eaab67b659fb21c3312f89eabeef897c5942ec8c48d86bd019221cf5",
   "text": "Worlds Luxury Spa Awards विजेता 2024",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Award title kept verbatim (contains 'Luxury'/'Spa' as part of a proper name); only 'Winner' translated."
   ]
  },
  {
   "id": "t_60e1aed948aa76612184",
   "sourceHash": "60e1aed948aa766121842aaa39981ac124622162303fc9b81370dedc084f9e1f",
   "text": "Worlds Luxury Hotel Awards 2024",
   "status": "translated",
   "unchangedReason": "Award title is a proper name and stays verbatim.",
   "issues": [
    "Award title contains 'Luxury' as part of a proper name; kept verbatim."
   ]
  },
  {
   "id": "t_bba6b745144e536d4cc7",
   "sourceHash": "bba6b745144e536d4cc7e542c223227f5a187cc071a8460dc4c2791abcd2f828",
   "text": "Kairali Ayurvedic Group के प्रबंध निदेशक के.वी. रमेश को 2019 में CONSIDICI राष्ट्रीय पुरस्कार से सम्मानित किया गया।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ed07e850107d4debe48e",
   "sourceHash": "ed07e850107d4debe48e7f3d5fad04855bf55a854f2b6fd57f237ac00e2694eb",
   "text": "योग कक्षाएँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8aec5f233df477e4af53",
   "sourceHash": "8aec5f233df477e4af53c682a679700833b8409df02a976bcfcb556d14505f41",
   "text": ": सत्रों में हठ और विन्यास शैलियाँ शामिल हैं और इन्हें अनुभव के विभिन्न स्तरों के अनुसार ढाला जाता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_78879b429abb9a0fbbf4",
   "sourceHash": "78879b429abb9a0fbbf4bc6fe52c763c2bed6d5c6d847ba5057a73c0193e3d3c",
   "text": "ध्यान सत्र",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a9333f127e6eadb620c4",
   "sourceHash": "a9333f127e6eadb620c446168c8dc6fefe5a5e0a852edc3a7c3af19b8d5a854e",
   "text": ": मार्गदर्शक माइंडफुलनेस, श्वास-जागरूकता और मंत्र ध्यान की तकनीकें सिखाते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_01e2de292f77a9fca0e3",
   "sourceHash": "01e2de292f77a9fca0e3e78f5d2776878a1b783928d7ac660cd314a63bc55b5b",
   "text": "आयुर्वेदिक परामर्श",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fe56be42730ac79c6257",
   "sourceHash": "fe56be42730ac79c62576f4f23e78b982431a1ad62b76e17728c40a96129e75b",
   "text": ": आपकी प्रकृति और लक्ष्यों को समझने के लिए एक आयुर्वेदिक चिकित्सक के साथ परामर्श।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a53e807997872e1cf2dc",
   "sourceHash": "a53e807997872e1cf2dcf5d0b96c30b4fccc98d00769c16d1e2a3492acea7da5",
   "text": "दैनिक और ऋतु-अनुसार दिनचर्या",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_738a0fa7b2e70bc00d07",
   "sourceHash": "738a0fa7b2e70bc00d07870edd25f0dd0a555193d9e94cd9e4a1ff75da74135a",
   "text": ": इनमें आयुर्वेदिक आहार संबंधी सुझाव, दैनिक दिनचर्या (दिनचर्या) और ऋतु-अनुसार अभ्यास (ऋतुचर्या) शामिल हो सकते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_379f0eed8acd93344e68",
   "sourceHash": "379f0eed8acd93344e68a59b971b31f3eaa81cd07e18670efaa3592bda4db475",
   "text": ": अभ्यास के साथ-साथ अभ्यंग और शिरोधारा जैसी आयुर्वेदिक मालिश भी प्रदान की जाती हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_880c95473eeb40219f63",
   "sourceHash": "880c95473eeb40219f6321ddb7c5c48655f66c63119e4a325a21e314920043ef",
   "text": ": प्रोग्राम की समीक्षा के लिए फ़ॉलो-अप सत्र निर्धारित किए जा सकते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f49b31c1e01e4fbff928",
   "sourceHash": "f49b31c1e01e4fbff928851f6cf5af976820011f44a39979d0e4f16afdab06fd",
   "text": "आयुर्वेद की मूल अवधारणाओं को गहराई से जानें। तीन दोषों और पाँच तत्वों को समझें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b8140dff5a6911648c65",
   "sourceHash": "b8140dff5a6911648c6587bfb35d9f4e3485950ec650c6bcfc6b9bd6472e3444",
   "text": "हमारे विशेषज्ञ शेफ़ के साथ आयुर्वेदिक पाक-कला सीखें। पारंपरिक मसालों और पकाने की विधियों से पौष्टिक भोजन तैयार करना सीखें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
