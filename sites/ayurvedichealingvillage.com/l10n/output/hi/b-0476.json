{
 "batchId": "b-0476",
 "sourceSetHash": "c3b8c158d4caa339babc486319799314d9dd543b3b0ab3beca6c2ec79ad0875d",
 "locale": "hi",
 "units": [
  {
   "id": "t_8c8812b2af277d1f82c8",
   "sourceHash": "8c8812b2af277d1f82c8b18d041da08f823f8b0863d720142f0d0f9c65ea797e",
   "text": ": अनुभवी प्रकृतिविदों और गाइडों के साथ केरल के वन्यजीव अभयारण्यों और राष्ट्रीय उद्यानों को देखें, जो आपको क्षेत्र के पारिस्थितिक तंत्रों की गहरी जानकारी देते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c595ea8058fe945ba2e0",
   "sourceHash": "c595ea8058fe945ba2e0b2408bd42c7911f51f7adbc9da13cf03db6ac14b85f0",
   "text": "गाइड के साथ भ्रमण: अनुभवी प्रकृतिविदों और गाइडों के साथ केरल के वन्यजीव अभयारण्यों और राष्ट्रीय उद्यानों को देखें, जो आपको क्षेत्र के पारिस्थितिक तंत्रों की गहरी जानकारी देते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3a4d3a864e5a13a6ee54",
   "sourceHash": "3a4d3a864e5a13a6ee54f37a9266d9e80624169a102a76be7576e7191cb82f42",
   "text": "पर्यावरण-अनुकूल दृष्टिकोण",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f0acaffddecab412f152",
   "sourceHash": "f0acaffddecab412f152bb5bca4e2131db6a108dee0553de27cfd8b5123accd6",
   "text": ": हम टिकाऊ तरीकों को प्राथमिकता देते हैं, ताकि आपके भ्रमण के दौरान पर्यावरण पर न्यूनतम प्रभाव पड़े।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_94738dba6afa842d4180",
   "sourceHash": "94738dba6afa842d41808b1611f39a3ada0c7db61244508b5e4992ffcafd243b",
   "text": "पर्यावरण-अनुकूल दृष्टिकोण: हम टिकाऊ तरीकों को प्राथमिकता देते हैं, ताकि आपके भ्रमण के दौरान पर्यावरण पर न्यूनतम प्रभाव पड़े।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_849379b9dd7d47ed4c35",
   "sourceHash": "849379b9dd7d47ed4c353a1de1a059927dbc8f0d4eab00b7222394c0e6430d40",
   "text": "आपकी रुचि के अनुसार कार्यक्रम",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b6c5ba7802a8f593e71e",
   "sourceHash": "b6c5ba7802a8f593e71e6ff2e890d39f8359658b4e510820d66a7ec78326cc4e",
   "text": ": अपनी रुचि के अनुसार चुने गए पैकेजों में से चुनें — चाहे पक्षी-दर्शन हो, वन्यजीव फ़ोटोग्राफ़ी हो, या बस प्रकृति के सौंदर्य का आनंद लेना।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a406c14757e60a8357b4",
   "sourceHash": "a406c14757e60a8357b41ede99de378d0a660141d0c16c2a5343897d85b63d6e",
   "text": "आपकी रुचि के अनुसार कार्यक्रम: अपनी रुचि के अनुसार चुने गए पैकेजों में से चुनें — चाहे पक्षी-दर्शन हो, वन्यजीव फ़ोटोग्राफ़ी हो, या बस प्रकृति के सौंदर्य का आनंद लेना।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_87676043387a636e7bf2",
   "sourceHash": "87676043387a636e7bf2ef8f6ef7aada817881c9a25f70e65b8794c707d1ff05",
   "text": "परिवार के लिए उपयुक्त अनुभव",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_324abd04eea502b78ff2",
   "sourceHash": "324abd04eea502b78ff239cc34c1bc2d7b53694a6a8bd9731afe567d4ca86886",
   "text": ": वाइल्डलाइफ ड्राइव सभी आयु वर्गों के लिए उपयुक्त है, जो इसे परिवारों के लिए साथ समय बिताने की एक सुंदर गतिविधि बनाती है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_afc63a18e4c286bd8820",
   "sourceHash": "afc63a18e4c286bd882053eb4f345a94c8740e0b5f9920b42983678f044bc08b",
   "text": "परिवार के लिए उपयुक्त अनुभव: वाइल्डलाइफ ड्राइव सभी आयु वर्गों के लिए उपयुक्त है, जो इसे परिवारों के लिए साथ समय बिताने की एक सुंदर गतिविधि बनाती है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_08d0b841d3e6cca14192",
   "sourceHash": "08d0b841d3e6cca14192eb037d82be6220df13f8feaf7aa468843dee394e2499",
   "text": "अपने रोमांच के साथ स्वास्थ्य देखभाल भी जोड़ें",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5c4e98f30d4b23ccca19",
   "sourceHash": "5c4e98f30d4b23ccca197bae35746b6d57fb8452b684fa9c96d83225b372003e",
   "text": "वन्य क्षेत्रों में एक दिन बिताने के बाद, विश्राम और नई ऊर्जा के लिए हीलिंग विलेज के शांत वातावरण में लौटें। अपने रोमांच के साथ इन्हें भी जोड़ें:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_30b2776f71b02f8ce924",
   "sourceHash": "30b2776f71b02f8ce92432f59c5b03130c5d0a9ee3d3148174eb7eb4575aae6e",
   "text": ": Abhyangam (अभ्यंगम) और शिरोधारा जैसे उपचारों से अपने शरीर और मन को सुकून दें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_925a709ba72673bac855",
   "sourceHash": "925a709ba72673bac8555edaad1032db7763e7249a74d4d3a12c208c669d16b6",
   "text": "आयुर्वेदिक थेरेपी: Abhyangam (अभ्यंगम) और शिरोधारा जैसे उपचारों से अपने शरीर और मन को सुकून दें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e536fc9c400db5c58f0c",
   "sourceHash": "e536fc9c400db5c58f0c893220aa10d9e2a9b2e0f86e3b323f65a223f6e06a81",
   "text": ": प्रकृति के बीच शांतिदायक योग सत्रों के माध्यम से अपने अंतर्मन से फिर से जुड़ें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8bd9ebf09d2d02272a2a",
   "sourceHash": "8bd9ebf09d2d02272a2ad2780015580248cf54e968ab4b0cac44a577601693f7",
   "text": "योग और ध्यान: प्रकृति के बीच शांतिदायक योग सत्रों के माध्यम से अपने अंतर्मन से फिर से जुड़ें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ca9be9e412a0273b3865",
   "sourceHash": "ca9be9e412a0273b38651a0f74e308291bbeb2615f83ed10393da1f550d78478",
   "text": "स्वास्थ्यवर्धक भोजन",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8fbb346b2c34bb82a080",
   "sourceHash": "8fbb346b2c34bb82a080eb65998b88363aa2765c0d4f3966482b178397052adc",
   "text": ": जैविक, आयुर्वेदिक भोजन का आनंद लें, जो आपके शरीर को पोषण देता है और आगे के रोमांच के लिए आपकी ऊर्जा बढ़ाता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7f9779975a2153aa327f",
   "sourceHash": "7f9779975a2153aa327fa172ef274c048954aacaac3c09d02ce4fc9f1010162d",
   "text": "स्वास्थ्यवर्धक भोजन: जैविक, आयुर्वेदिक भोजन का आनंद लें, जो आपके शरीर को पोषण देता है और आगे के रोमांच के लिए आपकी ऊर्जा बढ़ाता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_94182c826b4d3a2688b6",
   "sourceHash": "94182c826b4d3a2688b659d004bf7a66354c19d6251a4541fc9480bd68b671b7",
   "text": "वाइल्डलाइफ ड्राइव अनुभव के लाभ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5e0d4e8715a5d5b573c4",
   "sourceHash": "5e0d4e8715a5d5b573c4b965b0ab357a96e26d76d4a647322c7349a185e0524a",
   "text": "प्रकृति से फिर से जुड़ें",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_64d62623acdc17da2733",
   "sourceHash": "64d62623acdc17da27339173894c32f55de5a12ace09b283a27d46cf0418fe3f",
   "text": ": दैनिक जीवन की भागदौड़ से दूर होकर केरल के अछूते वन्य परिवेश में डूब जाएँ।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1ff20bf0daee64eabf4b",
   "sourceHash": "1ff20bf0daee64eabf4bbe4af9fbb676c81a0baf5e75619da4282a7c782850d9",
   "text": "प्रकृति से फिर से जुड़ें: दैनिक जीवन की भागदौड़ से दूर होकर केरल के अछूते वन्य परिवेश में डूब जाएँ।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_57dbf12d09b0ef92fbad",
   "sourceHash": "57dbf12d09b0ef92fbad5fbb390cbc2b2e7430d43eb34db83bc86bfa99ae988e",
   "text": "सीखें और खोजें",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
