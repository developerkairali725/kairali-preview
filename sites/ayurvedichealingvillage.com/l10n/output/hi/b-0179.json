   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_443c7e0d74be53e2dd6a",
   "sourceHash": "443c7e0d74be53e2dd6a08888f062d4916a45e40d6aa9b38e6ec84063eff8fb0",
   "text": "80 किमी",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0dc589429b8e760b3f80",
   "sourceHash": "0dc589429b8e760b3f804d4c2dade23700de93d580f9cffa65b2506d980c70b4",
   "text": "अट्टप्पाडी पश्चिमी घाट की नीलगिरि पहाड़ियों के नीचे, भवानी नदी के उद्गम क्षेत्र के पास स्थित एक विशाल पर्वतीय घाटी है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
