 "units": [
  {
   "id": "t_8db2d065506ff2fb43ba",
   "sourceHash": "8db2d065506ff2fb43ba5b16fdf192279eaacb50d0d0911024e4c4947fa93fdb",
   "text": "[[OPEN_1]]ग्रीष्म (मार्च–मई)[[CLOSE_1]] — 28–38°C; गर्म, धूप वाले दिन, पित्त-शामक उपचारों के लिए उपयुक्त",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_188594a7c0ace982d4e8",
   "sourceHash": "188594a7c0ace982d4e897fcbf1754f595cdc8baa98dfed8e61830037faedcdc",
   "text": "[[OPEN_1]]मानसून (जून–सितंबर)[[CLOSE_1]] — 23–32°C; नियमित वर्षा, गहन पंचकर्म के लिए पारंपरिक ऋतु",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c480c9b9b15541d7b07a",
   "sourceHash": "c480c9b9b15541d7b07a1e7c4b2e8f5e889fdcea00f9e12398c9ab1a8fab8b0c",
   "text": "[[OPEN_1]]मानसून के बाद/शरद (अक्टूबर–नवंबर)[[CLOSE_1]] — 24–32°C; सुहावना मौसम, कायाकल्प थेरेपी के लिए उपयुक्त",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9ef9a8ee7593a189b8ae",
   "sourceHash": "9ef9a8ee7593a189b8ae480ebeb764986735a49dfbeb7016fe7c0b9b5fe4b386",
   "text": "[[OPEN_1]]शीत (दिसंबर–फ़रवरी)[[CLOSE_1]] — 20–30°C; हल्के गर्म दिन और ठंडी शामें, वात-संतुलन थेरेपी के लिए उपयुक्त",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4c3a83ff514f6d038770",
   "sourceHash": "4c3a83ff514f6d038770ca52b0d0f4017229bc97314910e90bbc384dfab95843",
   "text": "विशिष्ट उपचारों के लिए आने का सबसे अच्छा समय कब है?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9de993d07404fde745a0",
   "sourceHash": "9de993d07404fde745a020753cb5ebc91b05cea8646b2d830ac6ab68658653e2",
   "text": "हालाँकि उपचार पूरे वर्ष लाभदायक होते हैं, पारंपरिक रूप से मानसून (जून–सितंबर) गहन पंचकर्म और विषहरण के लिए सबसे अच्छा माना जाता है, शीत ऋतु (दिसंबर–फ़रवरी) कायाकल्प और रोग-प्रतिरोधक क्षमता प्रोग्रामों के लिए उपयुक्त है, और ग्रीष्म ऋतु (मार्च–मई) पित्त-शामक और तनाव-प्रबंधन उपचारों के लिए उपयुक्त है। हमारे चिकित्सक आपकी स्थिति के लिए सबसे उपयुक्त समय के बारे में सलाह देते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0f4a05cc648c393f1b82",
   "sourceHash": "0f4a05cc648c393f1b82c0d41bfe28e87ea20aaa9766fd9f2381908eae4dd6ad",
   "text": "तैयारी और सामान",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0aa49437e3db1389ed9e",
   "sourceHash": "0aa49437e3db1389ed9e932768a042ab8455bd257ab49af594cddf8242785339",
   "text": "Kairali में अपने प्रवास के लिए मुझे क्या सामान लाना चाहिए?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8a20293bd9dabdb482b9",
   "sourceHash": "8a20293bd9dabdb482b902627406f185fdea1c5fec736429f0c4e405cc8e7eef",
   "text": "आवश्यक वस्तुएँ:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e274c93f5512ec7ec94d",
   "sourceHash": "e274c93f5512ec7ec94db29512bc1b7e7486ed5a973a2ff1f07cc5b340ff83dd",
   "text": "आरामदायक, ढीले-ढाले सूती कपड़े",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_78d93b5a48f17dfb2e10",
   "sourceHash": "78d93b5a48f17dfb2e10cf66bc9dea9be86651d9eb7c8e93e06c17e5ccfd5b56",
   "text": "शाम के लिए हल्की शॉल या स्वेटर (विशेषकर दिसंबर-फ़रवरी में)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e1bf64d485f6e475f368",
   "sourceHash": "e1bf64d485f6e475f3683c2d0607583b359e791ca40071cb003cb1ec25480f0f",
   "text": "पूल के लिए शालीन स्विमवियर",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e9e605629bae3a12fc08",
   "sourceHash": "e9e605629bae3a12fc08bb02a85e6a94a226b6e56220de3f426dc340e232a5ce",
   "text": "प्राकृतिक पगडंडियों पर चलने के लिए जूते",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f2f4686507c4d9fc6881",
   "sourceHash": "f2f4686507c4d9fc688141cbd15f00fc16443d7592bc6b81a844f12768079b72",
   "text": "निजी प्रसाधन सामग्री (बुनियादी सुविधाएँ हम प्रदान करते हैं)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2ccddfcd0311b2cd354c",
   "sourceHash": "2ccddfcd0311b2cd354c19dffa8bb742870f2df67c4315d6661d941210c9c5e4",
   "text": "आपके द्वारा नियमित रूप से ली जाने वाली दवाइयाँ और सप्लीमेंट",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_19835d1fcfd457b190c5",
   "sourceHash": "19835d1fcfd457b190c5d404ff497e95458b7612b5a77c5c08c0364b3b869618",
   "text": "प्रवास के दौरान अपने विचार लिखने के लिए एक डायरी",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2a80fda2705175c91fae",
   "sourceHash": "2a80fda2705175c91fae4964e9318d68c82cef898fcf899a32f635400062a025",
   "text": "उपचार और योग के लिए:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1d43157a46c0880b8d86",
   "sourceHash": "1d43157a46c0880b8d8608c603c5521ede6061c8cf50820bf28cf593838cf4c2",
   "text": "ढीले, सूती कपड़ों के अतिरिक्त सेट (उपचारों में तेल का उपयोग होता है)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_703decae9f89c08091d5",
   "sourceHash": "703decae9f89c08091d51c776fec64d761889932e4f73372a6ec9df961ec0826",
   "text": "ध्यान के लिए हल्का सूती दुपट्टा",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_099686da260dd0c3bc17",
   "sourceHash": "099686da260dd0c3bc175c6987231ff7f7a19f9b12ef2002853880829fa148aa",
   "text": "उपचार के लिए कौन-से कपड़े उपयुक्त हैं?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_44e6a53b8e553cafda1a",
   "sourceHash": "44e6a53b8e553cafda1a088d97b4257bbf3426f62e9c7641645c18e754a44cdf",
   "text": "हल्के, ढीले-ढाले सूती कपड़े पहनें जिन्हें आसानी से धोया जा सके। उपचार के लिए हम डिस्पोज़ेबल लंगोट और बाथरोब प्रदान करते हैं। तेल उपचारों से कपड़ों पर दाग लग सकते हैं, इसलिए ऐसे कपड़े लाएँ जिन पर तेल लगने से आपको आपत्ति न हो।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_467be19731e4fee1a14f",
   "sourceHash": "467be19731e4fee1a14fcee8b664e3a9a9704c67372a3e0b20b5bba04b64cc5e",
   "text": "क्या लॉन्ड्री की सुविधा उपलब्ध है?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2d69b10c86fed2ae3755",
   "sourceHash": "2d69b10c86fed2ae3755234b36443a5ab2ba4b01b764dcd282cb99c207ff2acd",
   "text": "हाँ, हम अतिरिक्त शुल्क पर लॉन्ड्री सेवा प्रदान करते हैं। कपड़े आमतौर पर 24 घंटे में लौटा दिए जाते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7ee9bf880e998420761e",
   "sourceHash": "7ee9bf880e998420761ef7e495dcf8b27232613eb12ef15914b7ed8f26f36850",
   "text": "क्या कोई ड्रेस कोड है, और महिलाओं को उपचार के लिए क्या लाना चाहिए?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_257da94cf1fb4939cba0",
   "sourceHash": "257da94cf1fb4939cba0db04f6543f5eaf7fdb6f05c6f8c8748825a6a2af99a9",
   "text": "पूरे प्रवास के दौरान ढीले-ढाले सूती कपड़े पहनने की सलाह दी जाती है; पूल के लिए शालीन स्विमसूट उपयुक्त है। उपचार के लिए हम डिस्पोज़ेबल लंगोट और बाथरोब प्रदान करते हैं, और तेल उपचारों से कपड़ों पर दाग लग सकते हैं, इसलिए ऐसे कपड़े लाएँ जिन पर तेल लगने से आपको आपत्ति न हो। किसी विशेष जानकारी के लिए, यात्रा से पहले रोगी देखभाल टीम आपको सलाह दे सकती है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "t_257da94cf1fb4939cba0 banned-term यात्रा"
   ]
  }
 ]
}
