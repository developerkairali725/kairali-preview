   "issues": []
  },
  {
   "id": "t_0d102a5e3db122902d95",
   "sourceHash": "0d102a5e3db122902d9520d8877e5f72a67606226d7c18f75cfa4b43476eeaf5",
   "text": "हमारे पेशेंट केयर कोऑर्डिनेटर को WhatsApp पर इस नंबर पर संदेश भेजें:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_490d1d75705e06deae51",
   "sourceHash": "490d1d75705e06deae5118fa34a55257e103b3e179d167bea292527e5a643524",
   "text": ", या हमारी मुख्य लाइन पर इस नंबर पर कॉल करें:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e8172e652792021cbd39",
