   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_491f754f68f8d42068a8",
   "sourceHash": "491f754f68f8d42068a8c7a03d47bc17a1cc38bf30eefff35f6030be73543ce6",
   "text": "योग और ध्यान कार्यक्रम शुरू करने से पहले प्रतिभागी अक्सर ये प्रश्न पूछते हैं।",
   "status": "translated",
   "unchangedReason": null,
