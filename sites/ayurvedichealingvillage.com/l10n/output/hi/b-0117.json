 "units": [
  {
   "id": "t_40cbf5127a4ff98e3006",
   "sourceHash": "40cbf5127a4ff98e300697e77ec05ae6ceba3890f2bac83216dc6c3d59e36a1f",
   "text": "18 से 70 वर्ष की आयु का कोई भी व्यक्ति पंचकर्म की प्रक्रिया करवा सकता है या उसे यह सुझाई जा सकती है। धूम्रपान और अन्य नशा-मुक्ति प्रयासों में भी पंचकर्म सहायक है, क्योंकि यह अवांछित विषाक्त पदार्थों को बाहर निकालकर नशीले पदार्थों की इच्छा को कम करने में मदद करता है। शरीर में वात, पित्त और कफ के असंतुलन में भी पंचकर्म की आवश्यकता होती है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_210a058e6a8ae6b64f68",
   "sourceHash": "210a058e6a8ae6b64f68a18b9b1a94fca0449dfa12aeb2251e57b7aae4b9abe5",
   "text": "क्या पंचकर्म स्वास्थ्य समस्याओं में तुरंत राहत देता है?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1fc15ae7460187da69d5",
   "sourceHash": "1fc15ae7460187da69d55b038f1b457c349a5edbb190faa853cc149b9564ebf6",
   "text": "आम तौर पर नहीं! पंचकर्म शरीर को विषाक्त पदार्थों से मुक्त करता है, और इसके प्रभाव धीरे-धीरे दिखाई देने लगते हैं; हालाँकि व्यक्ति को हल्कापन और मांसपेशियों की जकड़न में राहत महसूस होती है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e89f05291eead854c499",
   "sourceHash": "e89f05291eead854c4996e02612ce6c123ede6067687d51bd287826db82ec81b",
   "text": "पंचकर्म उपचार के दौरान और उसके बाद मेरा आहार क्या होगा?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d31b447041868ffbfa03",
   "sourceHash": "d31b447041868ffbfa0377a6616698f57eb683d64ca457ee9924d4e87d7d46ad",
   "text": "पंचकर्म उपचार के दौरान हल्का शाकाहारी आहार निर्धारित किया जाता है। प्रक्रिया के बाद, प्रवृत्ति (झुकाव) के अनुसार एक विशेष आहार निर्धारित किया जाता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b3a052a2690831afd618",
   "sourceHash": "b3a052a2690831afd6187388655dd4a8a66097f7f0dc36443f12b3007ac9bc0b",
   "text": "क्या पंचकर्म प्रक्रियाएँ केवल रोगग्रस्त व्यक्तियों के लिए हैं?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7391688b4157e2747e03",
   "sourceHash": "7391688b4157e2747e030931acd9ac17b0530f1559d14343bd874b581fda126a",
   "text": "नहीं। पंचकर्म चिकित्साएँ स्वस्थ व्यक्तियों के लिए भी अच्छे स्वास्थ्य को बढ़ावा देने और रोगों की रोकथाम में सहायक हैं। यह मौसमी बदलावों के कारण संचित दोषों को बाहर निकालने में सहायक है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ac3258fc72c005e0380d",
   "sourceHash": "ac3258fc72c005e0380d6f1778154f4f074d1c2c5961e34f810d11305ff85dfc",
