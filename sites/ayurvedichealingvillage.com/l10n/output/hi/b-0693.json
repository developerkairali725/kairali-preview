 "units": [
  {
   "id": "t_4e05abd460c51e84c38c",
   "sourceHash": "4e05abd460c51e84c38c290a77d2aa0b352bf9bbe4a951a6814d59bac4c2af1f",
   "text": "यह आयुर्वेदिक आश्रय स्थल पालक्काड में, केरल और तमिलनाडु के बीच दुनिया के सबसे बड़े पर्वतीय दर्रे से बस कुछ किलोमीटर की दूरी पर स्थित है। प्रकृति ने पालक्काड को समृद्ध प्राकृतिक वनस्पति, पहाड़ों, जंगलों, उपजाऊ घाटियों, नदियों और पहाड़ी झरनों से भरपूर नवाज़ा है, जो इसे एक मनोरम दृश्यावली बनाते हैं। इस अनूठे स्वर्ग में बिताया गया समय आपको प्राचीन भारत की प्रामाणिक उपचार पद्धतियों का अनुभव करने देगा, साथ ही आप आधुनिक समग्र सुविधा और आराम का आनंद ले सकेंगे।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bded9603009bdb64f986",
   "sourceHash": "bded9603009bdb64f98689c1ffce4f24bd9d792168dc3c55077c460ae91318e8",
