   "sourceHash": "58b4e0b6f8fd5926dc6a99223ed8e971695beab0057e19ef8d695715529286b6",
   "text": "अब भी उत्तर नहीं मिला?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
