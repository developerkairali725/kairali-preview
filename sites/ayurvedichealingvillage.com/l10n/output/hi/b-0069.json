 "units": [
  {
   "id": "t_fcea7e41fb0a57d582d7",
   "sourceHash": "fcea7e41fb0a57d582d722fbe6a7e3380f525252b611350673286b64ebee8c98",
   "text": ": तंत्रिका पुनर्जनन में सहायता, सूजन कम करने और मांसपेशियों को सुदृढ़ करने के लिए तंत्रिका-सुरक्षात्मक, सूजन-रोधी और पुनर्युवन गुणों के लिए जानी जाने वाली विशिष्ट आयुर्वेदिक जड़ी-बूटियाँ और योग निर्धारित किए जाते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1c9028ebdc616b81342d",
   "sourceHash": "1c9028ebdc616b81342db01ccde0f4d35e91836f28b5cd3a7b4afc121a68af79",
   "text": "जीवनशैली और आहार संबंधी सुझाव",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b031a5edc5b287ccbb8e",
   "sourceHash": "b031a5edc5b287ccbb8e1561789dc92e6be45ee6c9f46ea902fb7e2909155d74",
   "text": ": रोगियों को संतुलित दिनचर्या अपनाने, तनाव प्रबंधन तकनीकों को शामिल करने और ऐसे आहार का पालन करने के लिए मार्गदर्शन दिया जाता है जो स्वास्थ्य-लाभ को बढ़ावा दे और दोषों को संतुलित करे। इससे उपचार के परिणामों को बेहतर बनाने और भविष्य में असंतुलन को रोकने में सहायता मिलती है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f77bf08f572543fbef8b",
   "sourceHash": "f77bf08f572543fbef8be3f0e65ada82209d65a623580fab2dcbc45673f4cf2f",
   "text": "नियमित फ़ॉलो-अप",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2c8d9cd6efc795800283",
   "sourceHash": "2c8d9cd6efc79580028371dc92b215e38f618034ae20b4b90023a343b23e127c",
   "text": ": प्रगति की निगरानी, उपचार योजना में आवश्यक समायोजन और निरंतर सहायता व मार्गदर्शन प्रदान करने के लिए आयुर्वेदिक डॉक्टर के साथ नियमित फ़ॉलो-अप परामर्श निर्धारित किए जाते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_abb39230fb25aaf070c6",
   "sourceHash": "abb39230fb25aaf070c66922fd7d5a63e254863859c2375baab948b504a65a86",
   "text": "समग्र दृष्टिकोण",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dd3f187e88c1c4711272",
   "sourceHash": "dd3f187e88c1c4711272a48df89d5ba5bd50b2e433ab91c52acbb5d50f1a7bb3",
   "text": ": आयुर्वेद मन और शरीर के संबंध को ध्यान में रखता है, इसलिए समग्र स्वास्थ्य को बढ़ावा देने और स्वास्थ्य-लाभ की प्रक्रिया को बेहतर बनाने के लिए उपचारों में ध्यान, श्वास-व्यायाम (प्राणायाम) और योग जैसी पद्धतियाँ भी शामिल हो सकती हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_42400299f5121f329956",
