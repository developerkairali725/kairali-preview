{
  "locale": "hi",
  "batchId": "combined-final-20261001-000",
  "units": [
    {
      "id": "t_078021fd01c1fd259756",
      "status": "translated",
      "text": "Kairali — The Ayurvedic Healing Village",
      "unchangedReason": "Brand/proper name kept unchanged per source-bound terminology",
      "sourceHash": "078021fd01c1fd25975671575a5b2030ba96c2601bf6ef71b5d13e7af692a729"
    },
    {
      "id": "t_5d8c71abc527284cd463",
      "status": "translated",
      "text": "हमारे बारे में",
      "sourceHash": "5d8c71abc527284cd463aa58f3f48098af5ab2f4225a744aa930a4b0e27d7395"
    },
    {
      "id": "t_38178a20b470cfd18299",
      "status": "translated",
      "text": "क्र.",
      "sourceHash": "38178a20b470cfd18299fb1593dd4ba706f1a83321dac051d01086efd8b7a96f"
    },
    {
      "id": "t_0221e487518899121b2b",
      "status": "translated",
      "text": "जारी करने की तिथि",
      "sourceHash": "0221e487518899121b2b17d411ac0d041807a8f9c33a835a47d67021243b4345"
    },
    {
      "id": "t_4fc52a3c4c558b517c46",
      "status": "translated",
      "text": "अवधि",
      "sourceHash": "4fc52a3c4c558b517c463b22d86d0e3b9cfd4255c98fe3510f9075b37ab419c9"
    },
    {
      "id": "t_b443725a6bacee145daf",
      "status": "translated",
      "text": "Pañchakarma (पंचकर्म)",
      "unchangedReason": "Sanskrit therapy name kept in original transliteration with Devanagari gloss per source-bound terminology",
      "sourceHash": "b443725a6bacee145dafc001bf40e51999c11174441552fac9858371901ba13a"
    },
    {
      "id": "t_218197693424e0154cef",
      "status": "translated",
      "text": "कहाँ से",
      "sourceHash": "218197693424e0154cefc0af31aed96c084b987e08136e91d5528ddbb5461e24"
    },
    {
      "id": "t_8c78fe5b9936488c1117",
      "status": "translated",
      "text": "मई",
      "sourceHash": "8c78fe5b9936488c111733d36f3da4b246a4d206159efe5cd64cdb229c38f069"
    },
    {
      "id": "t_2096cefba06a32ba5c67",
      "status": "translated",
      "text": "पाठ्यक्रम",
      "sourceHash": "2096cefba06a32ba5c67955490d391a5a98442e61f63865f39659c25f52f2426"
    },
    {
      "id": "t_340f463033e0fd5ddeab",
      "status": "translated",
      "text": "कोड",
      "sourceHash": "340f463033e0fd5ddeabb922df4d4f1b5747494d0f5ed9894f13b6e13ca831f5"
    },
    {
      "id": "t_06b2ba60a6be91b3b28d",
      "status": "translated",
      "text": "बुकिंग और भुगतान",
      "sourceHash": "06b2ba60a6be91b3b28d1301c040140bb3b4fd3ed10c14ce6aaeaf96223eda0d"
    },
    {
      "id": "t_7da6b784f6d58301539f",
      "status": "translated",
      "text": "40% अग्रिम राशि जमा करने पर बुकिंग सुनिश्चित होती है; शेष राशि भर्ती से कम से कम 30 दिन पहले तक देय है",
      "sourceHash": "7da6b784f6d58301539f9d07e2b8cece17437d52699f2de9124337d962b15d4a"
    },
    {
      "id": "t_7fa6528d36e1d5186b0f",
      "status": "translated",
      "text": "किसी विशेष विला के लिए अनुरोध कम से कम छह महीने पहले करना आवश्यक है और यह उपलब्धता के अधीन है; पुष्टि के लिए पूर्ण भुगतान आवश्यक है",
      "sourceHash": "7fa6528d36e1d5186b0f0a2d0c17c67ab5feebe6689ae0e11e2737057d99d984"
    },
    {
      "id": "t_9ddb96775b1b1be4b487",
      "status": "translated",
      "text": "भर्ती और डिस्चार्ज",
      "sourceHash": "9ddb96775b1b1be4b487d86d975a489518bd26ef23a0f174ff9a35cded9e663a"
    },
    {
      "id": "t_919f0819ddf505f67514",
      "status": "translated",
      "text": "चेक-इन दोपहर 12:00 बजे से; चेक-आउट 10:00 बजे तक",
      "sourceHash": "919f0819ddf505f67514c32173f3de642c1781fc663c6083beca647fe1cd1555"
    },
    {
      "id": "t_224e9a649543ed59890d",
      "status": "translated",
      "text": "जल्दी चेक-इन और देर से चेक-आउट अनुरोध पर, उपलब्धता के अधीन, उपलब्ध हैं, और इनके लिए शुल्क लग सकता है",
      "sourceHash": "224e9a649543ed59890d314b3f6f722564787ea608eb0b62cdd0bda3bd2b93e9"
    },
    {
      "id": "t_53c8fc0bacc0298deac4",
      "status": "translated",
      "text": "रद्दीकरण",
      "sourceHash": "53c8fc0bacc0298deac46fda125fa2ac099f9e6a2ece4a2512dbb1fc9330530e"
    },
    {
      "id": "t_f43fd80da99deca71704",
      "status": "translated",
      "text": "भर्ती से 30 दिन से अधिक पहले: पूरी राशि वापस",
      "sourceHash": "f43fd80da99deca717047c9906c37b910703721f76032a6058cc873b6742906c"
    },
    {
      "id": "t_f16a6463426591d36df6",
      "status": "translated",
      "text": "भर्ती से 15 से 30 दिन पहले: भुगतान की गई राशि का 50% वापस किया जाता है, जिसमें से लागू लेनदेन शुल्क और कर घटा दिए जाते हैं",
      "sourceHash": "f16a6463426591d36df62bf09bc80ac7d16e890276f4cbe06e598b8a8cd17a69"
    },
    {
      "id": "t_a21907c7ee7c76d3803e",
      "status": "translated",
      "text": "भर्ती से 15 दिन से कम पहले, या प्रवास के दौरान तिथियों में परिवर्तन: कोई धनवापसी नहीं",
      "sourceHash": "a21907c7ee7c76d3803e7a44eb53b26c6c4ff2669ea790c586d26e8046db3535"
    },
    {
      "id": "t_3583a358a585b13b6d62",
      "status": "translated",
      "text": "बच्चे",
      "sourceHash": "3583a358a585b13b6d6228f12d2baf3ef937fcf50bed4a521b70f95a520bc933"
    },
    {
      "id": "t_34a65040892da4409860",
      "status": "translated",
      "text": "5 वर्ष से कम: निःशुल्क",
      "sourceHash": "34a65040892da44098605a209a64bb3fa8d78166a463e2e7d0c6b04345946907"
    },
    {
      "id": "t_d967f5a9a151268faea3",
      "status": "translated",
      "text": "5 से 12 वर्ष: भोजन शुल्क का 50%; अतिरिक्त बिस्तर मानक दर पर",
      "sourceHash": "d967f5a9a151268faea314471e6ec09b0e577dbeddfdcf8c1c8414bf8c295484"
    },
    {
      "id": "t_68dcf70cdb2c8c603f37",
      "status": "translated",
      "text": "12 वर्ष से अधिक: पूरा शुल्क",
      "sourceHash": "68dcf70cdb2c8c603f37f346bf6a97df1596469c9850cd14574fc4c9e9a7e959"
    },
    {
      "id": "t_ef3a60a301d9b0587a9e",
      "status": "translated",
      "text": "माता-पिता या अभिभावकों को हर समय बच्चों की देखरेख करनी होगी। परिसर के कुछ हिस्से उपचार क्षेत्र हैं और बच्चों के लिए उपयुक्त नहीं हैं",
      "sourceHash": "ef3a60a301d9b0587a9e7074e94f073df5b508985423dffe1c8baa2b4146e95c"
    }
  ]
}