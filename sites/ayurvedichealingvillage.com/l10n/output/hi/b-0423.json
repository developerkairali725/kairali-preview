 "units": [
  {
   "id": "t_e0d777c9cf0bb93c2093",
   "sourceHash": "e0d777c9cf0bb93c20931fa06b8ca0e37f3cc85e3876b7a34745d8041ed62f21",
   "text": "पीले किनारों वाले बरामदे के साथ ईंट का विला",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1583533bf5272c4b3fd0",
   "sourceHash": "1583533bf5272c4b3fd03151e08d364e01dc241f0aac210d4a24743dbb58d148",
   "text": "ईंट के विला का प्रवेश द्वार और छायादार बरामदा",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f41e9e2cd963cb655dfb",
   "sourceHash": "f41e9e2cd963cb655dfb2212e345f5ff848fae26f3ebe567afc708680f30eeb0",
   "text": "ताड़ के पेड़ों के बीच गोलाकार ईंट का विला",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3386d0d6ad254ab1dce4",
   "sourceHash": "3386d0d6ad254ab1dce440f42bd4b0da8e4ee41690d1465f5685ff9ba8ca9828",
   "text": "खपरैल की छत वाला ईंट का विला",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_79cb0b2645702cb3cd8b",
   "sourceHash": "79cb0b2645702cb3cd8ba608837dc82cf656ca176b3a9c8bf484906ef6d73fa1",
   "text": "बगीचे की जलधारा के पास बैंगनी विला",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5abaa92e4a0e613ccbc1",
   "sourceHash": "5abaa92e4a0e613ccbc1c34135f090f91275511d33d3c5828dbe8443e8a6d0fe",
   "text": "हमारे क्लासिक विला में पारंपरिक सुरुचि और आधुनिक आराम का अनुभव करें। केरल की कालातीत वास्तुकला को अपनाएँ, आयुर्वेदिक उपचार का लाभ लें और प्रीमियम सुविधाओं का आनंद लें। इस शांत आश्रय में विश्राम करें, जहाँ आंतरिक संतुलन आपकी प्रतीक्षा कर रहा है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'luxurious amenities' rendered as 'प्रीमियम सुविधाएँ' (premium amenities)."
   ]
  },
  {
   "id": "t_b78f5fea99b31a0554b7",
   "sourceHash": "b78f5fea99b31a0554b7a2a1f09a9931bc7c261f0713560f4da43ebda769f023",
   "text": "ताड़ के पेड़ों के बीच हरे किनारों वाला विला",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_91ff1f2fd175199e3d02",
   "sourceHash": "91ff1f2fd175199e3d0269c641775d32273391913809a4ac7451191ccd956c8c",
   "text": "बैंगनी विला और घुमावदार जलधारा",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5e95b24d05c3db243b37",
   "sourceHash": "5e95b24d05c3db243b378ae86a9e7f3da5965cf332be6fad0104185ee0137d86",
   "text": "ईंट के बरामदे पर बेंत की कुर्सियाँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_acfedec02ac04ae37c10",
   "sourceHash": "acfedec02ac04ae37c100b751b29bcea1550f5c6a1dea371dfd64ad805be1f59",
   "text": "“मैं कई जगहों पर रहा हूँ, लेकिन घर जैसा अपनापन केवल एक ही जगह मिला।”",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0224df37e41bc9e95d47",
   "sourceHash": "0224df37e41bc9e95d478aca573e1b173b316d6e6f36ed8ea02b13ca67b1b2ec",
   "text": "हमारा प्रत्येक प्रीमियम विला प्राचीन शास्त्रों में वर्णित ‘वास्तु शास्त्र’ के प्राचीन सिद्धांतों पर आधारित है, जिसे फेंगशुई का भारतीय रूप भी कहा जाता है। इससे हमारे आगंतुकों को केरल के सबसे प्रामाणिक वैदिक परिवेश में आयुर्वेद या योग के लिए उत्कृष्ट विला-प्रवास मिलता है। वास्तु शास्त्र वास्तुकला और डिज़ाइन की एक प्राचीन भारतीय पद्धति है, जो प्रकृति के साथ सामंजस्य और संतुलन बनाने के लिए भवनों की स्थिति और दिशा पर बल देती है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'luxury villas' rendered as 'प्रीमियम विला'; 'guests' rendered as 'आगंतुक' (visitors); 'retreat' rendered as 'प्रवास' (stay)."
   ]
  },
  {
   "id": "t_ed4664f56be556f0fae5",
   "sourceHash": "ed4664f56be556f0fae5213426acaf52b5ddb585996c64a7caeaaea0599fe594",
   "text": "स्वास्थ्य को बढ़ावा दे",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2fcde3552ac08fd8e9a6",
   "sourceHash": "2fcde3552ac08fd8e9a63bc3b06ecc480d6bd0e46c0f13b9f96f803e0dab43d3",
   "text": "उत्पादकता बढ़ाए",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8cbe9fcdcb15c2453f74",
   "sourceHash": "8cbe9fcdcb15c2453f742f33cbd27eb7adf0add67ffdeca12f06a2ce9b8efe46",
   "text": "संबंधों को बेहतर बनाए",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d8d41719bbcf384405de",
   "sourceHash": "d8d41719bbcf384405ded7fa623a720596f7ccc2c828a639b58df684adb66447",
   "text": "एक शांतिपूर्ण वातावरण",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6aeeccfda8bd279d5689",
   "sourceHash": "6aeeccfda8bd279d56895068a165b21fe33796d682c1c454ef939ad30ad326d8",
   "text": "मन को सुकून देने वाला एक आश्रय, जहाँ प्रकृति और आयुर्वेद मिलकर पुनर्जीवन और आनंद का एक अविस्मरणीय प्रवास प्रदान करते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'retreat' rendered as 'प्रवास' (stay)."
   ]
  },
  {
   "id": "t_6c29f8f6a8bc55dd2abd",
   "sourceHash": "6c29f8f6a8bc55dd2abd578030ea1c2f8ff4947adb96f1e0666c57f4543dc914",
   "text": "रिट्रीट की कहानी पढ़ें",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e51e8fa374d8704ae435",
   "sourceHash": "e51e8fa374d8704ae435378f7702e0a92da4b4b830b308e795e1b478e3cbc334",
   "text": "एक कॉटेज और योग की दो छोटी तस्वीरें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b569208877e36d845502",
   "sourceHash": "b569208877e36d8455021eb385e50ec2b17a9fdcce88e8bbb9035ce803605d9d",
   "text": "हाउसबोट और 2017–2018 की तिथियाँ दर्शाती ऐतिहासिक “Ayurvedic Indian Journey” कलाकृति।",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Ayurvedic Indian Journey' kept verbatim as the title shown on the historical artwork (contains 'Journey' inside a proper title)."
   ]
  },
  {
   "id": "t_95b708cd25e5f23ee53e",
   "sourceHash": "95b708cd25e5f23ee53e0cd1bc8d48d0e32af70e8169cc36a27d279fcbe015c0",
   "text": "नए साल की शुरुआत शरीर को डिटॉक्स और शुद्ध करने तथा सभी सकारात्मक नई…का स्वागत करने का उत्तम समय है",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Source is a truncated teaser ending mid-sentence; rendered as a matching truncated fragment."
   ]
  },
  {
   "id": "t_99189af68c323a8f11ad",
   "sourceHash": "99189af68c323a8f11ad22f51ce69e9df9d0d0288d6a80d18dc5dd83cb34c1a7",
   "text": "तालाब के पास ध्यान में बैठी एक महिला।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ac57772359a2ea356e5c",
   "sourceHash": "ac57772359a2ea356e5c00ca3f4fdae336527f982a9c00c5d5bbb84e99c29a03",
   "text": "पालक्काड, केरल स्थित Kairali आयुर्वेदिक हीलिंग विलेज में योग और आयुर्वेद रिट्रीट।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_957fb5de9264fe407b5f",
   "sourceHash": "957fb5de9264fe407b5f3bfb3eedd86ffc73df35dce613a4254c1b9dabfcbbe8",
   "text": "हरी पहाड़ियाँ और एक घाटी।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9da4abc36114299eb719",
   "sourceHash": "9da4abc36114299eb719fd564d121c0f5deee151e6ca4b0c2c2e5d94c4faab9a",
   "text": "भारत के सबसे सुंदर दक्षिणी राज्य केरल की जीवन में एक बार होने वाली यात्रा।",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'trip' rendered as 'यात्रा' (travel/trip); not the banned 'journey' sense.",
    "t_9da4abc36114299eb719 banned-term यात्रा"
   ]
  },
  {
   "id": "t_d13e87e651691e84b695",
   "sourceHash": "d13e87e651691e84b6955e4bf02843680c1382124f8509de441438beba67bbe3",
   "text": "बाहर खड़े होकर योग मुद्रा का अभ्यास करता एक व्यक्ति।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
