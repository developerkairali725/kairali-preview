 "units": [
  {
   "id": "t_724b78597b3b080bbb14",
   "sourceHash": "724b78597b3b080bbb14f415d96519493708b057fd6ba8c56100bc420299dbf6",
   "text": "जीवनशैली/फिटनेस मूल्यांकन",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_70e3f5cb4702289e3bb0",
   "sourceHash": "70e3f5cb4702289e3bb045d382783629197642a7ad0649d06fdab1ac1cdfa0d4",
   "text": "स्विमिंग पूल, जिम, पुस्तकालय, तथा इनडोर/आउटडोर मनोरंजन सुविधाएँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_408a41be05a2d770f741",
   "sourceHash": "408a41be05a2d770f74119137c3ec5b102050bf34e4e17005393b9677aa9717c",
   "text": "नोट: अतिरिक्त खाद्य पदार्थ, व्यक्तिगत सत्र, फैक्ट्री विज़िट और आंतरिक औषधियों का शुल्क अलग से लिया जाता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8e51d580b65287e4e181",
   "sourceHash": "8e51d580b65287e4e1817217c11404131ce962af391bd229a571a435fa860b08",
   "text": "एक दिवसीय आयुर्वेद कार्यशाला कार्यक्रम, केरल (OAP-HV)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6c7a87be2dd1e567fee8",
   "sourceHash": "6c7a87be2dd1e567fee84a447e9380a082ab0c13dc39cc927fe40223208b514a",
   "text": "‘आयुर्’ का अर्थ है ‘जीवन’ और ‘वेद’ का अर्थ है ‘विज्ञान’; दोनों मिलकर ‘जीवन का विज्ञान’ बनाते हैं। 5000 से अधिक वर्षों से प्रचलित आयुर्वेद समग्र स्वास्थ्य के लिए भारत का समय-सिद्ध विज्ञान है। Kairali Ayurvedic Group विभिन्न आयुर्वेद प्रशिक्षण कार्यक्रम प्रदान करता है, जिनमें परिचयात्मक एक दिवसीय आयुर्वेद कार्यशाला कार्यक्रम (OAP-HV) भी शामिल है। यह कार्यक्रम आयुर्वेद के प्रति जागरूकता बढ़ाने और लोगों को स्वस्थ जीवनशैली अपनाने में सक्षम बनाने के लिए तैयार किया गया है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_737c9f3184706d2f1c56",
   "sourceHash": "737c9f3184706d2f1c5614b2754b1b5dd9a40bace096d350350bb6b9004d63f6",
   "text": "किसे भाग लेना चाहिए?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b83ce29aade0c054e99d",
   "sourceHash": "b83ce29aade0c054e99d21eec0f26d62d8c1a04149e3034d16da9f75d82933f6",
   "text": "यह कार्यशाला इनके लिए उपयुक्त है:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_548fca48ebedbe700937",
   "sourceHash": "548fca48ebedbe700937bba3a026aa0b0f4ea153e1db81c0a565002c7ffcf923",
   "text": "आयुर्वेद में रुचि रखने वाले सभी लोग",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ae8725c813d48f7d9516",
   "sourceHash": "ae8725c813d48f7d9516c75d5d003cfda8364e2caeff62d5289c50efe226296d",
   "text": "कॉर्पोरेट समूह और पेशेवर",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8d2e1755889bca4c95aa",
   "sourceHash": "8d2e1755889bca4c95aa233448ed6d1d7322ce91a6d06b88eff904845e413632",
   "text": "समूह में आने वाले आगंतुक",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'Group travelers' rendered as 'visitors coming in groups' to keep the clinical register (avoids travel/holiday framing)."
   ]
  },
  {
   "id": "t_3f13bccf535cc55802b9",
   "sourceHash": "3f13bccf535cc55802b93f81689030652c2441271e12ba3d24ae42130c7eebe2",
   "text": "व्यक्तिगत रूप से आने वाले आगंतुक (FITs), डॉक्टर, पोषण विशेषज्ञ",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'FITs' (free independent travellers) rendered as 'individually arriving visitors (FITs)'; acronym kept in parentheses."
   ]
  },
  {
   "id": "t_62c6a7bf827b62cda91a",
   "sourceHash": "62c6a7bf827b62cda91a19ca026437521f9b1317563930791ec3f81762db551d",
   "text": "क्लब, संघ और स्वास्थ्य-केंद्रित समूह",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_af5a8aa4209e1b79162a",
   "sourceHash": "af5a8aa4209e1b79162a483c253ecd34e8f799372ecc348098e129f35a7868e4",
   "text": "किसी पूर्व अनुभव की आवश्यकता नहीं है। आयुर्वेद और स्वस्थ जीवनशैली की मूल बातों में रुचि रखने वाला कोई भी व्यक्ति इस कार्यक्रम से लाभ उठा सकता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_244273d44a14a7e4ca39",
   "sourceHash": "244273d44a14a7e4ca39be1875676d7ca9ea400eb7c929458f4344caf37685be",
   "text": "इस जागरूकता कार्यशाला में शामिल हैं:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6c56e45b693f63eb8b4a",
   "sourceHash": "6c56e45b693f63eb8b4a5851b2e16a53a7f4bfadc166b5e905810c2ba01093fe",
   "text": "आयुर्वेद के सार और इतिहास पर एक व्याख्यान",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_db03dffd9e0476878997",
   "sourceHash": "db03dffd9e0476878997f48024bd773d55395cadba3b1504fee109fe4792c7fc",
   "text": "आयुर्वेद के मूल दर्शन और सिद्धांत",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5cca46eac441e903ced5",
   "sourceHash": "5cca46eac441e903ced521097e6c477ea183b4a61cb141d2f2041df3c215ce6b",
   "text": "आधुनिक जीवन में आयुर्वेद की प्रासंगिकता",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_761dc089150fe0b4b940",
   "sourceHash": "761dc089150fe0b4b940e11322aa88d3deda76ad1862ac18a017b21b42c17a5b",
   "text": "दैनिक दिनचर्या में आयुर्वेद अपनाने के व्यावहारिक तरीके",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_43d8e9bf344ce1e07d39",
   "sourceHash": "43d8e9bf344ce1e07d3919c67c3452f6ed3ec28e8dc243738261087d2573186e",
   "text": "मूलभूत आयुर्वेदिक थेरेपी का वीडियो प्रदर्शन",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_aaa4cc03ddc6efe7e367",
   "sourceHash": "aaa4cc03ddc6efe7e3678c3cd116643f2bd6c338c75e9c4c9ae901c1aa5ac8fb",
   "text": "आयुर्वेदिक औषधियों और Kairali उत्पादों का परिचय",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a5491fa2113acbdd0197",
   "sourceHash": "a5491fa2113acbdd01973f48b4029d72202892215423106c346008102cca5552",
   "text": "सफलतापूर्वक पूरा करने पर प्रमाणपत्र प्रदान किया जाता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7b87f41f0e407f60971b",
   "sourceHash": "7b87f41f0e407f60971b5e4db4126f81fbbc06b1786e3e62e2f1d5e071844395",
   "text": "कार्यशाला पाठ्यक्रम",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0d5462a10a7304d4c7c0",
   "sourceHash": "0d5462a10a7304d4c7c05ffa23a22a9cfd8fc1d84382758ac98d050e34f7adf5",
   "text": "आयुर्वेद को समझना: मूलभूत शिक्षण सत्र",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1d1afdaae59509128180",
   "sourceHash": "1d1afdaae59509128180882cac0ae058c5351b3487d9cca6dc24e706120cc3eb",
   "text": "आयुर्वेदिक औषधियों का परिचय (शास्त्रीय और मालिकाना)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b83a3b943ec99522c1a9",
   "sourceHash": "b83a3b943ec99522c1a96370f26a73a59522eb4dbad8ac032f8109e165821091",
   "text": "वीडियो प्रदर्शन: आयुर्वेदिक थेरेपी के व्यावहारिक पहलू",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
