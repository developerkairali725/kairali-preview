 "units": [
  {
   "id": "t_62da2fe8ad208cdb2af6",
   "sourceHash": "62da2fe8ad208cdb2af630b9d5dfe13275181e0b1f8555c12bbc1c1b01cac569",
   "text": "वरिष्ठ नागरिकों के लिए",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bfafbfebe19cb3a5c5ea",
   "sourceHash": "bfafbfebe19cb3a5c5ea22554838d741f1e66c5e73820cef7de7dc92ed6f14ac",
   "text": "जिन्होंने कभी हमारी देखभाल की",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1e95cf8452f81bc7aa42",
   "sourceHash": "1e95cf8452f81bc7aa429bf7f406971043da0efd0c6d8d58ec279a5367132f42",
   "text": "बुज़ुर्गों और वरिष्ठजनों के स्वास्थ्य की देखभाल",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_99fec0c7f02a3173a056",
   "sourceHash": "99fec0c7f02a3173a056ed0d98856b77c93f4d3df5d83cdbe0e2dd626a46e2ae",
   "text": "हमारे माता-पिता ने हमें शक्ति, स्थिरता और देखभाल दी। जैसे-जैसे समय उनकी गति धीमी करता है, वे ऐसे उपचार के हक़दार हैं जो उनकी गरिमा, आराम और आत्मनिर्भरता को बनाए रखे — दया या जल्दबाज़ी नहीं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7da5dceec9e5cb94f0b2",
   "sourceHash": "7da5dceec9e5cb94f0b2666fad3827cd166195167ab9546faa137334323bc113",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]उम्र के अनुरूप सुरक्षित, चिकित्सक के नेतृत्व में आयुर्वेदिक थेरेपी[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_cc4e632bb18b401c3614",
   "sourceHash": "cc4e632bb18b401c3614399601fb50821eeebe8e91df865f5da0e52340ba2fcd",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]दीर्घकालिक रोगों के लिए सौम्य, साक्ष्य-आधारित देखभाल[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2f75075f907c2445586f",
   "sourceHash": "2f75075f907c2445586fb59724863b0c75e2c7a4ec72717ca8bdb9aa35712463",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]सहायता-युक्त आवास और वरिष्ठजनों के अनुकूल निजी विला[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
