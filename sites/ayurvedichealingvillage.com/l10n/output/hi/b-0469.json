   "text": "विशेषज्ञ मार्गदर्शन:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2e24f285e0b28957accf",
   "sourceHash": "2e24f285e0b28957accfb808ef694fcfc550e02543001c8f84942d5f13e03168",
