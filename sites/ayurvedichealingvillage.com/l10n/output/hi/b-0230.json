   ]
  },
  {
   "id": "t_3037506a9842e4ab7cf0",
   "sourceHash": "3037506a9842e4ab7cf01d0a25c43a11faabcf27d3984ed70c7f92c88f87b831",
   "text": "आयुर्वेदिक भोजन क्या है?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fba73c73cf0dc30c4b38",
   "sourceHash": "fba73c73cf0dc30c4b38ced8494b7da52cd4fbfc851f7a0a38cd8061ce785169",
   "text": "हीलिंग विलेज में आयुर्वेदिक रेस्तराँ और पाक-कला",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4edc8bfafc6bd936b849",
   "sourceHash": "4edc8bfafc6bd936b849f38c009454eac0febc8982f990e734724156584d56f9",
   "text": "उत्पाद",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_230b919ea8e5c65d752c",
   "sourceHash": "230b919ea8e5c65d752c9f6b234aaab7c1c305eea5c9ee751f438d022099147b",
   "text": "आयुर्वेद और स्वास्थ्य के प्रति अपनी सच्ची प्रतिबद्धता के लिए प्रसिद्ध Kairali Ayurvedic Group ही आयुर्वेदिक हीलिंग विलेज की प्रेरक शक्ति है। Kairali के आयुर्वेदिक उत्पादों का उद्देश्य आयुर्वेद के प्राचीन ज्ञान को समकालीन दुनिया तक पहुँचाना है। ये उत्पाद समग्र स्वास्थ्य, गुणवत्ता और प्रामाणिकता के प्रति समूह के समर्पण को दर्शाते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_492ff08e85c56c70fdc3",
   "sourceHash": "492ff08e85c56c70fdc3a1d46a89b8c213449000eaf1c01f277c65893ba68337",
   "text": "Kairali आयुर्वेदिक उत्पाद",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1fa9367d8066562312aa",
   "sourceHash": "1fa9367d8066562312aae435cf495c7114d5c9a7797a687952b65e8961eb150f",
   "text": "आयुर्वेदिक उत्पादों की विस्तृत श्रृंखला देखें",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_636fa7c50798a95d8e47",
   "sourceHash": "636fa7c50798a95d8e47e531823fec9a4f1c5edc6fe47fa813b4a71c1fde5e0e",
   "text": "प्रमुख उत्पाद श्रेणियाँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9c4d25f4df9e635f21ab",
   "sourceHash": "9c4d25f4df9e635f21abd711626cb6c52e27cd3f6b5c26d7ac39258ced366695",
   "text": "हर्बल फ़ॉर्मूलेशन",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b8825a9305afd04477d6",
   "sourceHash": "b8825a9305afd04477d6336c0c92c09ed7dfaa570f0b41e582da69067a5021a8",
   "text": ": इन उत्पादों में विशेषज्ञता से तैयार हर्बल चूर्ण, कैप्सूल और सिरप शामिल हैं, जो पाचन, रोग-प्रतिरोधक क्षमता, जोड़ों के स्वास्थ्य और मानसिक स्पष्टता सहित विभिन्न स्वास्थ्य समस्याओं के उपचार के लिए बनाए गए हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e75e6cfebb7ae5fdf677",
   "sourceHash": "e75e6cfebb7ae5fdf6770c9984b92391ac40995a5e24019d2d6eba9a6667beef",
   "text": "हर्बल फ़ॉर्मूलेशन: इन उत्पादों में विशेषज्ञता से तैयार हर्बल चूर्ण, कैप्सूल और सिरप शामिल हैं, जो पाचन, रोग-प्रतिरोधक क्षमता, जोड़ों के स्वास्थ्य और मानसिक स्पष्टता सहित विभिन्न स्वास्थ्य समस्याओं के उपचार के लिए बनाए गए हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9a87c43f6646a3443af4",
   "sourceHash": "9a87c43f6646a3443af4c60792cb4d5ed564a96f3e79e8e4d4fae964e823a3e9",
   "text": "व्यक्तिगत देखभाल और त्वचा देखभाल",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ccab906c397cd5663b67",
   "sourceHash": "ccab906c397cd5663b67816fa95366db94ca482ff3269d7134687606992552c8",
   "text": ": तेल, फ़ेस पैक और मॉइस्चराइज़र जैसे आयुर्वेदिक त्वचा देखभाल उत्पाद त्वचा को पोषण देने और प्राकृतिक, दमकती रंगत पाने के लिए तैयार किए जाते हैं। इन उत्पादों में हल्दी, चंदन और एलोवेरा जैसी सामग्री होती है, जो अपने ताज़गी देने वाले प्रभावों के लिए जानी जाती हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
