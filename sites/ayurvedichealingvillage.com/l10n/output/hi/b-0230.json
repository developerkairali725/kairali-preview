   ]
  },
  {
   "id": "t_cc8072a5fae86196d573",
   "sourceHash": "cc8072a5fae86196d5731a9ab95f87368935d37334fd1d62e6737445cc997f2e",
   "text": "सभी के लिए आयुर्वेदिक आवासीय कार्यक्रम",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
