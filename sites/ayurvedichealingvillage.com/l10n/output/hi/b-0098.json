   "sourceHash": "f2c7a76b191d726d7341da0e2ebc45d37afe047598d4aab846b3135f10295c80",
   "text": "[[OPEN_1]]होम[[CLOSE_1]][[OPEN_2]]/[[CLOSE_2]][[OPEN_3]]हमारे विला[[CLOSE_3]][[OPEN_4]]/[[CLOSE_4]][[OPEN_5]]महाराजा सुइट[[CLOSE_5]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_276e88125599bc406fd0",
   "sourceHash": "276e88125599bc406fd090ceec8f66ad8702b62ba0e9d96e8772d12baca9e617",
