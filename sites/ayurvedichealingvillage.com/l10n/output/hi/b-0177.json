 "units": [
  {
   "id": "t_11cab7ddff08ebbfef5d",
   "sourceHash": "11cab7ddff08ebbfef5d9bb6e3d2cd3e3b646b036cf654e07591e7a8b940e6c7",
   "text": "मलमपुझा रॉक गार्डन",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5ab37612848d81b5aedd",
   "sourceHash": "5ab37612848d81b5aedd2bfd2d08dedac531cf07d366f023dd7bde66e0ce028c",
   "text": "मलमपुझा रॉक गार्डन की रचना पद्मश्री नेकचंद सैनी ने की थी, जो विश्व-प्रसिद्ध मूर्तिकार थे और जिन्होंने चंडीगढ़ में भारत का पहला रॉक गार्डन भी बनाया था।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e94fb7a6eb4e43e795d2",
   "sourceHash": "e94fb7a6eb4e43e795d27bfaa704854b4a93179ba041c4b9fa9d22b8185c59cd",
   "text": "मूर्तिकला",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6caff280199f70ecc400",
   "sourceHash": "6caff280199f70ecc4008fcf347df465c2d0b40befd1003d8dcc9015716a414a",
   "text": "रोपित उद्यान",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d22b2a9a90d680071f9a",
   "sourceHash": "d22b2a9a90d680071f9a96944170da76b455e7c3fe6d5320ce71b7673da921f6",
   "text": "चित्तूर गुरुमठम",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_70b31b32d9d03c3e8508",
   "sourceHash": "70b31b32d9d03c3e8508d1285d9aed611d67365ce1fea6e40e22654ef57f7af9",
   "text": "चित्तूर गुरुमठम, सोकनाशिनी नदी के तट पर स्थित, मलयालम भाषा के जनक थुंचत रामानुजन एझुथच्चन का स्मारक है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0ca125c7a7f34db1c461",
   "sourceHash": "0ca125c7a7f34db1c461594d198e2918c7c79c86494f96d15952e7cae3eb1d1f",
   "text": "प्राचीन पांडुलिपियाँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_719ced5088400afc6dc5",
   "sourceHash": "719ced5088400afc6dc5613da5c61606d8e0bd0879cae8e3c69c76007af88260",
   "text": "फैंटेसी पार्क",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8bd030be2739569acded",
   "sourceHash": "8bd030be2739569acdedd53640aa2a9e26067f069cb8a62941bfccded803647e",
   "text": "पालक्काड में मलमपुझा बाँध के पास स्थित फैंटेसी पार्क केरल का पहला मनोरंजन पार्क है, और यह पूरे परिवार के लिए आनंद की जगह है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e23e043568998f9bcf7f",
   "sourceHash": "e23e043568998f9bcf7f7ef3784aeabb150ce153f37db8673fc549103a6b18fc",
   "text": "परिवार",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2a197d1a7dbd9da34301",
   "sourceHash": "2a197d1a7dbd9da34301ff14e2fa93efdddb2ffa92f5b5a6d5c6e91ee27ff68b",
   "text": "झूले और वॉटर पार्क",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ca25b7b4109f4aef1b7e",
   "sourceHash": "ca25b7b4109f4aef1b7e6b56cd5a2e215100e6b46a8ae87e9482bc226b34755f",
   "text": "मलमपुझा (जलाशय)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_36ee8774af3f93daedd5",
   "sourceHash": "36ee8774af3f93daedd5c021634bf9a8a068c3fd53ca1764a22a40a208799787",
   "text": "मलमपुझा जलाशय एक लोकप्रिय पर्यटन आकर्षण है। इसके चारों ओर सुंदर उद्यान, मनोरंजन पार्क, मछली के आकार के एक्वेरियम और एक सर्प उद्यान हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_18761524b7f1d36bacca",
   "sourceHash": "18761524b7f1d36bacca088d300533e4a56f2a68e2d0281ae81dbab51efcaeb3",
   "text": "नौका विहार",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0670e06927819e2f50c0",
   "sourceHash": "0670e06927819e2f50c08cd40a013b6eb2c8e627620c89021a2976302412a8ad",
   "text": "उद्यान",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8dfa3c6c34add3fe8b2e",
   "sourceHash": "8dfa3c6c34add3fe8b2e54762baa01c9f2f6eb842296cb6f1bd295b31a15c481",
   "text": "सर्प उद्यान",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9197a9aa6dd7c14626c2",
   "sourceHash": "9197a9aa6dd7c14626c2c4c054fd6c94897e2531eb0fa23d047cf5e2d3ddd633",
   "text": "25 से 50 किमी",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ab4f0e0a7a070200ac21",
   "sourceHash": "ab4f0e0a7a070200ac2113151be51b3a8f5f73a01debe793d0e870a87b69c4f4",
   "text": "दर्शनीय स्थल — 25–50 किमी",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bd44bda6f1e5323febbd",
   "sourceHash": "bd44bda6f1e5323febbd4574e4911f6d8540b46fde31442179fa524c6d855b39",
   "text": "दर्शनीय स्थल (25 से 50 किमी)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4a452763f54c0ca6dbef",
   "sourceHash": "4a452763f54c0ca6dbefff45b93850666138097bf99b0b88ed329cb19099e523",
   "text": "हालाँकि पालक्काड एक छोटा शहर है, फिर भी इसकी समृद्ध संस्कृति, भरपूर हरियाली और विविध वनस्पतियों व वन्यजीवों को देखते हुए इसका एक महत्वपूर्ण पर्यटन स्थल के रूप में विकसित होना आश्चर्य की बात नहीं है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5f1c3abe87326652f83c",
   "sourceHash": "5f1c3abe87326652f83c0b9abb88de4299ebf31e8c0e56930b4b8b724fe595ad",
   "text": "25 से 50 किमी दूर स्थित स्थान",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a74fbfc0a44198a649f1",
   "sourceHash": "a74fbfc0a44198a649f1153d9e9abbf8d304fd74fed9be389a65fbc6caeafeab",
   "text": "तिरुवेगप्पुरा शंकरनारायण मंदिर",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_488dce20871cfc599922",
   "sourceHash": "488dce20871cfc599922ae1a9838ce4ce71d5f5e495d1c4044133d77e004ced1",
   "text": "25 किमी",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d3e656534070b1f5e2c9",
   "sourceHash": "d3e656534070b1f5e2c97271d5ce47803c85c9116874f03ebf75e19feff2aeef",
   "text": "14वीं शताब्दी का यह प्राचीन मंदिर, जिसे मूनुमूर्ति मंदिर भी कहा जाता है, भारतपुझा नदी की सहायक नदी थूथा के तट पर बनाया गया था।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c45a2fd7c6d06dd7bff1",
   "sourceHash": "c45a2fd7c6d06dd7bff161764eba427a4aee0581800a568d2e7ea7463ce28a6b",
   "text": "14वीं शताब्दी का मंदिर",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
}
