 "units": [
  {
   "id": "t_317db569db094c5e6b38",
   "sourceHash": "317db569db094c5e6b380a5bebf86433250bb3365f8d88097cf0f7c173012e6e",
   "text": ": चिकित्सक गहन जाँच करते हैं, जिसमें नाड़ी परीक्षण, जीभ की जाँच तथा जीवनशैली और खान-पान की आदतों से जुड़े प्रश्न शामिल हो सकते हैं। इससे अंतर्निहित कारणों और असंतुलनों की पहचान करने में मदद मिलती है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dd281e5e3579b8292400",
   "sourceHash": "dd281e5e3579b8292400c4a803c82ca743dec8acc8f7a4b10cde5e2f890096bf",
   "text": ": निदान के आधार पर एक व्यक्तिगत उपचार योजना बनाई जाती है। इसमें आयुर्वेदिक चिकित्साओं, जड़ी-बूटी आधारित औषधियों, आहार में बदलाव और जीवनशैली संबंधी सुझावों का संयोजन शामिल हो सकता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_787adff347564d7d07dc",
   "sourceHash": "787adff347564d7d07dc399916e7c51c1454c92b67b7c3b324ba722d0f8ebdaf",
   "text": ": व्यक्ति को साइनस और माइग्रेन को लक्षित करने वाली विशिष्ट आयुर्वेदिक चिकित्साएँ दी जाती हैं, जैसे नस्यम (नाक के माध्यम से जड़ी-बूटी युक्त तेल देना), शिरोधारा (माथे पर जड़ी-बूटी युक्त तेल की धारा डालना) और रक्त संचार सुधारने तथा जकड़न से राहत देने के लिए सिर की हल्की मालिश।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_17554838839272b297f5",
   "sourceHash": "17554838839272b297f5705ed312caba6c6bceacf37f57ce0008e9f620a83f09",
   "text": "आहार संबंधी मार्गदर्शन",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4e9cf0fcd31260906b2d",
   "sourceHash": "4e9cf0fcd31260906b2db2154f1aaea915bc1567017772de07e191dee319b544",
   "text": ": चिकित्सक आहार संबंधी दिशानिर्देश देते हैं, बढ़े हुए दोषों को शांत करने वाले खाद्य पदार्थ सुझाते हैं और कुछ मसालों, कैफ़ीन तथा प्रसंस्कृत खाद्य पदार्थों जैसे ट्रिगर करने वाले पदार्थों से बचने की सलाह देते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7e92367630cc56d6f473",
   "sourceHash": "7e92367630cc56d6f473feed9b593b8b348fca1b9e41b53768ecefe0ce202ac9",
   "text": "जीवनशैली संबंधी सुझाव",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9fc32bfa81bfb6efd5bb",
   "sourceHash": "9fc32bfa81bfb6efd5bb4b7fcd6e4c12d2d4ccfeb367fa15d6eb3c182ffe1b74",
   "text": ": समग्र स्वास्थ्य को सहयोग देने और साइनस तथा माइग्रेन के दौरों की आवृत्ति और तीव्रता को कम करने के लिए व्यक्तिगत जीवनशैली परिवर्तनों की सलाह दी जाती है, जैसे तनाव प्रबंधन की तकनीकें, योग, ध्यान और नियमित व्यायाम।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_75c2167557de1e35a178",
   "sourceHash": "75c2167557de1e35a178d9d738a0326eaf9435a49b7b3de937c80b2d71b5e9f3",
