 "units": [
  {
   "id": "t_0496d22445175a3f5bcd",
   "sourceHash": "0496d22445175a3f5bcd2d07c0cbf435517caff45c1b790da822df0fb1302b82",
   "text": "जारी रखने के लिए हर्बल औषधियाँ (खरीद के लिए उपलब्ध)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_fa96788a0a301984e8d9",
   "sourceHash": "fa96788a0a301984e8d9b50251956dabe2689aca07fb5e389a4499c45684670c",
   "text": "ऑनलाइन फ़ॉलो-अप परामर्श का विकल्प",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5460d0e386a7f023a0ec",
   "sourceHash": "5460d0e386a7f023a0ec341b1778fe99845e56480f9a861a65886b91074bc95d",
   "text": "हम आधुनिक जीवनशैली में आयुर्वेदिक पद्धतियों को शामिल करने पर एक विस्तृत मार्गदर्शिका भी प्रदान करते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bc999f9dd7dfd565abed",
   "sourceHash": "bc999f9dd7dfd565abed9836211f16e1fd41b65792b2362d7af478e0dbd13b39",
   "text": "हाँ, हमारी इन-हाउस फ़ार्मेसी हमारे डॉक्टरों द्वारा निर्धारित प्रामाणिक आयुर्वेदिक औषधियाँ उपलब्ध कराती है। घर पर अपना उपचार जारी रखने के लिए हम आपके लिए दवाओं की आपूर्ति तैयार कर सकते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0c0d75d50d43363e1109",
   "sourceHash": "0c0d75d50d43363e110982278b8451ba39648e651dc5ead7ebbcc951e356e5ab",
   "text": "हाँ, आपकी प्रगति पर नज़र रखने और आवश्यकतानुसार सिफ़ारिशों में बदलाव करने के लिए हम अपने डॉक्टरों के साथ ऑनलाइन फ़ॉलो-अप परामर्श प्रदान करते हैं। इन्हें आपके प्रवास के 1, 3 और 6 महीने बाद, या आपके उपचार-चिकित्सक की सलाह के अनुसार, निर्धारित किया जा सकता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8149102a32e03062736f",
   "sourceHash": "8149102a32e03062736f3d82c8c79b2b371c105a0f314fa2c964d8566e7ada60",
   "text": "क्या आप आयुर्वेद के बारे में शैक्षिक कार्यक्रम प्रदान करते हैं?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_192255cfb4086b690433",
   "sourceHash": "192255cfb4086b690433929d2d2d7177da670592abac1f6ee1f2a20ce98082a4",
   "text": "हाँ, हम आयोजित करते हैं:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_390952fc4ef423770c5d",
   "sourceHash": "390952fc4ef423770c5d231159a76cda16a9a443e3a93977e2a7e73f2f7a8ea3",
   "text": "आपके प्रवास के दौरान आयुर्वेदिक सिद्धांतों पर दैनिक व्याख्यान",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9ed2b8dbdc7ad056117a",
   "sourceHash": "9ed2b8dbdc7ad056117ac8f437281705f875874dfb0ca595ad174065a193c49a",
   "text": "आयुर्वेदिक व्यंजनों के कुकिंग प्रदर्शन",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2035b385654bfa56e86a",
   "sourceHash": "2035b385654bfa56e86abcb31868154369aab6410a75d7f2f7fbdc33169ce4a3",
   "text": "स्व-देखभाल पद्धतियों पर कार्यशालाएँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d3688959e94cb11f7159",
   "sourceHash": "d3688959e94cb11f7159e26e5619dbd568c3402c6b3b4a8005227ebc688063e8",
   "text": "पेशेवरों के लिए प्रमाणन पाठ्यक्रम (वर्ष भर निर्धारित)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3af19a2346d1f084edb4",
   "sourceHash": "3af19a2346d1f084edb4089805fe0e2b6e1c343ebbb0d23e831ca533c1e2eff0",
   "text": "आयुर्वेदिक ज्ञान को गहरा करने के लिए गहन आवासीय कार्यक्रम",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "'retreats' rendered as 'आवासीय कार्यक्रम' (residential programmes) per clinical register."
   ]
  },
  {
   "id": "t_3405ffa167440a5707ed",
   "sourceHash": "3405ffa167440a5707ed258f6ee66ac9e2f391e9a9287f96c47078a07497a7d8",
   "text": "हमारी सिफ़ारिश:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d70de3615a03ca503e14",
   "sourceHash": "d70de3615a03ca503e14210d26e186bdb7b47f61f88f7ed2c6e03f6270ff4431",
   "text": "आयुर्वेदिक सिद्धांतों पर हमारी ब्लॉग श्रृंखला",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1f4ca5be61f023c8acec",
   "sourceHash": "1f4ca5be61f023c8acec55bdea89ae92c6266c840b344bd345669e9a5866f37d",
   "text": "हमारी वेबसाइट पर उपलब्ध निःशुल्क ई-बुक्स",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0c796e43f8751fc4930a",
   "sourceHash": "0c796e43f8751fc4930aaf348491e14a33313b895d6f4604cf384fe818f29d6b",
   "text": "हमारे YouTube चैनल पर शैक्षिक वीडियो",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_71ce48cccfcf6569fa01",
   "sourceHash": "71ce48cccfcf6569fa01a3731ef1b26d8c2bd132120a07a51bb9702bd74f3da7",
   "text": "अनुशंसित पुस्तकों की सूची (अनुरोध पर उपलब्ध)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1881f799c85a40041cc8",
   "sourceHash": "1881f799c85a40041cc85b079320aec1847c6d9b283bf4d81dfa50ce9dcca9e3",
   "text": "हर महीने निर्धारित परिचयात्मक वेबिनार",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5548d4869e1cb9b6fada",
   "sourceHash": "5548d4869e1cb9b6fadacdb2a99da98fc4210cb4bc512a82b6a9e3eb7cb4056f",
   "text": "क्या आप आयुर्वेदिक चिकित्सकों के लिए कोई प्रमाणन या प्रशिक्षण कार्यक्रम प्रदान करते हैं?",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3755d04d26ff179ea493",
   "sourceHash": "3755d04d26ff179ea4938c55225ae785478327f1ec16dbd62243d3d65564f958",
   "text": "हाँ, हम इनके लिए पेशेवर प्रशिक्षण कार्यक्रम प्रदान करते हैं:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b847783b73513a091db4",
   "sourceHash": "b847783b73513a091db4f1aa7b764cf3bf7a17362f34823acbb5fa0319d4d938",
   "text": "आयुर्वेदिक पेशेवरों के लिए सतत शिक्षा (विभिन्न अवधियाँ)",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9fb4cdd2549180072d20",
   "sourceHash": "9fb4cdd2549180072d20358bedaea88d9173d7e36877f82b331d34dc97641620",
   "text": "आगामी कार्यक्रम-सूची और आवश्यकताओं के लिए कृपया हमारी आरक्षण टीम से संपर्क करें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7696c4e3648c91fb8480",
   "sourceHash": "7696c4e3648c91fb84803585a12d1e30a15f12d3b6d8dbb243752c7d2e563867",
   "text": "अधिकृत पुन: प्रयोज्य फ़ैमिली दायरे के भीतर ऑपरेटर का प्रतिवर्ती डिज़ाइन निर्णय",
   "status": "translated",
   "unchangedReason": null,
