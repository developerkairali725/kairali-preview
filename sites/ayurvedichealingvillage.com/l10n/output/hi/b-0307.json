   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9dabb83b2d2f1baead7b",
   "sourceHash": "9dabb83b2d2f1baead7b457ca155210b3125d55b9caad2d98315f4ece0c17435",
   "text": "पौष्टिक शाकाहारी भोजन।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_019243ffb98f9c0393f6",
   "sourceHash": "019243ffb98f9c0393f67f465ec78660ea272507c1dad0719fb6763bf0970b91",
