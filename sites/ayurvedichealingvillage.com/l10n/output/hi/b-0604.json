   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5775f4cab6e0a3d1eea4",
   "sourceHash": "5775f4cab6e0a3d1eea48f37c1e2cb1fbabdd430bcd3ed8d3a0ec0000db41334",
   "text": "मूल प्रशंसापत्र पढ़ें",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6d262abc4b0a7a3b5011",
   "sourceHash": "6d262abc4b0a7a3b501188281360bda9763ff464edee1d5043af97ccb7f3a80b",
   "text": "समीक्षा की भाषा",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_510c765f211f334349ea",
   "sourceHash": "510c765f211f334349ea628fdaf21b83b13865b58b3f73457eae254959afb844",
   "text": "समीक्षाएँ लोड हो रही हैं…",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5350a63171a037eca926",
   "sourceHash": "5350a63171a037eca926bbaf454c3290da2c93496295b738cf30c29e8f2af492",
   "text": "फिर से लोड करके देखें",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_40f69fa2cb372d60e093",
   "sourceHash": "40f69fa2cb372d60e093b8011fdee8daae96873624e65b420e4f380a9e470ed8",
   "text": "Google समीक्षाएँ दिखाएँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5edce5c6b1409484d11f",
   "sourceHash": "5edce5c6b1409484d11fd47e8e7a1d6afbc02dd6f57660fb6d183eb1174c3741",
   "text": "Google Maps से समीक्षाएँ लोड हो रही हैं…",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_e2121a7419ac828ab40e",
   "sourceHash": "e2121a7419ac828ab40e6066d959a3f54c305172da3117bd9b7db1f9d25b315f",
   "text": "समीक्षा पैनल अभी उपलब्ध नहीं है। आप फिर भी सभी समीक्षाएँ सीधे Google Maps पर पढ़ सकते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b29cf705a0386aeeca5d",
   "sourceHash": "b29cf705a0386aeeca5d27a3d64a4c4e94484e6efd8e3eb5525ddf5856038f5a",
   "text": "Google Maps पर समीक्षाएँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ea37d6d9f4aa220b5e2a",
   "sourceHash": "ea37d6d9f4aa220b5e2aa3292a213ee83fb12cb8183aa0938a95b64c793a7af0",
   "text": "अधिकतम पाँच समीक्षाएँ, जिन्हें Google ने प्रासंगिकता के अनुसार क्रमबद्ध किया है। कोई स्टार-रेटिंग फ़िल्टर लागू नहीं किया गया है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_14c5b4eec60e4457ee7b",
   "sourceHash": "14c5b4eec60e4457ee7b595123e8412e8b75a5fed111ff1d961e90d89aabc3a2",
   "text": "इस पैनल में कोई समीक्षा उपलब्ध नहीं है। पूरी लिस्टिंग देखने के लिए Google Maps खोलें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_229a524d2b922f39129b",
   "sourceHash": "229a524d2b922f39129b2c4d0a49924ec807720fe5ebe8fd23e77d36004ea628",
   "text": "Google द्वारा अनूदित · मूल देखें",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_bf205dead12f53765dcf",
   "sourceHash": "bf205dead12f53765dcfb874b326e5d7c68e118721a88eaef0928aa2dbf04ecf",
   "text": "Google Maps पर पढ़ें ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8adb4d5967e26ca6e3cd",
   "sourceHash": "8adb4d5967e26ca6e3cde53fdf70f9a5a1765c3c592810e3e90790b0a52714d6",
   "text": "समीक्षाएँ Google Maps द्वारा प्रदान की गई हैं। Google नकली सामग्री की जाँच करता है और पहचान होने पर उसे हटा देता है; समीक्षाएँ Google द्वारा सत्यापित नहीं की जाती हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a14d8afeac52cc8e7ca1",
   "sourceHash": "a14d8afeac52cc8e7ca19dad4d2c8be48a299f01ea2a0b85969b70c655d84814",
   "text": "सभी Google समीक्षाएँ पढ़ें ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_cd8401f0d92cc92c526b",
   "sourceHash": "cd8401f0d92cc92c526bab1054fe06d950249adf960ef59df20b4c408d45d4cf",
   "text": "यात्रियों के अनुभव",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_be5d55bd2a29b60a679f",
   "sourceHash": "be5d55bd2a29b60a679ff2f1ef3827526beb298757937e02cddd933c094fa068",
   "text": "Tripadvisor समीक्षाएँ दिखाएँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9d942debee18625ee55e",
   "sourceHash": "9d942debee18625ee55e419556de83ee0463af32b446f0180c122fd9d6eb07c8",
   "text": "जब आप इसे खोलना चुनते हैं, तब Tripadvisor का अपना समीक्षा विजेट लोड होता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_48032948a3d8b1cb30d4",
   "sourceHash": "48032948a3d8b1cb30d4241534cb1bb078cf9ef766bccdf4522df0e8a6ad0cce",
   "text": "Kairali का आधिकारिक Tripadvisor समीक्षा विजेट",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_de63edc928be48a420ed",
   "sourceHash": "de63edc928be48a420edc37a4543569c01f2fda119f2b09799ede0f601ef7b4e",
   "text": "सभी Tripadvisor समीक्षाएँ पढ़ें ↗",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  }
 ]
