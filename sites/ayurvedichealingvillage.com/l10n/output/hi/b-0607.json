   "issues": []
  },
  {
   "id": "t_92f683d795e29769c385",
   "sourceHash": "92f683d795e29769c385a88a1627c0a8f8b1be582ce4e55c03e70d0660f86ce8",
   "text": "भेजने का समय आप तय करते हैं। यह पेज आपका ड्राफ़्ट तैयार करता है; उसे आपका ईमेल ऐप या WhatsApp भेजता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
