   "sourceHash": "2953c1fd83a115b33e2e14f6c1fa054a5dc17e0493bf1018c005ab9497cb174d",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]सभी शाकाहारी भोजन (नाश्ता, दोपहर का भोजन, रात का भोजन)।[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_32674f4cd19f0a858bb5",
   "sourceHash": "32674f4cd19f0a858bb5b07a09d966347d036bab1b3efcde3ad782609e2bafee",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]इन-हाउस वायुमंडलीय प्राकृतिक जल (In-house Atmospheric Natural Water) का दैनिक आवंटन, हर्बल जल की असीमित आपूर्ति।[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d467e1596253272b2c60",
   "sourceHash": "d467e1596253272b2c602ff8e6091f97d7063fd2517666594ce70945ac2dabe0",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]प्रति व्यक्ति प्रतिदिन भाप स्नान के साथ दो आयुर्वेदिक थेरेपी।[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a6a47c56095fc9278dec",
   "sourceHash": "a6a47c56095fc9278dec65d681edb0e310f1b6418f8cc81a5d2c891929b5abfd",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]मालिश के हर सत्र के साथ निःशुल्क जूस या हर्बल चाय। अतिरिक्त खाद्य पदार्थों के लिए शुल्क लागू होगा।[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ddc31507fff30b6de53a",
   "sourceHash": "ddc31507fff30b6de53a3ff38308f08670337b790d7f42a46f1513cf39bbdc86",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]हर सुबह निःशुल्क सामूहिक योग सत्र। व्यक्तिगत कक्षाएँ सशुल्क होंगी।[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_840c68bfb65a50595c12",
   "sourceHash": "840c68bfb65a50595c12d9710aaac6059f1a91fbb5daa54056cae8b2602d4f31",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]हर शाम निःशुल्क सामूहिक ध्यान सत्र। व्यक्तिगत कक्षाएँ सशुल्क होंगी।[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_09f9e58fc3b18c56072a",
   "sourceHash": "09f9e58fc3b18c56072a2dd42b76ff46680e0ebae9bfb339ee160e53ac2b90ab",
   "text": "[[OPEN_1]]◆[[CLOSE_1]][[OPEN_2]]सप्ताह में एक बार आयुर्वेद पर निःशुल्क व्याख्यान।[[CLOSE_2]]",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
