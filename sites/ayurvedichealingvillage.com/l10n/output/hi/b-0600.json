  {
   "id": "t_f7ffd249f46bcddc6a7a",
   "sourceHash": "f7ffd249f46bcddc6a7a7e306e6c7b8cb326b134c53f93699a137814296eedaa",
   "text": "पश्चिमी घाट की ओर लंबी सैर, जिनके प्रवेश संबंधी प्रबंध जाने से पहले जाँच लेने चाहिए।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_0afe1a00f23d90b9dd10",
   "sourceHash": "0afe1a00f23d90b9dd104b0716e926a9dd63b21bd39cda5a5a6b3bd18fc1e9c5",
   "text": "दर्शनीय स्थल गाइड पर जाएँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6083305291cb48b5bc14",
   "sourceHash": "6083305291cb48b5bc149b422aaad15d258b8aa1d40c6aa44b4271ad64d4479e",
   "text": "पालक्काड के आसपास और उससे आगे",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4b504c9e85ffa4c45ce2",
   "sourceHash": "4b504c9e85ffa4c45ce2b84a015cd4c0cef7bcc36f0d3b6af732349209330701",
   "text": "हमारे आसपास के मंदिरों, नदी किनारे के परिदृश्यों और वनाच्छादित पहाड़ियों को जानें। घूमने योग्य 22 स्थानों में से चुनें, साथ में आयुर्वेदिक हीलिंग विलेज से अनुमानित सड़क दूरियाँ दी गई हैं ताकि आप योजना बना सकें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_6a71f6245786b01b208e",
   "sourceHash": "6a71f6245786b01b208e9d653e2de01128cb5f5c2757e2709fcbea5f2e854513",
   "text": "अपने प्रवास के दौरान कहीं घूमने की योजना बना रहे हैं? परिवहन के बारे में और इसे अपनी अपॉइंटमेंट के अनुसार व्यवस्थित करने के लिए रिसेप्शन से बात करें।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_29b6725edbd31dd9a4b9",
   "sourceHash": "29b6725edbd31dd9a4b9f1ba3e2ef234e0cc9d85eca7bcdd64930f3de48b58ef",
   "text": "/ देखें",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f56061681216936168c3",
   "sourceHash": "f56061681216936168c376f8d39a54d4ba93c3b98ddc19cd5f91b0e0e28a28d0",
   "text": "लगभग",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1f34503f65b4a355a94e",
