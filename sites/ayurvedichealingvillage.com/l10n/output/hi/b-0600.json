   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f1c9500f7235f7a2fadf",
   "sourceHash": "f1c9500f7235f7a2fadfc95b657482da92bb93c600f3c89ff09fefcfa4275a9b",
   "text": "हाउसबोट भ्रमण →",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c97f41f5506d5235f5f6",
   "sourceHash": "c97f41f5506d5235f5f6bfa3b6184e21c6fa7f947f879609b7cbb1fa05127d83",
   "text": "केरल में करने के लिए और भी बहुत कुछ →",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_36c07f5bdb0817b7f35c",
   "sourceHash": "36c07f5bdb0817b7f35cf57590f0e995fee3cd0c6ae66ec2527f34222612e737",
   "text": "सड़क दूरी के अनुमानों में इनका उपयोग किया गया है:",
   "status": "translated",
   "unchangedReason": null,
   "issues": [
    "Fragment followed by attribution links (OpenStreetMap contributors, OSRM routing); rephrased with a colon so the links can follow in Hindi word order."
