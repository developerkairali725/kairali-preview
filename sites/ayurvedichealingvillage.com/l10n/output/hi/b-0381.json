 "units": [
  {
   "id": "t_d27da146ad3f59e8e8cd",
   "sourceHash": "d27da146ad3f59e8e8cde35fbc339a6004f27753e04bcdfaa127d3baaa365072",
   "text": "प्रतिदिन भाप स्नान, प्रति व्यक्ति दो आयुर्वेदिक थेरेपी के साथ।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b0dc19cf61a42a172871",
   "sourceHash": "b0dc19cf61a42a1728715d2fdbb6aae83a68ea56e36517ec69b06dd8b0424c4c",
   "text": "मालिश के प्रत्येक सत्र के साथ निःशुल्क जूस या हर्बल चाय। अतिरिक्त खाद्य पदार्थों के लिए शुल्क लागू होगा।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8d1a069225da4bcc3dd0",
   "sourceHash": "8d1a069225da4bcc3dd0920aed59b3e26430e316461a9e7b61e4d797af1e2973",
   "text": "प्रतिदिन सुबह निःशुल्क सामूहिक योग सत्र। व्यक्तिगत कक्षाओं के लिए शुल्क लिया जाएगा।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c26a807fafba6089492f",
   "sourceHash": "c26a807fafba6089492f19707f92be7daa8ee47776bc5c42749abe7cdb73988b",
   "text": "प्रतिदिन शाम निःशुल्क सामूहिक ध्यान सत्र। व्यक्तिगत कक्षाओं के लिए शुल्क लिया जाएगा।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_caa9b34ae8690d69cd07",
   "sourceHash": "caa9b34ae8690d69cd078766fb480da65318d595f2cf3e3fadcbe90be5a4c264",
   "text": "सप्ताह में एक बार आयुर्वेद पर निःशुल्क व्याख्यान।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_559eb14fba143e37f55c",
   "sourceHash": "559eb14fba143e37f55c1ad3cce067c5f186eabb759a88e52697d8fe1fbb8302",
   "text": "सप्ताह में एक बार योग पर निःशुल्क व्याख्यान।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_31a54b21688419b999eb",
   "sourceHash": "31a54b21688419b999ebc5add56d4793de51160250c44006b62f5bca4f66de6d",
   "text": "सप्ताह में एक बार निःशुल्क कुकिंग वर्कशॉप।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_2e9370117eac4254e607",
   "sourceHash": "2e9370117eac4254e6077d938aec447ab84e7b1e7a7154fae9768f9c969e1178",
   "text": "सप्ताह में एक बार निःशुल्क गाँव भ्रमण।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8330bc440ef866f28c88",
   "sourceHash": "8330bc440ef866f28c888ad77c5e99819740e5c3a90870ef6863d6af90e55677",
   "text": "जैविक उद्यान का गाइडेड भ्रमण।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a6d508b78d47beb4168a",
   "sourceHash": "a6d508b78d47beb4168ac0fcffa7c1b3526a34d30e5acc9c2113adc6d5dd1168",
   "text": "हमारी स्वामित्व वाली आयुर्वेदिक फ़ैक्टरी का भ्रमण, शुल्क के आधार पर। हमारे मैत्रीपूर्ण कर्मचारी आपको दरों और विवरण के बारे में जानकारी देंगे।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c932d0ae17acdb495b61",
   "sourceHash": "c932d0ae17acdb495b615da7b6cfd37be9c76e00a6c86cc3f699c66722ebe073",
   "text": "व्यक्तिगत जीवनशैली और फ़िटनेस का दैनिक मूल्यांकन।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4ca9ddefb03169dbbf0b",
   "sourceHash": "4ca9ddefb03169dbbf0bd738eef6f63ccaf44b6ef9b2b96d8e757e58fceeb8d9",
   "text": "स्विमिंग पूल, पुस्तकालय, जिम और सभी इनडोर सुविधाओं का उपयोग निःशुल्क किया जा सकता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_f9221b0fc8fe8e736ded",
   "sourceHash": "f9221b0fc8fe8e736dedf0056c0d5f62f52779aa84cb0ec9f7c11cf3f9b1f7ed",
   "text": "आंतरिक औषधियों का शुल्क अलग से लिया जाएगा, क्योंकि उनका निर्धारण उपचार के आगे बढ़ने के साथ ही किया जा सकता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
