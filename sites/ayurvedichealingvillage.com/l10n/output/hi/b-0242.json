 "units": [
  {
   "id": "t_b1e49179293c442241f6",
   "sourceHash": "b1e49179293c442241f681a5668c89c8e4ca936e7d2bee98da150b0277369a7a",
   "text": "सतत जीवनशैली: पर्यावरण-अनुकूल कॉटेज में ठहरें, जो आसपास के प्राकृतिक परिवेश के साथ सहज रूप से घुल-मिल जाते हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_292cb4ef497ff2871db5",
   "sourceHash": "292cb4ef497ff2871db542345aae339e99f6c3593c094b9253ca00875a36f5a3",
   "text": "पालक्काड के प्रमुख दर्शनीय स्थल",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5effbe02552e392cab43",
   "sourceHash": "5effbe02552e392cab435a16031f76ab8932ca1ef8eb478b309dbae9f6296c51",
   "text": "जब आप Kairali – आयुर्वेदिक हीलिंग विलेज में ठहरते हैं, तो आप पालक्काड के अनेक अद्भुत स्थलों को देखने के लिए बिल्कुल उपयुक्त स्थान पर होते हैं:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_5a4c5a9ed80a7e8c11cf",
   "sourceHash": "5a4c5a9ed80a7e8c11cfb41b91730e745af5e91bcbf629d6be8a1b16fd5dca26",
   "text": "पालक्काड किला",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3dc972b83c907f506124",
   "sourceHash": "3dc972b83c907f506124e5b5cbf452621e6995c869f80aebff3c57618246fb49",
   "text": ": हैदर अली द्वारा निर्मित 18वीं शताब्दी का यह सुसंरक्षित किला एक ऐतिहासिक स्थल है, जो इस क्षेत्र के औपनिवेशिक अतीत की झलक देता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_cc2a2899f33beeb93f05",
   "sourceHash": "cc2a2899f33beeb93f059bf3f55569db3ad95005fb61a5d528dc20bb3fe4908a",
   "text": "पालक्काड किला: हैदर अली द्वारा निर्मित 18वीं शताब्दी का यह सुसंरक्षित किला एक ऐतिहासिक स्थल है, जो इस क्षेत्र के औपनिवेशिक अतीत की झलक देता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_dcf5dddb103321437c3e",
   "sourceHash": "dcf5dddb103321437c3e76248a05f8f4bdcd9a5fc107acd297601d981535b453",
   "text": ": यह UNESCO विश्व धरोहर स्थल प्रकृति प्रेमियों के लिए स्वर्ग है, जहाँ ट्रेकिंग के अवसर और दुर्लभ वन्यजीवों को देखने का मौका मिलता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c5408a70e65987ed2dfc",
   "sourceHash": "c5408a70e65987ed2dfc87a09b667605c75ccb78e11d9f9ab93c51baaf324a9a",
   "text": "साइलेंट वैली राष्ट्रीय उद्यान: यह UNESCO विश्व धरोहर स्थल प्रकृति प्रेमियों के लिए स्वर्ग है, जहाँ ट्रेकिंग के अवसर और दुर्लभ वन्यजीवों को देखने का मौका मिलता है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ea30f450eea86b7bfca6",
   "sourceHash": "ea30f450eea86b7bfca6db03972d04b4b69441b3202f3dc32d58c62843dccde5",
   "text": "मलमपुझा बाँध और उद्यान",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_7851a2c2dae3d5ba8851",
   "sourceHash": "7851a2c2dae3d5ba8851fbc8df028901fd539a4404c28dce769addcf25ce0e71",
   "text": ": हरे-भरे उद्यानों, रोपवे और नौका-विहार की सुविधाओं वाले इस मनोरम स्थल पर एक सुकून भरा दिन बिताइए।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_1b1efc89407a3e4968a5",
   "sourceHash": "1b1efc89407a3e4968a5ebf5ad873c0743f0cb0e78148297e43d532f24bd7be0",
   "text": "मलमपुझा बाँध और उद्यान: हरे-भरे उद्यानों, रोपवे और नौका-विहार की सुविधाओं वाले इस मनोरम स्थल पर एक सुकून भरा दिन बिताइए।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_a5cdaf8f9b2bd4ea87fd",
   "sourceHash": "a5cdaf8f9b2bd4ea87fdf7fc8c769178efe7cf1d79196afdae03e790c15773dd",
   "text": "नेल्लियाम्पति पहाड़ियाँ",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_4311876c187c11d72d24",
   "sourceHash": "4311876c187c11d72d241e1236ba57678130e9af0979d5f9a91c5de466ea7a29",
   "text": ": “केरल की ऊटी” के नाम से प्रसिद्ध ये पहाड़ियाँ ट्रेकिंग, पिकनिक और मनमोहक दृश्यों के लिए आदर्श हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_b60c9cac4a04b40b57f6",
   "sourceHash": "b60c9cac4a04b40b57f6bfdc37876b7e70b5035002443e6d4056c2c7adabea46",
   "text": "नेल्लियाम्पति पहाड़ियाँ: “केरल की ऊटी” के नाम से प्रसिद्ध ये पहाड़ियाँ ट्रेकिंग, पिकनिक और मनमोहक दृश्यों के लिए आदर्श हैं।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_d04f6cc8b1eeeee6a5f5",
   "sourceHash": "d04f6cc8b1eeeee6a5f522a634d90b7bdf4a3e87619d9dee178c80a118eb5d86",
   "text": "कल्पाथी हेरिटेज विलेज",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_ad56d719bdfe4432d2ba",
   "sourceHash": "ad56d719bdfe4432d2badb65c782518ced0f12de39c403b51156b7843c7911a1",
   "text": ": अपने वैदिक समुदाय, प्राचीन मंदिरों और वार्षिक रथ उत्सव के लिए प्रसिद्ध इस ऐतिहासिक गाँव की सैर कीजिए।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_c4761e06d9e41eec5032",
   "sourceHash": "c4761e06d9e41eec50320e94599b778b8fa7ac8e749958c177a070fe5e700e8a",
   "text": "कल्पाथी हेरिटेज विलेज: अपने वैदिक समुदाय, प्राचीन मंदिरों और वार्षिक रथ उत्सव के लिए प्रसिद्ध इस ऐतिहासिक गाँव की सैर कीजिए।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_444e28e235ef0a18cc64",
   "sourceHash": "444e28e235ef0a18cc645354ec509d14e58491fe9e92ce8d452e72489a59ed39",
   "text": "परम्बिकुलम टाइगर रिज़र्व",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8c32afbecb81164459b3",
   "sourceHash": "8c32afbecb81164459b31cd7aa9f970f37e12cb8a00f4a16fff7408457ab052e",
   "text": ": वन्यजीव प्रेमियों के लिए अवश्य देखने योग्य यह रिज़र्व बाघों, हाथियों और अन्य विदेशी प्रजातियों का घर है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_44654b43d524b3c38bc4",
   "sourceHash": "44654b43d524b3c38bc40ebc168a468bf5e8081c3111181a4bce0b5e64a53993",
   "text": "परम्बिकुलम टाइगर रिज़र्व: वन्यजीव प्रेमियों के लिए अवश्य देखने योग्य यह रिज़र्व बाघों, हाथियों और अन्य विदेशी प्रजातियों का घर है।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_48fd38c8ff6b17dfc089",
   "sourceHash": "48fd38c8ff6b17dfc089b7fa744e103479e336e70b51615ab3eae3052c698364",
   "text": "पालक्काड में सांस्कृतिक अनुभव",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_8122b842e36f201fa25d",
   "sourceHash": "8122b842e36f201fa25d3c008899881d421f2184b6f9344a8fa41d852ff6cdcb",
   "text": "पालक्काड सांस्कृतिक अनुभवों का खज़ाना है। पारंपरिक संगीत और नृत्य प्रस्तुतियाँ देखिए, धरोहर स्थलों पर जाइए, और स्थानीय उत्सवों में भाग लीजिए, जैसे:",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_3e53ecf88da758199a9a",
   "sourceHash": "3e53ecf88da758199a9a7d9a95cfa2c53d2d91518a42b9a1c38e050a46f5cbb5",
   "text": "कल्पाथी रथोत्सवम",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_18d0db16caeb7af230a6",
   "sourceHash": "18d0db16caeb7af230a6fdb0f722463bd581cf1d325ddce3f965db3f7c7b204b",
   "text": ": प्राचीन कल्पाथी विश्वनाथ स्वामी मंदिर में मनाया जाने वाला एक जीवंत रथ उत्सव।",
   "status": "translated",
   "unchangedReason": null,
   "issues": []
  },
  {
   "id": "t_9d85774e496ef32aebaf",
   "sourceHash": "9d85774e496ef32aebafd2dab1b8587255ee331ed078394bcaaaabe8155f42c3",
   "text": "कल्पाथी रथोत्सवम: प्राचीन कल्पाथी विश्वनाथ स्वामी मंदिर में मनाया जाने वाला एक जीवंत रथ उत्सव।",
   "status": "translated",
